# Reachability repro for Bug#39244016 / upstream b9892d521d6c68580eb17e8b8fe993e51828cd5e
# Fil_shard::do_io() missing mutex_release() before returning DB_PAGE_IS_STALE
# in the "file->size <= page_no" branch.
#
# STATUS (see .bug39244016_repro/NOTES.txt for the full writeup): REPRODUCED.
# Red/green validated: unfixed code crashes the server deterministically
# (SIGABRT, assertion in fil_space_t::was_not_deleted()); with the fix
# (mutex_release() added) the identical test passes cleanly and a
# bounded-timeout probe against the same shard returns immediately.
#
# Only ONE dirty page is used (page 5) -- no sibling I/O needed. Growing to
# a single extra page beyond the initial 5-page/80KB session temp tablespace
# is enough; more rows just add more sibling pages without changing the
# mechanism (all sibling pages that are NOT paused complete instantly and
# don't interfere).
#
# Setup required before running (adjust to your own scratch paths):
#   - Build mysqld/mysqltest/mysql with -DWITH_DEBUG=ON (Debug build type
#     for ENABLED_DEBUG_SYNC), start mysqld with:
#       --loose-debug-sync-timeout=600   (REQUIRED -- default is 0, which
#         makes every "WAIT_FOR ... TIMEOUT n" clause return instantly
#         instead of actually waiting)
#       --log_error_verbosity=3          (only needed for ib::info()-level
#         diagnostics; not required for this version of the test)
#   - Update the two hardcoded paths below (marked ADJUST-PATH) to match your
#     datadir and probe.sh's location.
#   - CREATE DATABASE test; before running (mysqltest connects to db "test").
#
# IMPORTANT test-harness gotcha (cost significant time to find -- see
# NOTES.txt "WHAT WAS ACTUALLY BLOCKING" section): connections B and C must
# BOTH be established BEFORE B issues its `--send SET GLOBAL
# innodb_buf_flush_list_now = ON`. THD creation (Channel_info::create_thd ->
# THD::init -> plugin_thdvar_init) acquires LOCK_global_system_variables, and
# sys_var::update() for a GLOBAL variable holds that SAME lock for the
# entire duration of its on-update callback -- which for
# innodb_buf_flush_list_now is buf_flush_sync_all_buf_pools(), i.e. for as
# long as the paused write is parked. Connecting C *after* B's --send blocks
# C's own connection setup on that lock for the whole pause window, which
# looks identical to "the truncate can't proceed" but is actually just a
# test-harness artifact unrelated to the InnoDB fil-shard mechanism under
# test. (This is what caused the PREVIOUS round of this investigation to
# conclude "not reproduced" / "structural wall" -- see NOTES.txt.)

--disable_warnings
SET GLOBAL innodb_adaptive_hash_index = OFF;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_buf_flush_list_now = ON;
--enable_warnings

# ---- Connection A: create a single dirty page beyond the initial extent ----
# ADJUST-PATH: point this at your own datadir's mysqld.sock.
connect (conA, localhost, root,, test,, /tmp/bug39244016-repro/data/mysqld.sock,);
connection conA;
CREATE TEMPORARY TABLE t1 (a INT, b VARCHAR(4000)) ENGINE=InnoDB;
--disable_query_log
let $i = 1;
while ($i <= 4)
{
  eval INSERT INTO t1 VALUES ($i, REPEAT('x', 4000));
  inc $i;
}
--enable_query_log
SELECT COUNT(*) FROM t1;

--echo # Determine conA's session temp tablespace id
--disable_query_log
let $space_id = query_get_value(SELECT SPACE FROM INFORMATION_SCHEMA.INNODB_TEMP_TABLE_INFO, SPACE, 1);
--enable_query_log
--echo target_space_id: $space_id

# ---- Connect B and C BOTH up front (see gotcha above) ----
connect (conB, localhost, root,, test,, /tmp/bug39244016-repro/data/mysqld.sock,);
connect (conC, localhost, root,, test,, /tmp/bug39244016-repro/data/mysqld.sock,);

# ---- Connection B: arm the sync point, then issue a global flush (async). ----
# B resumes purely via its own TIMEOUT (no one ever signals "never").
connection conB;
SET DEBUG_SYNC = 'innodb_fil_do_io_before_stale_recheck SIGNAL paused WAIT_FOR never TIMEOUT 20';
--send SET GLOBAL innodb_buf_flush_list_now = ON

# ---- Connection C: wait for pause, disconnect A (drives space_truncate) ----
connection conC;
--enable_warnings
SET DEBUG_SYNC = 'now WAIT_FOR paused TIMEOUT 30';
SHOW WARNINGS;

connection conA;
--echo # Disconnecting A while B is parked inside do_io() with the shard mutex released.
disconnect conA;
connection conC;
--echo # Confirm the tablespace file was actually truncated back down while B was parked.
# ADJUST-PATH: point this at your own datadir's #innodb_temp directory.
--exec ls -la "/tmp/bug39244016-repro/data/#innodb_temp/"

# ---- Reap connection B's flush: it returns once its own TIMEOUT (20s) elapses ----
# If the bug is present (unfixed), the server crashes with SIGABRT before this
# reaps successfully (see NOTES.txt for why: dblwr::write()'s own
# DB_PAGE_IS_STALE handling immediately calls was_stale() -> was_not_deleted(),
# which asserts the shard mutex is NOT held -- but it still is, because it
# leaked one call frame earlier).
connection conB;
--reap
SHOW WARNINGS;
SET DEBUG_SYNC = 'RESET';

connection default;
disconnect conB;
disconnect conC;

--echo # Bounded-timeout probe: reuse the shard via a new session.
--echo # If the shard mutex leaked (bug present), this hangs until the shell timeout
--echo # (in a non-debug/release build; in a debug build the server crashes above
--echo # instead, before this probe even gets a chance to run).
--echo # If the fix is applied, this returns immediately.
# ADJUST-PATH: probe.sh hardcodes MYSQL_BIN/SOCK; edit it for your environment.
--exec /tmp/bug39244016-84-build/probe.sh

SET GLOBAL innodb_page_cleaner_disabled_debug = OFF;
