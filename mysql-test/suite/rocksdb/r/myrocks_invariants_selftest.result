INSERT INTO t_upk_part VALUES (1, 1), (2, NULL), (3, 1);
INSERT INTO t_unp_blob VALUES ('x', 1), ('y', NULL), (REPEAT('z', 255), 1);
INSERT INTO t_unp_null VALUES (1, 1), (NULL, 1), (NULL, NULL);
INSERT INTO t_unp_prefix VALUES ('abcdefg', 1), ('bcdefgh', NULL);
INSERT INTO t_unp_func VALUES (1, 1), (2, NULL);
INSERT INTO t_unp_virtual (a) VALUES (1), (2), (3);
# Hidden primary key only where no UNIQUE key qualifies.
SELECT TABLE_NAME, GROUP_CONCAT(DISTINCT INDEX_NAME ORDER BY INDEX_NAME) AS idx
FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'inv' AND TABLE_NAME LIKE 't\_u%'
 GROUP BY TABLE_NAME ORDER BY TABLE_NAME;
TABLE_NAME	idx
t_unp_blob	HIDDEN_PK_ID,kc,ub
t_unp_func	HIDDEN_PK_ID,kb,uf
t_unp_null	HIDDEN_PK_ID,kb,ua
t_unp_prefix	HIDDEN_PK_ID,kb,ua
t_unp_virtual	HIDDEN_PK_ID,ka,ug
t_upk	kb,ua
t_upk2	kd,ua,ubc
t_upk_blob	kc,ub
t_upk_part	kb,ua
t_upk_stored	ka,ug
ALTER TABLE t_pk DROP INDEX kab;
ALTER TABLE t_cf ADD INDEX kab (a, b), ALGORITHM=INPLACE;
CREATE TABLE t_dropped (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t_dropped VALUES (1, 1), (2, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DROP TABLE t_dropped;
# A dropped table with rocksdb_enable_delete_range_for_drop_index=ON.
SET @saved_delete_range = @@GLOBAL.rocksdb_enable_delete_range_for_drop_index;
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = ON;
CREATE TABLE t_dropped_dr (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t_dropped_dr VALUES (1, 1), (2, 2), (3, 3);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DROP TABLE t_dropped_dr;
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = @saved_delete_range;
