#
# Invariant 5: a snapshot is stable across a compaction.
#
DELETE FROM m_rdb WHERE pk = 1;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
violations: 0
# Without a snapshot the change is seen, and reported.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
