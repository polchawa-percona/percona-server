#
# Invariant 2: InnoDB mirror compare.
#
CREATE TABLE m_rdb (pk INT PRIMARY KEY, a INT, b TEXT) ENGINE=ROCKSDB;
CREATE TABLE m_inn (pk INT PRIMARY KEY, a INT, b TEXT) ENGINE=InnoDB;
INSERT INTO m_rdb VALUES (1, 1, 'a'), (2, NULL, NULL);
INSERT INTO m_inn VALUES (1, 1, 'a'), (2, NULL, NULL);
violations: 0
UPDATE m_rdb SET b = 'b' WHERE pk = 2;
INVARIANT VIOLATION 2: m_rdb (2:6322056046) differs from mirror m_inn (2:3172395927)
violations: 1
#
# Invariant 5: a snapshot is stable across a compaction.
#
DELETE FROM m_rdb WHERE pk = 1;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
violations: 0
# Without a snapshot the change is seen, and reported.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
INSERT INTO m_rdb VALUES (7, 7, 'g');
INVARIANT VIOLATION 5: snapshot of m_rdb changed from 1:3409937537 to 2:3448450495
violations: 1
#
# Invariant 6: commit log is a prefix.
#
CREATE TABLE commit_log (seq INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO commit_log VALUES (1), (2), (3);
violations: 0 survived: 3
