call mtr.add_suppression("CHECKTABLE t_cf");
CREATE DATABASE inv;
USE inv;
#
# Healthy tables of several shapes: no output.
#
CREATE TABLE t_pk (pk INT PRIMARY KEY, a INT, b VARCHAR(20), c BLOB,
KEY ka (a), UNIQUE KEY kb (b), KEY kab (a, b), KEY kc (c(10)))
ENGINE=ROCKSDB;
CREATE TABLE t_hidden (a INT, b VARCHAR(20), KEY ka (a)) ENGINE=ROCKSDB;
CREATE TABLE t_cf (pk INT, a INT, b VARCHAR(20) COLLATE utf8mb4_general_ci,
PRIMARY KEY (pk) COMMENT 'cfname=inv_cf',
KEY ka (a) COMMENT 'rev:inv_rev_cf',
KEY kb (b) COMMENT 'cfname=inv_cf') ENGINE=ROCKSDB;
CREATE TABLE t_part (pk INT, a INT, PRIMARY KEY (pk), KEY ka (a))
ENGINE=ROCKSDB PARTITION BY HASH (pk) PARTITIONS 3;
CREATE TABLE t_subpart (pk INT, a INT, PRIMARY KEY (pk, a), KEY ka (a))
ENGINE=ROCKSDB
PARTITION BY RANGE (pk) SUBPARTITION BY HASH (a) SUBPARTITIONS 2
(PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN MAXVALUE);
CREATE TABLE t_ttl (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB
COMMENT 'ttl_duration=3600;';
CREATE TABLE t_inv (pk INT PRIMARY KEY, a INT, KEY ka (a) INVISIBLE) ENGINE=ROCKSDB;
CREATE TABLE t_innodb (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=InnoDB;
CREATE TABLE `t,"odd``` (`p,k` INT PRIMARY KEY, `a"b` INT, `c``d` VARCHAR(10),
KEY `k,"1``` (`a"b`, `c``d`)) ENGINE=ROCKSDB;
INSERT INTO t_pk VALUES (1, 10, 'x', 'blob1'), (2, NULL, 'y', NULL),
(3, 10, NULL, REPEAT('z', 100)), (4, 40, 'w', '');
INSERT INTO t_hidden VALUES (1, 'a'), (1, 'a'), (NULL, NULL);
INSERT INTO t_cf VALUES (1, 1, 'A'), (2, 2, 'a'), (3, 3, 'b');
INSERT INTO t_part VALUES (1, 1), (2, 2), (3, 3), (4, 4), (5, NULL);
INSERT INTO t_subpart VALUES (1, 1), (2, 2), (150, 3), (151, 4);
INSERT INTO t_ttl VALUES (1, 1), (2, 2);
INSERT INTO t_inv VALUES (1, 1);
INSERT INTO `t,"odd``` VALUES (1, 1, 'x'), (2, NULL, 'y');
INSERT INTO t_innodb VALUES (1, 1), (2, 2), (3, 3), (4, 4), (5, NULL);
ALTER TABLE t_pk DROP INDEX kab;
ALTER TABLE t_cf ADD INDEX kab (a, b), ALGORITHM=INPLACE;
CREATE TABLE t_dropped (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t_dropped VALUES (1, 1), (2, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DROP TABLE t_dropped;
# A dropped table with rocksdb_enable_delete_range_for_drop_index=ON.
SET @saved_delete_range = @@GLOBAL.rocksdb_enable_delete_range_for_drop_index;
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = ON;
CREATE TABLE t_dropped_dr (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t_dropped_dr VALUES (1, 1), (2, 2), (3, 3);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DROP TABLE t_dropped_dr;
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = @saved_delete_range;
violations: 0, CHECK TABLE skipped: 1, dictionary check skipped: 1
