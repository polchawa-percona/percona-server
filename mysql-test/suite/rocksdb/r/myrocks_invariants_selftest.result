DROP TABLE t_cf;
#
# Invariant 3: the server DD and the MyRocks dictionary disagree on the
# hidden primary key. The DD is edited directly; the open tables keep
# their share, so only the dictionary check sees the change.
#
# t_upk.a nullable in the DD: no UNIQUE key qualifies, the DD expects a
# HIDDEN_PK_ID that MyRocks does not have.
SET SESSION debug = '+d,skip_dd_table_access_check';
UPDATE mysql.columns c JOIN mysql.tables t ON c.table_id = t.id
JOIN mysql.schemata s ON t.schema_id = s.id
SET c.is_nullable = 1
WHERE s.name = 'inv' AND t.name = 't_upk' AND c.name = 'a';
v	tn	pn	idx
INVARIANT VIOLATION 3: index missing in MyRocks dictionary	t_upk	NULL	HIDDEN_PK_ID
violations: 1
UPDATE mysql.columns c JOIN mysql.tables t ON c.table_id = t.id
JOIN mysql.schemata s ON t.schema_id = s.id
SET c.is_nullable = 0
WHERE s.name = 'inv' AND t.name = 't_upk' AND c.name = 'a';
# t_unp_null.a NOT NULL in the DD: UNIQUE ua qualifies, MyRocks has a
# HIDDEN_PK_ID that the DD does not expect.
UPDATE mysql.columns c JOIN mysql.tables t ON c.table_id = t.id
JOIN mysql.schemata s ON t.schema_id = s.id
SET c.is_nullable = 0
WHERE s.name = 'inv' AND t.name = 't_unp_null' AND c.name = 'a';
v	tn	pn	idx
INVARIANT VIOLATION 3: MyRocks dictionary entry without a table or index	t_unp_null	NULL	HIDDEN_PK_ID
violations: 1
UPDATE mysql.columns c JOIN mysql.tables t ON c.table_id = t.id
JOIN mysql.schemata s ON t.schema_id = s.id
SET c.is_nullable = 1
WHERE s.name = 'inv' AND t.name = 't_unp_null' AND c.name = 'a';
SET SESSION debug = '-d,skip_dd_table_access_check';
