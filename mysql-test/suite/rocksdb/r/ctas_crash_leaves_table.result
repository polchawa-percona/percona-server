CREATE TABLE t2 (pk INT PRIMARY KEY, a INT NOT NULL, b VARCHAR(64) NOT NULL,
KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t2 (pk, a, b)
WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 30)
SELECT i, i * 7 MOD 11, REPEAT(CHAR(96 + i MOD 26), i) FROM s;
