# Scenario: ALTER TABLE t1 ALGORITHM=INPLACE, DROP PARTITION p2, killed at alter_table_inplace_before_commit
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=ROCKSDB
PARTITION BY RANGE (id) (
PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN (200),
PARTITION p2 VALUES LESS THAN (300));
INSERT INTO t1 VALUES (1, 1), (2, 2), (101, 101), (102, 102), (201, 201),
(202, 202);
SET DEBUG_SYNC = 'alter_table_inplace_before_commit SIGNAL parked WAIT_FOR never_happens';
ALTER TABLE t1 ALGORITHM=INPLACE, DROP PARTITION p2;
SET DEBUG_SYNC = 'now WAIT_FOR parked';
# Kill and restart
# State after recovery (errors are printed, not fatal)
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
p0
p1
p2
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
  ORDER BY PARTITION_NAME;
PARTITION_NAME
p0
p1
p2
SELECT COUNT(*) FROM t1;
COUNT(*)
6
SELECT id FROM t1 ORDER BY id;
id
1
2
101
102
201
202
INSERT INTO t1 VALUES (50, 50), (150, 150), (250, 250);
SELECT COUNT(*) FROM t1;
COUNT(*)
9
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# Plain DROP TABLE
DROP TABLE t1;
# Cleanup that always works
DROP TABLE IF EXISTS t1;
Warnings:
Note	1051	Unknown table 'test.t1'
# MyRocks dictionary entries left for t1 after the table is gone
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
  ORDER BY PARTITION_NAME;
PARTITION_NAME
# Re-create the table with the same partition names, including p3
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=ROCKSDB
PARTITION BY RANGE (id) (
PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN (200),
PARTITION p2 VALUES LESS THAN (300),
PARTITION p3 VALUES LESS THAN (400));
INSERT INTO t1 VALUES (1, 1), (101, 101), (201, 201), (301, 301);
SELECT COUNT(*) FROM t1;
COUNT(*)
4
DROP TABLE IF EXISTS t1;
# Scenario: ALTER TABLE t1 ALGORITHM=INPLACE, ADD PARTITION (PARTITION p3 VALUES LESS THAN (400)), killed at alter_table_inplace_before_commit
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=ROCKSDB
PARTITION BY RANGE (id) (
PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN (200),
PARTITION p2 VALUES LESS THAN (300));
INSERT INTO t1 VALUES (1, 1), (2, 2), (101, 101), (102, 102), (201, 201),
(202, 202);
SET DEBUG_SYNC = 'alter_table_inplace_before_commit SIGNAL parked WAIT_FOR never_happens';
ALTER TABLE t1 ALGORITHM=INPLACE, ADD PARTITION (PARTITION p3 VALUES LESS THAN (400));
SET DEBUG_SYNC = 'now WAIT_FOR parked';
# Kill and restart
# State after recovery (errors are printed, not fatal)
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
