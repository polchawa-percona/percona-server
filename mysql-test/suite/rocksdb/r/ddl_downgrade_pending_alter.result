CREATE TABLE orphan_probe (a INT PRIMARY KEY) ENGINE=ROCKSDB;
DROP TABLE orphan_probe;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a), KEY kb(b)) ENGINE=ROCKSDB;
CREATE TABLE t2 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a), KEY kb(b)) ENGINE=ROCKSDB;
CREATE TABLE t3 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
INSERT INTO t2 VALUES (1,10,30),(2,20,20),(3,30,10);
INSERT INTO t3 VALUES (1,10,30),(2,20,20),(3,30,10);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
# t1: DROP INDEX committed in the data dictionary, crash before the
# table is reopened.
# Crash at crash_after_index_create during: ALTER TABLE t1 DROP INDEX ka, ALGORITHM=INPLACE
ALTER TABLE t1 DROP INDEX ka, ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
# t2: DROP INDEX rolled back by the data dictionary.
# Crash at crash_commit_after_prepare during: ALTER TABLE t2 DROP INDEX ka, ALGORITHM=INPLACE
ALTER TABLE t2 DROP INDEX ka, ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
# t3: ADD INDEX rolled back by the data dictionary.
# Crash at crash_commit_after_prepare during: ALTER TABLE t3 ADD INDEX kb(b), ALGORITHM=INPLACE
ALTER TABLE t3 ADD INDEX kb(b), ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
# None of the tables is opened. Clean shutdown, then start a simulated
# older server version that ignores pending ALTER TABLE records.
# restart: --debug=+d,rocksdb_simulate_no_pending_alter_support
