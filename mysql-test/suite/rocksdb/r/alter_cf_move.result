SET @@global.rocksdb_delete_cf = 'ddl5_cf_pk';
ERROR HY000: Cannot drop Column family ('ddl5_cf_pk') because it is in use or does not exist.
# A failed ALTER creates the CF of the new index, then rolls back.
INSERT INTO t1 VALUES (1001, 1, 'v000001');
ALTER TABLE t1 ADD UNIQUE INDEX ub (b) COMMENT 'cfname=ddl5_cf_failed', ALGORITHM=INPLACE;
