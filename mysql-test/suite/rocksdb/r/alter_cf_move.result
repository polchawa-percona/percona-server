# Changing only the index comment of an existing index is not possible in
# SQL; ALTER INDEX ... VISIBLE keeps the CF.
ALTER TABLE t1 ALTER INDEX kb INVISIBLE;
ALTER TABLE t1 ALTER INDEX kb VISIBLE;
SELECT INDEX_NAME, CF FROM INFORMATION_SCHEMA.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	CF
ka	rev:ddl5_cf_a
kb	default
PRIMARY	default
# Move the primary key to a reverse CF. Changing the primary key is not
# supported in place; COPY works.
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY (pk) COMMENT 'cfname=rev:ddl5_cf_pk', ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY (pk) COMMENT 'cfname=rev:ddl5_cf_pk', ALGORITHM=COPY;
