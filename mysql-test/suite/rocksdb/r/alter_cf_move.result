#
# rocksdb_no_create_column_family: ALTER into an existing CF works, ALTER
# into a new CF fails and leaves the table unchanged.
#
# restart: --rocksdb_no_create_column_family=1
SELECT COUNT(*) FROM t1;
COUNT(*)
1000
