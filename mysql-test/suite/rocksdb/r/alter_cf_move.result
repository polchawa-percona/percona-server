call mtr.add_suppression("Cannot mark Column family .* to be dropped, because it is in use");
#
# Moving indexes and the primary key between column families with ALTER
# TABLE. A column family is selected only by the cfname= qualifier of an
# index comment; an index comment without it leaves the index in the
# default column family.
#
CREATE TABLE t1 (
pk INT NOT NULL,
a INT NOT NULL,
b VARCHAR(32) NOT NULL,
PRIMARY KEY (pk),
KEY ka (a) COMMENT 'cfname=ddl5_cf_a',
KEY kb (b) COMMENT 'rev:ddl5_not_a_cf'
) ENGINE=ROCKSDB;
# Initial layout: kb's comment has no cfname=, so it is in the default CF.
SELECT INDEX_NAME, CF FROM INFORMATION_SCHEMA.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	CF
ka	ddl5_cf_a
kb	default
PRIMARY	default
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY)) AS n_pk, (SELECT COUNT(*) FROM t1 FORCE INDEX (ka)) AS n_ka, (SELECT COUNT(*) FROM t1 FORCE INDEX (kb)) AS n_kb, (SELECT SUM(a) FROM t1 FORCE INDEX (PRIMARY)) AS sum_pk, (SELECT SUM(a) FROM t1 FORCE INDEX (ka)) AS sum_ka, (SELECT MIN(b) FROM t1 FORCE INDEX (kb)) AS min_kb, (SELECT MAX(b) FROM t1 FORCE INDEX (kb)) AS max_kb, (SELECT MAX(pk) FROM t1) AS max_pk;
n_pk	n_ka	n_kb	sum_pk	sum_ka	min_kb	max_kb	max_pk
1000	1000	1000	47025	47025	v000001	v001000	1000
# Re-creating an index under the same name with a different cfname= changes
# its comment, which MyRocks does not do in place.
ALTER TABLE t1 DROP INDEX ka, ADD INDEX ka (a) COMMENT 'cfname=rev:ddl5_cf_a', ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
# A new index in the new CF is built in place; then the old one is dropped.
ALTER TABLE t1 ADD INDEX ka2 (a) COMMENT 'cfname=rev:ddl5_cf_a', ALGORITHM=INPLACE;
Warnings:
Warning	1831	Duplicate index 'ka2' defined on the table 'test.t1'. This is deprecated and will be disallowed in a future release.
ALTER TABLE t1 DROP INDEX ka, ALGORITHM=INPLACE;
ALTER TABLE t1 RENAME INDEX ka2 TO ka;
SELECT INDEX_NAME, CF FROM INFORMATION_SCHEMA.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	CF
ka	rev:ddl5_cf_a
kb	default
PRIMARY	default
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY)) AS n_pk, (SELECT COUNT(*) FROM t1 FORCE INDEX (ka)) AS n_ka, (SELECT COUNT(*) FROM t1 FORCE INDEX (kb)) AS n_kb, (SELECT SUM(a) FROM t1 FORCE INDEX (PRIMARY)) AS sum_pk, (SELECT SUM(a) FROM t1 FORCE INDEX (ka)) AS sum_ka, (SELECT MIN(b) FROM t1 FORCE INDEX (kb)) AS min_kb, (SELECT MAX(b) FROM t1 FORCE INDEX (kb)) AS max_kb, (SELECT MAX(pk) FROM t1) AS max_pk;
n_pk	n_ka	n_kb	sum_pk	sum_ka	min_kb	max_kb	max_pk
