SET SESSION transaction_isolation = 'READ-COMMITTED';
# Autocommit INSERT: the secondary key entry crosses the limit
CREATE TABLE t1 (id INT PRIMARY KEY, w VARCHAR(700), KEY (w))
ENGINE=ROCKSDB CHARSET latin1;
SET SESSION rocksdb_write_batch_max_bytes = 1024;
INSERT INTO t1 VALUES (1, REPEAT('a', 300));
INSERT INTO t1 VALUES (2, REPEAT('b', 450));
ERROR HY000: Got error 10 'Operation aborted: Memory limit reached' from ROCKSDB
SET SESSION rocksdb_write_batch_max_bytes = 0;
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
1
SELECT COUNT(*) FROM t1 FORCE INDEX (w);
COUNT(*)
1
# UPDATE of the indexed column: the new entry crosses the limit
CREATE TABLE t2 (id INT PRIMARY KEY, w VARCHAR(700), KEY (w))
ENGINE=ROCKSDB CHARSET latin1;
INSERT INTO t2 VALUES (1, 'a'), (2, 'b');
SET SESSION rocksdb_write_batch_max_bytes = 1024;
UPDATE t2 SET w = REPEAT('z', 480) WHERE id = 1;
ERROR HY000: Got error 10 'Operation aborted: Memory limit reached' from ROCKSDB
SET SESSION rocksdb_write_batch_max_bytes = 0;
SELECT id, w FROM t2 FORCE INDEX (PRIMARY) ORDER BY id;
id	w
1	a
2	b
SELECT COUNT(*) FROM t2 FORCE INDEX (w);
COUNT(*)
2
# REPLACE of an existing row with a unique secondary key: the new
# entry crosses the limit
CREATE TABLE t5 (id INT PRIMARY KEY, w VARCHAR(700), UNIQUE KEY (w))
ENGINE=ROCKSDB CHARSET latin1;
INSERT INTO t5 VALUES (1, 'a'), (2, 'b');
SET SESSION rocksdb_write_batch_max_bytes = 1024;
REPLACE INTO t5 VALUES (1, REPEAT('z', 480));
ERROR HY000: Got error 10 'Operation aborted: Memory limit reached' from ROCKSDB
INSERT INTO t5 VALUES (2, 'b') ON DUPLICATE KEY UPDATE w = REPEAT('y', 480);
ERROR HY000: Got error 10 'Operation aborted: Memory limit reached' from ROCKSDB
SET SESSION rocksdb_write_batch_max_bytes = 0;
SELECT id, w FROM t5 FORCE INDEX (PRIMARY) ORDER BY id;
id	w
1	a
2	b
SELECT id, w FROM t5 FORCE INDEX (w) ORDER BY id;
id	w
1	a
2	b
# Two secondary keys: the second entry crosses the limit after the
# first one was written, so the statement rollback must remove it
CREATE TABLE t6 (id INT PRIMARY KEY, a INT, w VARCHAR(700), KEY (a), KEY (w))
ENGINE=ROCKSDB CHARSET latin1;
INSERT INTO t6 VALUES (1, 1, 'a');
SET SESSION rocksdb_write_batch_max_bytes = 1024;
INSERT INTO t6 VALUES (2, 2, REPEAT('b', 450));
ERROR HY000: Got error 10 'Operation aborted: Memory limit reached' from ROCKSDB
INSERT IGNORE INTO t6 VALUES (3, 3, REPEAT('c', 450));
SET SESSION rocksdb_write_batch_max_bytes = 0;
SELECT COUNT(*) FROM t6 FORCE INDEX (PRIMARY);
COUNT(*)
1
SELECT COUNT(*) FROM t6 FORCE INDEX (a);
COUNT(*)
1
SELECT COUNT(*) FROM t6 FORCE INDEX (w);
COUNT(*)
1
# Multi-statement transaction: no row may lack its secondary key entry
CREATE TABLE t3 (id INT PRIMARY KEY, w VARCHAR(700), KEY (w))
ENGINE=ROCKSDB CHARSET latin1;
SET SESSION rocksdb_write_batch_max_bytes = 16384;
BEGIN;
COMMIT;
limit hit: 1
SET SESSION rocksdb_write_batch_max_bytes = 0;
committed_rows_ok
1
DROP TABLE t1, t2, t3, t5, t6;
