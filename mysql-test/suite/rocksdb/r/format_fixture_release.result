#
# v12: secondary keys without the covered bitmap
#
SELECT id, fake_id, LENGTH(bigfield) FROM v12_cov ORDER BY id;
id	fake_id	LENGTH(bigfield)
1	1001	1
8	1008	8
24	1024	24
31	1031	31
32	1032	32
33	1033	33
128	1128	128
SELECT id, LEFT(bigfield, 40) FROM v12_cov FORCE INDEX (bf) WHERE bigfield LIKE 'c%';
id	LEFT(bigfield, 40)
24	cccccccccccccccccccccccc
# v12 index stores no covered bitmap, so the row is read
SELECT id, bigfield FROM v12_cov FORCE INDEX(fid) WHERE fake_id = 1031;
id	bigfield
31	ddddddddddddddddddddddddddddddd
include/assert.inc [v12 index stores no covered bitmap, so the row is read: 0 rocksdb_covered_secondary_key_lookups]
# Value longer than the prefix, the row is read
SELECT id, bigfield FROM v12_cov FORCE INDEX(fid) WHERE fake_id = 1033;
id	bigfield
33	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
include/assert.inc [Value longer than the prefix, the row is read: 0 rocksdb_covered_secondary_key_lookups]
