INSERT INTO v11_vb VALUES (0x000000000000000000000000, 12), (0x42, 102);
UPDATE v11_vb SET vb = 0x4343434343434343 WHERE n = 108;
DELETE FROM v11_vb WHERE n = 9;
UPDATE v11_vb_sk SET vb = 0x00000000000000000000 WHERE id = 1001;
INSERT INTO v11_mixed VALUES (8, 1.250, 'abc ', 0x00, 'Text 8');
UPDATE v11_mixed SET d = -0.500, vc = 'Zed' WHERE id = 2;
DELETE FROM v11_mixed WHERE id = 6;
INSERT INTO v12_cov VALUES (40, 1040, REPEAT('e', 40));
