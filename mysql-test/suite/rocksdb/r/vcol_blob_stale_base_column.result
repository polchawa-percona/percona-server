# The invalid read in this test is only detected under ASAN.
CREATE TABLE t1 (
id INT PRIMARY KEY,
b BLOB,
u INT,
vb BLOB GENERATED ALWAYS AS (IFNULL(b, '')) VIRTUAL,
KEY kb (b(13), u)
) ENGINE=ROCKSDB;
INSERT INTO t1 (id, b, u) VALUES
(1, '0', 21), (2, 'b', 25), (3, REPEAT('0', 20), 32), (4, 'Z', 11);
SELECT MAX(u) FROM t1 FORCE INDEX (kb) WHERE id > 0;
MAX(u)
32
SELECT id, u FROM t1 FORCE INDEX (kb) WHERE id > 0 ORDER BY id;
id	u
1	21
2	25
3	32
4	11
SELECT id, LENGTH(vb) FROM t1 FORCE INDEX (kb) WHERE id > 0 ORDER BY id;
id	LENGTH(vb)
1	1
2	1
3	20
4	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# Same with a composite primary key and a generated column that reads
# two base columns (the shape found by the targeted stress).
#
CREATE TABLE t2 (
id INT,
a VARCHAR(64) NOT NULL,
b BLOB,
u INT,
vb BLOB GENERATED ALWAYS AS (CONCAT(a, IFNULL(b, ''))) VIRTUAL,
PRIMARY KEY (a, id),
KEY kb (b(13), u)
) ENGINE=ROCKSDB;
INSERT INTO t2 (id, a, b, u) VALUES
(36, '823', '0', 21), (50, REPEAT('0', 63), 'b', 25),
(50, 'bbbbbbbb', REPEAT('0', 20), 32), (17, '        ', 'Z', 11);
SELECT MAX(u), MIN(a) FROM t2 WHERE id = 45;
MAX(u)	MIN(a)
NULL	NULL
SELECT MAX(u), COUNT(*) FROM t2 FORCE INDEX (kb) WHERE id > 0;
MAX(u)	COUNT(*)
32	4
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
DROP TABLE t2;
