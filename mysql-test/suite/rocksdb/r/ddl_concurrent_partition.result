test.t4	check	status	OK
test.t5	check	status	OK
test.h1	check	status	OK
# Wait for the drop-index thread, then compact every column family.
# Index data in SST files that belongs to no index (expect 0).
orphan index entries in SST files: 0
# MyRocks indexes per table (one per partition per index).
TABLE_NAME	COUNT(*)
h1	8
t1	6
t2	6
t3	6
