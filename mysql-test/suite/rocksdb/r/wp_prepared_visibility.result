# Locking reads and conflicting writes wait for the prepared row locks.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
SELECT pk FROM t1 WHERE pk = 11 FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SELECT pk FROM t1 WHERE pk = 2 FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
INSERT INTO t1 VALUES (99, 110, 'dup_a');
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
INSERT INTO t1 VALUES (11, 999, 'dup_pk');
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
# Let the writer commit.
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
# READ COMMITTED after commit: new state
SELECT COUNT(*), SUM(pk), SUM(a) FROM t1;
COUNT(*)	SUM(pk)	SUM(a)
11	72	1720
SELECT pk, a, b FROM t1 ORDER BY pk;
