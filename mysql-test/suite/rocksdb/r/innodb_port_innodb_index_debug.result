insert into t480 select 0 from t480;
create table t1(f1 int auto_increment not null,
f2 char(200) not null, f3 char(200) not null,
primary key(f1,f2,f3), key(f1))engine=rocksdb charset latin1;
insert into t1 select NULL,'aaa','bbb' from t480;
insert into t1 select NULL,'aaaa','bbbb' from t480;
insert into t1 select NULL,'aaaaa','bbbbb' from t480;
insert into t1 select NULL,'aaaaaa','bbbbbb' from t480;
# An index build sorting through many merge chunks on disk.
alter table t1 add index k2(f2, f1), algorithm=inplace;
# t1.k2 matches the table: 1
alter table t1 drop index k2;
# Error in the merge sort of an index build.
SET DEBUG = '+d,myrocks_merge_buf_offset_overflow';
alter table t1 add index k2(f2, f1), algorithm=inplace;
ERROR HY000: MyRocks failed populating secondary key during alter.
SET DEBUG = '-d,myrocks_merge_buf_offset_overflow';
SET SESSION rocksdb_merge_buf_size = @saved_merge_buf_size;
# Error while copying the rows of a primary key rebuild.
SET DEBUG = '+d,abort_copy_table';
alter table t1 drop primary key,add primary key(f2,f1);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SET DEBUG = '-d,abort_copy_table';
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `f1` int NOT NULL AUTO_INCREMENT,
  `f2` char(200) NOT NULL,
  `f3` char(200) NOT NULL,
  PRIMARY KEY (`f1`,`f2`,`f3`),
  KEY `f1` (`f1`)
) ENGINE=ROCKSDB AUTO_INCREMENT=1921 DEFAULT CHARSET=latin1
select count(*), count(distinct f1) from t1;
count(*)	count(distinct f1)
1920	1920
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# t1.f1 matches the table: 1
select count(*) from information_schema.rocksdb_ddl
where table_schema = 'test' and table_name = 't1';
count(*)
2
drop table t1;
create table t1(k1 int auto_increment primary key,
k2 char(200),k3 char(200))engine=rocksdb;
