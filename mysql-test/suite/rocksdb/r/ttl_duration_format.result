CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT 'ttl_duration=-5;';
ERROR HY000: TTL duration (-5) in MyRocks must be an unsigned non-null 64-bit integer.
ALTER TABLE t3 COMMENT = 'ttl_duration=-5;';
ERROR HY000: TTL duration (-5) in MyRocks must be an unsigned non-null 64-bit integer.
SELECT TTL_DURATION FROM information_schema.ROCKSDB_DDL
