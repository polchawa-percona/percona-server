3600
# ttl_duration=18446744073709551616
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT 'ttl_duration=18446744073709551616;';
ERROR HY000: TTL duration (18446744073709551616) in MyRocks must be an unsigned non-null 64-bit integer.
ALTER TABLE t3 COMMENT = 'ttl_duration=18446744073709551616;';
ERROR HY000: TTL duration (18446744073709551616) in MyRocks must be an unsigned non-null 64-bit integer.
SELECT TTL_DURATION FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't3';
