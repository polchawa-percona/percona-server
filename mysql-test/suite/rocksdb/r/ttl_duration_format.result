CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT 'ttl_duration=99999999999999999999;';
ERROR HY000: TTL duration (99999999999999999999) in MyRocks must be an unsigned non-null 64-bit integer.
ALTER TABLE t3 COMMENT = 'ttl_duration=99999999999999999999;';
ERROR HY000: TTL duration (99999999999999999999) in MyRocks must be an unsigned non-null 64-bit integer.
