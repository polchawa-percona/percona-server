CREATE TABLE t_tiny_u   (a TINYINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
CREATE TABLE t_tiny     (a TINYINT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
CREATE TABLE t_medium_u (a MEDIUMINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
CREATE TABLE t_medium   (a MEDIUMINT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
# 8.4 no longer allows AUTO_INCREMENT on FLOAT or DOUBLE.
CREATE TABLE t_float  (a FLOAT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
