# A completed DROP TABLE leaves a recovery record that must not affect a
# table created later with the same name, also after a restart.
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
DROP TABLE t1;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1);
CREATE TABLE t2 (id INT PRIMARY KEY) ENGINE=ROCKSDB;
DROP TABLE t2;
# A failed partitioned CREATE TABLE keeps its recovery record (the
# server removes the table from its DD after the engine failed); the
# record must not affect the next startup.
SET SESSION debug = "+d,rocksdb_truncate_failure";
CREATE TABLE t2 (id INT PRIMARY KEY) ENGINE=ROCKSDB
PARTITION BY HASH (id) PARTITIONS 2;
ERROR HY000: Internal error: Simulated truncation failure.
SET SESSION debug = "-d,rocksdb_truncate_failure";
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
SELECT (SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2')) = (SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2')) AS dictionaries_agree;
dictionaries_agree
1
SELECT * FROM t1;
id	a
1	1
DROP TABLE t1;
