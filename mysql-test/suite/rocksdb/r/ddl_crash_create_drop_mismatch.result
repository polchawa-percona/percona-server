# A crash during the startup recovery itself, after the table is removed
# from the server's data dictionary and before MyRocks drops what it has
# of the table: the next startup finishes the recovery.
CREATE TABLE t0 (id INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t0 VALUES (1),(2),(3);
# Partitioned CREATE TABLE: crash after the first partition is created,
# then crash in the recovery.
SET SESSION debug = "+d,rocksdb_crash_after_create_table";
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN MAXVALUE);
ERROR HY000: Lost connection to MySQL server during query
# restart
include/assert_grep.inc [The recovery crashed after removing the table from the DD]
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
SELECT (SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t0','t1')) = (SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t0','t1')) AS dictionaries_agree;
dictionaries_agree
1
SELECT COUNT(*) AS t1_in_dd FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
t1_in_dd
0
SELECT COUNT(*) AS t1_in_myrocks FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
t1_in_myrocks
0
SELECT * FROM t0;
id
1
2
3
