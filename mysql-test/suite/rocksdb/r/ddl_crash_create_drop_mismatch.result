# DROP TABLE with rocksdb_enable_delete_range_for_drop_index=ON: crash
# after the rows are deleted, before the MyRocks dictionary commit.
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = ON;
# Crash at rocksdb_crash_after_delete_range during: DROP TABLE t1
DROP TABLE t1;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
