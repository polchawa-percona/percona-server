CREATE TABLE t1 (pk INT, a VARCHAR(100),
PRIMARY KEY (pk) COMMENT 'cfname=cf_blob') ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, REPEAT('a', 50));
INSERT INTO t1 VALUES (2, REPEAT('b', 50)), (3, REPEAT('c', 50));
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SELECT pk, LENGTH(a) FROM t1 ORDER BY pk;
pk	LENGTH(a)
1	50
2	50
