# Part 1 crashes every build; part 2 (after a secondary key read) is detected only under ASAN.
#
# Part 1: PK on a fully covered TINYBLOB, fresh handler
#
CREATE TABLE t1 (b TINYBLOB NOT NULL, c INT, PRIMARY KEY (b(255))) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (REPEAT('a', 200), 1), (REPEAT('b', 255), 2), ('c', 3);
SELECT LENGTH(b), LEFT(b, 3), c FROM t1;
LENGTH(b)	LEFT(b, 3)	c
200	aaa	1
255	bbb	2
1	c	3
SELECT LENGTH(b), c FROM t1 WHERE b > 'b';
LENGTH(b)	c
255	2
1	3
UPDATE t1 SET c = c + 10 WHERE b = 'c';
DELETE FROM t1 WHERE b = REPEAT('a', 200);
SELECT LENGTH(b), c FROM t1 ORDER BY b DESC;
LENGTH(b)	c
1	13
255	2
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# Part 1b: PK on a fully covered TINYTEXT (single-byte charset)
#
CREATE TABLE t2 (t TINYTEXT CHARACTER SET latin1 NOT NULL, c INT,
PRIMARY KEY (t(255))) ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (REPEAT('x', 255), 1), ('y', 2), ('Z', 3);
SELECT LENGTH(t), LEFT(t, 3), c FROM t2;
LENGTH(t)	LEFT(t, 3)	c
255	xxx	1
1	y	2
1	Z	3
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
DROP TABLE t2;
#
# Part 2: secondary key read with a blob part, then a PK read in the
# next statement of the same handler
#
CREATE TABLE t3 (b TINYBLOB NOT NULL, d TINYBLOB, e INT,
PRIMARY KEY (b(255)), KEY kd (d(255))) ENGINE=ROCKSDB;
INSERT INTO t3 VALUES (REPEAT('a', 255), REPEAT('d', 255), 1),
(REPEAT('z', 255), 'e', 2), ('m', NULL, 3);
SELECT LENGTH(d) FROM t3 FORCE INDEX (kd) WHERE d > '';
LENGTH(d)
255
1
SELECT LENGTH(b), LENGTH(d), e FROM t3;
LENGTH(b)	LENGTH(d)	e
255	255	1
1	NULL	3
255	1	2
SELECT LENGTH(d) FROM t3 FORCE INDEX (kd) WHERE d > '';
LENGTH(d)
255
1
UPDATE t3 SET e = e + 1;
SELECT LENGTH(b), LEFT(b, 2), LENGTH(d), e FROM t3;
LENGTH(b)	LEFT(b, 2)	LENGTH(d)	e
255	aa	255	2
1	m	NULL	4
255	zz	1	3
CHECK TABLE t3;
Table	Op	Msg_type	Msg_text
test.t3	check	status	OK
DROP TABLE t3;
