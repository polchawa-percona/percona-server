SET @orig_read_filtering = @@global.rocksdb_enable_ttl_read_filtering;
SET GLOBAL rocksdb_enable_ttl_read_filtering = 1;
#
# 1. Explicit ttl_col, one variant per column type
#
CREATE TABLE t1 (
a INT NOT NULL,
ts BIGINT UNSIGNED NOT NULL,
v VARCHAR(32) NOT NULL,
PRIMARY KEY (a)
) ENGINE=ROCKSDB COMMENT='ttl_duration=3600;ttl_col=ts;';
INSERT INTO t1 VALUES (1, UNIX_TIMESTAMP() - 7200, 'old'), (2, UNIX_TIMESTAMP() - 7200, 'old'), (3, UNIX_TIMESTAMP() - 7200, 'old'),
(4, UNIX_TIMESTAMP() - 7200, 'old'), (5, UNIX_TIMESTAMP() - 7200, 'old');
INSERT INTO t1 VALUES (6, UNIX_TIMESTAMP(), 'new'), (7, UNIX_TIMESTAMP(), 'new'), (8, UNIX_TIMESTAMP(), 'new'),
(9, UNIX_TIMESTAMP(), 'new'), (10, UNIX_TIMESTAMP(), 'new');
# Expired rows are hidden from scans, point lookups and DML
SELECT a, v FROM t1 ORDER BY a;
a	v
6	new
7	new
8	new
9	new
10	new
SELECT COUNT(*) FROM t1;
COUNT(*)
5
SELECT a FROM t1 WHERE a = 1;
a
SELECT a FROM t1 WHERE a BETWEEN 1 AND 7 ORDER BY a;
a
6
7
UPDATE t1 SET v = 'touched' WHERE a = 2;
SELECT ROW_COUNT();
ROW_COUNT()
0
DELETE FROM t1 WHERE a = 4;
SELECT ROW_COUNT();
ROW_COUNT()
0
# A new row may reuse the primary key of an expired, not yet compacted row
INSERT INTO t1 VALUES (3, UNIX_TIMESTAMP(), 'reused');
SELECT a, v FROM t1 WHERE a = 3;
a	v
3	reused
# Without read filtering the expired rows are still stored
SET GLOBAL rocksdb_enable_ttl_read_filtering = 0;
SELECT a, v FROM t1 ORDER BY a;
a	v
1	old
2	old
3	reused
4	old
5	old
6	new
7	new
8	new
9	new
10	new
SET GLOBAL rocksdb_enable_ttl_read_filtering = 1;
# Compaction removes exactly the expired rows and keeps the reused key
SELECT variable_value INTO @expired FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_rows_expired';
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
SELECT variable_value - @expired AS rows_expired FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_rows_expired';
rows_expired
4
SET GLOBAL rocksdb_enable_ttl_read_filtering = 0;
SELECT a, v FROM t1 ORDER BY a;
a	v
3	reused
6	new
7	new
8	new
9	new
10	new
SET GLOBAL rocksdb_enable_ttl_read_filtering = 1;
SELECT a, v FROM t1 ORDER BY a;
a	v
3	reused
6	new
7	new
8	new
9	new
10	new
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
