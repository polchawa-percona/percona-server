#
# 6. ALTER TABLE tr OPTIMIZE PARTITION p1 is held while it runs. DML on
#    another table proceeds. Reads and writes of tr, in the optimized and
#    in another partition, wait for the OPTIMIZE: it holds a metadata
#    lock on the whole table that blocks both.
#
UPDATE tr SET c = CONCAT(c, '~') WHERE id BETWEEN 100 AND 149;
UPDATE tr_ref SET c = CONCAT(c, '~') WHERE id BETWEEN 100 AND 149;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
