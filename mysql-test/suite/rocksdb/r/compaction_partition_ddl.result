#
# 3. rocksdb_compact_cf = 'default' is held while REORGANIZE PARTITION
#    copies tr p1 and p2. The compaction finishes after the copy and
#    before the ALTER drops the old partitions.
#
UPDATE tr SET c = CONCAT(c, '#') WHERE id BETWEEN 200 AND 299;
UPDATE tr_ref SET c = CONCAT(c, '#') WHERE id BETWEEN 200 AND 299;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
# con_mc: SET GLOBAL rocksdb_compact_cf = 'default' (held while it runs)
SET GLOBAL rocksdb_compact_cf = 'default';
SET DEBUG_SYNC = 'alter_after_copy_table SIGNAL copied WAIT_FOR go';
ALTER TABLE tr REORGANIZE PARTITION p1, p2 INTO (PARTITION p1 VALUES LESS THAN (150), PARTITION p2 VALUES LESS THAN (300));
SET DEBUG_SYNC = 'now WAIT_FOR copied';
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
# con_mc: reap
SET DEBUG_SYNC = 'now SIGNAL go';
Warnings:
Warning	138	Inplace partition altering is not supported
SET DEBUG_SYNC = 'RESET';
ALTER TABLE tr_ref REORGANIZE PARTITION p1, p2 INTO (PARTITION p1 VALUES LESS THAN (150), PARTITION p2 VALUES LESS THAN (300));
