#
# 7. The drop-index thread is held after tr drops p2 and tl drops p2.
#    Every manual compaction trigger runs in the window between the
#    drops' dictionary commit and their reclaim, with DML on the
#    remaining partitions.
#
SET GLOBAL debug = '+d,rocksdb_pause_drop_index_thread';
ALTER TABLE tr DROP PARTITION p2;
