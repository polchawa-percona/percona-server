include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
SELECT @@global.rocksdb_read_free_rpl, @@global.replica_parallel_workers;
@@global.rocksdb_read_free_rpl	@@global.replica_parallel_workers
PK_SK	1
SET @saved_rec_ts = @@global.rocksdb_debug_ttl_rec_ts;
SET @saved_filter_ts = @@global.rocksdb_debug_ttl_read_filter_ts;
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = 0;
#
# Reused handler: the updated row keeps its own TTL
#
[connection master]
CREATE TABLE t2 (a INT PRIMARY KEY, b INT, c INT, KEY(b)) ENGINE=ROCKSDB
COMMENT 'ttl_duration=3600;';
include/rpl/sync_to_replica.inc
[connection slave]
# Rows 1 and 3 are written on the replica 2000 seconds in the past,
# so they expire 1600 seconds from now; row 3 is not updated.
SET GLOBAL rocksdb_debug_ttl_rec_ts = -2000;
[connection master]
INSERT INTO t2 VALUES (1, 1, 1), (3, 3, 3);
include/rpl/sync_to_replica.inc
[connection slave]
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
# One transaction on one replica worker, which reuses the table's
# handler: the INSERT of row 2 (written now) comes first.
[connection master]
BEGIN;
INSERT INTO t2 VALUES (2, 2, 2);
UPDATE t2 SET c = 10 WHERE a = 1;
COMMIT;
include/rpl/sync_to_replica.inc
[connection slave]
SELECT * FROM t2 FORCE INDEX(PRIMARY) ORDER BY a;
a	b	c
1	1	10
2	2	2
3	3	3
# 2500 seconds later rows 1 and 3 have expired, row 2 has not
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = -2500;
SELECT * FROM t2 FORCE INDEX(PRIMARY) ORDER BY a;
a	b	c
2	2	2
SELECT a, b FROM t2 FORCE INDEX(b) ORDER BY a;
a	b
2	2
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = @saved_filter_ts;
SET GLOBAL rocksdb_debug_ttl_rec_ts = @saved_rec_ts;
[connection master]
DROP TABLE t2;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
