CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB ROW_FORMAT=COMPRESSED;
SHOW WARNINGS;
Level	Code	Message
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=COMPRESSED
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB KEY_BLOCK_SIZE=8;
SHOW WARNINGS;
Level	Code	Message
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci KEY_BLOCK_SIZE=8
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB
STATS_PERSISTENT=1 STATS_AUTO_RECALC=1 STATS_SAMPLE_PAGES=10;
SHOW WARNINGS;
Level	Code	Message
DROP TABLE t1;
# sql_generate_invisible_primary_key does not apply to MyRocks
SET SESSION sql_generate_invisible_primary_key = ON;
CREATE TABLE t1 (a INT) ENGINE=ROCKSDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int DEFAULT NULL
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*) FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA='test' AND TABLE_NAME='t1' AND COLUMN_NAME='my_row_id';
COUNT(*)
0
SET SESSION sql_generate_invisible_primary_key = OFF;
INSERT INTO t1 VALUES (1), (1);
SELECT * FROM t1;
a
1
1
DROP TABLE t1;
# CHECK constraints ARE supported (positive control)
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, CONSTRAINT ck CHECK (b > 0)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1);
INSERT INTO t1 VALUES (2, -1);
ERROR HY000: Check constraint 'ck' is violated.
ALTER TABLE t1 ADD CONSTRAINT ck2 CHECK (b < 100);
INSERT INTO t1 VALUES (3, 200);
ERROR HY000: Check constraint 'ck2' is violated.
ALTER TABLE t1 DROP CHECK ck;
INSERT INTO t1 VALUES (4, -5);
SELECT * FROM t1 ORDER BY a;
a	b
1	1
4	-5
DROP TABLE t1;
