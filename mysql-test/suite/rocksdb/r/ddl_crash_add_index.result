# The cleanup after a committed ALTER TABLE fails (debug point): the
# table stays usable with the new index list, and the next ALTER TABLE
# first finishes the cleanup, or fails without changing anything.
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET SESSION debug = "+d,rocksdb_fail_pending_alter_cleanup";
ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE;
SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
id	b
3	10
2	20
1	30
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=INSTANT;
ERROR HY000: Internal error: Failed to finish an interrupted ALTER TABLE
SET SESSION debug = "-d,rocksdb_fail_pending_alter_cleanup";
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=INSTANT;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  `c` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ka` (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES (4,40,40,4);
