# INFORMATION_SCHEMA.TABLES statistics read the MyRocks definition
# without opening the table. With an interrupted ALTER TABLE, the first
# open may replace that definition: a statistics query that reads it
# (debug sync point) makes the first open wait, before or after the data
# dictionary commit.
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
# Crash at crash_commit_after_prepare during: ALTER TABLE t1 ADD UNIQUE INDEX kb(b), ALGORITHM=INPLACE
ALTER TABLE t1 ADD UNIQUE INDEX kb(b), ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_indexes_before_open FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
rocksdb_indexes_before_open
3
SET DEBUG_SYNC = 'rocksdb_table_statistics_pending_alter SIGNAL in_stats WAIT_FOR stats_done';
SELECT TABLE_ROWS IS NOT NULL, DATA_LENGTH IS NOT NULL FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
SET DEBUG_SYNC = 'now WAIT_FOR in_stats';
SET DEBUG_SYNC = 'rocksdb_resolve_pending_alter_lock_busy SIGNAL open_waits';
SHOW CREATE TABLE t1;
# The first open waits for the statistics query
SET DEBUG_SYNC = 'now WAIT_FOR open_waits TIMEOUT 60';
SELECT COUNT(*) AS open_waits FROM performance_schema.processlist
WHERE INFO = 'SHOW CREATE TABLE t1';
open_waits
1
SET DEBUG_SYNC = 'now SIGNAL stats_done';
TABLE_ROWS IS NOT NULL	DATA_LENGTH IS NOT NULL
1	1
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ka` (`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET DEBUG_SYNC = 'RESET';
SELECT COUNT(*) AS rocksdb_indexes FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
rocksdb_indexes
2
SELECT * FROM t1 ORDER BY id;
id	a	b
