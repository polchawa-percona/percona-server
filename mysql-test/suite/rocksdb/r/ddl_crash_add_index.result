# A server version without pending ALTER TABLE records left the index
# list of MyRocks ahead of the data dictionary: the table cannot be
# opened (instead of crashing the server) until the server is started
# with rocksdb_validate_tables=2, which rebuilds the index list.
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
# Crash at rocksdb_skip_pending_alter,crash_commit_after_prepare during: ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE
ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
SET SESSION rocksdb_perf_context_level = 2;
SELECT * FROM t1;
ERROR HY000: Internal error: Table definition differs between MyRocks and the data dictionary
# The failed open released the table handler (expect 0)
SELECT COUNT(*) AS open_handlers FROM information_schema.ROCKSDB_PERF_CONTEXT
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
open_handlers
0
# restart: --rocksdb_validate_tables=2
# The rebuild fails (debug point): the open fails and releases the
# table handler (expect 0)
SET SESSION rocksdb_perf_context_level = 2;
SET SESSION debug = "+d,rocksdb_open_fail_rebuild";
SELECT * FROM t1;
ERROR HY000: MyRocks failed creating new key definitions during alter.
SET SESSION debug = "-d,rocksdb_open_fail_rebuild";
SELECT COUNT(*) AS open_handlers FROM information_schema.ROCKSDB_PERF_CONTEXT
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
open_handlers
0
SELECT * FROM t1 ORDER BY id;
id	a	b
1	10	30
2	20	20
3	30	10
INSERT INTO t1 VALUES (4,40,40);
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
# restart
