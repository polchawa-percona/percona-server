ENGINE=ROCKSDB;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` varchar(20) DEFAULT NULL,
  PRIMARY KEY (`a`),
  KEY `kc` (`c`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*), SUM(a), SUM(b), SUM(LENGTH(c)) FROM t;
COUNT(*)	SUM(a)	SUM(b)	SUM(LENGTH(c))
2000	1999000	1249000	7400
