# 8. COPY: KILL QUERY in the copy phase
#    (after the first commit_in_the_middle batch was committed)
SET DEBUG_SYNC = 'rocksdb.flush_batch SIGNAL in_copy WAIT_FOR go';
ALTER TABLE t ADD COLUMN d INT, ALGORITHM=COPY;
SET DEBUG_SYNC = 'now WAIT_FOR in_copy';
SET DEBUG_SYNC = 'now SIGNAL go';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` varchar(20) DEFAULT NULL,
  PRIMARY KEY (`a`),
  KEY `kc` (`c`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*), SUM(a), SUM(b), SUM(LENGTH(c)) FROM t;
COUNT(*)	SUM(a)	SUM(b)	SUM(LENGTH(c))
2000	1999000	1249000	7400
SELECT COUNT(*), SUM(LENGTH(c)) FROM t FORCE INDEX (kc) WHERE c >= '';
COUNT(*)	SUM(LENGTH(c))
2000	7400
