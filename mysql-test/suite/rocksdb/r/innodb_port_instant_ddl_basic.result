# By default MyRocks does not add columns instantly.
CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN c3 INT, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
DROP TABLE t1;
SET @saved_append_column = @@global.rocksdb_enable_instant_ddl_for_append_column;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
# Test without any index
# ------------------------------------------------------------
# Create a table with 3 columns. [c1, c2, c3]
# ------------------------------------------------------------
CREATE TABLE t1 (c1 char(20), c2 char(20), c3 char(20)  ) ENGINE=ROCKSDB;
INSERT INTO t1 values ("r1c1", "r1c2", "r1c3");
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
r1c1	r1c2	r1c3

