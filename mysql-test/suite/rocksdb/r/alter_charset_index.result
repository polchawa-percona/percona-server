DROP TABLE t1;
# Unicode data set, outside latin1: supplementary characters,
# ligatures, title-case digraphs and combining marks.
CREATE TABLE t1 (
c VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
id INT NOT NULL,
PRIMARY KEY (c, id),
UNIQUE KEY kid (id),
KEY kc (c),
KEY kp (c(3))
) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES ('ﬁ', 1), ('fi', 2), ('Ǆ', 3), ('DŽ', 4), ('😀', 5),
('😀😀', 6), ('é', 7), ('é', 8), ('日本語', 9), ('日本', 10),
('Ωmega', 11), ('ωmega', 12), ('İstanbul', 13), ('istanbul', 14);
UPDATE t1 SET c = CONCAT('e', _utf8mb4 0xCC81) WHERE id = 7;
