######## Engine: InnoDB

# Table with a latin1-representable data set, converted through the
# character sets. The primary key is the string column itself.
CREATE TABLE t1 (
c VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
id INT NOT NULL,
PRIMARY KEY (c, id),
UNIQUE KEY kid (id),
KEY kc (c),
KEY kp (c(3))
) ENGINE=InnoDB;
INSERT INTO t1 VALUES ('a', 1), ('A', 2), ('á', 3), ('ab', 4), ('ss', 5),
('ß', 6), ('ae', 7), ('æ', 8), ('abc  ', 9), ('abc', 10), ('', 11),
('Zürich', 12), ('zurich', 13), ('ÿ', 14), ('y', 15), ('ñ', 16),
('n', 17), ('aaaaaaaaaaaaaaaaaaaa', 18), ('AAAAAAAAAAAAAAAAAAAA', 19),
('o\'clock', 20);
