#
# Changing the character set or collation of indexed columns with ALTER
# TABLE rebuilds the MyRocks keys in the new collation's mem-comparable
# format. After each ALTER, every row must be found through the full
# secondary index, the prefix index and the primary key, and the index
# scans must return the same rows as the table scan. The same steps run on
# InnoDB for comparison; the results must be identical.
#
# Multi-level collations whose sort keys are longer than the column
# (latin2_czech_cs, utf8mb4_0900_as_cs with prefix keys) are not here:
# they fail with error 505 today (port-findings #4) and are covered by
# rocksdb.alter_charset_index_multilevel (disabled). LDML collations are
# covered by rocksdb.innodb_port_innodb_ctype_ldml.
#

######## Engine: ROCKSDB

# Table with a latin1-representable data set, converted through the
# character sets. The primary key is the string column itself.
CREATE TABLE t1 (
c VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
id INT NOT NULL,
PRIMARY KEY (c, id),
UNIQUE KEY kid (id),
KEY kc (c),
KEY kp (c(3))
) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES ('a', 1), ('A', 2), ('á', 3), ('ab', 4), ('ss', 5),
('ß', 6), ('ae', 7), ('æ', 8), ('abc  ', 9), ('abc', 10), ('', 11),
('Zürich', 12), ('zurich', 13), ('ÿ', 14), ('y', 15), ('ñ', 16),
('n', 17), ('aaaaaaaaaaaaaaaaaaaa', 18), ('AAAAAAAAAAAAAAAAAAAA', 19),
('o\'clock', 20);
# ALTER TABLE t1 CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci
ALTER TABLE t1 CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT COUNT(*) AS n,
SUM(CRC32(HEX(c))) AS crc_kid FROM t1 FORCE INDEX (kid);
n	crc_kid
20	37759407212
SELECT (SELECT SUM(CRC32(HEX(c))) FROM t1 FORCE INDEX (kc)) AS crc_kc,
(SELECT SUM(CRC32(HEX(c))) FROM t1 FORCE INDEX (kp)) AS crc_kp,
(SELECT SUM(CRC32(HEX(c))) FROM t1 FORCE INDEX (PRIMARY)) AS crc_pk;
crc_kc	crc_kp	crc_pk
37759407212	37759407212	37759407212
# Rows not found by an equality lookup on c through kc, kp and PRIMARY:
SELECT
(SELECT COUNT(*) FROM t1 AS x WHERE NOT EXISTS
(SELECT 1 FROM t1 AS y FORCE INDEX (kc) WHERE y.c = x.c AND y.id = x.id)) AS miss_kc,
(SELECT COUNT(*) FROM t1 AS x WHERE NOT EXISTS
(SELECT 1 FROM t1 AS y FORCE INDEX (kp) WHERE y.c = x.c AND y.id = x.id)) AS miss_kp,
(SELECT COUNT(*) FROM t1 AS x WHERE NOT EXISTS
(SELECT 1 FROM t1 AS y FORCE INDEX (PRIMARY) WHERE y.c = x.c AND y.id = x.id)) AS miss_pk;
miss_kc	miss_kp	miss_pk
0	0	0
# Number of rows equal to each value under the new collation, by index:
SELECT x.id, (SELECT COUNT(*) FROM t1 AS y FORCE INDEX (kc) WHERE y.c = x.c) AS eq_kc,
(SELECT COUNT(*) FROM t1 AS y IGNORE INDEX (kc, kp, PRIMARY) WHERE y.c = x.c) AS eq_scan
FROM t1 AS x FORCE INDEX (kid) ORDER BY x.id;
id	eq_kc	eq_scan
1	3	3
2	3	3
3	3	3
4	1	1
5	2	2
6	2	2
7	2	2
8	2	2
9	1	1
10	1	1
11	1	1
12	2	2
13	2	2
14	2	2
15	2	2
16	2	2
17	2	2
18	2	2
19	2	2
20	1	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
