Table	Op	Msg_type	Msg_text
test.lo	check	status	OK
test.mid1	check	status	OK
test.mid2	check	status	OK
test.hi	check	status	OK
DROP TABLE lo, mid1, mid2, hi;
# the bulk loads did not need the compact-and-retry fallback
bulk load retries: 0
