# Scenario C: phantom insert into an updated range.
# con1 updates a secondary-key range inside a multi-statement transaction,
# then con2 inserts a row into that range. InnoDB at REPEATABLE READ
# blocks the insert with a gap lock. MyRocks has no gap locks; at
# REPEATABLE READ it refuses con1's range update instead, and at READ
# COMMITTED (like InnoDB at READ COMMITTED) the insert goes through and
# the new row is not updated.
CREATE TABLE t1 (id INT PRIMARY KEY, k INT, v INT, KEY (k))
ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 10, 0), (2, 20, 0), (3, 30, 0);
BEGIN;
UPDATE t1 SET v = v + 1 WHERE k BETWEEN 10 AND 30;
INSERT INTO t1 VALUES (4, 15, 0);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SELECT * FROM t1 ORDER BY id;
id	k	v
1	10	1
2	20	1
3	30	1
COMMIT;
SELECT * FROM t1 ORDER BY id;
id	k	v
1	10	1
2	20	1
3	30	1
DROP TABLE t1;

