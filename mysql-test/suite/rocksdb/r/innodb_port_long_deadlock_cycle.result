#
# Scenario 4: a wait chain without a cycle (con5 -> con4 -> con3 -> con2
# -> con1), where con5 itself is waited on by con6. Deadlock detection
# runs only for a request whose transaction others wait on. When the
# chain behind the request is longer than rocksdb_deadlock_detect_depth,
# the request fails with ER_LOCK_DEADLOCK although there is no cycle (the
# variable is documented as the number of transactions traversed "before
# assuming deadlock"). With a large enough depth it waits and times out.
#
SELECT variable_value INTO @deadlocks_before FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_row_lock_deadlocks';
BEGIN;
SELECT * FROM t1 WHERE id = 1 FOR UPDATE;
id
1
BEGIN;
SELECT * FROM t1 WHERE id = 2 FOR UPDATE;
id
2
SELECT * FROM t1 WHERE id = 1 FOR UPDATE;
BEGIN;
SELECT * FROM t1 WHERE id = 3 FOR UPDATE;
id
3
SELECT * FROM t1 WHERE id = 2 FOR UPDATE;
BEGIN;
SELECT * FROM t1 WHERE id = 4 FOR UPDATE;
id
4
SELECT * FROM t1 WHERE id = 3 FOR UPDATE;
SET SESSION rocksdb_lock_wait_timeout = 1;
SET SESSION rocksdb_deadlock_detect_depth = 2;
BEGIN;
SELECT * FROM t1 WHERE id = 5 FOR UPDATE;
id
5
SELECT * FROM t1 WHERE id = 5 FOR UPDATE;
SELECT * FROM t1 WHERE id = 4 FOR UPDATE;
Got one of the listed errors
# depth 2: ER_LOCK_DEADLOCK although there is no cycle
ROLLBACK;
id
5
ROLLBACK;
ROLLBACK;
id
1
ROLLBACK;
id
2
ROLLBACK;
id
3
ROLLBACK;
SELECT variable_value - @deadlocks_before AS deadlocks_counted
FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_row_lock_deadlocks';
deadlocks_counted
1
