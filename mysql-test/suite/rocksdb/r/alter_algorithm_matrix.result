# With the default settings, ALGORITHM=INSTANT for ADD COLUMN fails with
# a hint to try INPLACE, but MyRocks rejects INPLACE for it too.
CREATE TABLE ins (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
ALTER TABLE ins ADD COLUMN e INT, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE ins ADD COLUMN e INT, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
ALTER TABLE ins ADD COLUMN e INT, ALGORITHM=COPY;
DROP TABLE ins;
