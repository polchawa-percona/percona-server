SET GLOBAL rocksdb_deadlock_detect = OFF;
SET GLOBAL rocksdb_lock_wait_timeout = 300;
CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);
CREATE TABLE t2 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (0);
CREATE TABLE t3 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t3 VALUES (0);
BEGIN;
DELETE FROM t1 WHERE c1 = 0;
BEGIN;
DELETE FROM t2 WHERE c1 = 0;
BEGIN;
DELETE FROM t3 WHERE c1 = 0;
DELETE FROM t2 WHERE c1 = 0; COMMIT;
DELETE FROM t1 WHERE c1 = 0; COMMIT;
DELETE FROM t3 WHERE c1 = 0; COMMIT;
# Three transactions wait for each other; shut the server down.
# restart
# None of the deletes was committed.
SELECT * FROM t1;
c1
0
SELECT * FROM t2;
c1
0
SELECT * FROM t3;
c1
0
#
# Kill the server with an open transaction, restart, shut down at once.
#
INSERT INTO t1 VALUES (1);
BEGIN;
INSERT INTO t1 VALUES (2);
DELETE FROM t2 WHERE c1 = 0;
# Kill the server
# restart
# restart
SELECT * FROM t1;
c1
0
1
SELECT * FROM t2;
c1
0
DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;
