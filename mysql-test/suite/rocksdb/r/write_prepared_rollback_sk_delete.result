call mtr.add_suppression("CHECKTABLE");
SET SESSION rocksdb_write_batch_flush_threshold = 1;
# Case 0
CREATE TABLE t (pk INT PRIMARY KEY, c BIGINT NOT NULL, KEY kc (c)) ENGINE=ROCKSDB;
INSERT INTO t VALUES (1, 10), (2, 100);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
BEGIN;
UPDATE t SET c = 20 WHERE pk = 1;
UPDATE t SET c = c + 1 WHERE pk = 2;
ROLLBACK;
UPDATE t SET c = 20 WHERE pk = 1;
UPDATE t SET c = 30 WHERE pk = 1;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SELECT pk, c FROM t USE INDEX () ORDER BY pk;
pk	c
1	30
2	100
SELECT pk, c FROM t FORCE INDEX (kc) ORDER BY c, pk;
pk	c
1	30
2	100
SELECT pk, c FROM t WHERE c = 20;
pk	c
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
