CREATE TABLE test.mlog (
id INT AUTO_INCREMENT PRIMARY KEY,
run VARCHAR(20), ptype VARCHAR(20), step VARCHAR(40),
cnt INT, crc BIGINT, pk_ab BIGINT, sk_ab BIGINT, sk_cnt INT, parts TEXT
) ENGINE=InnoDB;
CREATE PROCEDURE test.ddl3_parts(IN t VARCHAR(64), OUT res TEXT)
BEGIN
DECLARE done INT DEFAULT 0;
DECLARE pn VARCHAR(64);
DECLARE cur CURSOR FOR
SELECT COALESCE(SUBPARTITION_NAME, PARTITION_NAME)
FROM information_schema.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = t AND PARTITION_NAME IS NOT NULL
ORDER BY PARTITION_ORDINAL_POSITION, SUBPARTITION_ORDINAL_POSITION;
DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
SET res = '';
OPEN cur;
l: LOOP
FETCH cur INTO pn;
IF done THEN LEAVE l; END IF;
SET @q = CONCAT('SELECT COUNT(*) INTO @n FROM test.', t, ' PARTITION (', pn, ')');
PREPARE s FROM @q;
EXECUTE s;
DEALLOCATE PREPARE s;
SET res = CONCAT(res, pn, ':', @n, ' ');
END LOOP;
CLOSE cur;
IF res = '' THEN SET res = '(not partitioned)'; END IF;
END|
#
# Part 1: operation matrix
#
# Server started without rocksdb_allow_unsafe_alter.
SELECT @@rocksdb_allow_unsafe_alter;
@@rocksdb_allow_unsafe_alter
0

######## engine InnoDB, mode 0

#### RANGE
CREATE TABLE tr (a INT NOT NULL, b INT, c VARCHAR(20), PRIMARY KEY (a), KEY kb (b))
ENGINE=InnoDB PARTITION BY RANGE (a)
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN (30), PARTITION p3 VALUES LESS THAN (40));
INSERT INTO tr WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 39)
SELECT n, n MOD 7, CONCAT('v', n) FROM s;
step	row_count	sk_matches_pk	parts
create	39	1	p0:9 p1:10 p2:10 p3:10 
ALTER TABLE tr ADD PARTITION (PARTITION p4 VALUES LESS THAN (50));
INSERT INTO tr VALUES (41, 41 MOD 7, 'v41'), (45, 45 MOD 7, 'v45'), (48, 48 MOD 7, 'v48');
step	row_count	sk_matches_pk	parts
add	42	1	p0:9 p1:10 p2:10 p3:10 p4:3 
ALTER TABLE tr REORGANIZE PARTITION p0, p1 INTO (PARTITION p01 VALUES LESS THAN (20));
step	row_count	sk_matches_pk	parts
reorganize_merge	42	1	p01:19 p2:10 p3:10 p4:3 
ALTER TABLE tr REORGANIZE PARTITION p4 INTO
(PARTITION p4a VALUES LESS THAN (45), PARTITION p4b VALUES LESS THAN (50));
step	row_count	sk_matches_pk	parts
reorganize_split	42	1	p01:19 p2:10 p3:10 p4a:1 p4b:2 
ALTER TABLE tr TRUNCATE PARTITION p2;
step	row_count	sk_matches_pk	parts
truncate	32	1	p01:19 p2:0 p3:10 p4a:1 p4b:2 
# Drop the last partition: no remaining partition accepts its rows.
ALTER TABLE tr DROP PARTITION p4b;
step	row_count	sk_matches_pk	parts
drop_last	30	1	p01:19 p2:0 p3:10 p4a:1 
ALTER TABLE tr REBUILD PARTITION p01;
step	row_count	sk_matches_pk	parts
rebuild	30	1	p01:19 p2:0 p3:10 p4a:1 
ALTER TABLE tr ANALYZE PARTITION p01;
Table	Op	Msg_type	Msg_text
x	analyze	status	OK
ALTER TABLE tr CHECK PARTITION p01, p2;
Table	Op	Msg_type	Msg_text
x	check	status	OK
ALTER TABLE tr OPTIMIZE PARTITION p01;
Table	Op	Msg_type	Msg_text
x	optimize	note	Table does not support optimize on partitions. All partitions will be rebuilt and analyzed.
x	optimize	status	OK
ALTER TABLE tr REPAIR PARTITION p01;
Table	Op	Msg_type	Msg_text
x	repair	status	OK
step	row_count	sk_matches_pk	parts
maintenance	30	1	p01:19 p2:0 p3:10 p4a:1 
ALTER TABLE tr REORGANIZE PARTITION p4a INTO
(PARTITION p4a VALUES LESS THAN (45), PARTITION pmax VALUES LESS THAN MAXVALUE);
INSERT INTO tr VALUES (1000, 1000 MOD 7, 'v1000');
step	row_count	sk_matches_pk	parts
add_maxvalue	31	1	p01:19 p2:0 p3:10 p4a:1 pmax:1 
# EXCHANGE PARTITION: MyRocks rejects it (ER_PARTITION_MGMT_ON_NONPARTITIONED),
# InnoDB swaps the rows. The exchange is done twice so that both engines
# continue from the same data.
CREATE TABLE tx (a INT NOT NULL, b INT, c VARCHAR(20), PRIMARY KEY (a), KEY kb (b)) ENGINE=InnoDB;
INSERT INTO tx VALUES (21, 0, 'x21'), (22, 1, 'x22');
ALTER TABLE tr EXCHANGE PARTITION p2 WITH TABLE tx;
SELECT * FROM tr PARTITION (p2) ORDER BY a;
a	b	c
21	0	x21
22	1	x22
SELECT * FROM tx ORDER BY a;
a	b	c
ALTER TABLE tr EXCHANGE PARTITION p2 WITH TABLE tx;
DROP TABLE tx;
step	row_count	sk_matches_pk	parts
exchange	31	1	p01:19 p2:0 p3:10 p4a:1 pmax:1 
ALTER TABLE tr REMOVE PARTITIONING;
step	row_count	sk_matches_pk	parts
remove_partitioning	31	1	(not partitioned)
DROP TABLE tr;

