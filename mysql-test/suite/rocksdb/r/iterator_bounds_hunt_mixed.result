create table t_r(
a int,
b varchar(36) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
c int,
primary key(a), key idx_bc(b, c)
) engine=rocksdb;
create table t_i(
a int,
b varchar(36) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
c int,
primary key(a), key idx_bc(b, c)
) engine=innodb;
insert into t_r values(1,'',1),(2,'ab',2),(3,'abcd',3),(4,'abcdefgh',4),
(5,'abcdefghi',5),(6,'abcdefghijkl',6),(7,'abcdefghijklm',7),(8,'zyx',8);
insert into t_i values(1,'',1),(2,'ab',2),(3,'abcd',3),(4,'abcdefgh',4),
(5,'abcdefghi',5),(6,'abcdefghijkl',6),(7,'abcdefghijklm',7),(8,'zyx',8);
set global rocksdb_force_flush_memtable_now = 1;
analyze table t_r;
Table	Op	Msg_type	Msg_text
test.t_r	analyze	status	OK
analyze table t_i;
Table	Op	Msg_type	Msg_text
test.t_i	analyze	status	OK
set session rocksdb_perf_context_level = 2;
explain select a from t_r force index(idx_bc) where b in ('', 'abcd') order by a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_r	NULL	range	idx_bc	idx_bc	39	NULL	#	#	Using where; Using index; Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t_r`.`a` AS `a` from `test`.`t_r` FORCE INDEX (`idx_bc`) where (`test`.`t_r`.`b` in ('','abcd')) order by `test`.`t_r`.`a`
select a from t_r force index(idx_bc) where b in ('', 'abcd') order by a;
