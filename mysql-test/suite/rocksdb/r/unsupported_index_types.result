#
# FULLTEXT
#
CREATE TABLE t1 (id INT PRIMARY KEY, t TEXT, FULLTEXT KEY ft (t)) ENGINE=ROCKSDB;
ERROR HY000: The used table type doesn't support FULLTEXT indexes
CREATE TABLE t1 (id INT PRIMARY KEY, t VARCHAR(100)) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD FULLTEXT INDEX ft (t);
ERROR HY000: The used table type doesn't support FULLTEXT indexes
CREATE FULLTEXT INDEX ft ON t1 (t);
ERROR HY000: The used table type doesn't support FULLTEXT indexes
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `t` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
# An InnoDB table with a FULLTEXT index cannot be converted
CREATE TABLE t1 (id INT PRIMARY KEY, t VARCHAR(100), FULLTEXT KEY ft (t)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'abc');
ALTER TABLE t1 ENGINE=ROCKSDB;
ERROR HY000: The used table type doesn't support FULLTEXT indexes
SELECT ENGINE FROM information_schema.TABLES
WHERE TABLE_SCHEMA='test' AND TABLE_NAME='t1';
ENGINE
InnoDB
SELECT * FROM t1;
id	t
1	abc
DROP TABLE t1;
#
# SPATIAL / GEOMETRY: any geometry column is rejected, indexed or not
#
CREATE TABLE t1 (id INT PRIMARY KEY, g GEOMETRY NOT NULL SRID 0,
SPATIAL KEY sp (g)) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
CREATE TABLE t1 (id INT PRIMARY KEY, g GEOMETRY NOT NULL SRID 0) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
CREATE TABLE t1 (id INT PRIMARY KEY, g POINT NOT NULL, KEY k (g)) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN g POINT;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
# An InnoDB table with a geometry column cannot be converted
CREATE TABLE t1 (id INT PRIMARY KEY, g POINT NOT NULL SRID 0,
SPATIAL KEY sp (g)) ENGINE=InnoDB;
ALTER TABLE t1 ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
DROP TABLE t1;
#
# Descending key parts
#
CREATE TABLE t1 (a INT, b INT, PRIMARY KEY (a), KEY kb (b DESC)) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support descending indexes
CREATE TABLE t1 (a INT, b INT, PRIMARY KEY (a), KEY kab (a ASC, b DESC)) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support descending indexes
CREATE TABLE t1 (a INT, b INT, PRIMARY KEY (a)) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD INDEX kb (b DESC);
ERROR 42000: The storage engine for the table doesn't support descending indexes
CREATE INDEX kb ON t1 (b DESC);
ERROR 42000: The storage engine for the table doesn't support descending indexes
# Explicit ASC is accepted
CREATE INDEX kb ON t1 (b ASC);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  PRIMARY KEY (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
#
# Multi-valued (JSON array) indexes
#
CREATE TABLE t1 (a INT PRIMARY KEY, j JSON,
KEY mv ((CAST(j->'$.tags' AS UNSIGNED ARRAY)))) ENGINE=ROCKSDB;
ERROR 42000: The storage engine for the table doesn't support multi-valued indexes
CREATE TABLE t1 (a INT PRIMARY KEY, j JSON) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD INDEX mv ((CAST(j->'$.tags' AS UNSIGNED ARRAY)));
ERROR 42000: The storage engine for the table doesn't support multi-valued indexes
CREATE INDEX mv ON t1 ((CAST(j->'$.tags' AS CHAR(10) ARRAY)));
ERROR 42000: The storage engine for the table doesn't support multi-valued indexes
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `j` json DEFAULT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
#
# Functional indexes ARE supported (positive control)
#
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(20), KEY fk ((UPPER(b)))) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 'x'), (2, 'y'), (3, 'X');
SELECT a FROM t1 FORCE INDEX (fk) WHERE UPPER(b) = 'X' ORDER BY a;
a
1
3
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
