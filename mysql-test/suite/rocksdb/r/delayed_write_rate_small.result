CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(200)) ENGINE=ROCKSDB;
# rocksdb_delayed_write_rate = DEFAULT after another value
SET GLOBAL rocksdb_delayed_write_rate = 1000000;
SELECT COUNT(*) FROM t1;
COUNT(*)
15000
# rocksdb_delayed_write_rate = 1
SELECT COUNT(*) FROM t1;
COUNT(*)
30000
# rocksdb_delayed_write_rate = 18446744073709551615
SELECT COUNT(*) FROM t1;
COUNT(*)
45000
DROP TABLE t1;
# restart
