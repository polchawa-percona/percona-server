CREATE TABLE t1 (num INT PRIMARY KEY) ENGINE=ROCKSDB;
# Insert dummy data to increase time taken to complete ALTER rebuild
# Table is inserted with 1, 2, 3, .. , 100001
SET SESSION cte_max_recursion_depth=10000000;
INSERT INTO t1 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n <= 100000) SELECT n FROM v;
SET @saved_append_column = @@global.rocksdb_enable_instant_ddl_for_append_column;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
ALTER TABLE t1 ADD col INT NOT NULL DEFAULT 1, ALGORITHM=INSTANT;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = @saved_append_column;
SELECT * FROM t1 LIMIT 15;
num	col
1	1
2	1
3	1
4	1
5	1
6	1
7	1
8	1
9	1
10	1
11	1
12	1
13	1
14	1
15	1
# Prepare the new instant column
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY (num, col);
# Run the DML in online
DELETE FROM t1 WHERE num=1;
SELECT * FROM t1 LIMIT 15;
num	col
2	1
3	1
4	1
5	1
