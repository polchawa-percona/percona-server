16	1
SELECT COUNT(*), SUM(col = 1), MIN(num), MAX(num) FROM t1;
COUNT(*)	SUM(col = 1)	MIN(num)	MAX(num)
100000	100000	2	100001
SELECT * FROM t1 WHERE num = 50000 AND col = 1;
num	col
50000	1
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `num` int NOT NULL,
  `col` int NOT NULL DEFAULT '1',
  PRIMARY KEY (`num`,`col`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECK TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
