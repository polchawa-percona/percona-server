CREATE TABLE o (k INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO o VALUES (1);
CREATE TABLE t (pk INT PRIMARY KEY, d INT NOT NULL, c INT NOT NULL,
KEY kold (d, pk)) ENGINE=ROCKSDB;
INSERT INTO t VALUES (1, 10, 1), (2, 20, 2), (3, 30, 3), (4, 40, 4);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET SESSION transaction_isolation = 'REPEATABLE-READ';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT * FROM o;
k
1
DELETE FROM t WHERE pk = 2;
UPDATE t SET d = 35 WHERE pk = 3;
INSERT INTO t VALUES (5, 50, 5), (6, 60, 6);
ALTER TABLE t ADD INDEX kd (d), ALGORITHM=INPLACE;
# the snapshot through the primary key
SELECT * FROM t FORCE INDEX (PRIMARY) ORDER BY pk;
pk	d	c
1	10	1
2	20	2
3	30	3
4	40	4
# kold, scan, index-only: snapshot data or ER_TABLE_DEF_CHANGED: 1
# kold, d = 35 (a value pk 3 got after the snapshot): snapshot data or ER_TABLE_DEF_CHANGED: 1
# kold, d = 20 (pk 2, deleted after the snapshot): snapshot data or ER_TABLE_DEF_CHANGED: 1
# kold, row count: snapshot data or ER_TABLE_DEF_CHANGED: 1
# kold, scan that reads the rows: snapshot data or ER_TABLE_DEF_CHANGED: 1
# kd, scan, index-only: snapshot data or ER_TABLE_DEF_CHANGED: 1
# kd, d = 35 (a value pk 3 got after the snapshot): snapshot data or ER_TABLE_DEF_CHANGED: 1
# kd, d = 20 (pk 2, deleted after the snapshot): snapshot data or ER_TABLE_DEF_CHANGED: 1
# kd, row count: snapshot data or ER_TABLE_DEF_CHANGED: 1
# kd, scan that reads the rows: snapshot data or ER_TABLE_DEF_CHANGED: 1
COMMIT;
# a new transaction reads the current data through kd
SELECT * FROM t FORCE INDEX (kd) WHERE d > 0 ORDER BY d;
pk	d	c
1	10	1
3	35	3
4	40	4
5	50	5
6	60	6
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t, o;
