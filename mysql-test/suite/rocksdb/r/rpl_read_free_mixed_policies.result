[connection master]
[connection master]
CREATE TABLE seq_200 (seq INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO seq_200 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 200) SELECT n FROM s;
CREATE TABLE tp  (a INT PRIMARY KEY, c INT) ENGINE=ROCKSDB;
CREATE TABLE tps (a INT PRIMARY KEY, b INT, c INT, KEY(b)) ENGINE=ROCKSDB;
CREATE TABLE tpu (a INT PRIMARY KEY, b INT, c INT, UNIQUE KEY(b)) ENGINE=ROCKSDB;
CREATE TABLE ts  (b INT, c INT, KEY(b)) ENGINE=ROCKSDB;
INSERT INTO tp  SELECT seq, seq FROM seq_200;
INSERT INTO tps SELECT seq, seq, seq FROM seq_200;
INSERT INTO tpu SELECT seq, seq, seq FROM seq_200;
INSERT INTO ts  SELECT seq, seq FROM seq_200;
