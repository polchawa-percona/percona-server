SELECT COUNT(*), SUM(c2), SUM(c33), SUM(c65), SUM(n1), SUM(n7), COUNT(n8) FROM t1;
COUNT(*)	SUM(c2)	SUM(c33)	SUM(c65)	SUM(n1)	SUM(n7)	COUNT(n8)
63	124	2013	3835	63	441	0
# Instant columns again after the rebuild, then restart and compaction
ALTER TABLE t1 ADD COLUMN c66 INT NOT NULL DEFAULT 66, ALGORITHM=INSTANT;
INSERT INTO t1 (id, c1, c66) VALUES (100, 100, 6600);
# restart
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
SELECT COUNT(*), SUM(c2), SUM(c33), SUM(c65), SUM(n1), SUM(n7), COUNT(n8), SUM(c66) FROM t1;
COUNT(*)	SUM(c2)	SUM(c33)	SUM(c65)	SUM(n1)	SUM(n7)	COUNT(n8)	SUM(c66)
64	126	2046	3900	64	448	0	10758
SELECT id, c1, c2, c65, n1, n8, c66 FROM t1 WHERE id IN (1, 64, 65, 100) ORDER BY id;
id	c1	c2	c65	n1	n8	c66
1	1	2	0	1	NULL	66
64	64	0	65	1	NULL	66
65	65	2	-65	1	NULL	66
100	100	2	65	1	NULL	6600
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# Scenario 8 (from instant_max_column_crash):
# Instant ADD COLUMN up to the server limit of 4096 columns
#
# Create table with 4094 columns
call create_table("tb1", 4094);
INSERT INTO tb1 (col_1, col_4094) VALUES (1, 1);
ALTER TABLE tb1 ADD COLUMN col_4095 INT NOT NULL DEFAULT 4095, ALGORITHM=INSTANT;
INSERT INTO tb1 (col_1, col_4094, col_4095) VALUES (2, 2, 2);
ALTER TABLE tb1 ADD COLUMN col_4096 INT NOT NULL DEFAULT 4096, ALGORITHM=INSTANT;
INSERT INTO tb1 (col_1, col_4094, col_4095, col_4096) VALUES (3, 3, 3, 3);
# The 4097th column exceeds the server limit
ALTER TABLE tb1 ADD COLUMN col_4097 INT, ALGORITHM=INSTANT;
ERROR HY000: Too many columns
SELECT col_1, col_4094, col_4095, col_4096 FROM tb1 ORDER BY col_1;
col_1	col_4094	col_4095	col_4096
1	1	4095	4096
2	2	2	4096
3	3	3	3
# restart
SELECT col_1, col_4094, col_4095, col_4096 FROM tb1 ORDER BY col_1;
col_1	col_4094	col_4095	col_4096
1	1	4095	4096
2	2	2	4096
3	3	3	3
DROP TABLE tb1;
DROP PROCEDURE create_table;
