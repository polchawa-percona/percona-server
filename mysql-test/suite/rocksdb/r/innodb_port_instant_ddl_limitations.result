SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
#
# Scenario 6:
# INSTANT ADD/DROP column with key
#
CREATE TABLE t1 (c1 INT, c2 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN c3 INT KEY, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
DROP TABLE t1;
CREATE TABLE t1 (c1 INT KEY, c2 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 DROP COLUMN c1, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 DROP COLUMN c1, ADD PRIMARY KEY (c2), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
DROP TABLE t1;
CREATE TABLE t1 (c1 INT KEY, c2 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN c3 INT UNIQUE KEY, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD COLUMN c3 INT, ADD INDEX idx (c3), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
DROP TABLE t1;
CREATE TABLE t1 (c1 INT KEY, c2 INT, INDEX idx(c2)) ENGINE=ROCKSDB;
ALTER TABLE t1 DROP COLUMN c2, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
DROP TABLE t1;
#
# Scenario 7:
# Many instant ADD COLUMNs, and the null bitmap limit of MyRocks
#
CREATE TABLE t1 (id INT PRIMARY KEY, c1 INT, k INT NOT NULL DEFAULT 0, KEY (k)) ENGINE=ROCKSDB;
INSERT INTO t1 (id, c1) VALUES (1, 1);
# 64 instant ADD COLUMNs of NOT NULL columns, one row written per version
# DD metadata of table t1
NAME	SE_PRIVATE_DATA
t1	instant_col=3;
# DD metadata of the columns of t1
NAME	ORDINAL_POSITION	HIDDEN	SE_PRIVATE_DATA
id	1	Visible	NULL
c1	2	Visible	NULL
k	3	Visible	NULL
c2	4	Visible	default=02000000;
c3	5	Visible	default=03000000;
