SELECT COUNT(*), SUM(c2), SUM(c33), SUM(c65) FROM t1;
COUNT(*)	SUM(c2)	SUM(c33)	SUM(c65)
65	126	2079	4095
SELECT id, c1, c2, c3, c64, c65 FROM t1 WHERE id IN (1, 2, 3, 64, 65) ORDER BY id;
id	c1	c2	c3	c64	c65
1	1	2	3	64	65
2	2	-2	3	64	65
3	3	2	-3	64	65
64	64	2	3	-64	65
65	65	2	3	64	-65
# Update and delete rows written before different ADD COLUMNs
UPDATE t1 SET c65 = 0, k = id WHERE id IN (1, 33);
UPDATE t1 SET c2 = 0 WHERE id = 64;
DELETE FROM t1 WHERE id IN (2, 40);
SELECT id, c1, c2, c33, c65, k FROM t1 WHERE id IN (1, 33, 64) ORDER BY id;
id	c1	c2	c33	c65	k
1	1	2	33	0	1
33	33	2	-33	0	33
64	64	0	33	65	0
SELECT id, k FROM t1 FORCE INDEX (k) WHERE k > 0 ORDER BY k;
id	k
1	1
33	33
# The table has one nullable column (c1). Nullable columns can be added
# instantly while the row's null bitmap stays one byte (8 columns)
# The 9th nullable column needs a second null-bit byte: not instant
ALTER TABLE t1 ADD COLUMN n8 INT, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
# Without ALGORITHM the ADD COLUMN rebuilds the table
ALTER TABLE t1 ADD COLUMN n8 INT;
# The rebuild cleared the instant metadata
# DD metadata of table t1
NAME	SE_PRIVATE_DATA
t1	NULL
