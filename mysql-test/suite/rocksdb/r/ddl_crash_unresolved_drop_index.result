CREATE TABLE orphan_probe (a INT PRIMARY KEY) ENGINE=ROCKSDB;
DROP TABLE orphan_probe;
#
# RENAME TABLE before the first open: the record moves with the table.
# A new table with the old name is not affected by the record, also
# after a restart.
#
CREATE DATABASE db2;
CREATE TABLE t1_0 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a), KEY kb(b)) ENGINE=ROCKSDB ;
INSERT INTO t1_0 VALUES (1,10,30),(2,20,20),(3,30,10);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
# Crash at crash_commit_after_prepare during: ALTER TABLE t1_0 DROP INDEX ka, ALGORITHM=INPLACE
ALTER TABLE t1_0 DROP INDEX ka, ALGORITHM=INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
# Unresolved: MyRocks still has the index list of the ALTER TABLE
SELECT PARTITION_NAME, COUNT(*) AS rocksdb_indexes FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1_0' GROUP BY PARTITION_NAME ORDER BY PARTITION_NAME;
PARTITION_NAME	rocksdb_indexes
NULL	2
RENAME TABLE t1_0 TO test.t2_0;
SHOW CREATE TABLE test.t2_0;
Table	Create Table
t2_0	CREATE TABLE `t2_0` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ka` (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT PARTITION_NAME, INDEX_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't2_0' ORDER BY PARTITION_NAME, INDEX_NAME;
PARTITION_NAME	INDEX_NAME
NULL	ka
NULL	kb
NULL	PRIMARY
SELECT * FROM test.t2_0 ORDER BY id;
id	a	b
1	10	30
2	20	20
3	30	10
SELECT id, a FROM test.t2_0 FORCE INDEX(ka) WHERE a > 0 ORDER BY a;
id	a
1	10
2	20
3	30
SELECT id, b FROM test.t2_0 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
id	b
3	10
2	20
1	30
INSERT INTO test.t2_0 VALUES (4,40,40);
UPDATE test.t2_0 SET a = a + 100, b = b + 100 WHERE id = 1;
SELECT id, a FROM test.t2_0 FORCE INDEX(ka) WHERE a > 0 ORDER BY a;
id	a
2	20
3	30
4	40
1	110
SELECT id, b FROM test.t2_0 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
id	b
3	10
2	20
4	40
1	130
CHECK TABLE test.t2_0;
Table	Op	Msg_type	Msg_text
test.t2_0	check	status	OK
