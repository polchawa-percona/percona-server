#
# DDL that completed before the crash
#
# ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE, crash after it completes
ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE;
# restart
SELECT table_name FROM information_schema.tables
WHERE table_schema = 'test' ORDER BY table_name;
TABLE_NAME
t1
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` varchar(32) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ka` (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*), SUM(id), SUM(a) FROM t1;
COUNT(*)	SUM(id)	SUM(a)
500	125250	12250
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	#	#	OK
