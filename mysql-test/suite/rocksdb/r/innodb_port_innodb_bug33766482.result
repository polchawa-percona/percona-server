# Multi-valued indexes are rejected by MyRocks
CREATE TABLE t1 (
id INT UNSIGNED,
a JSON DEFAULT NULL,
PRIMARY KEY (id),
KEY ((CAST(JSON_EXTRACT(a,_utf8mb4'$.b') AS CHAR(255) ARRAY)))
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci ;
ERROR 42000: The storage engine for the table doesn't support multi-valued indexes
CREATE TABLE t1 (
id INT UNSIGNED,
a JSON DEFAULT NULL,
PRIMARY KEY (id),
KEY k ((CAST(JSON_EXTRACT(a,_utf8mb4'$.b') AS CHAR(255))))
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci ;
CREATE PROCEDURE fill()
BEGIN
DECLARE v_i BIGINT UNSIGNED DEFAULT 0;
REPEAT
SET v_i:=v_i+1;
REPLACE INTO t1(id,a) VALUES(FLOOR(RAND()*100000),CONCAT('{"a":"\'{ab:a,ba:',FLOOR(RAND()*100000),',bab:baa}\'","b":"\'{a:bbb,bab:true,bb:[',FLOOR(RAND()*100000),',8,7,1,9,10,8,7,3]}\'","ba":"b","baa":[6,1,1,2,9,8,0,5,2,4]}'));
UNTIL v_i=200 END REPEAT;
END |
CREATE PROCEDURE upd()
BEGIN
DECLARE v_i BIGINT UNSIGNED DEFAULT 0;
REPEAT
SET v_i:=v_i+1;
UPDATE t1 SET a= CONCAT('{"b":',FLOOR(RAND()*100000),',"aba":"\'{a:[a,aa,b,aab,aa,bba,baa,a],b:bba}\'","b":',FLOOR(RAND()*100000),',"bb":2}');
UNTIL v_i = 10 END REPEAT;
END |
REPLACE INTO t1(id,a) VALUES(7,CONCAT('{"a":"\'{ab:a,ba:',FLOOR(RAND()*100000),',bab:baa}\'","b":"\'{a:bbb,bab:true,bb:[',FLOOR(RAND()*100000),',8,7,1,9,10,8,7,3]}\'","ba":"b","baa":[6,1,1,2,9,8,0,5,2,4]}'));
UPDATE t1 SET a= CONCAT('{"b":',FLOOR(RAND()*100000),',"aba":"\'{a:[a,aa,b,aab,aa,bba,baa,a],b:bba}\'","b":',FLOOR(RAND()*100000),',"bb":2}');
UPDATE t1 SET a= CONCAT('{"b":',FLOOR(RAND()*100000),',"aba":"\'{a:[a,aa,b,aab,aa,bba,baa,a],b:bba}\'","b":',FLOOR(RAND()*100000),',"bb":2}');
# The instruments exist
SELECT COUNT(*) > 0 FROM performance_schema.setup_instruments
WHERE name LIKE 'memory/rocksdb/%' AND enabled = 'YES';
COUNT(*) > 0
1
CALL fill();
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (k)) = (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY)) AS index_matches_pk;
index_matches_pk
1
CALL upd();
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (k)) = (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY)) AS index_matches_pk;
index_matches_pk
1
# A deterministic final UPDATE: every row is found through the index
UPDATE t1 SET a = '{"b":42,"bb":2}';
SELECT COUNT(*) = (SELECT COUNT(*) FROM t1) AS all_found_via_index FROM t1 FORCE INDEX (k)
WHERE CAST(JSON_EXTRACT(a,_utf8mb4'$.b') AS CHAR(255)) = '42';
all_found_via_index
1
SELECT COUNT(*) FROM t1 FORCE INDEX (k)
WHERE CAST(JSON_EXTRACT(a,_utf8mb4'$.b') AS CHAR(255)) <> '42';
COUNT(*)
0
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP PROCEDURE IF EXISTS fill;
DROP PROCEDURE IF EXISTS upd;
DROP TABLE t1;
