CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT NOT NULL) ENGINE = ROCKSDB;
SET SESSION cte_max_recursion_depth = 2000;
INSERT INTO t1 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 1000)
SELECT n, n FROM v;
call mtr.add_suppression("Error retrieving index entry from primary key");
# Kill an INPLACE ADD INDEX paused at rocksdb.inplace_populate_sk_scan_row
SET DEBUG_SYNC = 'rocksdb.inplace_populate_sk_scan_row SIGNAL paused WAIT_FOR killed';
ALTER TABLE t1 ADD INDEX k_killed(c2), ALGORITHM = INPLACE;
SET DEBUG_SYNC = 'now WAIT_FOR paused';
KILL QUERY ID;
SET DEBUG_SYNC = 'now SIGNAL killed';
Got one of the listed errors
SET DEBUG_SYNC = 'RESET';
# The next index build on the same connection must succeed.
ALTER TABLE t1 ADD INDEX k_next(c2), ALGORITHM = INPLACE;
SELECT COUNT(*), SUM(c2) FROM t1 FORCE INDEX (k_next);
COUNT(*)	SUM(c2)
1000	500500
ALTER TABLE t1 DROP INDEX k_next;
# Kill an INPLACE ADD INDEX paused at rocksdb.inplace_populate_sk_scan_row
SET DEBUG_SYNC = 'rocksdb.inplace_populate_sk_scan_row SIGNAL paused WAIT_FOR killed';
ALTER TABLE t1 ADD INDEX k_killed(c2), ALGORITHM = INPLACE;
SET DEBUG_SYNC = 'now WAIT_FOR paused';
KILL QUERY ID;
SET DEBUG_SYNC = 'now SIGNAL killed';
Got one of the listed errors
SET DEBUG_SYNC = 'RESET';
# The next index build on the same connection must succeed.
ALTER TABLE t1 ADD INDEX k_next(c2), ALGORITHM = INPLACE;
SELECT COUNT(*), SUM(c2) FROM t1 FORCE INDEX (k_next);
COUNT(*)	SUM(c2)
