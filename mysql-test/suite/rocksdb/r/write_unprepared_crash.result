SELECT @@rocksdb_write_policy;
@@rocksdb_write_policy
write_unprepared
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE seq (n INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO seq SELECT n FROM (WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 2000) SELECT n FROM s) x;
CREATE TABLE t1 (id INT PRIMARY KEY, v INT, u INT, KEY kv (v), UNIQUE KEY ku (u)) ENGINE=ROCKSDB;
INSERT INTO t1 SELECT n, 1, n FROM seq WHERE n <= 100;
#
# Round 1
#
SET SESSION transaction_isolation = 'READ-COMMITTED';
# Flushed inserts, never prepared
SET SESSION rocksdb_write_batch_flush_threshold = 1;
BEGIN;
INSERT INTO t1 SELECT n + 1000 * 1, 2, n + 1000 * 1 FROM seq WHERE n <= 900;
# Keys written to the database before COMMIT: yes
# Committed by another session while con1 is open
INSERT INTO t1 VALUES (50000 + 1, 7, 50000 + 1);
# Kill and restart
# After recovery: committed rows only
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
101	107
SELECT COUNT(*), SUM(v) FROM t1 FORCE INDEX (kv);
COUNT(*)	SUM(v)
101	107
SELECT COUNT(*) FROM t1 FORCE INDEX (ku);
COUNT(*)
101
SELECT COUNT(*) FROM t1 WHERE id > 1000 AND id < 50000;
COUNT(*)
0
SELECT id, v FROM t1 WHERE id IN (5, 6, 7) ORDER BY id;
id	v
5	1
6	1
7	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# The values the dead transaction wrote are free
INSERT INTO t1 VALUES (1000 * 1 + 1, 4, 1000 * 1 + 1);
DELETE FROM t1 WHERE id = 1000 * 1 + 1;
#
# Round 2
#
SET SESSION transaction_isolation = 'READ-COMMITTED';
# Flushed inserts, updates and deletes of committed rows
SET SESSION rocksdb_write_batch_flush_threshold = 4096;
BEGIN;
INSERT INTO t1 SELECT n + 1000 * 2, 2, n + 1000 * 2 FROM seq WHERE n <= 900;
UPDATE t1 SET v = 99 WHERE id = 5;
UPDATE t1 SET v = 99 WHERE id = 6;
DELETE FROM t1 WHERE id = 7;
# Keys written to the database before COMMIT: yes
# Committed by another session while con1 is open
INSERT INTO t1 VALUES (50000 + 2, 7, 50000 + 2);
# Kill and restart
# After recovery: committed rows only
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
102	114
SELECT COUNT(*), SUM(v) FROM t1 FORCE INDEX (kv);
COUNT(*)	SUM(v)
102	114
SELECT COUNT(*) FROM t1 FORCE INDEX (ku);
COUNT(*)
102
SELECT COUNT(*) FROM t1 WHERE id > 1000 AND id < 50000;
COUNT(*)
0
SELECT id, v FROM t1 WHERE id IN (5, 6, 7) ORDER BY id;
id	v
5	1
6	1
7	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# The values the dead transaction wrote are free
INSERT INTO t1 VALUES (1000 * 2 + 1, 4, 1000 * 2 + 1);
DELETE FROM t1 WHERE id = 1000 * 2 + 1;
#
# Round 3
#
SET SESSION transaction_isolation = 'READ-COMMITTED';
# Flushed writes, then a failed statement rolled back
SET SESSION rocksdb_write_batch_flush_threshold = 1;
BEGIN;
INSERT INTO t1 SELECT n + 1000 * 3, 2, n + 1000 * 3 FROM seq WHERE n <= 900;
INSERT INTO t1 VALUES (99001, 3, 99001), (99002, 3, 99002), (99003, 3, 50);
ERROR 23000: Duplicate entry '50' for key 't1.ku'
# Keys written to the database before COMMIT: yes
# Committed by another session while con1 is open
INSERT INTO t1 VALUES (50000 + 3, 7, 50000 + 3);
# Kill and restart
# After recovery: committed rows only
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
103	121
SELECT COUNT(*), SUM(v) FROM t1 FORCE INDEX (kv);
COUNT(*)	SUM(v)
103	121
SELECT COUNT(*) FROM t1 FORCE INDEX (ku);
COUNT(*)
103
SELECT COUNT(*) FROM t1 WHERE id > 1000 AND id < 50000;
COUNT(*)
0
SELECT id, v FROM t1 WHERE id IN (5, 6, 7) ORDER BY id;
id	v
5	1
6	1
7	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# The values the dead transaction wrote are free
INSERT INTO t1 VALUES (1000 * 3 + 1, 4, 1000 * 3 + 1);
DELETE FROM t1 WHERE id = 1000 * 3 + 1;
DROP TABLE t1, seq;
