#
# Bug #33454557 Innodb asserts due to corruption in the fsp layer while
# running MTR tests
#
set @s:=concat("CREATE TABLE t(id INT PRIMARY KEY, a LONGBLOB GENERATED ALWAYS AS
('",REPEAT("a",1024*1024),"') STORED) ENGINE=ROCKSDB;");
PREPARE r FROM @s;
EXECUTE r;
DEALLOCATE PREPARE r;
INSERT INTO t (id) VALUES (1), (2);
set @s:=concat("CREATE TABLE t2(w INT, A INT GENERATED ALWAYS
AS('",REPEAT("\\0",1024*1024),"') STORED) ENGINE=ROCKSDB;");
PREPARE r FROM @s;
EXECUTE r;
DEALLOCATE PREPARE r;
DROP TABLE t2;
# Kill and restart
SELECT id, LENGTH(a), MD5(a) FROM t ORDER BY id;
id	LENGTH(a)	MD5(a)
1	1048576	7202826a7791073fe2787f0c94603278
2	1048576	7202826a7791073fe2787f0c94603278
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
CREATE TABLE `ibstd_02` (
`a` int NOT NULL,
`d` int NOT NULL,
`b` varchar(198) NOT NULL,
`c` char(94) DEFAULT NULL,
`nc02614` blob,
`nc07663` decimal(10,0) NOT NULL,
`nc08713` mediumtext,
`nc04074` mediumtext NOT NULL,
`nc09146` tinytext NOT NULL,
KEY `d` (`d`),
KEY `a` (`a`),
KEY `b` (`b`(10),`a`,`d`),
KEY `c` (`c`(56)),
KEY `b_2` (`b`(5),`c`(10),`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO ibstd_02 (a, d, b, c, nc02614, nc07663, nc08713, nc04074, nc09146)
VALUES (1, 1, 'b1', 'c1', REPEAT('p', 65000), 1, REPEAT('q', 300000),
REPEAT('r', 100000), 't1');
alter table ibstd_02 add column nc09053 blob not null, algorithm=instant;
alter table ibstd_02 add column nc03118 mediumtext, algorithm=instant;
alter table ibstd_02 add column nc08926 tinytext, algorithm=instant, lock=default;
alter table ibstd_02 add column nc09010 double default '73563844.85182579', algorithm=instant;
alter table ibstd_02 add column nc07017 decimal not null, algorithm=instant, lock=default;
alter table ibstd_02 add column nc07007 tinytext not null, algorithm=instant;
alter table ibstd_02 add column nc08086 blob, algorithm=instant;
INSERT INTO ibstd_02 (a, d, b, c, nc02614, nc07663, nc08713, nc04074, nc09146,
nc09053, nc03118, nc07017, nc07007, nc08086)
VALUES (2, 2, 'b2', 'c2', REPEAT('p', 10), 2, NULL, REPEAT('s', 200000), 't2',
REPEAT('u', 65535), REPEAT('v', 500000), 7, 'w', REPEAT('x', 40000));
# Kill and restart
SELECT a, LENGTH(nc02614), LENGTH(nc08713), LENGTH(nc04074), nc09146,
LENGTH(nc09053), LENGTH(nc03118), nc08926, nc09010, nc07017, nc07007,
LENGTH(nc08086)
FROM ibstd_02 ORDER BY a;
a	LENGTH(nc02614)	LENGTH(nc08713)	LENGTH(nc04074)	nc09146	LENGTH(nc09053)	LENGTH(nc03118)	nc08926	nc09010	nc07017	nc07007	LENGTH(nc08086)
1	65000	300000	100000	t1	65535	NULL	NULL	73563844.85182579	0	w	NULL
2	10	NULL	200000	t2	65535	500000	NULL	73563844.85182579	7	w	40000
SELECT a FROM ibstd_02 FORCE INDEX (b) ORDER BY a;
a
1
2
CHECK TABLE ibstd_02;
Table	Op	Msg_type	Msg_text
test.ibstd_02	check	status	OK
drop table ibstd_02;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = DEFAULT;
# Kill and restart
# Case 1 : Test create and drop large number of partitions.
CREATE TABLE t1(a INT NOT NULL, PRIMARY KEY(a)) ENGINE=ROCKSDB
PARTITION BY HASH(a) PARTITIONS 1024;
DROP TABLE t1;
# Case 2 : Test create, rename and drop large number of partitions.
CREATE TABLE t1(a INT NOT NULL, PRIMARY KEY(a)) ENGINE=ROCKSDB
PARTITION BY HASH(a) PARTITIONS 1024;
INSERT INTO t1 VALUES (1), (2), (1023), (1024);
RENAME TABLE t1 TO t2;
DROP TABLE t2;
# Case 3 : Test create, truncate and drop large number of partitions.
CREATE TABLE t1(a INT NOT NULL, PRIMARY KEY(a)) ENGINE=ROCKSDB
PARTITION BY HASH(a) PARTITIONS 1024;
INSERT INTO t1 VALUES (1), (2), (1023), (1024);
TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;
COUNT(*)
0
DROP TABLE t1;
# Case 4 : A partitioned table kept across the kill.
CREATE TABLE t1(a INT NOT NULL, PRIMARY KEY(a)) ENGINE=ROCKSDB
PARTITION BY HASH(a) PARTITIONS 1024;
INSERT INTO t1 VALUES (1), (2), (1023), (1024);
# Kill and restart
SELECT a FROM t1 ORDER BY a;
a
1
2
1023
1024
# Only t1's 1024 partitions are left in the MyRocks dictionary.
SELECT COUNT(*), COUNT(DISTINCT partition_name) FROM information_schema.rocksdb_ddl
WHERE table_schema = 'test' AND table_name = 't1';
COUNT(*)	COUNT(DISTINCT partition_name)
1024	1024
SELECT COUNT(*) FROM information_schema.rocksdb_ddl
WHERE table_schema = 'test' AND table_name <> 't1';
COUNT(*)
0
DROP TABLE t1;
SELECT COUNT(*) FROM information_schema.rocksdb_ddl WHERE table_schema = 'test';
COUNT(*)
0
