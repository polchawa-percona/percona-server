CREATE PROCEDURE prepare_data(IN val INT)
BEGIN
DECLARE i INT DEFAULT 1;
WHILE i < val DO
INSERT INTO t1 (b) VALUES (i);
SET i = i + 1;
END WHILE;
END|
CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY AUTO_INCREMENT, b INT) ENGINE=ROCKSDB;
BEGIN;
CALL prepare_data(30000);
COMMIT;
# Without a histogram the optimizer guesses the filter of a range on b
filtered: 33.33
ANALYZE TABLE t1 UPDATE HISTOGRAM ON b WITH 50 BUCKETS;
Table	Op	Msg_type	Msg_text
test.t1	histogram	status	Histogram statistics created for column 'b'.
SELECT SCHEMA_NAME, TABLE_NAME, COLUMN_NAME FROM information_schema.column_statistics WHERE COLUMN_NAME = 'b';
SCHEMA_NAME	TABLE_NAME	COLUMN_NAME
test	t1	b
SELECT JSON_EXTRACT(histogram, '$."histogram-type"') AS type,
JSON_LENGTH(histogram, '$.buckets') AS buckets,
JSON_EXTRACT(histogram, '$."sampling-rate"') < 1 AS sampled,
JSON_EXTRACT(histogram, '$."sampling-rate"') > 0 AS rate_positive
FROM information_schema.column_statistics WHERE COLUMN_NAME = 'b';
type	buckets	sampled	rate_positive
"equi-height"	50	1	1
# With the histogram the filter estimate is close to the real 10%
filtered between 8 and 12: 1
DROP TABLE t1;
#
# Cleanup
#
DROP PROCEDURE prepare_data;
