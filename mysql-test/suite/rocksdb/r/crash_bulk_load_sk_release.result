CREATE TABLE t_sk (id INT PRIMARY KEY, k INT, KEY k (k)) ENGINE=ROCKSDB;
CREATE TABLE t_sk_unsorted (id INT PRIMARY KEY, k INT, KEY k (k)) ENGINE=ROCKSDB;
RESET BINARY LOGS AND GTIDS;
# Kill during a sorted bulk load with allow_sk = OFF
SET SESSION cte_max_recursion_depth = 4000000;
SET SESSION rocksdb_bulk_load_size = 1000, SESSION rocksdb_bulk_load_allow_sk = 0, SESSION rocksdb_bulk_load = 1;
INSERT INTO t_sk WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 2000000) SELECT n, n FROM seq ORDER BY n;
# Kill and restart
# t_sk after recovery
engine_matches_binlog
1
sk_matches_pk
1
no_sk_entries_without_pk
1
CHECK TABLE t_sk;
Table	Op	Msg_type	Msg_text
test.t_sk	check	status	OK
leftover_tmp_sst_files: 0
# Kill during an unsorted bulk load with allow_sk = OFF
SET SESSION cte_max_recursion_depth = 4000000;
SET SESSION rocksdb_bulk_load_size = 1000, SESSION rocksdb_bulk_load_allow_sk = 0, SESSION rocksdb_bulk_load_allow_unsorted = 1, SESSION rocksdb_bulk_load = 1;
INSERT INTO t_sk_unsorted WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 2000000) SELECT 2000000 - n + 1, n FROM seq;
# Kill and restart
# t_sk_unsorted after recovery
engine_matches_binlog
1
sk_matches_pk
1
no_sk_entries_without_pk
1
CHECK TABLE t_sk_unsorted;
Table	Op	Msg_type	Msg_text
test.t_sk_unsorted	check	status	OK
leftover_tmp_sst_files: 0
DROP TABLE t_sk, t_sk_unsorted;
