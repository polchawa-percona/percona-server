#
# Test#0 : a primary key change cannot be done in place.
#
CREATE TABLE t0 (id0 INT, id1 INT, PRIMARY KEY (id0, id1)) ENGINE=ROCKSDB;
ALTER TABLE t0 DROP PRIMARY KEY, ADD PRIMARY KEY(id0), ALGORITHM = INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
DROP TABLE t0;
#
# Test#1 : Try and fail to rebuild the table's PK from 2 columns to 1 column with duplicates.
#
CREATE TABLE t1 (
id0 int,
id1 int,
PRIMARY KEY (id0, id1),
KEY k1 (id1)
) ENGINE=ROCKSDB;
INSERT INTO t1(id0, id1) VALUES
(1, 1),
(2, 2),
(2, 3);
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY(id0), ALGORITHM = COPY;
ERROR 23000: Duplicate entry '2' for key 't1.PRIMARY'
# Check that records are present.
SELECT * FROM t1 ORDER BY id0, id1;
id0	id1
1	1
2	2
2	3
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id0` int NOT NULL,
  `id1` int NOT NULL,
  PRIMARY KEY (`id0`,`id1`),
  KEY `k1` (`id1`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# t1.k1 matches the table: 1
DROP TABLE t1;
#
# Test#2 : Try and fail to rebuild the table's PK from 2 columns to 1 column with duplicates.
#          Then succeed doing it on second set of two columns with unique rows.
#
CREATE TABLE t2 (
id0 int,
id1 int,
id2 int,
PRIMARY KEY (id0, id2),
KEY k1 (id1)
) ENGINE=ROCKSDB;
INSERT INTO t2(id0, id1, id2) VALUES
(1, 2, 3),
(1, 2, 4),
(1, 3, 5);
ALTER TABLE t2 DROP PRIMARY KEY, ADD PRIMARY KEY(id1), ALGORITHM = COPY;
ERROR 23000: Duplicate entry '2' for key 't2.PRIMARY'
ALTER TABLE t2 DROP PRIMARY KEY, ADD PRIMARY KEY(id1, id2), ALGORITHM = COPY;
# Check that records are present.
SELECT * FROM t2 ORDER BY id0, id1, id2;
id0	id1	id2
1	2	3
1	2	4
1	3	5
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id0` int NOT NULL,
  `id1` int NOT NULL,
  `id2` int NOT NULL,
  PRIMARY KEY (`id1`,`id2`),
  KEY `k1` (`id1`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
# t2.k1 matches the table: 1
# Point lookups through the new primary key.
SELECT * FROM t2 WHERE id1 = 2 AND id2 = 4;
id0	id1	id2
1	2	4
SELECT * FROM t2 WHERE id1 = 3;
id0	id1	id2
1	3	5
DROP TABLE t2;
#
# Test#3 : Try and fail to rebuild the table's PK from unique 1 column to
#          set of 2 columns with duplicate rows.
#
CREATE TABLE t3 (
id0 int,
id1 char(2),
id2 varchar(3),
id3 date,
id4 bool,
PRIMARY KEY (id0),
KEY k2 (id2, id3)
) ENGINE=ROCKSDB;
INSERT INTO t3(id0, id1, id2, id3, id4) VALUES
(1, '22', '3', '2020-01-01', true),
(2, '33', '4', '2020-02-01', false),
(3, '22', '3', '2020-01-01', true);
ALTER TABLE t3 DROP PRIMARY KEY, ADD PRIMARY KEY(id1, id2), ALGORITHM = COPY;
ERROR 23000: Duplicate entry '22-3' for key 't3.PRIMARY'
#
# Test#4 : Change primary key to all 5 columns. Then fail to change to
#          last 4 ones due to duplicates.
#
ALTER TABLE t3 DROP PRIMARY KEY, ADD PRIMARY KEY(id0, id1, id2, id3, id4), ALGORITHM = COPY;
ALTER TABLE t3 DROP PRIMARY KEY, ADD PRIMARY KEY(id1, id2, id3, id4), ALGORITHM = COPY;
ERROR 23000: Duplicate entry '22-3-2020-01-01-1' for key 't3.PRIMARY'
# Check that records are present.
SELECT * FROM t3 ORDER BY id0, id1, id2, id3, id4;
id0	id1	id2	id3	id4
1	22	3	2020-01-01	1
2	33	4	2020-02-01	0
3	22	3	2020-01-01	1
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id0` int NOT NULL,
  `id1` char(2) NOT NULL,
  `id2` varchar(3) NOT NULL,
  `id3` date NOT NULL,
  `id4` tinyint(1) NOT NULL,
  PRIMARY KEY (`id0`,`id1`,`id2`,`id3`,`id4`),
  KEY `k2` (`id2`,`id3`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECK TABLE t3;
Table	Op	Msg_type	Msg_text
test.t3	check	status	OK
# t3.k2 matches the table: 1
DROP TABLE t3;
# No temporary tables of the failed ALTERs are left in the MyRocks dictionary.
SELECT COUNT(*) FROM information_schema.rocksdb_ddl WHERE table_schema = 'test';
COUNT(*)
0
