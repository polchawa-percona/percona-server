CREATE TABLE t_rev (k INT NOT NULL, id INT NOT NULL, pad CHAR(200) NOT NULL,
PRIMARY KEY (k, id) COMMENT 'cfname=rev:cf_x4g5') ENGINE=ROCKSDB;
CREATE TABLE t_fwd (k INT NOT NULL, id INT NOT NULL, pad CHAR(200) NOT NULL,
PRIMARY KEY (k, id) COMMENT 'cfname=cf_x4g5f') ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t_rev
WITH RECURSIVE s(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM s WHERE i < 1999)
SELECT (i DIV 20) * 2 + 1, i MOD 20 + 1, REPEAT('x', 200) FROM s;
INSERT INTO t_fwd
WITH RECURSIVE s(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM s WHERE i < 1999)
SELECT (i DIV 20) * 2 + 1, i MOD 20 + 1, REPEAT('x', 200) FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'rev:cf_x4g5';
SET GLOBAL rocksdb_compact_cf = 'cf_x4g5f';
SELECT CF_NAME, COUNT(*) > 3 AS several_files, MIN(LEVEL) > 0 AS not_l0
FROM INFORMATION_SCHEMA.ROCKSDB_LIVE_FILES_METADATA
WHERE CF_NAME IN ('rev:cf_x4g5', 'cf_x4g5f')
GROUP BY CF_NAME ORDER BY CF_NAME;
CF_NAME	several_files	not_l0
cf_x4g5f	1	1
rev:cf_x4g5	1	1
equality lookups wrong: 0
