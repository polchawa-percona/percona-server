concurrent load finished, all checks passed
# Reclaim every dropped index and compact both column families.
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_signal_drop_index_thread = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
SET GLOBAL rocksdb_compact_cf = 'cf_cc2';
# No SST holds rows of an index that MyRocks no longer knows.
SELECT COUNT(*) AS orphan_index_rows
FROM information_schema.ROCKSDB_INDEX_FILE_MAP f
WHERE f.NUM_ROWS > 0
AND f.COLUMN_FAMILY IN (SELECT DISTINCT COLUMN_FAMILY
FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'd1')
AND f.INDEX_NUMBER NOT IN (SELECT INDEX_NUMBER
FROM information_schema.ROCKSDB_DDL);
orphan_index_rows
0
# Rows per table and their identities, before the restart.
SELECT 't0' AS tbl, COUNT(DISTINCT owner) AS owners,
(SELECT COUNT(*) FROM d1.t0 FORCE INDEX(PRIMARY)) =
(SELECT COUNT(*) FROM d1.t0 FORCE INDEX(sk)) AS pk_eq_sk
FROM d1.t0 HAVING owners <= 1;
tbl	owners	pk_eq_sk
t0	1	1
SELECT 't1' AS tbl, COUNT(DISTINCT owner) AS owners,
(SELECT COUNT(*) FROM d1.t1 FORCE INDEX(PRIMARY)) =
(SELECT COUNT(*) FROM d1.t1 FORCE INDEX(sk)) AS pk_eq_sk
FROM d1.t1 HAVING owners <= 1;
tbl	owners	pk_eq_sk
t1	1	1
