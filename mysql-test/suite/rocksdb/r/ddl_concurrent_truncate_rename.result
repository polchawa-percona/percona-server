t5	1	1
# Restart with table validation; every table must survive unchanged.
# restart: --rocksdb_validate_tables=1
# Row counts and id sums are unchanged after the restart.
SELECT COUNT(*) = 6 AS same_tables
FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'd1' AND TABLE_NAME LIKE 't_' AND ENGINE = 'ROCKSDB';
same_tables
1
DROP DATABASE d1;
DROP DATABASE d2;
