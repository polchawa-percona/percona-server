SET SESSION cte_max_recursion_depth = 5000;
#
# 1. Values of 64 KiB and more in a prefix-indexed TEXT column
#
INSERT INTO t1 VALUES (1, CONCAT('first', REPEAT('a', 65536)));
INSERT INTO t1 VALUES (2, CONCAT('second', REPEAT('ż', 100000)));
UPDATE t1 SET t = CONCAT('first', REPEAT('b', 300000)) WHERE id = 1;
SELECT id, LENGTH(t), LEFT(t, 6) FROM t1 FORCE INDEX(k) WHERE t LIKE 'first%' OR t LIKE 'second%' ORDER BY id;
id	LENGTH(t)	LEFT(t, 6)
1	300005	firstb
2	200006	second
SELECT id, LENGTH(t) FROM t1 FORCE INDEX(k200) WHERE t LIKE 'secondżż%';
id	LENGTH(t)
2	200006
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# 2. The prefix index must be much smaller than the table
#
INSERT INTO t2 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 1000)
SELECT n, CONCAT(n, REPEAT(MD5(n), 900)) FROM s;
INSERT INTO t3 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 1000)
SELECT n, CONCAT(n, REPEAT(MD5(n), 90)) FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SELECT d.TABLE_NAME,
SUM(IF(d.INDEX_NAME = 'k', m.DATA_SIZE, 0)) * 10 < SUM(IF(d.INDEX_NAME = 'PRIMARY', m.DATA_SIZE, 0)) AS prefix_index_small
FROM information_schema.ROCKSDB_DDL d
JOIN information_schema.ROCKSDB_INDEX_FILE_MAP m USING (COLUMN_FAMILY, INDEX_NUMBER)
WHERE d.TABLE_SCHEMA = 'test' AND d.TABLE_NAME IN ('t2', 't3')
GROUP BY d.TABLE_NAME ORDER BY d.TABLE_NAME;
TABLE_NAME	prefix_index_small
t2	1
t3	1
SELECT COUNT(*) FROM t2 FORCE INDEX(k) WHERE t LIKE '5%';
COUNT(*)
111
SELECT COUNT(*) FROM t3 FORCE INDEX(k) WHERE v LIKE '5%';
COUNT(*)
111
DROP TABLE t2, t3;
SET SESSION cte_max_recursion_depth = DEFAULT;
