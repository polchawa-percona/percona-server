SET @saved_bulk_load_allow_sk = @@session.rocksdb_bulk_load_allow_sk;
SET @saved_xa_detach_on_prepare = @@session.xa_detach_on_prepare;
CREATE TABLE t1 (a INT PRIMARY KEY, b INT NOT NULL, KEY kb (b)) ENGINE=ROCKSDB;
# Reference: rocksdb_bulk_load_allow_sk=ON, BEGIN ... ROLLBACK
SET SESSION rocksdb_bulk_load_allow_sk = ON;
SET SESSION rocksdb_bulk_load = 1;
BEGIN;
INSERT INTO t1 VALUES (1, 1), (2, 2);
ROLLBACK;
SET SESSION rocksdb_bulk_load = 0;
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY) WHERE a IN (1, 2)) =
(SELECT COUNT(*) FROM t1 FORCE INDEX (kb) WHERE b IN (1, 2))
AS same_rows;
same_rows
1
SET SESSION rocksdb_bulk_load_allow_sk = OFF;
# BEGIN ... ROLLBACK
SET SESSION rocksdb_bulk_load = 1;
BEGIN;
INSERT INTO t1 VALUES (3, 3), (4, 4);
ROLLBACK;
SET SESSION rocksdb_bulk_load = 0;
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY) WHERE a IN (3, 4)) =
(SELECT COUNT(*) FROM t1 FORCE INDEX (kb) WHERE b IN (3, 4))
AS same_rows;
same_rows
1
# XA ROLLBACK of a prepared transaction, xa_detach_on_prepare=OFF
SET SESSION xa_detach_on_prepare = OFF;
SET SESSION rocksdb_bulk_load = 1;
XA START 'x1';
INSERT INTO t1 VALUES (5, 5), (6, 6);
XA END 'x1';
XA PREPARE 'x1';
XA ROLLBACK 'x1';
SET SESSION rocksdb_bulk_load = 0;
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY) WHERE a IN (5, 6)) =
(SELECT COUNT(*) FROM t1 FORCE INDEX (kb) WHERE b IN (5, 6))
AS same_rows;
same_rows
1
# Autocommit INSERT that fails on its second row
SET SESSION rocksdb_bulk_load = 1;
INSERT INTO t1 VALUES (7, 7), (8, NULL);
ERROR 23000: Column 'b' cannot be null
SET SESSION rocksdb_bulk_load = 0;
SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY) WHERE a IN (7, 8)) =
(SELECT COUNT(*) FROM t1 FORCE INDEX (kb) WHERE b IN (7, 8))
AS same_rows;
same_rows
1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
SET SESSION rocksdb_bulk_load_allow_sk = @saved_bulk_load_allow_sk;
SET SESSION xa_detach_on_prepare = @saved_xa_detach_on_prepare;
