12
include/assert.inc [phase2 rocksdb == innodb]
SET GLOBAL rocksdb_debug_skip_bloom_filter_check_on_iterator_bounds=@saved_bounds;
SET DEBUG_SYNC='RESET';
drop table t;
drop table t_i;
