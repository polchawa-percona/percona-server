12
include/assert.inc [phase1 rocksdb == innodb]
SET DEBUG_SYNC='RESET';
SET DEBUG_SYNC='rocksdb.check_flags_nwd SIGNAL hunt_flip_reached2 WAIT_FOR hunt_flip_resume2';
SELECT a FROM t FORCE INDEX(idx_bcd) WHERE b = 1 OR (b = 2 AND c = 2) ORDER BY a;
SET DEBUG_SYNC='now WAIT_FOR hunt_flip_reached2';
SET DEBUG_SYNC='now SIGNAL hunt_flip_resume2';
a
1
2
10
11
12
bloom_intervals 1
include/assert.inc [phase2 bloom delta is 1]
select a from t_i force index(idx_bcd) where b = 1 or (b = 2 and c = 2) order by a;
a
1
