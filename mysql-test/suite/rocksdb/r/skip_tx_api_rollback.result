CREATE TABLE t1 (pk INT PRIMARY KEY, a INT, b VARCHAR(10),
UNIQUE KEY ua (a), KEY kb (b)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y'), (3, 30, 'z');
SET SESSION rocksdb_master_skip_tx_api = ON;
SET SESSION transaction_isolation = 'READ-COMMITTED';
# 1. Multi-row INSERT that fails on a duplicate after inserting rows.
BEGIN;
INSERT INTO t1 VALUES (4, 40, 'p');
INSERT INTO t1 VALUES (5, 50, 'q'), (6, 60, 'r'), (1, 70, 's');
ERROR 23000: Duplicate entry '1' for key 't1.PRIMARY'
INSERT INTO t1 VALUES (7, 80, 't'), (8, 10, 'u');
ERROR 23000: Duplicate entry '10' for key 't1.ua'
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x
2	20	y
3	30	z
4	40	p
COMMIT;
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x
2	20	y
3	30	z
4	40	p
SELECT pk, a FROM t1 FORCE INDEX (ua) ORDER BY a;
pk	a
1	10
2	20
3	30
4	40
SELECT pk, b FROM t1 FORCE INDEX (kb) ORDER BY b, pk;
pk	b
4	p
1	x
2	y
3	z
# 2. UPDATE that changes indexed columns and fails part way.
BEGIN;
UPDATE t1 SET a = a + 10 ORDER BY pk;
ERROR 23000: Duplicate entry '20' for key 't1.ua'
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x
2	20	y
3	30	z
4	40	p
UPDATE t1 SET b = CONCAT(b, '2') WHERE pk <= 2;
COMMIT;
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x2
2	20	y2
3	30	z
4	40	p
SELECT pk, a FROM t1 FORCE INDEX (ua) ORDER BY a;
pk	a
1	10
2	20
3	30
4	40
SELECT pk, b FROM t1 FORCE INDEX (kb) ORDER BY b, pk;
pk	b
4	p
1	x2
2	y2
3	z
# 3. Savepoints. MyRocks allows ROLLBACK TO SAVEPOINT only while the
#    transaction has no modifications; otherwise it fails and the
#    transaction becomes rollback-only.
BEGIN;
SAVEPOINT s0;
SELECT COUNT(*) FROM t1;
COUNT(*)
4
ROLLBACK TO SAVEPOINT s0;
INSERT INTO t1 VALUES (10, 100, 'sp0');
SAVEPOINT s1;
INSERT INTO t1 VALUES (11, 110, 'sp1');
ROLLBACK TO SAVEPOINT s1;
ERROR HY000: MyRocks currently does not support ROLLBACK TO SAVEPOINT if modifying rows.
COMMIT;
ERROR HY000: This transaction was rolled back and cannot be committed. Only supported operation is to roll it back, so all pending changes will be discarded. Please restart another transaction.
ROLLBACK;
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x2
2	20	y2
3	30	z
4	40	p
SELECT pk, a FROM t1 FORCE INDEX (ua) ORDER BY a;
pk	a
1	10
2	20
3	30
4	40
SELECT pk, b FROM t1 FORCE INDEX (kb) ORDER BY b, pk;
pk	b
4	p
1	x2
2	y2
3	z
# 4. Full rollback discards everything.
BEGIN;
DELETE FROM t1;
INSERT INTO t1 VALUES (99, 990, 'gone');
ROLLBACK;
SELECT * FROM t1 ORDER BY pk;
pk	a	b
1	10	x2
2	20	y2
3	30	z
4	40	p
# The table is consistent when read with the normal transaction API.
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
4
SELECT COUNT(*) FROM t1 FORCE INDEX (ua);
COUNT(*)
4
SELECT COUNT(*) FROM t1 FORCE INDEX (kb);
COUNT(*)
4
DROP TABLE t1;
