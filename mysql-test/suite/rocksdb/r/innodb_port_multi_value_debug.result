CREATE INDEX i2 ON t1((CAST(f1->"$[*]" AS CHAR(10) ARRAY)));
ERROR 42000: The storage engine for the table doesn't support multi-valued indexes
ALTER TABLE t1 ADD INDEX i3 ((CAST(f1->"$[*]" AS UNSIGNED ARRAY))), ALGORITHM=COPY;
