SELECT @@global.rocksdb_flush_log_at_trx_commit, @@global.sync_binlog;
@@global.rocksdb_flush_log_at_trx_commit	@@global.sync_binlog
1	1
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=ROCKSDB;
#
# 1. Acknowledged commits are all in the engine and in the binary log.
#
FLUSH BINARY LOGS;
SET GLOBAL rocksdb_debug_simulate_power_loss = ON;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*), MAX(id) FROM t1;
COUNT(*)	MAX(id)
100	100
# Transactions in the binary log:
100
#
# 2. Crash points around the binary log write, with power loss
#    semantics. A transaction is kept exactly when it reached the
#    binary log.
#
# crash_commit_before_log
FLUSH BINARY LOGS;
SET SESSION debug = 'd,crash_commit_before_log';
INSERT INTO t1 VALUES (1000, 1), (1000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (1000, 1000 + 1);
rows_in_engine
0
# Transactions in the binary log:
0
# crash_commit_after_prepare
FLUSH BINARY LOGS;
SET SESSION debug = 'd,crash_commit_after_prepare';
INSERT INTO t1 VALUES (2000, 1), (2000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (2000, 2000 + 1);
rows_in_engine
0
# Transactions in the binary log:
0
# half_binlogged_transaction
FLUSH BINARY LOGS;
SET SESSION debug = 'd,half_binlogged_transaction';
INSERT INTO t1 VALUES (3000, 1), (3000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (3000, 3000 + 1);
rows_in_engine
0
# Transactions in the binary log:
0
# crash_commit_after_log
FLUSH BINARY LOGS;
SET SESSION debug = 'd,crash_commit_after_log';
INSERT INTO t1 VALUES (4000, 1), (4000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (4000, 4000 + 1);
rows_in_engine
2
# Transactions in the binary log:
1
# crash_commit_before
FLUSH BINARY LOGS;
SET SESSION debug = 'd,crash_commit_before';
INSERT INTO t1 VALUES (5000, 1), (5000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (5000, 5000 + 1);
rows_in_engine
0
# Transactions in the binary log:
0
# crash_commit_after
FLUSH BINARY LOGS;
SET SESSION debug = 'd,crash_commit_after';
INSERT INTO t1 VALUES (6000, 1), (6000 + 1, 2);
SELECT COUNT(*) AS rows_in_engine FROM t1 WHERE id IN (6000, 6000 + 1);
rows_in_engine
2
# Transactions in the binary log:
1
#
# 3. Commits followed by FLUSH BINARY LOGS: the rotation syncs the
#    engine, so nothing is lost even though the binary log that held
#    the commits is no longer the last one.
#
FLUSH BINARY LOGS;
SET GLOBAL rocksdb_debug_simulate_power_loss = ON;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) FROM t1 WHERE id > 10000;
COUNT(*)
50
DROP TABLE t1;
