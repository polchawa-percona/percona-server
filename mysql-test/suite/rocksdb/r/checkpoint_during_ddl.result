call mtr.add_suppression("Plugin rocksdb reported");
call mtr.add_suppression("\\[Warning\\] .* #sql");
#
# Checkpoint taken after the DDL completed (baseline).
#
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
ALTER TABLE t1 ADD COLUMN c INT DEFAULT 5, ALGORITHM=COPY;
ALTER TABLE t1 ADD INDEX kc (c), ALGORITHM=INPLACE;
SET GLOBAL rocksdb_create_checkpoint = 'CHECKPOINT';
# restart
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` int DEFAULT '5',
  PRIMARY KEY (`a`),
  KEY `kb` (`b`),
  KEY `kc` (`c`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT * FROM t1 FORCE INDEX (kc) ORDER BY a;
a	b	c
1	1	5
2	2	5
3	3	5
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# COPY ALTER
#

# Case: COPY ALTER, temporary table created, no rows copied (paused at copy_data_between_tables_before)
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, c VARCHAR(32), KEY kb (b))
ENGINE=ROCKSDB;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
COUNT(*)	SUM(a)	SUM(b)
2000	2001000	94950
SET DEBUG_SYNC = 'copy_data_between_tables_before SIGNAL ddl_paused WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN d INT DEFAULT 7, ALGORITHM=COPY;
SET DEBUG_SYNC = 'now WAIT_FOR ddl_paused';
SET GLOBAL rocksdb_create_checkpoint = 'CHECKPOINT';
# Kill the server while the DDL is paused and restore the checkpoint.
# Kill the server
# restart
# The table has its original definition and all rows.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` varchar(32) DEFAULT NULL,
  PRIMARY KEY (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
COUNT(*)	SUM(a)	SUM(b)
2000	2001000	94950
SELECT COUNT(*), SUM(a), SUM(b) FROM t1 FORCE INDEX (kb) WHERE b >= 0;
COUNT(*)	SUM(a)	SUM(b)
2000	2001000	94950
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# MyRocks knows exactly the indexes of the server definition.
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	INDEX_TYPE
kb	2
PRIMARY	1
# A COPY ALTER leaves its #sql table in the MyRocks dictionary, as after
# a crash during COPY ALTER (reported at startup by the PS-11680 fix).
New leftover #sql tables: 1
# The table accepts DML and the DDL can be repeated.
INSERT INTO t1 VALUES (5000, 1, 'x');
UPDATE t1 SET b = b + 1 WHERE a <= 10;
DELETE FROM t1 WHERE a = 5000;
ALTER TABLE t1 ADD COLUMN d INT DEFAULT 7, ALGORITHM=COPY;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
COUNT(*)	SUM(a)	SUM(b)
2000	2001000	94960
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;

