CREATE TABLE t (pk INT PRIMARY KEY, c INT) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 2000;
INSERT INTO t WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 1000) SELECT n, n FROM v;
call mtr.add_suppression("Error retrieving index entry from primary key");
