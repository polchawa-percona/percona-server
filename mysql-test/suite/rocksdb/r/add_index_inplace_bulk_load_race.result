SET @saved_rocksdb_bulk_load = @@global.rocksdb_bulk_load;
SET GLOBAL rocksdb_bulk_load = 1;
# Establish connection con1 (user=root)
CREATE TABLE t1 (i INT, j INT, PRIMARY KEY (i)) ENGINE = ROCKSDB;
INSERT INTO t1 VALUES (1,1);
SET GLOBAL debug = '+d,rocksdb_bulk_load_pause_before_ingest';
SET DEBUG_SYNC = 'rocksdb.bulk_load_finished_before_ingest SIGNAL finished';
# Disconnecting on con1 finishes its bulk load
# Establish connection con2 (user=root)
SET DEBUG_SYNC = 'now WAIT_FOR finished';
SET DEBUG_SYNC = 'alter_table_inplace_before_commit SIGNAL populated';
ALTER TABLE t1 ADD INDEX kj(j), ALGORITHM=INPLACE;
SET DEBUG_SYNC = 'now WAIT_FOR populated TIMEOUT 10';
# Let the disconnecting thread ingest its bulk load
SET GLOBAL debug = '-d,rocksdb_bulk_load_pause_before_ingest';
# Wait until con1 is gone, its bulk load is ingested by then
# The new index must have an entry for every row
SELECT COUNT(*) FROM t1 FORCE INDEX(PRIMARY);
COUNT(*)
1
SELECT COUNT(*) FROM t1 FORCE INDEX(kj);
COUNT(*)
1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
SET DEBUG_SYNC = 'RESET';
SET GLOBAL rocksdb_bulk_load = @saved_rocksdb_bulk_load;
