CREATE DATABASE dump_db;
CREATE TABLE dump_db.t1 (a INT PRIMARY KEY, b INT, KEY(b)) ENGINE=ROCKSDB;
INSERT INTO dump_db.t1 VALUES (1, 2), (2, 1), (3, 4), (4, 3);
ANALYZE TABLE dump_db.t1;
Table	Op	Msg_type	Msg_text
dump_db.t1	analyze	status	OK
# The dump query scans the covering secondary key
EXPLAIN SELECT /*!40001 SQL_NO_CACHE */ * FROM dump_db.t1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	b	5	NULL	#	100.00	Using index
Warnings:
Warning	1681	'SQL_NO_CACHE' is deprecated and will be removed in a future release.
Note	1003	/* select#1 */ select `dump_db`.`t1`.`a` AS `a`,`dump_db`.`t1`.`b` AS `b` from `dump_db`.`t1`
# The dump writes the rows in this order
INSERT INTO `t1` VALUES (2,1);
INSERT INTO `t1` VALUES (1,2);
INSERT INTO `t1` VALUES (4,3);
INSERT INTO `t1` VALUES (3,4);
DROP DATABASE dump_db;
# The restore must succeed and restore every row
SELECT * FROM dump_db.t1 ORDER BY a;
a	b
1	2
2	1
3	4
4	3
SELECT COUNT(*) FROM dump_db.t1 FORCE INDEX(b);
COUNT(*)
4
CHECK TABLE dump_db.t1;
Table	Op	Msg_type	Msg_text
dump_db.t1	check	status	OK
DROP DATABASE IF EXISTS dump_db;
