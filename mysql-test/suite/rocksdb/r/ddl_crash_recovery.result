Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
INSERT INTO t1 VALUES (4,4,4);
SELECT * FROM t1;
id	a	b
4	4	4
DROP TABLE t1;
#
# 4. DROP TABLE: kill the server while the dropped indexes are still
#    being removed in the background. After the restart the drop resumes
#    and the data of the table goes away.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a), KEY kb(b)) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t1 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 10000)
SELECT n, n, n FROM s;
SET SESSION cte_max_recursion_depth = DEFAULT;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SELECT SUM(NUM_ROWS) > 0 AS has_keys FROM information_schema.ROCKSDB_INDEX_FILE_MAP WHERE INDEX_NUMBER IN (INDEX_NUMBERS);
has_keys
1
SET GLOBAL rocksdb_pause_background_work = 1;
DROP TABLE t1;
# Kill the server
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
# Server data dictionary:
SELECT TABLE_NAME, ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2');
TABLE_NAME	ENGINE
# MyRocks dictionary:
SELECT DISTINCT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
TABLE_NAME
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
SELECT COALESCE(SUM(NUM_ROWS), 0) AS keys_left FROM information_schema.ROCKSDB_INDEX_FILE_MAP WHERE INDEX_NUMBER IN (INDEX_NUMBERS);
keys_left
0
#
# 5. INSTANT ADD COLUMN: crash before the server DD commit. The ALTER is
#    rolled back: old definition, old rows.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1,1),(2,2,2),(3,3,3);
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
# Crash at crash_commit_after_prepare during: ALTER TABLE t1 ADD COLUMN c INT DEFAULT 7, ALGORITHM=INSTANT
ALTER TABLE t1 ADD COLUMN c INT DEFAULT 7, ALGORITHM=INSTANT;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
