#
# 9. CREATE TABLE ... SELECT: kill after the first rows are written,
#    before the statement commits. MyRocks has no atomic DDL, so (as for
#    every engine without it) the new table stays, empty, in both
#    dictionaries; InnoDB would have no table. Only consistency is checked.
#
CREATE TABLE t2 (id INT PRIMARY KEY, a INT) ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (1,1),(2,2),(3,3);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET DEBUG_SYNC = 'create_select_after_write_rows_event SIGNAL written WAIT_FOR never';
CREATE TABLE t1 ENGINE=ROCKSDB SELECT * FROM t2;
SET DEBUG_SYNC = 'now WAIT_FOR written';
# Kill the server
Got one of the listed errors
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
