SELECT 't2' AS table_name, COUNT(*) AS row_count FROM test.t2;
table_name	row_count
t2	3
CHECK TABLE test.t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
DROP TABLE t1, t2;
