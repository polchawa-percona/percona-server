#
# 1. CREATE TABLE: crash after the MyRocks dictionary commit.
#    The server DD is committed before the engine creates the table, so
#    both dictionaries have the table: it exists, empty and usable.
#
# Crash at rocksdb_crash_after_create_table during: CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
# Server data dictionary:
SELECT TABLE_NAME, ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2');
TABLE_NAME	ENGINE
t1	ROCKSDB
# MyRocks dictionary:
SELECT DISTINCT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
TABLE_NAME
t1
SELECT 't1' AS table_name, COUNT(*) AS row_count FROM test.t1;
table_name	row_count
t1	0
CHECK TABLE test.t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
INSERT INTO t1 VALUES (1,1,1),(2,2,2),(3,3,3);
SELECT id FROM t1 FORCE INDEX(ka) WHERE a > 1 ORDER BY id;
id
2
3
ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE;
DROP TABLE t1;
#
# 2. TRUNCATE TABLE: crash after the new table is committed, before the
#    old one (renamed to #truncate_tmp#t1) is dropped. Startup removes
#    the leftover, so t1 is empty and nothing else is left in MyRocks.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1,1),(2,2,2),(3,3,3);
# Crash at rocksdb_crash_after_create_table during: TRUNCATE TABLE t1
TRUNCATE TABLE t1;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
# Server data dictionary:
SELECT TABLE_NAME, ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2');
TABLE_NAME	ENGINE
t1	ROCKSDB
# MyRocks dictionary:
SELECT DISTINCT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
TABLE_NAME
t1
SELECT 't1' AS table_name, COUNT(*) AS row_count FROM test.t1;
table_name	row_count
t1	0
CHECK TABLE test.t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
include/assert_grep.inc [Startup removed the truncate leftover]
INSERT INTO t1 VALUES (4,4,4);
SELECT * FROM t1;
id	a	b
4	4	4
DROP TABLE t1;
#
# 3. TRUNCATE TABLE: crash after the old table is dropped from the
#    MyRocks dictionary. t1 is empty and consistent.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1,1),(2,2,2),(3,3,3);
# Crash at rocksdb_crash_after_delete_table during: TRUNCATE TABLE t1
TRUNCATE TABLE t1;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
# Server data dictionary:
SELECT TABLE_NAME, ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2');
TABLE_NAME	ENGINE
t1	ROCKSDB
# MyRocks dictionary:
SELECT DISTINCT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
TABLE_NAME
t1
