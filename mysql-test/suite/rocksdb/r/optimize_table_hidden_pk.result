# Table with a primary key.
CREATE TABLE t1 (id INT PRIMARY KEY, c INT) ENGINE=ROCKSDB;
INSERT INTO t1 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1
FROM s WHERE n < 500) SELECT n, n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DELETE FROM t1;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	status	OK
# SST entries (rows or delete markers) left; expect none.
SELECT d.index_name, d.index_type,
COALESCE(SUM(m.num_rows + m.entry_deletes + m.entry_singledeletes), 0)
AS sst_entries
FROM information_schema.rocksdb_ddl d
LEFT JOIN information_schema.rocksdb_index_file_map m
ON m.column_family = d.column_family AND m.index_number = d.index_number
WHERE d.table_schema = 'test' AND d.table_name = 't1'
    GROUP BY d.index_name, d.index_type;
index_name	index_type	sst_entries
PRIMARY	1	0
DROP TABLE t1;
# Table without a primary key.
CREATE TABLE t1 (id INT, c INT) ENGINE=ROCKSDB;
INSERT INTO t1 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1
FROM s WHERE n < 500) SELECT n, n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DELETE FROM t1;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	status	OK
# SST entries (rows or delete markers) left; expect none.
SELECT d.index_name, d.index_type,
COALESCE(SUM(m.num_rows + m.entry_deletes + m.entry_singledeletes), 0)
AS sst_entries
FROM information_schema.rocksdb_ddl d
LEFT JOIN information_schema.rocksdb_index_file_map m
ON m.column_family = d.column_family AND m.index_number = d.index_number
WHERE d.table_schema = 'test' AND d.table_name = 't1'
    GROUP BY d.index_name, d.index_type;
index_name	index_type	sst_entries
HIDDEN_PK_ID	3	0
DROP TABLE t1;
