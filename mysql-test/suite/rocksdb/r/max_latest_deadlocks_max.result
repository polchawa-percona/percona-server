SET @prior_max_latest_deadlocks = @@global.rocksdb_max_latest_deadlocks;
SET @prior_lock_wait_timeout = @@global.rocksdb_lock_wait_timeout;
SET @prior_deadlock_detect = @@global.rocksdb_deadlock_detect;
SET GLOBAL rocksdb_deadlock_detect = ON;
SET GLOBAL rocksdb_lock_wait_timeout = 10000;
SELECT 1 AS server_alive;
server_alive
1
CREATE TABLE t (i INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t VALUES (1), (2);
begin;
select * from t where i=1 for update;
i
1
begin;
select * from t where i=2 for update;
i
2
select * from t where i=2 for update;
select * from t where i=1 for update;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
rollback;
i
2
rollback;
SELECT COUNT(DISTINCT DEADLOCK_ID) > 0 AS deadlock_reported
FROM information_schema.ROCKSDB_DEADLOCK;
deadlock_reported
1
SET GLOBAL rocksdb_max_latest_deadlocks = @prior_max_latest_deadlocks;
SET GLOBAL rocksdb_lock_wait_timeout = @prior_lock_wait_timeout;
SET GLOBAL rocksdb_deadlock_detect = @prior_deadlock_detect;
DROP TABLE t;
