SELECT @@global.sync_binlog, @@global.innodb_flush_log_at_trx_commit,
@@global.rocksdb_flush_log_at_trx_commit;
@@global.sync_binlog	@@global.innodb_flush_log_at_trx_commit	@@global.rocksdb_flush_log_at_trx_commit
1	1	1
CREATE TABLE ti (id INT PRIMARY KEY, v VARCHAR(16)) ENGINE=InnoDB;
CREATE TABLE tr (id INT PRIMARY KEY, v VARCHAR(16)) ENGINE=ROCKSDB;
RESET BINARY LOGS AND GTIDS;
# Crash point: crash_commit_before
BEGIN;
INSERT INTO ti VALUES (1, 'innodb');
INSERT INTO tr VALUES (1, 'rocksdb');
SET SESSION debug = "+d,crash_commit_before";
COMMIT;
ERROR HY000: Lost connection to MySQL server during query
SELECT (SELECT COUNT(*) FROM ti WHERE id = 1) AS innodb_has_row, (SELECT COUNT(*) FROM tr WHERE id = 1) AS rocksdb_has_row, 0 AS expected;
innodb_has_row	rocksdb_has_row	expected
0	0	0
