CREATE TABLE t1 (a INT PRIMARY KEY, b INT,
UNIQUE KEY kb (b) COMMENT 'cfname=cf_ps11908_a') ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
SELECT INDEX_NAME, CF FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	CF
PRIMARY	default
kb	cf_ps11908_a
ALTER TABLE t1 DROP KEY kb, ADD KEY kb (b) COMMENT 'cfname=cf_ps11908_b';
SELECT INDEX_NAME, CF FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;
INDEX_NAME	CF
PRIMARY	default
kb	cf_ps11908_b
INSERT INTO t1 VALUES (4,2);
SELECT a, b FROM t1 FORCE INDEX (kb) ORDER BY b, a;
a	b
1	1
2	2
4	2
3	3
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
