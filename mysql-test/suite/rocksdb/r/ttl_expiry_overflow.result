CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB
COMMENT='ttl_duration=18446744073709551615;';
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
CREATE TABLE t2 (a INT PRIMARY KEY, ts BIGINT UNSIGNED NOT NULL) ENGINE=ROCKSDB
COMMENT='ttl_duration=1;ttl_col=ts;';
INSERT INTO t2 VALUES (1, 18446744073709551615), (2, 18446744073709551615);
# Read filtering on (default)
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
3
SELECT COUNT(*) FROM t1 FORCE INDEX (kb);
COUNT(*)
3
SELECT COUNT(*) FROM t2;
COUNT(*)
2
# Read filtering off, before compaction
SET @save_read_filtering = @@global.rocksdb_enable_ttl_read_filtering;
SET GLOBAL rocksdb_enable_ttl_read_filtering = 0;
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
3
SELECT COUNT(*) FROM t1 FORCE INDEX (kb);
COUNT(*)
3
SELECT COUNT(*) FROM t2;
COUNT(*)
2
# Read filtering off, after compaction
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
3
SELECT COUNT(*) FROM t1 FORCE INDEX (kb);
COUNT(*)
3
SELECT COUNT(*) FROM t2;
COUNT(*)
2
SET GLOBAL rocksdb_enable_ttl_read_filtering = @save_read_filtering;
DROP TABLE t1, t2;
