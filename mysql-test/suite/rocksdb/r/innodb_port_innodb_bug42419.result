SET @saved_deadlock_detect = @@global.rocksdb_deadlock_detect;
SET @saved_lock_wait_timeout = @@global.rocksdb_lock_wait_timeout;
SET GLOBAL rocksdb_deadlock_detect = ON;
SET GLOBAL rocksdb_lock_wait_timeout = 50;
CREATE TABLE t1 (a INT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
COMMIT;
SET AUTOCOMMIT = 0;
CREATE TEMPORARY TABLE t1_tmp ( b INT );
INSERT INTO t1_tmp (b) SELECT b FROM t1 WHERE a = 3 FOR SHARE;
INSERT INTO t1_tmp (b) SELECT b FROM t1 WHERE a = 2 FOR SHARE;
SET AUTOCOMMIT = 0;
CREATE TEMPORARY TABLE t2_tmp ( a int, new_a int );
INSERT INTO t2_tmp VALUES (1,51),(2,52),(3,53);
UPDATE t1 SET a = (SELECT new_a FROM t2_tmp WHERE t2_tmp.a = t1.a) WHERE a = 1;
UPDATE t1 SET a = (SELECT new_a FROM t2_tmp WHERE t2_tmp.a = t1.a) WHERE a = 2;
INSERT INTO t1_tmp (b) SELECT b FROM t1 WHERE a = 1 FOR SHARE;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
Reap the server message for connection user2 UPDATE t1 ...
UPDATE t1 SET a = (SELECT new_a FROM t2_tmp WHERE t2_tmp.a = t1.a) WHERE a = 3;
COMMIT;
SELECT * FROM t1 ORDER BY a;
a	b
51	1
52	2
53	3
DROP TABLE t1;
SET GLOBAL rocksdb_deadlock_detect = @saved_deadlock_detect;
SET GLOBAL rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
