# restart
#
# Window B with a partitioned table: one warning for the whole table.
#
ALTER TABLE t1 PARTITION BY HASH(id) PARTITIONS 3;
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
# Kill the server
# restart
include/assert.inc [Table data is unchanged after the interrupted ALTER]
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The partitioned leftover is reported once, with all its indexes]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
DROP TABLE t1;
#
# Window C1: crash after the original is renamed to "#sql2-...". MyRocks
# does not start with the default rocksdb_validate_tables=1 (finding 37,
# see alter_copy_crash_rename.test), so restart with =2 to see the
# warnings. "#sql2-..." has no DD table and holds the table before the
# ALTER. SQL cannot repair this state, so the data directory is restored
# from a copy afterwards.
#
# restart
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b');
SET SESSION debug='+d,rocksdb_crash_after_rename';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
ERROR HY000: Lost connection to MySQL server during query
# restart: --rocksdb_validate_tables=2
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
2
include/assert_grep.inc [The intermediate table of window C1 is reported as droppable]
include/assert_grep.inc [The original table of window C1 is reported as possibly the only copy]
# The intermediate table can be dropped, "#sql2-..." cannot.
DROP TABLE `test`.`#sql-LEFTOVER`;
DROP TABLE `test`.`#sql2-LEFTOVER`;
ERROR 42S02: Unknown table 'test.#sql2-LEFTOVER'
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
# restart
#
# Window C2: crash after the intermediate table gets the original name.
# Here "#sql2-..." has a hidden DD table, so the hint has the DROP
# statement, with a caution.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b');
SET SESSION debug='+d,rocksdb_crash_after_rename_from_tmp';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
ERROR HY000: Lost connection to MySQL server during query
# restart: --rocksdb_validate_tables=2
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The original table of window C2 is reported with a cautious DROP hint]
DROP TABLE `test`.`#sql2-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
# restart
SELECT COUNT(*) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
COUNT(*)
0
