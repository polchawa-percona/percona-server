include/assert.inc [Table data is unchanged after the interrupted ALTER]
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The leftover is reported once at startup]
include/assert_grep.inc [The leftover is not a validation mismatch]
include/assert_grep.inc [Validation reports no problem]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
