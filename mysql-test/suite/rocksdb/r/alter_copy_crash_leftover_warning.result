call mtr.add_suppression("is a leftover of an interrupted ALTER TABLE");
call mtr.add_suppression("Schema mismatch - A DD table exists for table test.t1");
call mtr.add_suppression("Attempt to open a table that is not present in RocksDB-SE");
call mtr.add_suppression("Schema mismatch - Table test.t1 is registered in RocksDB but does not have a corresponding DD table");
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
ENGINE=ROCKSDB;
#
# Window B: crash after the copy commits, before the renames.
#
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
# Kill the server
# restart
# The table is the old version, data unchanged.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ka` (`a`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
include/assert.inc [Table data is unchanged after the interrupted ALTER]
# The intermediate table is left in the MyRocks dictionary only.
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
# It is reported at startup, with the statement that drops it.
include/assert_grep.inc [The leftover of window B is reported once at startup]
# It can be dropped, and is no longer reported after a restart.
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
# restart
include/assert_grep.inc [The dropped leftover is not reported again]
# The ALTER can be retried.
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SELECT COUNT(*), SUM(id), COUNT(c) FROM t1;
COUNT(*)	SUM(id)	COUNT(c)
1000	500500	0
ALTER TABLE t1 DROP COLUMN c, ALGORITHM=COPY;
#
# Window A: crash during the row copy. The intermediate table is empty.
#
SET SESSION debug='+d,crash_copy_before_commit';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
ERROR HY000: Lost connection to MySQL server during query
# restart
include/assert.inc [Table data is unchanged after the interrupted ALTER]
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The leftover of window A is reported once at startup]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
#
# Window B with each rocksdb_validate_tables value: the leftover is
# reported in every mode, never as a validation mismatch, and the
# server starts.
#
# rocksdb_validate_tables=0
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
# Kill the server
# restart: --rocksdb_validate_tables=0
SELECT @@global.rocksdb_validate_tables;
@@global.rocksdb_validate_tables
0
include/assert.inc [Table data is unchanged after the interrupted ALTER]
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The leftover is reported once at startup]
include/assert_grep.inc [The leftover is not a validation mismatch]
include/assert_grep.inc [Validation reports no problem]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
# rocksdb_validate_tables=1
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
# Kill the server
# restart: --rocksdb_validate_tables=1
SELECT @@global.rocksdb_validate_tables;
@@global.rocksdb_validate_tables
1
include/assert.inc [Table data is unchanged after the interrupted ALTER]
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
1
include/assert_grep.inc [The leftover is reported once at startup]
include/assert_grep.inc [The leftover is not a validation mismatch]
include/assert_grep.inc [Validation reports no problem]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
COUNT(DISTINCT TABLE_NAME)
0
# rocksdb_validate_tables=2
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
