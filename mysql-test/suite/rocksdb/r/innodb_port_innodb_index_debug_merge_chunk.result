CREATE TABLE t1 (id INT PRIMARY KEY, b CHAR(200) NOT NULL) ENGINE=ROCKSDB CHARSET latin1;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t1 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 2000) SELECT n, REPEAT('x', 1 + n % 100) FROM v;
SET @saved_merge_buf_size = @@session.rocksdb_merge_buf_size;
SET @saved_merge_combine_read_size = @@session.rocksdb_merge_combine_read_size;
SET SESSION rocksdb_merge_buf_size = 4096;
SET SESSION rocksdb_merge_combine_read_size = 4096;
ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE;
SET SESSION rocksdb_merge_buf_size = @saved_merge_buf_size;
SET SESSION rocksdb_merge_combine_read_size = @saved_merge_combine_read_size;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `b` char(200) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=latin1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# t1.kb matches the table: 1
DROP TABLE t1;
