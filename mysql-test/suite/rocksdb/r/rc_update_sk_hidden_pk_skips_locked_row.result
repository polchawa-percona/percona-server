CREATE TABLE t1 (a INT, b INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
SET SESSION transaction_isolation = 'READ-COMMITTED';
BEGIN;
SELECT * FROM t1 WHERE b = 2 FOR UPDATE;
a	b
2	2
SET SESSION transaction_isolation = 'READ-COMMITTED';
SET SESSION rocksdb_lock_wait_timeout = 1;
# Point UPDATE of the locked row through the secondary key
UPDATE t1 FORCE INDEX (ka) SET b = b + 1000 WHERE a = 2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# UPDATE of the locked row and an unlocked row through the secondary key
UPDATE t1 FORCE INDEX (ka) SET b = b + 1000 WHERE a IN (2, 3);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
COMMIT;
SELECT * FROM t1 ORDER BY a;
a	b
1	1
2	2
3	3
DROP TABLE t1;
