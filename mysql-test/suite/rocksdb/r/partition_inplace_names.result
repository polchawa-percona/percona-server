#
# In-place ADD/DROP PARTITION (rocksdb_allow_unsafe_alter=ON) must name
# partitions the same way as CREATE TABLE and table open do, and must
# reject names that do not fit into the internal name buffer.
#
SELECT @@rocksdb_allow_unsafe_alter;
@@rocksdb_allow_unsafe_alter
1
SET NAMES utf8mb4;
# Non-ASCII partition names.
CREATE TABLE t1 (i INT) ENGINE=ROCKSDB
PARTITION BY LIST(i) (PARTITION p中 VALUES IN (1));
ALTER TABLE t1 ADD PARTITION (PARTITION q中 VALUES IN (2));
INSERT INTO t1 VALUES (1), (2);
SELECT * FROM t1 PARTITION (q中);
i
2
# restart
SET NAMES utf8mb4;
SELECT * FROM t1 ORDER BY i;
i
1
2
SELECT * FROM t1 PARTITION (q中);
i
2
ALTER TABLE t1 DROP PARTITION q中;
SELECT * FROM t1 ORDER BY i;
i
1
# Only the remaining partition is left in the MyRocks dictionary.
SELECT COUNT(DISTINCT PARTITION_NAME) FROM INFORMATION_SCHEMA.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
COUNT(DISTINCT PARTITION_NAME)
1
# Subpartitioned table: adding a partition whose subpartition names do
# not fit is rejected and leaves the table intact.
CREATE TABLE t2 (i INT) ENGINE=ROCKSDB
PARTITION BY LIST(MOD(i, 2)) SUBPARTITION BY HASH(i)
(PARTITION p0 VALUES IN (0) (SUBPARTITION sp0, SUBPARTITION sp1));
INSERT INTO t2 VALUES (0), (2);
ALTER TABLE t2 ADD PARTITION
(PARTITION 中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中 VALUES IN (1) (SUBPARTITION 中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中s, SUBPARTITION sp3));
ERROR HY000: The path specified for PATH is too long.
SELECT COUNT(*) FROM t2;
COUNT(*)
2
INSERT INTO t2 VALUES (4);
SELECT COUNT(*) FROM t2;
COUNT(*)
3
DROP TABLE t1, t2;
