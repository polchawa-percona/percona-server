#
# Instant DDL for appended columns OFF (default)
#
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = OFF;
# Scenario 1: table with 0 rows
CREATE TABLE t1 (c1 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN c2 INT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c3 INT, ALGORITHM=DEFAULT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c4 INT, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD COLUMN c5 INT, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` int DEFAULT NULL,
  `c2` int DEFAULT NULL,
  `c3` int DEFAULT NULL
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
# Scenario 2: table with rows
CREATE TABLE t1 (c1 INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1), (2);
ALTER TABLE t1 ADD COLUMN c2 INT;
affected rows: 2
info: Records: 2  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c3 INT DEFAULT 3, ALGORITHM=DEFAULT;
affected rows: 2
info: Records: 2  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c4 INT DEFAULT 4, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD COLUMN c5 INT, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
1	NULL	3
2	NULL	3
INSERT INTO t1 (c1) VALUES (3);
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
1	NULL	3
2	NULL	3
3	NULL	3
# DROP COLUMN
ALTER TABLE t1 DROP COLUMN c2, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 DROP COLUMN c2, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
ALTER TABLE t1 DROP COLUMN c2;
affected rows: 3
info: Records: 3  Duplicates: 0  Warnings: 0
SELECT * FROM t1 ORDER BY c1;
c1	c3
1	3
2	3
3	3
DROP TABLE t1;
# Scenario 3: a deleted row still visible to an open snapshot
# (t1 has no nullable column, so adding a nullable one changes the
# size of the MyRocks null-bit header: MyRocks then always copies,
# see rocksdb_support_instant())
# (the snapshot is taken through another table, so that it holds no
# metadata lock on t1 and the ALTER can run)
CREATE TABLE t0 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t1 (c1 INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1), (2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT * FROM t0;
a
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT DEFAULT 7;
affected rows: 1
info: Records: 1  Duplicates: 0  Warnings: 0
SELECT * FROM t1;
c1	c2
2	7
# The snapshot is older than the ALTER. For a COPY rebuild it gets
# ER_TABLE_DEF_CHANGED once PS-11627 is merged (an empty table
# before); for an instant change it sees the deleted row with the
# new column (PS-11657). Not recorded here: covered by those tests.
SELECT * FROM t1;
COMMIT;
SELECT * FROM t1;
c1	c2
2	7
DROP TABLE t0, t1;
#
# Instant DDL for appended columns ON
#
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
# Scenario 1: table with 0 rows
CREATE TABLE t1 (c1 INT) ENGINE=ROCKSDB;
ALTER TABLE t1 ADD COLUMN c2 INT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c3 INT, ALGORITHM=DEFAULT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c4 INT, ALGORITHM=INSTANT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c5 INT, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` int DEFAULT NULL,
  `c2` int DEFAULT NULL,
  `c3` int DEFAULT NULL,
  `c4` int DEFAULT NULL
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
# Scenario 2: table with rows
CREATE TABLE t1 (c1 INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1), (2);
ALTER TABLE t1 ADD COLUMN c2 INT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c3 INT DEFAULT 3, ALGORITHM=DEFAULT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c4 INT DEFAULT 4, ALGORITHM=INSTANT;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
ALTER TABLE t1 ADD COLUMN c5 INT, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3	c4
1	NULL	3	4
2	NULL	3	4
INSERT INTO t1 (c1) VALUES (3);
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3	c4
1	NULL	3	4
2	NULL	3	4
3	NULL	3	4
# DROP COLUMN
ALTER TABLE t1 DROP COLUMN c2, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 DROP COLUMN c2, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
ALTER TABLE t1 DROP COLUMN c2;
affected rows: 3
info: Records: 3  Duplicates: 0  Warnings: 0
SELECT * FROM t1 ORDER BY c1;
c1	c3	c4
1	3	4
2	3	4
3	3	4
DROP TABLE t1;
# Scenario 3: a deleted row still visible to an open snapshot
# (t1 has no nullable column, so adding a nullable one changes the
# size of the MyRocks null-bit header: MyRocks then always copies,
# see rocksdb_support_instant())
# (the snapshot is taken through another table, so that it holds no
# metadata lock on t1 and the ALTER can run)
CREATE TABLE t0 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t1 (c1 INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1), (2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT * FROM t0;
a
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT DEFAULT 7;
affected rows: 1
info: Records: 1  Duplicates: 0  Warnings: 0
SELECT * FROM t1;
c1	c2
2	7
# The snapshot is older than the ALTER. For a COPY rebuild it gets
# ER_TABLE_DEF_CHANGED once PS-11627 is merged (an empty table
# before); for an instant change it sees the deleted row with the
# new column (PS-11657). Not recorded here: covered by those tests.
SELECT * FROM t1;
COMMIT;
SELECT * FROM t1;
c1	c2
2	7
DROP TABLE t0, t1;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = 0;
