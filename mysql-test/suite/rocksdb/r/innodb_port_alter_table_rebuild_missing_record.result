############################################################
# Test#5 Bug#37318367 Delete a range of records in the middle
# of a larger table
############################################################
CREATE TABLE t1 (id int AUTO_INCREMENT NOT NULL, c INT, PRIMARY KEY(id)) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t1 (id) WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 2000) SELECT 0 FROM v;
UPDATE t1 SET c = id % 97;
# Rebuild by ALGORITHM=COPY.
connection con2;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
connection default;
DELETE FROM t1 WHERE id > 2 AND id < 7 OR id BETWEEN 500 AND 1499;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
connection con1;
SET DEBUG_SYNC='copy_data_between_tables_before SIGNAL paused WAIT_FOR go';
# Send ALTER TABLE t1 ENGINE=ROCKSDB
ALTER TABLE t1 ENGINE=ROCKSDB;
connection default;
SET DEBUG_SYNC='now WAIT_FOR paused';
connection con2;
COMMIT;
connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';
SET DEBUG_SYNC='now SIGNAL go';
connection con1;
# Reap ALTER TABLE
connection default;
SET DEBUG_SYNC='RESET';
# Row count unchanged by the rebuild: 996
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# Online index build (ALGORITHM=INPLACE).
connection con2;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
connection default;
DELETE FROM t1 WHERE id BETWEEN 1500 AND 1899;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
connection con1;
SET DEBUG_SYNC='alter_table_inplace_after_lock_downgrade SIGNAL paused WAIT_FOR go';
# Send ALTER TABLE t1 ADD INDEX k_c (c), ALGORITHM=INPLACE
ALTER TABLE t1 ADD INDEX k_c (c), ALGORITHM=INPLACE;
connection default;
SET DEBUG_SYNC='now WAIT_FOR paused';
connection con2;
COMMIT;
connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';
SET DEBUG_SYNC='now SIGNAL go';
connection con1;
# Reap ALTER TABLE
connection default;
SET DEBUG_SYNC='RESET';
# Row count unchanged by the rebuild: 596
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# t1.k_c matches the table: 1
SELECT COUNT(*), MIN(id), MAX(id), SUM(c) FROM t1;
COUNT(*)	MIN(id)	MAX(id)	SUM(c)
596	1	2000	28257
# Test cleanup.
DROP TABLE t1;
#
# Cleanup.
connection default;
DROP PROCEDURE test.insert_records;
disconnect con1;
disconnect con2;
