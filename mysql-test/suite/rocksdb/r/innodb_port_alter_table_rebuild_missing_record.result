connect  con1, localhost, root,,;
connect  con2, localhost, root,,;
CREATE PROCEDURE test.insert_records (IN record_count INT)
BEGIN
DECLARE counter INT DEFAULT 1;
WHILE counter <= record_count DO
INSERT INTO test.t1 (id) VALUES (0);
SET counter = counter + 1;
END WHILE;
END //
##############################################################
# Bug#36846567 Inplace ALTER TABLE might cause lost rows if concurrent purge
##############################################################

connection default;
CREATE TABLE t1 (pk CHAR(5) PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES ('aaaaa'), ('bbbbb'), ('bbbcc'), ('ccccc'), ('ddddd'), ('eeeee');
ALTER TABLE t1 ENGINE=ROCKSDB, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY.
connection con2;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
connection default;
DELETE FROM t1 WHERE pk = 'bbbcc';
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
connection con1;
SET DEBUG_SYNC='copy_data_between_tables_before SIGNAL paused WAIT_FOR go';
# Send ALTER TABLE t1 ENGINE=ROCKSDB
ALTER TABLE t1 ENGINE=ROCKSDB;
connection default;
SET DEBUG_SYNC='now WAIT_FOR paused';
connection con2;
COMMIT;
connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';
SET DEBUG_SYNC='now SIGNAL go';
connection con1;
# Reap ALTER TABLE
connection default;
SET DEBUG_SYNC='RESET';
# Row count unchanged by the rebuild: 5
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# Before the fix row 'ddddd' was missing from the table after ALTER.
SELECT * FROM t1;
pk
aaaaa
bbbbb
ccccc
ddddd
eeeee
# Test cleanup
DROP TABLE t1;
