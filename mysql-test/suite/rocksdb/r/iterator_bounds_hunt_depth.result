create table t_d(
a int,
b tinyint,
c tinyint,
d bigint,
primary key(a), key idx_bcd(b, c, d)
) engine=rocksdb;
create table t_di(
a int,
b tinyint,
c tinyint,
d bigint,
primary key(a), key idx_bcd(b, c, d)
) engine=innodb;
insert into t_d values(1,2,1,1),(2,1,3,3),(3,1,3,4),(4,2,1,5),(5,2,2,6);
insert into t_di values(1,2,1,1),(2,1,3,3),(3,1,3,4),(4,2,1,5),(5,2,2,6);
set global rocksdb_force_flush_memtable_now = 1;
analyze table t_d;
