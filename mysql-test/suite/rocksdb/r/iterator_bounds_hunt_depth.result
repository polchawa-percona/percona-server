test.t_d	analyze	status	OK
analyze table t_di;
Table	Op	Msg_type	Msg_text
test.t_di	analyze	status	OK
set session rocksdb_perf_context_level = 2;
explain select a from t_d force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2 order by a;
