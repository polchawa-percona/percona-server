CALL mtr.add_suppression("Attempting backtrace");
CREATE TABLE t1 (id INT PRIMARY KEY, v INT, KEY k_v (v)) ENGINE=ROCKSDB;
#
# 0. The crash fires before the counted write: an autocommit INSERT
#    aborted at its first durable write (the prepare of the two-phase
#    commit with the binary log) is not recovered.
#
INSERT INTO t1 VALUES (1, 1);
SET SESSION rocksdb_debug_crash_on_nth_durable_write = 1;
INSERT INTO t1 VALUES (2, 2);
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT * FROM t1;
id	v
1	1
# The crash fired at tx_prepare
# Without the binary log there is no prepare: with
# rocksdb_flush_log_at_trx_commit=1 the first commit is synced and
# kept, the second one is aborted at its tx_commit site, before the
# write, so it is not recovered although it would have been synced.
SET SESSION sql_log_bin = 0;
SET SESSION rocksdb_debug_crash_on_nth_durable_write = 2;
INSERT INTO t1 VALUES (3, 3);
INSERT INTO t1 VALUES (4, 4);
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT * FROM t1;
id	v
1	1
3	3
# The second crash fired at tx_commit
DELETE FROM t1;
#
# 1. rocksdb_flush_log_at_trx_commit=1: every commit is synced and
#    survives.
#
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS cnt, MIN(id) AS min_id, MAX(id) AS max_id, (SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v >= 0) AS cnt_sk FROM t1;
cnt	min_id	max_id	cnt_sk
150	1	150	150
#
# 2. For comparison, a plain abort without the unsynced data loss
#    loses nothing with rocksdb_flush_log_at_trx_commit=2, even with
#    no background sync: the writes already reached the OS.
#
# restart: --rocksdb_debug_unsynced_data_loss=OFF
SELECT @@global.rocksdb_debug_unsynced_data_loss;
@@global.rocksdb_debug_unsynced_data_loss
0
SET GLOBAL debug = '+d,rocksdb_skip_background_wal_sync';
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT @@global.rocksdb_debug_unsynced_data_loss;
@@global.rocksdb_debug_unsynced_data_loss
1
SELECT COUNT(*) AS cnt, MIN(id) AS min_id, MAX(id) AS max_id, (SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v >= 0) AS cnt_sk FROM t1;
cnt	min_id	max_id	cnt_sk
200	1	200	200
#
# 3. rocksdb_flush_log_at_trx_commit=2 and 0 with the background sync
#    held back: the unsynced commits are lost on power loss, the synced
#    ones are kept.
#
# rocksdb_flush_log_at_trx_commit = 2
SET GLOBAL debug = '+d,rocksdb_skip_background_wal_sync';
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS cnt, MIN(id) AS min_id, MAX(id) AS max_id, (SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v >= 0) AS cnt_sk FROM t1;
cnt	min_id	max_id	cnt_sk
200	1	200	200
# rocksdb_flush_log_at_trx_commit = 0
SET GLOBAL debug = '+d,rocksdb_skip_background_wal_sync';
SET GLOBAL rocksdb_flush_log_at_trx_commit = 0;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS cnt, MIN(id) AS min_id, MAX(id) AS max_id, (SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v >= 0) AS cnt_sk FROM t1;
cnt	min_id	max_id	cnt_sk
200	1	200	200
#
# 4. rocksdb_write_disable_wal=ON: rows that were only in the memtable
#    are lost, rows flushed to an SST file are kept. The binary log is
#    off for the session: with it every commit is a two-phase commit
#    and its prepare is always written to the WAL (RocksDB's
#    WriteCommittedTxn::PrepareInternal clears disableWAL), so the
#    rows would be kept or lost with the unsynced WAL, not with the
#    memtable.
#
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
SET SESSION sql_log_bin = 0;
SET SESSION rocksdb_write_disable_wal = ON;
INSERT INTO t1 VALUES (5001, 1), (5002, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
INSERT INTO t1 VALUES (5003, 3), (5004, 4);
SET SESSION rocksdb_write_disable_wal = OFF;
SET SESSION sql_log_bin = 1;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT id FROM t1 WHERE id > 5000 ORDER BY id;
id
5001
5002
#
# 5. A clean restart keeps commits made with
#    rocksdb_flush_log_at_trx_commit=2 although they were never synced
#    while the server ran.
#
SET GLOBAL debug = '+d,rocksdb_skip_background_wal_sync';
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
INSERT INTO t1 VALUES (6001, 1), (6002, 2);
# restart
SELECT id FROM t1 WHERE id > 6000 ORDER BY id;
id
6001
6002
#
# 6. rocksdb_flush_log_at_trx_commit=2 with the background sync running:
#    whatever is lost must be the most recent commits, and a
#    multi-statement transaction is kept whole or lost whole. The
#    server must also start with rocksdb_wal_recovery_mode=1 (absolute
#    consistency).
#
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
ERROR HY000: Lost connection to MySQL server during query
# restart: --rocksdb_wal_recovery_mode=1
SELECT COUNT(*) = IFNULL(MAX(id) - 10000, 0) AS prefix_kept
FROM t1 WHERE id BETWEEN 10001 AND 19999;
prefix_kept
1
SELECT @trx IN (0, 40) AS trx_whole,
(@last < 151 OR @trx = 40) AND (@trx = 0 OR @last >= 150) AS trx_in_order;
trx_whole	trx_in_order
1	1
SELECT (SELECT COUNT(*) FROM t1) = (SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v >= 0) AS sk_matches_pk;
sk_matches_pk
1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
#
# Reach: every crash was fired by the hook (8 crashes: sections 0 (2),
# 1, 2, 3 (2), 4 and 6) and the unsynced data was dropped in all of
# them except the plain abort of section 2.
#
# reach: the expected crashes were fired by the hook, with the expected unsynced data drops
DROP TABLE t1;
