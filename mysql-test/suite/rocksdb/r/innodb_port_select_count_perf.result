info: Records: 10  Duplicates: 0  Warnings: 0
CREATE TABLE t3 (
c1 INT AUTO_INCREMENT PRIMARY KEY,
c2 INT,
c3 INT,
c4 INT,
INDEX k2(c2)
) ENGINE=ROCKSDB PARTITION BY HASH(c1) PARTITIONS 4;
