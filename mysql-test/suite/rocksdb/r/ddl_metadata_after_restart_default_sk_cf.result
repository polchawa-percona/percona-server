  PRIMARY KEY (`a`),
  KEY `kb` (`b`)
) ENGINE=ROCKSDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='ttl_duration=360000;'
