#########
# Begin upgrade testing with mysql_upgrade
###
# Copy the remote tablespace & DB zip files from suite location to working location.
# Check that the file exists in the working folder.
# Stop DB server which was created by MTR default
# Unzip the zip file.
# Remove copied files
# restart
#########
# Performing test specific validation
###
SET SESSION time_zone = '+00:00';
SET SESSION transaction_isolation = 'READ-COMMITTED';
# MyRocks dictionary after the upgrade.
SELECT table_name, partition_name, index_number, cf, index_type,
kv_format_version, ttl_duration, index_flags
FROM information_schema.rocksdb_ddl
WHERE table_schema = 'upg'
 ORDER BY index_number;
