#
# autoinc_debug: two parallel inserts with auto_increment_increment=2,
# right after a restart.
#
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY) ENGINE=ROCKSDB;
SET AUTO_INCREMENT_INCREMENT = 1;
INSERT INTO t1 VALUES(NULL);
SELECT * FROM t1;
id
1
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=ROCKSDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# restart
SET AUTO_INCREMENT_INCREMENT = 2;
SET DEBUG_SYNC= 'rocksdb.after_unique_pk_check SIGNAL opened WAIT_FOR flushed1';
INSERT INTO t1 VALUES(NULL);
SET AUTO_INCREMENT_INCREMENT = 2;
SET DEBUG_SYNC= 'now WAIT_FOR opened';
# con1 is not blocked by the paused insert and gets the next value.
INSERT INTO t1 VALUES(NULL);
SET DEBUG_SYNC= 'now SIGNAL flushed1';
SELECT * FROM t1;
id
1
3
5
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=ROCKSDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES(NULL);
SELECT * FROM t1;
id
1
3
5
7
SET AUTO_INCREMENT_INCREMENT = 1;
SET DEBUG_SYNC= 'RESET';
DROP TABLE t1;
#
# Bug #21983865 UNEXPECTED DEADLOCK WITH INNODB_AUTOINC_LOCK_MODE=0
#
create table t1(f1 int not null auto_increment primary key) engine=rocksdb;
# con1 pauses after its value is assigned
set debug_sync='rocksdb.after_unique_pk_check SIGNAL others WAIT_FOR continue_others';
insert into t1 values(NULL);
# 39 more connections insert while con1 is paused; none of them waits.
SELECT COUNT(*), COUNT(DISTINCT f1), MIN(f1), MAX(f1) FROM t1;
COUNT(*)	COUNT(DISTINCT f1)	MIN(f1)	MAX(f1)
39	39	2	40
# Release con1
set debug_sync='now SIGNAL continue_others';
SELECT COUNT(*), COUNT(DISTINCT f1), MIN(f1), MAX(f1) FROM t1;
COUNT(*)	COUNT(DISTINCT f1)	MIN(f1)	MAX(f1)
40	40	1	40
insert into t1 values(NULL);
SELECT MAX(f1) FROM t1;
MAX(f1)
41
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `f1` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`f1`)
) ENGINE=ROCKSDB AUTO_INCREMENT=42 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET DEBUG_SYNC= 'RESET';
drop table t1;
