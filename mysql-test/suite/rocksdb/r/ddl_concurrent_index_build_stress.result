SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE t1 (pk INT PRIMARY KEY, a INT NOT NULL, b VARCHAR(32) NOT NULL) ENGINE=ROCKSDB;
CREATE TABLE t2 LIKE t1;
CREATE TABLE t3 (pk INT, a INT NOT NULL, b VARCHAR(32) NOT NULL, PRIMARY KEY(pk) COMMENT 'cfname=cc3a') ENGINE=ROCKSDB;
CREATE TABLE t4 LIKE t3;
CREATE TABLE w (pk INT PRIMARY KEY, a INT NOT NULL, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 5000)
SELECT n, (n * 7) % 1000, CONCAT('v', n) FROM v;
INSERT INTO t2 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 5000)
SELECT n, (n * 7) % 1000, CONCAT('v', n) FROM v;
INSERT INTO t3 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 5000)
SELECT n, (n * 7) % 1000, CONCAT('v', n) FROM v;
INSERT INTO t4 WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 5000)
SELECT n, (n * 7) % 1000, CONCAT('v', n) FROM v;
INSERT INTO w WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 5000) SELECT n, n FROM v;
CREATE PROCEDURE wdml(n INT)
BEGIN
DECLARE i INT DEFAULT 0;
WHILE i < n DO
UPDATE w SET a = a + 1 WHERE pk = 1 + (i * 37) % 5000;
DELETE FROM w WHERE pk = 1 + (i * 53) % 5000;
INSERT INTO w VALUES (1 + (i * 53) % 5000, i) ON DUPLICATE KEY UPDATE a = i;
SET i = i + 1;
END WHILE;
END|
ALTER TABLE t1 ADD INDEX ka(a) , ADD UNIQUE INDEX ub(b) , ALGORITHM=INPLACE;
ALTER TABLE t2 ADD INDEX ka(a) , ADD UNIQUE INDEX ub(b) , ALGORITHM=INPLACE;
ALTER TABLE t3 ADD INDEX ka(a) COMMENT 'cfname=cc3a', ADD UNIQUE INDEX ub(b) COMMENT 'cfname=cc3a', ALGORITHM=INPLACE;
ALTER TABLE t4 ADD INDEX ka(a) COMMENT 'cfname=cc3a', ADD UNIQUE INDEX ub(b) COMMENT 'cfname=cc3a', ALGORITHM=INPLACE;
CALL wdml(300);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';
ALTER TABLE t1 DROP INDEX ka, DROP INDEX ub, ALGORITHM=INPLACE;
ALTER TABLE t2 DROP INDEX ka, DROP INDEX ub, ALGORITHM=INPLACE;
