CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = ON;
SET SESSION debug = "+d,rocksdb_delete_range_failure";
TRUNCATE TABLE t1;
SET SESSION debug = "-d,rocksdb_delete_range_failure";
SET GLOBAL rocksdb_enable_delete_range_for_drop_index = DEFAULT;
# The old table is left behind under its temporary name.
SELECT COUNT(DISTINCT TABLE_NAME) AS leftovers FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#truncate_tmp#%';
leftovers
1
INSERT INTO t1 VALUES (10,10);
RENAME TABLE t1 TO t2;
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
SELECT (SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2')) = (SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1','t2')) AS dictionaries_agree;
dictionaries_agree
1
SELECT COUNT(*) AS leftovers FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#truncate_tmp#%';
leftovers
0
SELECT DISTINCT TABLE_NAME FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1', 't2');
TABLE_NAME
t2
SELECT * FROM t2;
id	a
10	10
DROP TABLE t2;
