CREATE DATABASE db_inn;
CREATE DATABASE db_my;
CREATE TABLE db_inn.t (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
k  INT NOT NULL,
v  INT NOT NULL,
UNIQUE KEY uq (k)
) ENGINE=InnoDB;
CREATE TABLE db_my.t (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
k  INT NOT NULL,
v  INT NOT NULL,
UNIQUE KEY uq (k)
) ENGINE=RocksDB;
CREATE TABLE db_inn.aux (id INT, note VARCHAR(32)) ENGINE=InnoDB;
CREATE TABLE db_my.aux  (id INT, note VARCHAR(32)) ENGINE=RocksDB;
INSERT INTO db_inn.t (k, v) VALUES (10,1),(20,2) ON DUPLICATE KEY UPDATE v = v;
SET @ar_inn = ROW_COUNT();
SET @lii_inn = LAST_INSERT_ID();
INSERT INTO db_my.t  (k, v) VALUES (10,1),(20,2) ON DUPLICATE KEY UPDATE v = v;
SET @ar_my = ROW_COUNT();
SET @lii_my = LAST_INSERT_ID();
SELECT @ar_inn = @ar_my AS same_affected_rows;
same_affected_rows
1
SELECT @lii_inn = @lii_my AS same_last_insert_id;
same_last_insert_id
1
SELECT id, k, v FROM db_inn.t ORDER BY id;
id	k	v
1	10	1
2	20	2
SELECT id, k, v FROM db_my.t  ORDER BY id;
id	k	v
1	10	1
2	20	2
SELECT (
(SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;
eq
1
INSERT INTO db_inn.t (k, v) VALUES (30,3);
INSERT INTO db_my.t  (k, v) VALUES (30,3);
SELECT id AS inn_next_id FROM db_inn.t WHERE k = 30;
inn_next_id
3
SELECT id AS my_next_id  FROM db_my.t  WHERE k = 30;
my_next_id
3
INSERT INTO db_inn.t (id, k, v) VALUES (1, 10, 100)
ON DUPLICATE KEY UPDATE v = LAST_INSERT_ID(55);
SET @ar_inn = ROW_COUNT();
SET @lii_inn = LAST_INSERT_ID();
SHOW WARNINGS;
Level	Code	Message
INSERT INTO db_my.t  (id, k, v) VALUES (1, 10, 100)
ON DUPLICATE KEY UPDATE v = LAST_INSERT_ID(55);
SET @ar_my = ROW_COUNT();
SET @lii_my = LAST_INSERT_ID();
SHOW WARNINGS;
Level	Code	Message
SELECT @ar_inn = @ar_my AS same_affected_rows;
same_affected_rows
1
SELECT @lii_inn = @lii_my AS same_last_insert_id;
same_last_insert_id
1
SELECT id, k, v FROM db_inn.t ORDER BY id;
id	k	v
1	10	55
2	20	2
3	30	3
SELECT id, k, v FROM db_my.t  ORDER BY id;
id	k	v
1	10	55
2	20	2
3	30	3
INSERT INTO db_inn.t (k, v) VALUES (40,4);
INSERT INTO db_my.t  (k, v) VALUES (40,4);
SELECT id AS inn_next_id FROM db_inn.t WHERE k = 40;
inn_next_id
4
SELECT id AS my_next_id  FROM db_my.t  WHERE k = 40;
my_next_id
4
CREATE TRIGGER db_inn.bu3 BEFORE UPDATE ON db_inn.t FOR EACH ROW
BEGIN
SET @lii_bu_inn = LAST_INSERT_ID();
INSERT INTO db_inn.aux VALUES (NEW.id, 'bu');
END//
CREATE TRIGGER db_my.bu3 BEFORE UPDATE ON db_my.t FOR EACH ROW
BEGIN
SET @lii_bu_my = LAST_INSERT_ID();
INSERT INTO db_my.aux  VALUES (NEW.id, 'bu');
END//
INSERT INTO db_inn.t (id, k, v) VALUES (2, 20, 200)
ON DUPLICATE KEY UPDATE v = LAST_INSERT_ID(77);
SET @ar_inn = ROW_COUNT();
SET @lii_inn = LAST_INSERT_ID();
SHOW WARNINGS;
Level	Code	Message
INSERT INTO db_my.t  (id, k, v) VALUES (2, 20, 200)
ON DUPLICATE KEY UPDATE v = LAST_INSERT_ID(77);
SET @ar_my = ROW_COUNT();
SET @lii_my = LAST_INSERT_ID();
SHOW WARNINGS;
Level	Code	Message
SELECT @ar_inn = @ar_my AS same_affected_rows;
same_affected_rows
1
SELECT @lii_inn = @lii_my AS same_last_insert_id;
same_last_insert_id
1
SELECT @lii_bu_inn = @lii_bu_my AS same_trigger_last_insert_id;
same_trigger_last_insert_id
1
SELECT id, note FROM db_inn.aux ORDER BY id, note;
id	note
2	bu
SELECT id, note FROM db_my.aux  ORDER BY id, note;
id	note
2	bu
SELECT (
(SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;
eq
1
DROP TRIGGER db_inn.bu3;
DROP TRIGGER db_my.bu3;
DELETE FROM db_inn.aux;
DELETE FROM db_my.aux;
CREATE TRIGGER db_inn.bi4 BEFORE INSERT ON db_inn.t FOR EACH ROW
BEGIN
IF NEW.k = 80 THEN SET NEW.k = 70; END IF;
END//
CREATE TRIGGER db_my.bi4 BEFORE INSERT ON db_my.t FOR EACH ROW
BEGIN
IF NEW.k = 80 THEN SET NEW.k = 70; END IF;
END//
INSERT INTO db_inn.t (id, k, v)
VALUES (6, 70, 6),(7, 80, 7) AS nw
ON DUPLICATE KEY UPDATE v = nw.v;
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
Level	Code	Message
INSERT INTO db_my.t (id, k, v)
VALUES (6, 70, 6),(7, 80, 7) AS nw
ON DUPLICATE KEY UPDATE v = nw.v;
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;
Level	Code	Message
SELECT @ar_inn = @ar_my AS same_affected_rows;
same_affected_rows
1
SELECT id, k, v FROM db_inn.t WHERE k IN (70,80) ORDER BY id;
id	k	v
6	70	7
SELECT id, k, v FROM db_my.t  WHERE k IN (70,80) ORDER BY id;
id	k	v
6	70	7
DROP TRIGGER db_inn.bi4;
DROP TRIGGER db_my.bi4;
CREATE TRIGGER db_inn.bi5 BEFORE INSERT ON db_inn.t FOR EACH ROW
BEGIN
SET @lii_bi_inn = LAST_INSERT_ID();
INSERT INTO db_inn.aux VALUES (NEW.id, 'bi');
END//
CREATE TRIGGER db_my.bi5 BEFORE INSERT ON db_my.t FOR EACH ROW
BEGIN
SET @lii_bi_my = LAST_INSERT_ID();
INSERT INTO db_my.aux  VALUES (NEW.id, 'bi');
END//
INSERT INTO db_inn.t (k, v) VALUES (50,5);
