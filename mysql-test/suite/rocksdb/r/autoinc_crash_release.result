CHECK TABLE a_int, a_part, a_sk, a_ofs;
Table	Op	Msg_type	Msg_text
test.a_int	check	status	OK
test.a_part	check	status	OK
test.a_sk	check	status	OK
test.a_ofs	check	status	OK
DROP TABLE chk_ack;
# A counter raised by ALTER right before a kill is not lost.
# Kill the server
# restart
INSERT INTO a_int (tag, c) VALUES (-1, 0);
raised_counter_survived_kill
1
# A TINYINT counter that reached its maximum before a kill.
CREATE TABLE a_tiny (id TINYINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, v INT)
ENGINE=ROCKSDB;
INSERT INTO a_tiny VALUES (250, 0);
INSERT INTO a_tiny (v) VALUES (1), (2), (3), (4), (5);
SELECT MAX(id) FROM a_tiny;
MAX(id)
255
# Kill the server
# restart
INSERT INTO a_tiny (v) VALUES (6);
Got one of the listed errors
SELECT COUNT(*), MAX(id) FROM a_tiny;
COUNT(*)	MAX(id)
6	255
DROP TABLE a_int, a_part, a_sk, a_ofs, a_tiny;
SET GLOBAL rocksdb_flush_log_at_trx_commit = DEFAULT;
