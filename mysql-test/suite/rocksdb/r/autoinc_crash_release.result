INSERT INTO a_int (tag, c) VALUES (-201, 0), (-202, 0), (-203, 0);
INSERT INTO a_part (tag) VALUES (-201), (-202), (-203);
INSERT INTO a_sk (pk, tag) VALUES (-201, -201), (-202, -202), (-203, -203);
SET SESSION auto_increment_increment = 3, auto_increment_offset = 2;
INSERT INTO a_ofs (tag) VALUES (-201), (-202), (-203);
