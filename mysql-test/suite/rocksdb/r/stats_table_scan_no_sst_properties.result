SET @save_use_scan = @@global.rocksdb_table_stats_use_table_scan;
SET @save_sampling = @@global.rocksdb_table_stats_sampling_pct;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE t (pk INT PRIMARY KEY, a INT, KEY ka (a)) ENGINE=ROCKSDB;
INSERT INTO t
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM s WHERE n < 1999)
SELECT n, n % 100 FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_table_stats_use_table_scan = ON;
SET GLOBAL rocksdb_table_stats_sampling_pct = 100;
ANALYZE TABLE t;
SELECT @@global.rocksdb_collect_sst_properties;
@@global.rocksdb_collect_sst_properties
0
# The scan saw 2000 rows; ka has 100 distinct values, the PK 2000
SELECT table_rows BETWEEN 1500 AND 2500 AS rows_ok
FROM information_schema.tables WHERE table_name = 't';
rows_ok
1
SELECT index_name, cardinality BETWEEN 50 AND 2500 AS cardinality_ok
FROM information_schema.statistics
WHERE table_name = 't' ORDER BY index_name;
INDEX_NAME	cardinality_ok
ka	1
PRIMARY	1
DROP TABLE t;
SET GLOBAL rocksdb_table_stats_use_table_scan = @save_use_scan;
SET GLOBAL rocksdb_table_stats_sampling_pct = @save_sampling;
