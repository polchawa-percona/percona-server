# Restart with the default rocksdb_validate_tables
# restart
# The cleanup after a committed ALTER TABLE fails (debug point): the
# table stays usable with the new index list, and the next ALTER TABLE
# first finishes the cleanup, or fails without changing anything.
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a), KEY kb(b)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET SESSION debug = "+d,rocksdb_fail_pending_alter_cleanup";
ALTER TABLE t1 DROP INDEX ka, ALGORITHM=INPLACE;
SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
id	b
3	10
2	20
1	30
