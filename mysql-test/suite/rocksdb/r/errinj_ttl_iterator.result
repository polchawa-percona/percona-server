call mtr.add_suppression("Got error [0-9]+ when reading table");
call mtr.add_suppression("aborting on");
call mtr.add_suppression("failed to write to WAL");
call mtr.add_suppression("failed on I/O");
call mtr.add_suppression("Failed to read/write in RocksDB");
call mtr.add_suppression("Status error, code: [0-9]+");
call mtr.add_suppression("Attempting backtrace");
call mtr.add_suppression("following information to find out");
call mtr.add_suppression("Rocksdb: ");
call mtr.add_suppression("Failed to bulk load");
call mtr.add_suppression("bulk load error");
call mtr.add_suppression("Error [0-9]+ finalizing last SST file");
call mtr.add_suppression("Error finishing bulk load");
call mtr.add_suppression("Found [0-9]+ prepared XA transactions");
# ITERATOR/INCOMPLETE INSERT over an expired row (hidden TTL): no RocksDB call of this class was made
# ITERATOR/INCOMPLETE INSERT over an expired row (TTL column): no RocksDB call of this class was made
# ITERATOR/INCOMPLETE UPDATE of expired and unexpired rows (hidden TTL): every injected failure was handled correctly
# ITERATOR/INCOMPLETE UPDATE of expired and unexpired rows (TTL column): every injected failure was handled correctly
# ITERATOR/INCOMPLETE DELETE of expired and unexpired rows: every injected failure was handled correctly
# ITERATOR/INCOMPLETE REPLACE of an expired and an unexpired row: no RocksDB call of this class was made
# ITERATOR/INCOMPLETE scan with TTL filtering: every injected failure was handled correctly
# ITERATOR/INCOMPLETE point reads with TTL filtering: every injected failure was handled correctly
# ITERATOR/INCOMPLETE INSERT ... SELECT from a TTL table: every injected failure was handled correctly
# ITERATOR/INCOMPLETE OPTIMIZE TABLE (TTL compaction, hidden TTL): the statement does not change the state
# ITERATOR/INCOMPLETE OPTIMIZE TABLE (TTL compaction, hidden TTL): no RocksDB call of this class was made
# ITERATOR/INCOMPLETE OPTIMIZE TABLE (TTL compaction, TTL column): the statement does not change the state
# ITERATOR/INCOMPLETE OPTIMIZE TABLE (TTL compaction, TTL column): no RocksDB call of this class was made
# ITERATOR/INCOMPLETE COPY ALTER of a TTL table: the statement does not change the state
# ITERATOR/INCOMPLETE COPY ALTER of a TTL table: every injected failure was handled correctly
SET GLOBAL rocksdb_debug_ttl_rec_ts = DEFAULT;
DROP TABLE IF EXISTS tt_h, tt_c;
DROP TABLE t_outt;
DROP PROCEDURE errinj_ttl_reset;
DROP PROCEDURE errinj_tables_state;
