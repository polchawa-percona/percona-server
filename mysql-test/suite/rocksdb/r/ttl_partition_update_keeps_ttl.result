SET SESSION transaction_isolation = 'READ-COMMITTED';
BEGIN;
SELECT COUNT(*) FROM t1;
COUNT(*)
0
INSERT INTO t1 VALUES (1, 1), (3, 3);
# Wait until rows 1 and 3 are expired for new transactions
SET SESSION transaction_isolation = 'READ-COMMITTED';
BEGIN;
SELECT COUNT(*) FROM t1;
COUNT(*)
0
# Row 1 stays in its partition, row 3 moves to p1
UPDATE t1 SET id = 51 WHERE id = 1;
SELECT ROW_COUNT();
ROW_COUNT()
1
UPDATE t1 SET id = 103 WHERE id = 3;
SELECT ROW_COUNT();
ROW_COUNT()
1
COMMIT;
# The updated rows keep their expired TTL: none is visible
SELECT id FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id
SELECT id FROM t1 FORCE INDEX (kk) ORDER BY id;
id
COMMIT;
DROP TABLE t1;
