SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE t1 (
pk INT NOT NULL,
a INT NOT NULL,
b VARCHAR(200),
PRIMARY KEY (pk) COMMENT 'cfname=cf_corrupt_pk',
KEY ka (a) COMMENT 'cfname=cf_corrupt_sk'
) ENGINE=ROCKSDB;
INSERT INTO t1
WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 5000)
SELECT n, n, REPEAT('x', 100) FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'cf_corrupt_pk';
SET GLOBAL rocksdb_compact_cf = 'cf_corrupt_sk';
include/assert.inc [The primary key is in exactly one SST file]
SELECT COUNT(*), SUM(a), SUM(LENGTH(b)) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)	SUM(a)	SUM(LENGTH(b))
5000	12502500	500000
# restart
#
# 1. Default io_error_action: a read of the damaged block aborts the
#    server and leaves the corruption marker.
#
SELECT @@global.rocksdb_io_error_action;
@@global.rocksdb_io_error_action
ABORT_SERVER
# A row in the last, undamaged data block reads fine.
SELECT pk, a, LENGTH(b) FROM t1 WHERE pk = 5000;
pk	a	LENGTH(b)
5000	5000	100
SELECT pk, a, LENGTH(b) FROM t1 WHERE pk = 1;
ERROR HY000: Lost connection to MySQL server during query
Pattern "data corruption detected" found
#
# 2. The marker stops the next start: mysqld exits without serving.
#
Pattern "The server will exit normally and stop restart attempts" found
#
# 3. allow_to_start_after_corruption=1, io_error_action=IGNORE_ERROR:
#    damaged rows give errors, undamaged rows are correct.
#
# restart:--rocksdb_allow_to_start_after_corruption=1 --rocksdb_io_error_action=IGNORE_ERROR
call mtr.add_suppression("Attempting backtrace");
call mtr.add_suppression("data corruption detected");
call mtr.add_suppression("aborting because of data corruption");
call mtr.add_suppression("block checksum mismatch");
call mtr.add_suppression("Ignoring I/O errors");
call mtr.add_suppression("Status: Corruption");
call mtr.add_suppression("There was corruption detected in the RocksDB data files");
call mtr.add_suppression("to mark rocksdb as corrupted");
call mtr.add_suppression("Got error .* from storage engine");
call mtr.add_suppression("Got error 511 when reading table");
call mtr.add_suppression("CHECKTABLE t1: .* failed to fetch row by rowid");
SELECT @@global.rocksdb_io_error_action, @@global.rocksdb_allow_to_start_after_corruption;
@@global.rocksdb_io_error_action	@@global.rocksdb_allow_to_start_after_corruption
IGNORE_ERROR	1
# Reads that don't need the damaged block.
SELECT pk, a, LENGTH(b) FROM t1 WHERE pk = 5000;
pk	a	LENGTH(b)
5000	5000	100
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1 WHERE pk BETWEEN 4900 AND 5000;
COUNT(*)	SUM(LENGTH(b))
101	10100
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1 WHERE pk > 1000;
COUNT(*)	SUM(LENGTH(b))
4000	400000
# The secondary index is in another SST file: a covering read is exact.
SELECT COUNT(*), SUM(a) FROM t1 FORCE INDEX (ka);
COUNT(*)	SUM(a)
5000	12502500
SELECT pk, a, LENGTH(b) FROM t1 FORCE INDEX (ka) WHERE a = 5000;
pk	a	LENGTH(b)
5000	5000	100
# A point read of a row in the damaged block.
SELECT pk, a, LENGTH(b) FROM t1 WHERE pk = 1;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
# Secondary-index lookups that need a damaged primary-key row.
SELECT pk, a, LENGTH(b) FROM t1 FORCE INDEX (ka) WHERE a = 1;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
SELECT COUNT(*) FROM t1 FORCE INDEX (ka) WHERE a BETWEEN 1 AND 10 AND LENGTH(b) > 0;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
# Writes and locking reads of damaged rows.
UPDATE t1 SET b = 'y' WHERE pk = 1;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
DELETE FROM t1 WHERE pk = 2;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
BEGIN;
SELECT pk FROM t1 WHERE pk = 3 FOR UPDATE;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
ROLLBACK;
# SKIP LOCKED and NOWAIT must not turn a read error into a skipped row
# (finding #24 is about this code path; with corruption the error is
# reported).
SELECT pk FROM t1 WHERE pk = 1 FOR UPDATE SKIP LOCKED;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
SELECT pk FROM t1 WHERE pk IN (1, 2, 5000) FOR UPDATE SKIP LOCKED;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
SELECT pk FROM t1 FORCE INDEX (ka) WHERE a IN (1, 5000) FOR UPDATE SKIP LOCKED;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
SELECT pk FROM t1 FORCE INDEX (ka) WHERE a IN (1, 5000) FOR UPDATE NOWAIT;
ERROR HY000: Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
# The undamaged rows are still writable.
UPDATE t1 SET b = 'y' WHERE pk = 5000;
SELECT pk, b FROM t1 WHERE pk = 5000;
pk	b
5000	y
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	Error	Got error 2 'Corruption: block checksum mismatch: stored ... computed ...' from ROCKSDB
test.t1	check	error	Corrupt
#
# 4. Repair: restore the SST file and remove the marker.
#
# restart
# The update of pk 5000 is in the WAL and survives the restart;
# everything else is back to the original values.
SELECT COUNT(*), SUM(a), SUM(LENGTH(b)) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)	SUM(a)	SUM(LENGTH(b))
5000	12502500	499901
SELECT pk, a, LENGTH(b) FROM t1 WHERE pk IN (1, 5000);
pk	a	LENGTH(b)
1	1	100
5000	5000	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
