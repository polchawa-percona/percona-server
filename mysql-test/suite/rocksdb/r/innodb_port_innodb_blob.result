CREATE TABLE t1 (a INT PRIMARY KEY, b TEXT) ENGINE=ROCKSDB;
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t3 (a INT PRIMARY KEY, b TEXT, c TEXT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,REPEAT('a',30000)),(2,REPEAT('b',40000));
BEGIN;
UPDATE t1 SET a=a+2;
ROLLBACK;
SET DEBUG_SYNC='rocksdb.update_write_row_after_unique_check SIGNAL have_latch WAIT_FOR go1';
BEGIN;
UPDATE t1 SET b=CONCAT(b,'foo');
SET DEBUG_SYNC='now WAIT_FOR have_latch';
SELECT a, RIGHT(b,20) FROM t1;
a	RIGHT(b,20)
1	aaaaaaaaaaaaaaaaaaaa
2	bbbbbbbbbbbbbbbbbbbb
SET DEBUG_SYNC='now SIGNAL go1';
SELECT a, RIGHT(b,20) FROM t1;
a	RIGHT(b,20)
1	aaaaaaaaaaaaaaaaafoo
2	bbbbbbbbbbbbbbbbbfoo
ROLLBACK;
SELECT a, RIGHT(b,20) FROM t1;
a	RIGHT(b,20)
1	aaaaaaaaaaaaaaaaaaaa
2	bbbbbbbbbbbbbbbbbbbb
BEGIN;
INSERT INTO t1 VALUES (3,REPEAT('c',50000));
SELECT @@transaction_isolation;
@@transaction_isolation
READ-COMMITTED
