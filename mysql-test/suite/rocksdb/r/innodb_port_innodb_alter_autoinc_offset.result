CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, a INT) ENGINE=ROCKSDB AUTO_INCREMENT=42;
SET AUTO_INCREMENT_INCREMENT = 5, AUTO_INCREMENT_OFFSET = 30;
INSERT INTO t1 (a) VALUES (1), (2);
SELECT * FROM t1 ORDER BY id;
id	a
45	1
50	2
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (6), (45), (123);
ALTER TABLE t1 DROP PRIMARY KEY, ADD id INT AUTO_INCREMENT PRIMARY KEY,
AUTO_INCREMENT = 42, ALGORITHM=COPY;
SELECT * FROM t1 ORDER BY id;
a	id
6	45
45	50
123	55
DROP TABLE t1;
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, a INT) ENGINE=ROCKSDB AUTO_INCREMENT=42;
SET AUTO_INCREMENT_INCREMENT = 5, AUTO_INCREMENT_OFFSET = 5;
INSERT INTO t1 (a) VALUES (1), (2);
SELECT * FROM t1 ORDER BY id;
id	a
45	1
50	2
DROP TABLE t1;
SET AUTO_INCREMENT_INCREMENT = 1, AUTO_INCREMENT_OFFSET = 1;
