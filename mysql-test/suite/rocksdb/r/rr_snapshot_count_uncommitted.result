CREATE TABLE t1 (f1 INT NOT NULL PRIMARY KEY, f2 INT NOT NULL, KEY k2 (f2))
ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
BEGIN;
BEGIN;
BEGIN;
BEGIN;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
SELECT COUNT(*) FROM t1 FORCE INDEX (k2);
COUNT(*)
3
SELECT COUNT(*) FROM t1 WHERE f1 > 100000;
COUNT(*)
0
SELECT MAX(f1) FROM t1;
MAX(f1)
3
COMMIT;
# KILL QUERY of a COUNT(*) paused inside the scan.
SET DEBUG_SYNC = 'rocksdb.check_flags_nwd SIGNAL scanning WAIT_FOR go';
SELECT COUNT(*) FROM t1 FORCE INDEX (k2);
SET DEBUG_SYNC = 'now WAIT_FOR scanning';
KILL QUERY READER_ID;
SET DEBUG_SYNC = 'now SIGNAL go';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
SELECT COUNT(*) FROM t1;
COUNT(*)
3
# The other transactions commit; their rows become visible.
COMMIT;
COMMIT;
COMMIT;
COMMIT;
SELECT COUNT(*) FROM t1;
COUNT(*)
10003
SELECT COUNT(*) FROM t1 FORCE INDEX (k2);
COUNT(*)
10003
DROP TABLE t1;
SET DEBUG_SYNC = 'RESET';
