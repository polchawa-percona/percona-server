# An added column keeps its default across a restart, whatever the algorithm.
ALTER TABLE t1 ADD COLUMN z INT DEFAULT 7;
INSERT INTO t1 (id, a, b, c) VALUES (3001, 1, 'v3001', 0);
SELECT COUNT(*), SUM(z) FROM t1;
COUNT(*)	SUM(z)
3001	21007
