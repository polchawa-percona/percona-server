CALL mtr.add_suppression("Found [0-9]+ prepared XA transactions");
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1);
XA START 'x';
UPDATE t1 set a=2;
XA END 'x';
XA PREPARE 'x';
# Kill and restart
SET SESSION rocksdb_lock_wait_timeout = 1;
# The recovered prepared transaction still holds its row locks
SELECT * FROM t1 LOCK IN SHARE MODE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# restart
# Readers see the committed state while the transaction is prepared
SELECT * FROM t1;
a
1
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	1	0	x
XA ROLLBACK 'x';
SELECT * FROM t1;
a
1
DROP TABLE t1;
#
# Bug #31437127 - ERROR LOG REPORTS INVALID (OLD?) TABLE OR DATABASE NAME:
# ERROR] [MY-010520] [Server] Invalid (old?) table or database name 't1#p#p1'
#
CREATE TABLE t1(a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB
PARTITION BY HASH(a) PARTITIONS 4;
XA BEGIN '123';
INSERT INTO t1 VALUES(1,2);
XA END '123';
XA PREPARE '123';
# restart
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	3	0	123
XA COMMIT '123';
SELECT * FROM t1;
a	b
1	2
SELECT * FROM t1 FORCE INDEX (kb) WHERE b = 2;
a	b
1	2
DROP TABLE t1;
