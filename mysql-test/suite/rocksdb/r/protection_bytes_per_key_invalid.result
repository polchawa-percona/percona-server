CREATE TABLE t1 (a INT, b VARCHAR(10)) ENGINE=ROCKSDB;
CREATE TABLE t2 (pk INT PRIMARY KEY, b VARCHAR(10)) ENGINE=ROCKSDB;
SET @save_global = @@global.rocksdb_protection_bytes_per_key;
# Unsupported values are rejected
SET SESSION rocksdb_protection_bytes_per_key = 1;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '1'
SET SESSION rocksdb_protection_bytes_per_key = 2;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '2'
SET SESSION rocksdb_protection_bytes_per_key = 3;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '3'
SET SESSION rocksdb_protection_bytes_per_key = 4;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '4'
SET GLOBAL rocksdb_protection_bytes_per_key = 1;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '1'
SET GLOBAL rocksdb_protection_bytes_per_key = 2;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '2'
SET GLOBAL rocksdb_protection_bytes_per_key = 3;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '3'
SET GLOBAL rocksdb_protection_bytes_per_key = 4;
ERROR 42000: Variable 'rocksdb_protection_bytes_per_key' can't be set to the value of '4'
SELECT @@session.rocksdb_protection_bytes_per_key,
@@global.rocksdb_protection_bytes_per_key;
@@session.rocksdb_protection_bytes_per_key	@@global.rocksdb_protection_bytes_per_key
0	0
# Writes work with 8 (hidden primary key and explicit primary key)
SET SESSION rocksdb_protection_bytes_per_key = 8;
INSERT INTO t1 VALUES (1, 'a'), (2, 'b');
INSERT INTO t2 VALUES (1, 'a'), (2, 'b');
BEGIN;
INSERT INTO t1 VALUES (5, 'x');
UPDATE t2 SET b = 'c' WHERE pk = 2;
DELETE FROM t2 WHERE pk = 1;
COMMIT;
SELECT * FROM t1 ORDER BY a;
a	b
1	a
2	b
5	x
SELECT * FROM t2 ORDER BY pk;
pk	b
2	c
# A new connection with the global value 8 can write
SET GLOBAL rocksdb_protection_bytes_per_key = 8;
SELECT @@session.rocksdb_protection_bytes_per_key;
@@session.rocksdb_protection_bytes_per_key
8
INSERT INTO t1 VALUES (3, 'd');
SELECT COUNT(*) FROM t1;
COUNT(*)
4
# Writes work with 0
SET SESSION rocksdb_protection_bytes_per_key = 0;
INSERT INTO t2 VALUES (3, 'e');
SELECT * FROM t2 ORDER BY pk;
pk	b
2	c
3	e
SET GLOBAL rocksdb_protection_bytes_per_key = @save_global;
SET SESSION rocksdb_protection_bytes_per_key = DEFAULT;
DROP TABLE t1, t2;
