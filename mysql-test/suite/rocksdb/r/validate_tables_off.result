call mtr.add_suppression("Schema mismatch");
call mtr.add_suppression("Attempt to open a table that is not present in RocksDB-SE");
call mtr.add_suppression("is a leftover of an interrupted ALTER TABLE");
SELECT @@global.rocksdb_validate_tables;
@@global.rocksdb_validate_tables
0
#
# 1. Interrupted COPY ALTER: the copy has committed, the server dies
#    before the renames. The intermediate table stays in MyRocks only.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
# Kill the server
# restart
SELECT * FROM t1 ORDER BY id;
id	a
1	1
2	2
3	3
SELECT COUNT(DISTINCT TABLE_NAME) AS leftovers FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
leftovers
1
include/assert_grep.inc [With validate_tables=0 the leftover is still reported]
DROP TABLE `test`.`#sql-LEFTOVER`;
SELECT COUNT(*) AS leftovers FROM information_schema.ROCKSDB_DDL
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%';
leftovers
0
DROP TABLE t1;
#
# 2. DROP TABLE: crash after the MyRocks dictionary commit, before the
#    server's data dictionary commit (PS-11666 window).
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
# Crash at rocksdb_crash_after_delete_table during: DROP TABLE t1
DROP TABLE t1;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
include/assert_grep.inc [With validate_tables=0 no validation error is logged]
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (4,4);
SELECT * FROM t1;
id	a
4	4
DROP TABLE t1;
# Both dictionaries agree again: MyRocks starts with validate_tables=1.
# restart: --rocksdb_validate_tables=1
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
# restart
