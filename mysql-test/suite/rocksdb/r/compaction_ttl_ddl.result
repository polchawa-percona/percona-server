SET @orig_rec_ts = @@global.rocksdb_debug_ttl_rec_ts;
CREATE TABLE t_col (
a INT NOT NULL, b INT NOT NULL, c VARCHAR(32), d BLOB,
ts BIGINT UNSIGNED NOT NULL,
PRIMARY KEY (a) COMMENT 'cfname=cft',
UNIQUE KEY ub (b) COMMENT 'cfname=rev:cft2',
KEY kc (c(4)) COMMENT 'cfname=cft'
) ENGINE=ROCKSDB COMMENT='ttl_duration=100;ttl_col=ts;';
CREATE TABLE t_hid (
a INT NOT NULL, b INT NOT NULL,
PRIMARY KEY (a) COMMENT 'cfname=cft',
KEY kb (b) COMMENT 'cfname=cft'
) ENGINE=ROCKSDB COMMENT='ttl_duration=100;';
CREATE TABLE t_part (
a INT NOT NULL, b INT NOT NULL,
PRIMARY KEY (a) COMMENT 'p0_cfname=cfp0;p1_cfname=cfp1;',
KEY kb (b) COMMENT 'cfname=cft'
) ENGINE=ROCKSDB COMMENT='ttl_duration=100000;p0_ttl_duration=100;'
  PARTITION BY RANGE (a) (
PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN (100));
CREATE TABLE t_plain (
a INT NOT NULL, b INT NOT NULL,
PRIMARY KEY (a) COMMENT 'cfname=cft',
KEY kb (b) COMMENT 'cfname=cft'
) ENGINE=ROCKSDB;
CREATE TABLE t_fill (
a INT NOT NULL, b INT NOT NULL,
PRIMARY KEY (a) COMMENT 'p0_cfname=cfp0;p1_cfname=cfp1;',
KEY kb (b) COMMENT 'cfname=cft',
UNIQUE KEY ub (b, a) COMMENT 'cfname=rev:cft2'
) ENGINE=ROCKSDB PARTITION BY HASH (a) PARTITIONS 2;
CREATE TABLE t_live (
a INT NOT NULL, PRIMARY KEY (a) COMMENT 'cfname=cft'
) ENGINE=ROCKSDB COMMENT='ttl_duration=100000;';
# Rows 1-4 have expired, rows 5-8 live long.
INSERT INTO t_col
SELECT n, n, REPEAT(CHAR(96 + n), 8), REPEAT('x', 1000),
IF(n <= 4, 1, UNIX_TIMESTAMP() + 100000)
FROM (SELECT 1 n UNION SELECT 2 UNION SELECT 3 UNION SELECT 4 UNION
SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8) s;
SET GLOBAL rocksdb_debug_ttl_rec_ts = -1000;
INSERT INTO t_hid VALUES (1,1),(2,2),(3,3),(4,4);
INSERT INTO t_part VALUES (1,1),(2,2),(3,3);
SET GLOBAL rocksdb_debug_ttl_rec_ts = 100000;
Warnings:
Warning	1292	Truncated incorrect rocksdb_debug_ttl_rec_ts value: '100000'
INSERT INTO t_hid VALUES (5,5),(6,6),(7,7),(8,8);
INSERT INTO t_part VALUES (4,4),(5,5),(6,6),(11,11),(12,12),(13,13);
SET GLOBAL rocksdb_debug_ttl_rec_ts = @orig_rec_ts;
INSERT INTO t_plain VALUES (1,1),(2,2),(3,3),(4,4);
INSERT INTO t_live VALUES (1),(2),(3),(4);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
INSERT INTO t_live VALUES (5);
#
# 1. INPLACE ADD INDEX during rocksdb_compact_cf
REPLACE INTO t_fill VALUES (0, 1), (1, 1);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cft';
ALTER TABLE t_col ADD INDEX kd (b, a) COMMENT 'cfname=cft', ALGORITHM=INPLACE;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
1. t_col.PRIMARY: ok
1. t_col.ub: ok
1. t_col.kc: ok
1. t_col.kd: ok
1. open transaction: t_live.PRIMARY: ok
#
# 2. INPLACE DROP INDEX during rocksdb_force_flush_memtable_and_lzero_now
INSERT INTO t_plain VALUES (5,5);
REPLACE INTO t_fill VALUES (0, 2), (1, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_force_flush_memtable_and_lzero_now = 1;
ALTER TABLE t_col DROP INDEX kc, ALGORITHM=INPLACE;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
2. t_col.PRIMARY: ok
2. t_col.ub: ok
2. t_col.kd: ok
2. t_plain.kb: ok
2. open transaction: t_live.PRIMARY: ok
#
# 3. TRUNCATE TABLE during rocksdb_compact_cf of the reverse column family
REPLACE INTO t_fill VALUES (0, 3), (1, 3);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'rev:cft2';
TRUNCATE TABLE t_hid;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_debug_ttl_rec_ts = -1000;
INSERT INTO t_hid VALUES (1,1),(2,2),(3,3),(4,4);
SET GLOBAL rocksdb_debug_ttl_rec_ts = 100000;
Warnings:
Warning	1292	Truncated incorrect rocksdb_debug_ttl_rec_ts value: '100000'
INSERT INTO t_hid VALUES (5,5),(6,6),(7,7),(8,8);
SET GLOBAL rocksdb_debug_ttl_rec_ts = @orig_rec_ts;
3. t_hid.PRIMARY: ok
3. t_hid.kb: ok
3. open transaction: t_live.PRIMARY: ok
#
# 4. COPY ALTER during a forced bottommost rocksdb_compact_cf
SET SESSION rocksdb_manual_compaction_bottommost_level = 'kForce';
REPLACE INTO t_fill VALUES (0, 4), (1, 4);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cft';
ALTER TABLE t_col FORCE, ALGORITHM=COPY;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
SET SESSION rocksdb_manual_compaction_bottommost_level = DEFAULT;
4. t_col.PRIMARY: ok
4. t_col.ub: ok
4. t_col.kd: ok
4. open transaction: t_live.PRIMARY: ok
#
# 5. COPY ALTER that changes ttl_duration during rocksdb_compact_lzero_now.
#    The copy reads the old table with TTL read filtering, so the expired
#    rows are not copied even though the new duration would cover them.
INSERT INTO t_plain VALUES (6,6);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
REPLACE INTO t_fill VALUES (0, 5), (1, 5);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_lzero_now = 1;
ALTER TABLE t_hid COMMENT='ttl_duration=100000;', ALGORITHM=COPY;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
5. t_hid.PRIMARY: ok
5. t_hid.kb: ok
5. open transaction: t_live.PRIMARY: ok
#
# 6. TRUNCATE PARTITION of the short-TTL partition during
#    rocksdb_compact_cf of its column family
REPLACE INTO t_fill VALUES (0, 6), (1, 6);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cfp0';
ALTER TABLE t_part TRUNCATE PARTITION p0;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
6. t_part.PRIMARY: ok
6. t_part.kb: ok
6. open transaction: t_live.PRIMARY: ok
#
# 7. ADD PARTITION, then DROP PARTITION, each during rocksdb_compact_cf
REPLACE INTO t_fill VALUES (0, 7), (1, 7);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cft';
ALTER TABLE t_part ADD PARTITION (PARTITION p2 VALUES LESS THAN (1000));
Warnings:
Warning	138	Inplace partition altering is not supported
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
INSERT INTO t_part VALUES (101,101),(102,102);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
7a. t_part.PRIMARY: ok
7a. t_part.kb: ok
REPLACE INTO t_fill VALUES (0, 8), (1, 8);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cft';
ALTER TABLE t_part DROP PARTITION p2;
Warnings:
Warning	138	Inplace partition altering is not supported
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
7b. t_part.PRIMARY: ok
7b. t_part.kb: ok
7b. open transaction: t_live.PRIMARY: ok
#
# 8. CREATE and DROP TABLE during a forced bottommost rocksdb_compact_cf
#    of a partition's column family
SET SESSION rocksdb_manual_compaction_bottommost_level = 'kForce';
REPLACE INTO t_fill VALUES (0, 9), (1, 9);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL debug = '+d,rocksdb_pause_compaction';
SET GLOBAL rocksdb_compact_cf = 'cfp1';
CREATE TABLE t_tmp (a INT NOT NULL, b INT NOT NULL,
PRIMARY KEY (a) COMMENT 'cfname=cft', KEY kb (b) COMMENT 'cfname=cft')
ENGINE=ROCKSDB COMMENT='ttl_duration=100;';
INSERT INTO t_tmp VALUES (1,1),(2,2);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
DROP TABLE t_tmp;
SET GLOBAL debug = '-d,rocksdb_pause_compaction';
8. t_part.PRIMARY: ok
8. open transaction: t_live.PRIMARY: ok
COMMIT;
#
# A forced bottommost compaction leaves exactly the live rows.
SET SESSION rocksdb_manual_compaction_bottommost_level = 'kForce';
SET GLOBAL rocksdb_compact_cf = 'cft';
SET GLOBAL rocksdb_compact_cf = 'rev:cft2';
SET GLOBAL rocksdb_compact_cf = 'cfp0';
SET GLOBAL rocksdb_compact_cf = 'cfp1';
SET SESSION rocksdb_manual_compaction_bottommost_level = DEFAULT;
SET GLOBAL rocksdb_enable_ttl_read_filtering = 0;
read filtering off: t_col.PRIMARY: ok
read filtering off: t_col.ub: ok
read filtering off: t_col.kd: ok
read filtering off: t_hid.PRIMARY: ok
read filtering off: t_hid.kb: ok
read filtering off: t_part.PRIMARY: ok
read filtering off: t_part.kb: ok
read filtering off: t_plain.PRIMARY: ok
read filtering off: t_plain.kb: ok
read filtering off: t_live.PRIMARY: ok
SET GLOBAL rocksdb_enable_ttl_read_filtering = DEFAULT;
CHECK TABLE t_col, t_hid, t_part, t_plain, t_live, t_fill;
Table	Op	Msg_type	Msg_text
test.t_col	check	status	OK
test.t_hid	check	status	OK
test.t_part	check	status	OK
test.t_plain	check	status	OK
test.t_live	check	status	OK
test.t_fill	check	status	OK
# restart: --rocksdb_validate_tables=1
after restart: t_col.PRIMARY: ok
after restart: t_col.ub: ok
after restart: t_col.kd: ok
after restart: t_hid.PRIMARY: ok
after restart: t_hid.kb: ok
after restart: t_part.PRIMARY: ok
after restart: t_part.kb: ok
after restart: t_plain.PRIMARY: ok
after restart: t_plain.kb: ok
after restart: t_live.PRIMARY: ok
CHECK TABLE t_col, t_hid, t_part, t_plain, t_live, t_fill;
Table	Op	Msg_type	Msg_text
test.t_col	check	status	OK
test.t_hid	check	status	OK
test.t_part	check	status	OK
test.t_plain	check	status	OK
test.t_live	check	status	OK
test.t_fill	check	status	OK
# restart
DROP TABLE t_col, t_hid, t_part, t_plain, t_live, t_fill;
