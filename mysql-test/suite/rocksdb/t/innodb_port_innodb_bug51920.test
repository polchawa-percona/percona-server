--source include/have_rocksdb.inc
--source include/count_sessions.inc

#
# Port of innodb.innodb_bug51920 to MyRocks.
# Bug #51920: connections in a lock wait ignore KILL until the lock wait
# timeout.
#
# Changes from the InnoDB original:
#   - ENGINE=ROCKSDB with a primary key, and the locking read uses it: a
#     full-table FOR UPDATE inside BEGIN would be refused by the gap-lock rule
#     at REPEATABLE READ.
#   - rocksdb_lock_wait_timeout is set to 60 seconds, and the test checks that
#     the killed statement ends long before it. Both KILL CONNECTION (the
#     original) and KILL QUERY are covered; after KILL QUERY the connection
#     stays usable and the lock can be taken once it is free.
#

SET @saved_lock_wait_timeout = @@global.rocksdb_lock_wait_timeout;
SET GLOBAL rocksdb_lock_wait_timeout = 60;
SET SESSION rocksdb_lock_wait_timeout = 60;

CREATE TABLE bug51920 (id INT PRIMARY KEY, i INT) ENGINE=ROCKSDB;
INSERT INTO bug51920 VALUES (1, 1);

BEGIN;
SELECT * FROM bug51920 WHERE id = 1 FOR UPDATE;

--echo # KILL CONNECTION of a session waiting for a row lock
connect (con1,localhost,root,,);
connection con1;
--send
UPDATE bug51920 SET i=2 WHERE id = 1;

connection default;
let $wait_condition =
  SELECT COUNT(*)=1 FROM information_schema.processlist
  WHERE INFO="UPDATE bug51920 SET i=2 WHERE id = 1";
-- source include/wait_condition.inc
SELECT ID FROM INFORMATION_SCHEMA.PROCESSLIST
WHERE INFO="UPDATE bug51920 SET i=2 WHERE id = 1"
INTO @thread_id;
let $wait_condition =
  SELECT COUNT(*) = 1 FROM information_schema.rocksdb_trx
  WHERE thread_id = @thread_id AND waiting_key != '';
-- source include/wait_condition.inc

SET @start = NOW(6);
KILL @thread_id;
let $wait_condition =
  SELECT COUNT(*)=0 FROM information_schema.processlist WHERE ID=@thread_id;
-- source include/wait_condition.inc
SELECT TIMESTAMPDIFF(SECOND, @start, NOW(6)) < 30 AS ended_before_timeout;

connection con1;
-- error 1317, 2006, 2013
reap;
connection default;
disconnect con1;

--echo # KILL QUERY of a session waiting for a row lock
connect (con2,localhost,root,,);
connection con2;
SET SESSION rocksdb_lock_wait_timeout = 60;
--let $con2 = `SELECT CONNECTION_ID()`
--send
UPDATE bug51920 SET i=3 WHERE id = 1;

connection default;
let $wait_condition =
  SELECT COUNT(*) = 1 FROM information_schema.rocksdb_trx
  WHERE thread_id = $con2 AND waiting_key != '';
-- source include/wait_condition.inc
SET @start = NOW(6);
--replace_result $con2 CON2_ID
--eval KILL QUERY $con2

connection con2;
--error ER_QUERY_INTERRUPTED
reap;
connection default;
SELECT TIMESTAMPDIFF(SECOND, @start, NOW(6)) < 30 AS ended_before_timeout;
--echo # The killed session holds no lock and still works.
--replace_result $con2 CON2_ID
eval SELECT COUNT(*) AS locks_of_killed_session FROM information_schema.rocksdb_locks l
  JOIN information_schema.rocksdb_trx t ON l.transaction_id = t.transaction_id
  WHERE t.thread_id = $con2;
COMMIT;

connection con2;
UPDATE bug51920 SET i=3 WHERE id = 1;
connection default;
SELECT * FROM bug51920;
disconnect con2;

DROP TABLE bug51920;
SET GLOBAL rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
--source include/wait_until_count_sessions.inc
