#
# PS-11681: a crash between the two renames of a COPY ALTER makes the
# table unavailable.
#
# ALTER TABLE ... ALGORITHM=COPY on a MyRocks table finishes with two
# renames: t -> #sql2-*, then #sql-* (the rebuilt copy) -> t. MyRocks is
# not an atomic-DDL engine, so the first rename is committed in both the
# MyRocks and the server data dictionary before the second one starts.
# This test crashes the server at the 6th durable write of the statement,
# the MyRocks dictionary commit of the second rename (the hook logs
# "fired at dict_commit [rename cp.#sql-... -> cp.t]"; the windows of
# the first rename and of the drop of #sql2-* also log dict_commit, so the
# test checks the logged names and not only the number). After the restart
# with the default options the table is gone (SHOW TABLES is empty, CHECK TABLE says the table
# does not exist) and the rows are only in hidden #sql-*/#sql2-* tables
# that SQL cannot read or rename back.
#
# Expected (as with atomic DDL, InnoDB): the statement was never
# acknowledged, so after the restart the table exists with the old or the
# new definition and all its rows, CHECK TABLE is OK, the table can be
# written to, and no #sql table is left in the MyRocks dictionary.
# Both outcomes print the same line, so the recorded result does not pick
# one of them. The window is also skipped in rocksdb.crashpoint_copy_alter.
#
# Whoever fixes PS-11681 must re-check the window if the sequence of the
# durable writes of the statement changes: if window 6 is no longer that
# rename the test fails (it does not pass on another write), and the number
# must then be updated here and in rocksdb.crashpoint_copy_alter.
#
--source include/big_test.inc
--source include/have_rocksdb.inc
--source include/have_debug.inc

CALL mtr.add_suppression("Attempting backtrace");

--source suite/rocksdb/include/crashpoint_state.inc

--disable_query_log
delimiter |;
CREATE PROCEDURE crashpoint_reset()
BEGIN
  DROP DATABASE IF EXISTS cp;
  CREATE DATABASE cp;
  CREATE TABLE cp.t (
    pk INT PRIMARY KEY,
    a INT NOT NULL,
    b VARCHAR(32) NOT NULL,
    d INT NULL,
    KEY ka (a)
  ) ENGINE=ROCKSDB;
  INSERT INTO cp.t VALUES
    (1, 107, 'one', NULL), (2, 214, 'two', 2), (3, 321, 'three', NULL),
    (4, 428, 'four', 4), (5, 535, 'five', NULL), (6, 642, 'six', 6),
    (7, 749, 'seven', NULL), (8, 856, 'eight', 8), (9, 963, 'nine', NULL),
    (10, 70, 'ten', 10);
END|
CREATE PROCEDURE crashpoint_probe()
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    GET DIAGNOSTICS CONDITION 1 @crashpoint_probe_res = MESSAGE_TEXT;
  END;
  SET @crashpoint_probe_res = 'ok';
  INSERT INTO cp.t (pk, a, b) VALUES (1000, 9999, 'probe');
  SELECT COUNT(*) INTO @crashpoint_pc FROM cp.t FORCE INDEX (ka)
    WHERE a = 9999;
  IF @crashpoint_pc <> 1 THEN
    SET @crashpoint_probe_res = 'the new row is not found through ka';
  END IF;
  DELETE FROM cp.t WHERE a = 9999;
  SELECT COUNT(*) INTO @crashpoint_pc FROM cp.t WHERE pk = 1000;
  IF @crashpoint_pc <> 0 THEN
    SET @crashpoint_probe_res = 'the deleted row is still there';
  END IF;
END|
delimiter ;|
--enable_query_log

--let $crashpoint_reset = CALL crashpoint_reset()
--let $crashpoint_probe = CALL crashpoint_probe()
--let $crashpoint_stmt = ALTER TABLE cp.t ADD COLUMN c INT NOT NULL DEFAULT 0, ALGORITHM=COPY
--let $crashpoint_pkcol = pk
--let $crashpoint_tables = cp.t
--let $crashpoint_label = COPY ALTER renames
--let $crashpoint_from = 6
--let $crashpoint_max = 6
# The window is pinned by meaning, not by its number: the hook must say that
# it fired at the dictionary commit of the rename #sql-* -> t, and the test
# fails if window 6 is anything else or is never reached.
--let $crashpoint_detail_window = 6
--let $crashpoint_detail_like = dict_commit [rename cp.#sql-%-> cp.t]
--let $crashpoint_neutral = 1
--source suite/rocksdb/include/crashpoint_loop.inc

DROP DATABASE IF EXISTS cp;
DROP PROCEDURE crashpoint_reset;
DROP PROCEDURE crashpoint_probe;
DROP PROCEDURE crashpoint_state;
DROP PROCEDURE crashpoint_run;
