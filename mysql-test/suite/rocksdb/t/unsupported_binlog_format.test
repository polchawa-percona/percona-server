#
# MyRocks negative test: writes with binlog_format other than ROW.
#
# MyRocks refuses to write when the binary log is enabled in STATEMENT or MIXED
# format (ER_REQUIRE_ROW_BINLOG_FORMAT). Reads still work. A statement that
# touches both engines is refused as a whole.
#

--source include/have_rocksdb.inc
--source include/have_log_bin.inc

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
CREATE TABLE ti (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 1);
INSERT INTO ti VALUES (1, 1);

--disable_warnings
SET SESSION binlog_format = STATEMENT;
--enable_warnings
--error ER_REQUIRE_ROW_BINLOG_FORMAT
INSERT INTO t1 VALUES (2, 2);
--error ER_REQUIRE_ROW_BINLOG_FORMAT
UPDATE t1 SET b = 10 WHERE a = 1;
--error ER_REQUIRE_ROW_BINLOG_FORMAT
DELETE FROM t1 WHERE a = 1;
--error ER_REQUIRE_ROW_BINLOG_FORMAT
REPLACE INTO t1 VALUES (1, 5);
--echo # Reads are allowed
SELECT * FROM t1;
--echo # InnoDB writes are allowed
INSERT INTO ti VALUES (2, 2);
--echo # A multi-table UPDATE touching MyRocks is refused as a whole
--error ER_REQUIRE_ROW_BINLOG_FORMAT
UPDATE t1, ti SET t1.b = 7, ti.b = 7 WHERE t1.a = ti.a;
SELECT * FROM ti ORDER BY a;

--disable_warnings
SET SESSION binlog_format = MIXED;
--enable_warnings
--error ER_REQUIRE_ROW_BINLOG_FORMAT
INSERT INTO t1 VALUES (3, 3);

--disable_warnings
SET SESSION binlog_format = ROW;
--enable_warnings
INSERT INTO t1 VALUES (4, 4);
SELECT * FROM t1 ORDER BY a;

DROP TABLE t1, ti;
