#
# Port of the Bug #23036096 part of innodb.deadlock_detect
# (mysql-test/suite/innodb/t/deadlock_detect.test) to MyRocks: the query of a transaction
# involved in a lock wait or deadlock must be visible in full in the diagnostics.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - InnoDB's monitor output (show_last_deadlock.inc) has no MyRocks equivalent that shows
#     queries; MyRocks exposes the current query of each transaction in
#     INFORMATION_SCHEMA.ROCKSDB_TRX.QUERY, so the check is done there while the long query
#     waits for a lock
#   - waits are detected with ROCKSDB_TRX.WAITING_KEY instead of the lock_wait_will_wait
#     debug sync point
#
# This test asserts the correct behaviour and is disabled until port-findings.md #31 is
# fixed: ROCKSDB_TRX.QUERY contains only NUL bytes (Rdb_trx_info_aggregator::process_tran
# writes the query into a reserved but empty std::string and then resize() overwrites it),
# and the column is VARCHAR(193) although up to 1024 bytes are captured.
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc

SET @saved_lock_wait_timeout = @@global.rocksdb_lock_wait_timeout;
SET GLOBAL rocksdb_lock_wait_timeout = 30;
SET SESSION rocksdb_lock_wait_timeout = 30;

CREATE TABLE bug(
    id INT PRIMARY KEY,
    ColumnAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA INT,
    ColumnBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB INT,
    ColumnCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC INT,
    ColumnDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD INT,
    ColumnEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE INT)
    engine = rocksdb;

INSERT INTO bug(id) VALUES(0), (1);

connect(con1, localhost, root,,);
connect(con2, localhost, root,,);

--connection con2
    BEGIN;
    SELECT * FROM bug WHERE id = 1 FOR UPDATE;

--connection con1
    --let $con1_id= `SELECT CONNECTION_ID()`
    BEGIN;
    --send SELECT * FROM bug WHERE id = 1 AND ColumnAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA = 0 AND ColumnBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB = 0 AND ColumnCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC = 0 AND ColumnDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD = 0 AND ColumnEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE = 0 /* END OF QUERY */ FOR UPDATE

--connection default
--let $wait_conn_id= $con1_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc

--echo # The waiting transaction's query is shown as text, from its start to its end.
--eval SELECT LEFT(query, 31) AS query_start, query LIKE '%/* END OF QUERY */ FOR UPDATE' AS query_complete, LOCATE(CHAR(0), query) = 0 AS no_nul_bytes FROM information_schema.rocksdb_trx WHERE thread_id = $con1_id

--connection con2
    ROLLBACK;

--connection con1
    --reap
    ROLLBACK;

--connection default
DROP TABLE bug;

disconnect con1;
disconnect con2;

--source include/wait_until_count_sessions.inc

SET GLOBAL rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
SET SESSION rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
