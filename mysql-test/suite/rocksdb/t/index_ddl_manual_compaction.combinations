[rc]
transaction-isolation=READ-COMMITTED

[rr]
transaction-isolation=REPEATABLE-READ

[rc_threads_skip]
transaction-isolation=READ-COMMITTED
rocksdb-manual-compaction-threads=2
rocksdb-manual-compaction-bottommost-level=kSkip

[rr_force_delete_range]
transaction-isolation=REPEATABLE-READ
rocksdb-manual-compaction-bottommost-level=kForce
rocksdb-enable-delete-range-for-drop-index=ON

[rc_filter_delete_range]
transaction-isolation=READ-COMMITTED
rocksdb-manual-compaction-threads=2
rocksdb-manual-compaction-bottommost-level=kIfHaveCompactionFilter
rocksdb-enable-delete-range-for-drop-index=ON

[rr_threads_filter]
transaction-isolation=REPEATABLE-READ
rocksdb-manual-compaction-threads=2
rocksdb-manual-compaction-bottommost-level=kIfHaveCompactionFilter
