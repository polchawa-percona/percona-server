--source include/have_rocksdb.inc
--source include/big_test.inc
--source include/count_sessions.inc

#
# Four sessions run COPY and INSTANT ALTER TABLE loops on the same table,
# each with rocksdb_commit_in_the_middle, so the ALTERs queue on the
# metadata lock and their copies commit in batches; a reader reads that
# table throughout. See include/ddl_concurrent_copy_alter.inc.
#

--let $ntab= 4
--let $nrows= 20000
--let $iters= 8
--let $same_table= 1
--let $alter_setup= SET SESSION rocksdb_commit_in_the_middle = ON, SESSION rocksdb_bulk_load_size = 500
--source suite/rocksdb/include/ddl_concurrent_copy_alter.inc
