#
# Port of the KILL QUERY part of innodb.innodb_bug14704286
# (mysql-test/suite/innodb/t/innodb_bug14704286.test) to MyRocks.
#
# A consistent snapshot is held while another transaction updates the
# secondary key of one row 28000 times; a read of that row through the
# secondary key by the old snapshot is then killed with KILL QUERY.
#
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB.
#   - The original waits until the read shows up as executing and relies on
#     it being slow (InnoDB walks a long undo chain). MyRocks skips the newer
#     versions quickly, so the read is parked at the MyRocks sync point
#     rocksdb.check_flags_iri (index read) instead and killed there; this
#     needs a debug build.
#   - Added: after the KILL the transaction is still open with its snapshot,
#     and the same read returns the original row.
#
--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/big_test.inc
--source include/count_sessions.inc

create table t1 (id int primary key, value int, value2 int,
value3 int, index(value,value2)) ENGINE=ROCKSDB;

insert into t1 values
(10,10,10,10),(11,11,11,11),(12,12,12,12),(13,13,13,13),(14,14,14,14),
(15,15,15,15),(16,16,16,16),(17,17,17,17),(18,18,18,18),(19,19,19,19),
(20,20,20,20);

connect (conn1, localhost, root,,);
connect (conn2, localhost, root,,);
connect (conn3, localhost, root,,);

connection conn1;
--let $conn1_id = `SELECT CONNECTION_ID()`
start transaction with consistent snapshot;

connection conn2;
delimiter |;
CREATE PROCEDURE update_t1()
BEGIN
	DECLARE i INT DEFAULT 1;
	while (i <= 28000) DO
		update test.t1 set value2=value2+1, value3=value3+1 where id=12;
		SET i = i + 1;
	END WHILE;
END|
delimiter ;|
set autocommit=0;
CALL update_t1();
set autocommit=1;
select * from t1 where id = 12;

connection conn1;
set debug_sync = 'rocksdb.check_flags_iri SIGNAL parked WAIT_FOR go';
send select * from t1 force index(value) where value=12;

connection conn3;
set debug_sync = 'now WAIT_FOR parked';
--echo KILL QUERY \$conn1_id;
--disable_query_log
eval KILL QUERY $conn1_id;
--enable_query_log
set debug_sync = 'now SIGNAL go';

connection conn1;
--error ER_QUERY_INTERRUPTED
reap;
set debug_sync = 'RESET';

--echo # The transaction and its snapshot survive the KILL.
select * from t1 force index(value) where value=12;
select * from t1 force index(primary) where id=12;
commit;
select * from t1 force index(value) where value=12;

connection default;
set debug_sync = 'RESET';
disconnect conn1;
disconnect conn2;
disconnect conn3;
drop procedure update_t1;
drop table t1;
--source include/wait_until_count_sessions.inc
