--source include/have_rocksdb.inc

#
# Differential hunt: the IODKU update leg changing keys (PK or unique SK),
# with and without triggers, including collisions created by the update
# itself or by a BEFORE UPDATE trigger.
#
# db_inn.t (InnoDB) and db_my.t (MyRocks) run the same workload; all
# observables must be equal. The test asserts equality and FAILS on any
# engine divergence.
#
# Cases:
#  A. Update leg moves the PK of the updated row.
#  B. Update expression moves the unique SK onto another row -> 1062;
#     under IGNORE the error is demoted, the row stays unchanged and the
#     affected-rows count is 1 (touched).
#  C. BEFORE UPDATE trigger moves the PK onto another existing row -> 1062.
#  D. BEFORE UPDATE trigger moves the PK to a free value.
#

CREATE DATABASE db_inn;
CREATE DATABASE db_my;

CREATE TABLE db_inn.t (
  id INT NOT NULL PRIMARY KEY,
  k  INT NOT NULL,
  v  VARCHAR(16) NOT NULL,
  UNIQUE KEY uq (k)
) ENGINE=InnoDB;

CREATE TABLE db_my.t (
  id INT NOT NULL PRIMARY KEY,
  k  INT NOT NULL,
  v  VARCHAR(16) NOT NULL,
  UNIQUE KEY uq (k)
) ENGINE=RocksDB;

INSERT INTO db_inn.t VALUES (1,10,'a'),(2,20,'b');
INSERT INTO db_my.t  VALUES (1,10,'a'),(2,20,'b');

# ---------------------------------------------------------------- case A
INSERT INTO db_inn.t (id, k, v) VALUES (1, 10, 'x')
  ON DUPLICATE KEY UPDATE id = 11, v = 'x';
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
INSERT INTO db_my.t  (id, k, v) VALUES (1, 10, 'x')
  ON DUPLICATE KEY UPDATE id = 11, v = 'x';
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT id, k, v FROM db_inn.t ORDER BY id;
SELECT id, k, v FROM db_my.t  ORDER BY id;
SELECT (
  (SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
  AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;

# ---------------------------------------------------------------- case B
# The update expression moves k onto row 2's value -> unique violation in
# the update leg. Plain: 1062 aborts. Under IGNORE: demoted to a warning,
# the row is unchanged, affected rows is 1 (touched).
--error 1062
INSERT INTO db_inn.t (id, k, v) VALUES (1, 10, 'y')
  ON DUPLICATE KEY UPDATE k = 20;
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
--error 1062
INSERT INTO db_my.t  (id, k, v) VALUES (1, 10, 'y')
  ON DUPLICATE KEY UPDATE k = 20;
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT id, k, v FROM db_inn.t ORDER BY id;
SELECT id, k, v FROM db_my.t  ORDER BY id;

INSERT IGNORE INTO db_inn.t (id, k, v) VALUES (1, 10, 'y')
  ON DUPLICATE KEY UPDATE k = 20;
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
INSERT IGNORE INTO db_my.t  (id, k, v) VALUES (1, 10, 'y')
  ON DUPLICATE KEY UPDATE k = 20;
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT (
  (SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
  AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;

# ---------------------------------------------------------------- case C
# BEFORE UPDATE trigger moves the PK onto row 2's PK -> 1062 in the update
# leg.
delimiter //;
CREATE TRIGGER db_inn.buC BEFORE UPDATE ON db_inn.t FOR EACH ROW
BEGIN
  IF NEW.v = 'move' THEN SET NEW.id = 2; END IF;
END//
CREATE TRIGGER db_my.buC BEFORE UPDATE ON db_my.t FOR EACH ROW
BEGIN
  IF NEW.v = 'move' THEN SET NEW.id = 2; END IF;
END//
delimiter ;//

--error 1062
INSERT INTO db_inn.t (id, k, v) VALUES (1, 10, 'move')
  ON DUPLICATE KEY UPDATE v = 'move';
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
--error 1062
INSERT INTO db_my.t  (id, k, v) VALUES (1, 10, 'move')
  ON DUPLICATE KEY UPDATE v = 'move';
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT id, k, v FROM db_inn.t ORDER BY id;
SELECT id, k, v FROM db_my.t  ORDER BY id;
SELECT (
  (SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
  AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;

# ---------------------------------------------------------------- case D
# BEFORE UPDATE trigger moves the PK to a free value.
DROP TRIGGER db_inn.buC;
DROP TRIGGER db_my.buC;

delimiter //;
CREATE TRIGGER db_inn.buD BEFORE UPDATE ON db_inn.t FOR EACH ROW
BEGIN
  IF NEW.v = 'free' THEN SET NEW.id = 99; END IF;
END//
CREATE TRIGGER db_my.buD BEFORE UPDATE ON db_my.t FOR EACH ROW
BEGIN
  IF NEW.v = 'free' THEN SET NEW.id = 99; END IF;
END//
delimiter ;//

INSERT INTO db_inn.t (id, k, v) VALUES (2, 20, 'free')
  ON DUPLICATE KEY UPDATE v = 'free';
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
INSERT INTO db_my.t  (id, k, v) VALUES (2, 20, 'free')
  ON DUPLICATE KEY UPDATE v = 'free';
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT id, k, v FROM db_inn.t ORDER BY id;
SELECT id, k, v FROM db_my.t  ORDER BY id;
SELECT (
  (SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
  AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq;

DROP TRIGGER db_inn.buD;
DROP TRIGGER db_my.buD;

# ---------------------------------------------------------------- case E
# Multi-row IODKU where the update leg moves the unique SK, so the next row
# of the same statement (with the original value) must be a plain insert,
# not another update.
INSERT INTO db_inn.t VALUES (3, 30, 'c');
INSERT INTO db_my.t  VALUES (3, 30, 'c');

INSERT INTO db_inn.t (id, k, v) VALUES (4, 30, 'e'),(5, 30, 'f')
  ON DUPLICATE KEY UPDATE k = 30 + 100, v = 'moved';
SET @ar_inn = ROW_COUNT();
SHOW WARNINGS;
INSERT INTO db_my.t  (id, k, v) VALUES (4, 30, 'e'),(5, 30, 'f')
  ON DUPLICATE KEY UPDATE k = 30 + 100, v = 'moved';
SET @ar_my = ROW_COUNT();
SHOW WARNINGS;

SELECT @ar_inn = @ar_my AS same_affected_rows;
SELECT id, k, v FROM db_inn.t WHERE k IN (30, 130) ORDER BY id;
SELECT id, k, v FROM db_my.t  WHERE k IN (30, 130) ORDER BY id;
SELECT (
  (SELECT COUNT(*) FROM db_inn.t) = (SELECT COUNT(*) FROM db_my.t)
  AND (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_inn.t) = (SELECT IFNULL(GROUP_CONCAT(CONCAT_WS(':', id, k, v) ORDER BY id SEPARATOR ';'), '') FROM db_my.t)
) AS eq_all_rows;

DROP DATABASE db_inn;
DROP DATABASE db_my;
