#
# Port of innodb.innodb_bug59641 (mysql-test/suite/innodb/t/innodb_bug59641.test) to MyRocks.
# Bug #59641 Prepared XA transaction causes shutdown hang after a crash
# Changes from the original:
#   - runs at READ COMMITTED: the UPDATEs inside the XA transactions are not on a full
#     unique key, which the gap-lock rule rejects at REPEATABLE READ
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - MyRocks has no READ UNCOMMITTED, so instead of reading the pending changes the
#     test checks that readers see only committed data and that each prepared
#     transaction still holds its row locks after the kill and after the restart
#   - XA RECOVER output is sorted
#
# Expected (as with InnoDB): three prepared XA transactions from three sessions
# survive a kill, the following clean shutdown does not hang, they survive that
# restart too, and XA ROLLBACK / XA COMMIT resolve them correctly.
# Blocked by port-findings.md #2 (prepared XA lost on restart); needs the XA crash
# fix (#1).
#
--source include/have_rocksdb.inc
--source include/have_log_bin.inc

CALL mtr.add_suppression("Found [0-9]+ prepared XA transactions");

CREATE TABLE t(a INT PRIMARY KEY, b INT)ENGINE=ROCKSDB;
INSERT INTO t VALUES(2,2),(4,4),(8,8),(16,16),(32,32);
COMMIT;
XA START '123';
INSERT INTO t VALUES(1,1);
XA END '123';
XA PREPARE '123';

CONNECT (con1,localhost,root,,);
CONNECTION con1;

XA START '456';
INSERT INTO t VALUES(3,47),(5,67);
UPDATE t SET b=2*b WHERE a BETWEEN 5 AND 8;
XA END '456';
XA PREPARE '456';

CONNECT (con2,localhost,root,,);
CONNECTION con2;

XA START '789';
UPDATE t SET b=4*a WHERE a=32;
XA END '789';
XA PREPARE '789';

CONNECT (con3,localhost,root,,);
CONNECTION con3;

--source include/kill_and_restart_mysqld.inc

--echo # Readers see only committed data
SELECT * FROM t;
--sorted_result
XA RECOVER;
SET SESSION rocksdb_lock_wait_timeout = 1;
--echo # Rows changed by each prepared transaction are still locked
--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t WHERE a = 1 FOR UPDATE;
--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t WHERE a = 8 FOR UPDATE;
--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t WHERE a = 32 FOR UPDATE;

# Shut down the server. This would hang because of the bug.
--source include/restart_mysqld.inc

SELECT * FROM t;
--sorted_result
XA RECOVER;
XA ROLLBACK '123';
XA ROLLBACK '456';
XA COMMIT '789';
SELECT * FROM t;

DROP TABLE t;
