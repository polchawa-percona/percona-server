--source include/have_rocksdb.inc
--source include/count_sessions.inc

#
# What a MyRocks REPEATABLE READ transaction sees, compared with InnoDB:
#
#   - When the snapshot is taken. BEGIN takes no snapshot; the first
#     consistent read does, and START TRANSACTION WITH CONSISTENT SNAPSHOT
#     takes it immediately. When the first statement of a transaction is a
#     locking read, the snapshot is taken when that statement locks its
#     first row, so it does not conflict with changes committed between
#     BEGIN and that statement, and later plain reads see those changes.
#   - Secondary key and primary key reads of one snapshot agree while other
#     transactions change the secondary key, for forward and reverse scans
#     and for an index in a reverse-ordered column family.
#   - The transaction's own uncommitted writes are visible through the
#     write batch in primary key and secondary key lookups, forward and
#     reverse range scans and COUNT(*).
#   - A snapshot keeps rows that other transactions delete, also after the
#     memtable is flushed and the column family is compacted (MyRocks only).
#   - The MyRocks snapshot is per engine: reading an InnoDB table does not
#     start it, so the first MyRocks read sees changes committed after the
#     InnoDB read. WITH CONSISTENT SNAPSHOT starts both (MyRocks only).
#   - Old versions of a row rewritten many times by another session after
#     the snapshot stay readable through the primary key and a secondary
#     key (percona_innodb.bug5450, innodb.innodb_bug84958).
#   - A LONGBLOB replaced and a JSON value partially updated by another
#     session after the snapshot keep their old values in the snapshot.
#   - START TRANSACTION READ ONLY, WITH CONSISTENT SNAPSHOT reads from its
#     snapshot and rejects writes and locking reads.
#
# The test runs under each write policy (see the .combinations file).
#

--let $i = 0
while ($i < 2)
{
  --let $engine = ROCKSDB
  if ($i == 1)
  {
    --let $engine = InnoDB
  }
  --echo
  --echo ########################################################################
  --echo # Engine: $engine
  --echo ########################################################################

  --connection default
  eval CREATE TABLE t (id INT PRIMARY KEY, k INT, v INT,
                       KEY kk (k), KEY kr (k, v) COMMENT 'cfname=rev:cf_rr_rev') ENGINE=$engine;
  INSERT INTO t VALUES (1,10,1),(2,20,2),(3,30,3),(4,40,4),(5,50,5);

  --connect (con1,localhost,root,,)
  SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
  SET SESSION rocksdb_lock_wait_timeout = 10;
  SET SESSION innodb_lock_wait_timeout = 10;
  --connect (con2,localhost,root,,)

  --echo
  --echo # BEGIN takes no snapshot; the first read does.
  --connection con1
  BEGIN;
  --connection con2
  UPDATE t SET v = 100 WHERE id = 1;
  --connection con1
  SELECT v FROM t WHERE id = 1;
  --connection con2
  UPDATE t SET v = 101 WHERE id = 1;
  --connection con1
  SELECT v FROM t WHERE id = 1;
  COMMIT;

  --echo # WITH CONSISTENT SNAPSHOT takes it immediately.
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  --connection con2
  UPDATE t SET v = 102 WHERE id = 1;
  --connection con1
  SELECT v FROM t WHERE id = 1;
  COMMIT;

  --echo # The first statement is a locking read: no conflict with changes
  --echo # committed after BEGIN, and later reads see them.
  BEGIN;
  --connection con2
  UPDATE t SET v = 200 WHERE id = 2;
  UPDATE t SET v = 300 WHERE id = 3;
  --connection con1
  SELECT v FROM t WHERE id = 2 FOR UPDATE;
  UPDATE t SET v = v + 1 WHERE id = 2;
  SELECT v FROM t WHERE id = 3;
  --connection con2
  UPDATE t SET v = 301 WHERE id = 3;
  --connection con1
  SELECT v FROM t WHERE id = 3;
  COMMIT;
  SELECT id, v FROM t WHERE id IN (2, 3) ORDER BY id;

  --echo
  --echo # Secondary key and primary key reads of one snapshot agree.
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  --connection con2
  UPDATE t SET k = 11 WHERE id = 1;
  INSERT INTO t VALUES (6, 12, 6);
  DELETE FROM t WHERE id = 2;
  --connection con1
  SELECT id, k FROM t FORCE INDEX (kk) WHERE k BETWEEN 10 AND 25 ORDER BY k;
  SELECT id, k FROM t FORCE INDEX (kk) WHERE k BETWEEN 10 AND 25 ORDER BY k DESC;
  SELECT id, k FROM t FORCE INDEX (kr) WHERE k BETWEEN 10 AND 25 ORDER BY k;
  SELECT id, k FROM t FORCE INDEX (kr) WHERE k BETWEEN 10 AND 25 ORDER BY k DESC;
  SELECT id, k FROM t FORCE INDEX (PRIMARY) WHERE k BETWEEN 10 AND 25 ORDER BY id;
  SELECT COUNT(*) FROM t FORCE INDEX (kk);
  SELECT COUNT(*) FROM t FORCE INDEX (PRIMARY);
  COMMIT;
  SELECT id, k FROM t FORCE INDEX (kk) WHERE k BETWEEN 10 AND 25 ORDER BY k;

  --echo
  --echo # The transaction's own uncommitted writes.
  BEGIN;
  INSERT INTO t VALUES (7, 25, 7);
  UPDATE t SET k = 5 WHERE id = 3;
  DELETE FROM t WHERE id = 4;
  SELECT id, k FROM t FORCE INDEX (kk) ORDER BY k;
  SELECT id, k FROM t FORCE INDEX (kk) ORDER BY k DESC;
  SELECT id, k FROM t FORCE INDEX (kr) WHERE k > 4 AND k < 30 ORDER BY k DESC;
  SELECT id, k FROM t FORCE INDEX (PRIMARY) WHERE id BETWEEN 3 AND 7 ORDER BY id DESC;
  SELECT k FROM t WHERE id = 3;
  SELECT id FROM t FORCE INDEX (kk) WHERE k = 5;
  SELECT COUNT(*) FROM t;
  ROLLBACK;
  SELECT COUNT(*) FROM t;

  --echo
  --echo # Old row versions under an open snapshot (percona_innodb.bug5450,
  --echo # innodb.innodb_bug84958): another session rewrites one row through
  --echo # INSERT ... ON DUPLICATE KEY UPDATE many times; primary key and
  --echo # secondary key reads of the snapshot still agree on the old version.
  --connection default
  eval CREATE TABLE t2 (a INT, b INT, c INT, PRIMARY KEY (a, b), KEY (b, c))
       ENGINE=$engine;
  INSERT INTO t2 VALUES (1, 2, 3) ON DUPLICATE KEY UPDATE c = c + 1;
  --connection con1
  BEGIN;
  SELECT * FROM t2;
  --connection con2
  --disable_query_log
  --let $n = 1
  while ($n <= 1000)
  {
    --eval INSERT INTO t2 VALUES (1, 2, 3) ON DUPLICATE KEY UPDATE c = $n
    --inc $n
  }
  --enable_query_log
  INSERT INTO t2 VALUES (1, 2, 3) ON DUPLICATE KEY UPDATE c = NULL;
  --connection con1
  SELECT * FROM t2 FORCE INDEX (PRIMARY);
  SELECT * FROM t2 FORCE INDEX (b);
  SELECT * FROM t2 FORCE INDEX (b) WHERE b = 2 AND c = 3;
  COMMIT;
  SELECT * FROM t2 FORCE INDEX (PRIMARY);
  SELECT * FROM t2 FORCE INDEX (b);
  --connection default
  DROP TABLE t2;

  --echo
  --echo # Large values under an open snapshot (the reader side of
  --echo # innodb.lob_partial_update_concurrent and json_small_partial_update_*,
  --echo # which the RC ports do not cover): updates by primary key, allowed at
  --echo # REPEATABLE READ, replace a LONGBLOB and partially update a JSON value;
  --echo # the snapshot still reads the old values.
  --connection default
  eval CREATE TABLE t4 (id INT PRIMARY KEY, b LONGBLOB, j JSON) ENGINE=$engine;
  INSERT INTO t4 VALUES (1, REPEAT('a', 1000000), '{"k": "v", "n": [1, 2, 3]}');
  --connection con1
  BEGIN;
  SELECT id, MD5(b), j FROM t4;
  --connection con2
  BEGIN;
  UPDATE t4 SET b = REPEAT('b', 2000000) WHERE id = 1;
  UPDATE t4 SET j = JSON_SET(j, '$.k', 'w', '$.n[1]', 20) WHERE id = 1;
  UPDATE t4 SET b = CONCAT(b, 'c') WHERE id = 1;
  COMMIT;
  --connection con1
  SELECT id, MD5(b), LENGTH(b), j FROM t4;
  COMMIT;
  SELECT id, MD5(b), LENGTH(b), j FROM t4;
  --connection default
  DROP TABLE t4;

  if ($engine == ROCKSDB)
  {
    --echo
    --echo # A snapshot keeps deleted rows through flush and compaction.
    START TRANSACTION WITH CONSISTENT SNAPSHOT;
    SELECT COUNT(*) FROM t;
    --connection con2
    DELETE FROM t WHERE id > 3;
    UPDATE t SET k = k + 100;
    --connection default
    SET GLOBAL rocksdb_force_flush_memtable_now = 1;
    SET GLOBAL rocksdb_compact_cf = 'default';
    SET GLOBAL rocksdb_compact_cf = 'rev:cf_rr_rev';
    --connection con1
    SELECT id, k FROM t FORCE INDEX (PRIMARY) ORDER BY id;
    SELECT id, k FROM t FORCE INDEX (kk) ORDER BY k;
    SELECT id, k FROM t FORCE INDEX (kr) ORDER BY k DESC;
    COMMIT;
    SELECT id, k FROM t ORDER BY id;

    --echo
    --echo # Reading an InnoDB table does not start the MyRocks snapshot.
    --connection default
    CREATE TABLE o (id INT PRIMARY KEY, w INT) ENGINE=InnoDB;
    INSERT INTO o VALUES (1, 1);
    --connection con1
    BEGIN;
    SELECT w FROM o;
    --connection con2
    UPDATE t SET v = 500 WHERE id = 1;
    UPDATE o SET w = 2;
    --connection con1
    SELECT v FROM t WHERE id = 1;
    SELECT w FROM o;
    COMMIT;
    --echo # WITH CONSISTENT SNAPSHOT starts both.
    START TRANSACTION WITH CONSISTENT SNAPSHOT;
    --connection con2
    UPDATE t SET v = 501 WHERE id = 1;
    UPDATE o SET w = 3;
    --connection con1
    SELECT v FROM t WHERE id = 1;
    SELECT w FROM o;
    COMMIT;
    --connection default
    DROP TABLE o;
  }

  --echo
  --echo # Read-only transaction with a consistent snapshot.
  --connection con1
  START TRANSACTION READ ONLY, WITH CONSISTENT SNAPSHOT;
  --connection con2
  UPDATE t SET v = 600 WHERE id = 1;
  --connection con1
  SELECT v FROM t WHERE id = 1;
  --error ER_CANT_EXECUTE_IN_READ_ONLY_TRANSACTION
  UPDATE t SET v = 1 WHERE id = 1;
  --error ER_CANT_EXECUTE_IN_READ_ONLY_TRANSACTION
  SELECT v FROM t WHERE id = 1 FOR UPDATE;
  SELECT v FROM t WHERE id = 1;
  COMMIT;
  SELECT v FROM t WHERE id = 1;

  --connection default
  --disconnect con1
  --disconnect con2
  DROP TABLE t;
  --inc $i
}

--source include/wait_until_count_sessions.inc
