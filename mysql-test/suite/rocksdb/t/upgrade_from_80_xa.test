#
# In-place upgrade of a Percona Server 8.0 datadir with prepared XA
# transactions on MyRocks, left behind when the 8.0 server was killed with
# SIGKILL (std_data/data80_rocks_upgrade_xa.zip, generated by
# std_data/upgrade80_rocksdb/gen_upgrade_datadirs.sh with 8.0.46-37).
# 8.4 must recover them as prepared, and COMMIT / ROLLBACK must apply them.
#
# Disabled until PS-11632 is fixed: MyRocks loses prepared XA transactions
# on restart. The same datadir restarted on 8.0 loses them as well, so this
# is not caused by the upgrade.
#
--source include/have_rocksdb.inc
--source include/have_util_unzip.inc
--source include/not_windows.inc

--source include/upgrade_from_prev_ver_suppressions.inc

--let $ADDITIONAL_OPTS = --log-bin=binlog
--let $ARCH_DATA = data80_rocks_upgrade_xa
--source include/begin_upgrade_from_prev_ver_mysql_upgrade.inc

--echo # The prepared transactions are recovered.
--sorted_result
XA RECOVER;

--echo # Their changes are not visible yet.
SELECT * FROM upgx.t_r ORDER BY id;
SELECT * FROM upgx.t_i ORDER BY id;

XA COMMIT 'upg_rocks_commit';
XA ROLLBACK 'upg_rocks_rollback';
XA COMMIT 'upg_mixed';
XA RECOVER;

SELECT * FROM upgx.t_r ORDER BY id;
SELECT * FROM upgx.t_r FORCE INDEX (ka) ORDER BY a;
SELECT * FROM upgx.t_i ORDER BY id;
CHECK TABLE upgx.t_r, upgx.t_i;

--echo # New transactions work after the upgrade.
connect (con1, localhost, root,,);
INSERT INTO upgx.t_r VALUES (50, 50);
XA START 'after_upgrade';
INSERT INTO upgx.t_r VALUES (60, 60);
XA END 'after_upgrade';
XA PREPARE 'after_upgrade';
XA COMMIT 'after_upgrade';
disconnect con1;
connection default;
SELECT * FROM upgx.t_r WHERE id >= 50 ORDER BY id;

--echo # The resolved transactions stay resolved after a restart.
--let $restart_parameters = "restart: --loose-skip-log-bin --skip-log-slave-updates --datadir=$MYSQLD_DATADIR1 --log-bin=binlog"
--let $do_not_echo_parameters = 1
--source include/restart_mysqld.inc
XA RECOVER;
SELECT * FROM upgx.t_r ORDER BY id;

--source include/end_upgrade_from_prev_ver_mysql_upgrade.inc
