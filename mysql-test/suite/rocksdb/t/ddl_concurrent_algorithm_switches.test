--source include/have_rocksdb.inc
--source include/count_sessions.inc

#
# Concurrent ALTER TABLE under every setting of the MyRocks variables that
# choose the ALTER algorithm (see .combinations):
#   rocksdb_enable_instant_ddl and rocksdb_enable_instant_ddl_for_*,
#   rocksdb_alter_column_default_inplace, rocksdb_alter_table_comment_inplace,
#   rocksdb_allow_unsafe_alter.
#
# No statement names an algorithm, so the same ALTER runs as INSTANT,
# INPLACE or COPY depending on the combination. That changes how long the
# exclusive metadata lock is held and whether the table is rebuilt under new
# index ids, which matters to concurrent readers and writers.
#
# Four sessions alter three tables (two of them the same table) in a loop:
# SET DEFAULT, table COMMENT, ADD COLUMN, DROP COLUMN, ADD INDEX, DROP INDEX.
# One more session adds and drops an empty partition of a partitioned table.
# Meanwhile a READ COMMITTED reader, a REPEATABLE READ reader with consistent
# snapshots and a writer run on the same tables.
#
# Checks: READ COMMITTED reads always see all rows through the primary key
# and a secondary index; REPEATABLE READ reads see their snapshot's rows or
# fail with ER_TABLE_DEF_CHANGED (a rebuilt table may read as empty until
# PS-11627 is merged; that case is counted separately and not printed);
# every update is kept; the final table definitions are the same whatever
# algorithm was used; an instantly added column keeps its default after a
# restart; no #sql table, dropped index or orphan SST data remains; and a
# restart with table validation is clean.
#

--let $nrows = 3000
--let $iters = 6

--disable_query_log
SET @save_cte = @@session.cte_max_recursion_depth;
SET SESSION cte_max_recursion_depth = 100000;
let $i = 1;
while ($i <= 3) {
  eval CREATE TABLE t$i (id INT PRIMARY KEY, a INT, b VARCHAR(32), c INT NOT NULL, d INT DEFAULT 0, KEY kb (b)) ENGINE=ROCKSDB COMMENT='initial';
  eval INSERT INTO t$i WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM s WHERE n < $nrows) SELECT n, n % 97, CONCAT('v', n), 0, n FROM s;
  inc $i;
}
# t5 is never altered: it holds the long-lived snapshot (an open transaction
# that read an altered table would block that table's ALTERs on its
# metadata lock).
eval CREATE TABLE t5 (id INT PRIMARY KEY, c INT NOT NULL) ENGINE=ROCKSDB;
eval INSERT INTO t5 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM s WHERE n < $nrows) SELECT n, 0 FROM s;
eval CREATE TABLE t4 (id INT PRIMARY KEY, b VARCHAR(32), KEY kb (b)) ENGINE=ROCKSDB
  PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (1000000));
eval INSERT INTO t4 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM s WHERE n < $nrows) SELECT n, CONCAT('v', n) FROM s;
SET SESSION cte_max_recursion_depth = @save_cte;
--enable_query_log

DELIMITER |;
CREATE PROCEDURE alter_loop(tn VARCHAR(10), iters INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE CONTINUE HANDLER FOR 1213 SET @deadlocks = IFNULL(@deadlocks, 0) + 1;
  SET @me = CONNECTION_ID();
  WHILE i < iters DO
    SET @s = CONCAT('ALTER TABLE ', tn, ' ALTER COLUMN d SET DEFAULT ', i);
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE ', tn, ' COMMENT=''c', @me, '_', i, '''');
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE ', tn, ' ADD COLUMN x', @me, '_', i, ' INT DEFAULT ', i);
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE ', tn, ' ADD INDEX k', @me, ' (a)');
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE ', tn, ' DROP COLUMN x', @me, '_', i);
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE ', tn, ' DROP INDEX k', @me);
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET i = i + 1;
  END WHILE;
END|
CREATE PROCEDURE part_loop(iters INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE CONTINUE HANDLER FOR 1213 SET @deadlocks = IFNULL(@deadlocks, 0) + 1;
  WHILE i < iters DO
    SET @s = CONCAT('ALTER TABLE t4 ADD PARTITION (PARTITION px', i, ' VALUES LESS THAN (', 1000001 + i, '))');
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET @s = CONCAT('ALTER TABLE t4 DROP PARTITION px', i);
    PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
    SET i = i + 1;
  END WHILE;
END|
CREATE PROCEDURE dml_loop(iters INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  WHILE i < iters DO
    UPDATE t2 SET c = c + 1 WHERE id = 1 + (i * 37) % 3000;
    UPDATE t3 SET c = c + 1 WHERE id = 1 + (i * 53) % 3000;
    UPDATE t5 SET c = c + 1 WHERE id = 1 + (i * 71) % 3000;
    SET i = i + 1;
  END WHILE;
END|
CREATE PROCEDURE rc_loop(iters INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE t INT;
  SET @rc_bad = 0;
  SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
  WHILE i < iters DO
    SET t = 1;
    WHILE t <= 4 DO
      SET @s = CONCAT('SELECT COUNT(*), SUM(id) INTO @cnt, @sid FROM t', t);
      PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
      SET @s = CONCAT('SELECT COUNT(*) INTO @cntb FROM t', t, ' FORCE INDEX(kb)');
      PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
      IF @cnt <> 3000 OR @cntb <> 3000 OR @sid <> 4501500 THEN
        SET @rc_bad = @rc_bad + 1;
      END IF;
      SET t = t + 1;
    END WHILE;
    SET i = i + 1;
  END WHILE;
  SELECT @rc_bad AS rc_bad_reads;
END|
CREATE PROCEDURE rr_loop(iters INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE t INT;
  DECLARE CONTINUE HANDLER FOR 1412 SET @rr_def_changed = @rr_def_changed + 1, @cnt = -1, @cntb = -1, @sid = -1;
  SET @rr_bad = 0, @rr_empty = 0, @rr_def_changed = 0;
  SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
  WHILE i < iters DO
    START TRANSACTION WITH CONSISTENT SNAPSHOT;
    SET t = 1;
    WHILE t <= 3 DO
      DO SLEEP(0.05);
      SET @s = CONCAT('SELECT COUNT(*), SUM(id) INTO @cnt, @sid FROM t', t);
      PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
      SET @s = CONCAT('SELECT COUNT(*) INTO @cntb FROM t', t, ' FORCE INDEX(kb)');
      PREPARE st FROM @s; EXECUTE st; DEALLOCATE PREPARE st;
      IF @cnt = -1 OR @cntb = -1 THEN
        SET @cnt = -1;
      ELSEIF @cnt = 0 OR @cntb = 0 THEN
        SET @rr_empty = @rr_empty + 1;
      ELSEIF @cnt <> 3000 OR @cntb <> 3000 OR @sid <> 4501500 THEN
        SET @rr_bad = @rr_bad + 1;
      END IF;
      SET t = t + 1;
    END WHILE;
    COMMIT;
    SET i = i + 1;
  END WHILE;
  SELECT @rr_bad AS rr_bad_reads;
END|
DELIMITER ;|

connect (ca1,localhost,root,,);
SET SESSION lock_wait_timeout = 300;
--send CALL alter_loop('t1', 6)
connect (ca2,localhost,root,,);
SET SESSION lock_wait_timeout = 300;
--send CALL alter_loop('t1', 6)
connect (ca3,localhost,root,,);
SET SESSION lock_wait_timeout = 300;
--send CALL alter_loop('t2', 6)
connect (ca4,localhost,root,,);
SET SESSION lock_wait_timeout = 300;
--send CALL alter_loop('t3', 6)
connect (cp,localhost,root,,);
SET SESSION lock_wait_timeout = 300;
--send CALL part_loop(6)
connect (cw,localhost,root,,);
--send CALL dml_loop(2000)
connect (crc,localhost,root,,);
--send CALL rc_loop(150)
connect (crr,localhost,root,,);
--send CALL rr_loop(150)

connect (csnap,localhost,root,,);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT SUM(c) INTO @snap_c FROM t5;

--let $c = 1
while ($c <= 4)
{
  --connection ca$c
  --reap
  --disconnect ca$c
  --inc $c
}
--connection cp
--reap
--disconnect cp
--connection cw
--reap
--disconnect cw
--connection crc
--reap
--disconnect crc
--connection crr
--reap
--let $rr_empty = `SELECT @rr_empty`
--let $rr_def_changed = `SELECT @rr_def_changed`
--disconnect crr
# How many REPEATABLE READ reads got ER_TABLE_DEF_CHANGED or read a rebuilt
# table as empty (PS-11627) depends on the combination and timing, so it is
# not part of the result. Set $SV_LOG to a file name to collect the counts.
if ($SV_LOG)
{
  --exec echo "rr_empty=$rr_empty rr_def_changed=$rr_def_changed" >> $SV_LOG
}

--connection csnap
SELECT SUM(c) = @snap_c AS old_snapshot_of_t5_unchanged FROM t5;
COMMIT;
--disconnect csnap

--connection default
--echo # Final state: the same definition whatever algorithm each ALTER used.
let $i = 1;
while ($i <= 4) {
  eval SELECT '$i' t, COUNT(*), SUM(id), (SELECT COUNT(*) FROM t$i FORCE INDEX(kb)) kb FROM t$i;
  inc $i;
}
SELECT SUM(c) AS t2_t3_t5_updates FROM (SELECT c FROM t2 UNION ALL SELECT c FROM t3 UNION ALL SELECT c FROM t5) u;
--replace_regex /COMMENT='c[0-9]+_5'/COMMENT='c<conn>_5'/
SHOW CREATE TABLE t1;
--replace_regex /COMMENT='c[0-9]+_5'/COMMENT='c<conn>_5'/
SHOW CREATE TABLE t2;
--replace_regex /COMMENT='c[0-9]+_5'/COMMENT='c<conn>_5'/
SHOW CREATE TABLE t3;
SHOW CREATE TABLE t4;

--echo # An added column keeps its default across a restart, whatever the algorithm.
ALTER TABLE t1 ADD COLUMN z INT DEFAULT 7;
INSERT INTO t1 (id, a, b, c) VALUES (3001, 1, 'v3001', 0);
SELECT COUNT(*), SUM(z) FROM t1;

SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_NAME LIKE '#sql%';
SELECT COUNT(*) AS rocksdb_ddl_indexes_not_in_server
  FROM information_schema.ROCKSDB_DDL r
  WHERE r.TABLE_SCHEMA = 'test' AND NOT EXISTS
    (SELECT 1 FROM information_schema.STATISTICS s
     WHERE s.TABLE_SCHEMA = 'test' AND s.TABLE_NAME = SUBSTRING_INDEX(r.TABLE_NAME, '#', 1)
       AND (s.INDEX_NAME = r.INDEX_NAME OR r.INDEX_NAME = 'HIDDEN_PK_ID'));
SET GLOBAL rocksdb_signal_drop_index_thread = ON;
let $wait_timeout = 300;
let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.ROCKSDB_GLOBAL_INFO WHERE TYPE = 'DDL_DROP_INDEX_ONGOING';
--source include/wait_condition.inc
SELECT COUNT(*) AS drop_ongoing FROM information_schema.ROCKSDB_GLOBAL_INFO WHERE TYPE = 'DDL_DROP_INDEX_ONGOING';
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';
SELECT COUNT(*) AS orphan_sst_index_entries FROM
  (SELECT DISTINCT INDEX_NUMBER FROM information_schema.ROCKSDB_INDEX_FILE_MAP WHERE COLUMN_FAMILY = 0) m
  WHERE INDEX_NUMBER NOT IN (SELECT INDEX_NUMBER FROM information_schema.ROCKSDB_DDL);

--source include/restart_mysqld.inc

SELECT COUNT(*), SUM(z), SUM(z = 7) FROM t1;
let $i = 1;
while ($i <= 4) {
  eval SELECT '$i' t, COUNT(*), SUM(id), (SELECT COUNT(*) FROM t$i FORCE INDEX(kb)) kb FROM t$i;
  eval CHECK TABLE t$i;
  inc $i;
}

DROP PROCEDURE alter_loop;
DROP PROCEDURE part_loop;
DROP PROCEDURE dml_loop;
DROP PROCEDURE rc_loop;
DROP PROCEDURE rr_loop;
DROP TABLE t1, t2, t3, t4, t5;
--source include/wait_until_count_sessions.inc
