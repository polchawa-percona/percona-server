#
# Crash-point enumeration over the durable writes of a COPY ALTER
# (table rebuild): the statement copies the rows into a rebuilt table and
# renames it; every crash point must leave either the old table or the
# rebuilt one, with all rows, never a half-rebuilt table, and the table
# must be usable (INSERT/DELETE through every index) after the restart.
# The server is restarted with the default options after every crash.
#
# Window 6 is skipped: PS-11681 (a crash between the two renames of a
# COPY ALTER makes the table unavailable). It is the dictionary commit of
# the second rename (#sql-* -> t): the first rename (t -> #sql2-*) is
# already committed in both dictionaries, so after the restart the table
# is gone although both copies of the data are still in MyRocks under
# their internal names. The disabled test
# rocksdb.crashpoint_copy_alter_rename asserts the correct result for that
# window. Windows 4, 5 and 7 leave a #sql* table in the MyRocks
# dictionary (PS-11680, the leftover is expected to be reported at least
# as a warning); the state they recover to is still correct.
#
--source include/big_test.inc
--source include/have_rocksdb.inc
--source include/have_debug.inc

# The enumeration intentionally crashes the server (abort) after each
# counted durable write.
CALL mtr.add_suppression("Attempting backtrace");

--source suite/rocksdb/include/crashpoint_state.inc

--disable_query_log
delimiter |;
CREATE PROCEDURE crashpoint_reset()
BEGIN
  DROP DATABASE IF EXISTS cp;
  CREATE DATABASE cp;
  CREATE TABLE cp.t (
    pk INT PRIMARY KEY,
    a INT NOT NULL,
    b VARCHAR(32) NOT NULL,
    d INT NULL,
    KEY ka (a)
  ) ENGINE=ROCKSDB;
  INSERT INTO cp.t VALUES
    (1, 107, 'one', NULL), (2, 214, 'two', 2), (3, 321, 'three', NULL),
    (4, 428, 'four', 4), (5, 535, 'five', NULL), (6, 642, 'six', 6),
    (7, 749, 'seven', NULL), (8, 856, 'eight', 8), (9, 963, 'nine', NULL),
    (10, 70, 'ten', 10);
END|
# The probe: the table must accept a row and give it up again through the
# primary key and the secondary index, whichever definition survived.
CREATE PROCEDURE crashpoint_probe()
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    GET DIAGNOSTICS CONDITION 1 @crashpoint_probe_res = MESSAGE_TEXT;
  END;
  SET @crashpoint_probe_res = 'ok';
  INSERT INTO cp.t (pk, a, b) VALUES (1000, 9999, 'probe');
  SELECT COUNT(*) INTO @crashpoint_pc FROM cp.t FORCE INDEX (ka)
    WHERE a = 9999;
  IF @crashpoint_pc <> 1 THEN
    SET @crashpoint_probe_res = 'the new row is not found through ka';
  END IF;
  DELETE FROM cp.t WHERE a = 9999;
  SELECT COUNT(*) INTO @crashpoint_pc FROM cp.t WHERE pk = 1000;
  IF @crashpoint_pc <> 0 THEN
    SET @crashpoint_probe_res = 'the deleted row is still there';
  END IF;
END|
delimiter ;|
--enable_query_log

--let $crashpoint_reset = CALL crashpoint_reset()
--let $crashpoint_probe = CALL crashpoint_probe()
--let $crashpoint_stmt = ALTER TABLE cp.t ADD COLUMN c INT NOT NULL DEFAULT 0, ALGORITHM=COPY
--let $crashpoint_pkcol = pk
--let $crashpoint_tables = cp.t
--let $crashpoint_label = COPY ALTER ADD COLUMN
--let $crashpoint_skip = 6
--let $crashpoint_skip_ticket = PS-11681
# The skipped window is pinned by meaning: the MyRocks dictionary commit of
# the second rename (#sql-* -> t); see crashpoint_copy_alter_rename.test.
--let $crashpoint_detail_window = 6
--let $crashpoint_detail_like = dict_commit [rename cp.#sql-%-> cp.t]
--let $crashpoint_leftover_ok = 4,5,7
--let $crashpoint_leftover_ticket = PS-11680
--source suite/rocksdb/include/crashpoint_loop.inc

DROP DATABASE IF EXISTS cp;
DROP PROCEDURE crashpoint_reset;
DROP PROCEDURE crashpoint_probe;
DROP PROCEDURE crashpoint_state;
DROP PROCEDURE crashpoint_run;
