#
# Port of the read view part of innodb.instant_ddl_basic
# (mysql-test/suite/innodb/include/instant_ddl_basic.inc, Bug #33937504:
# INSTANT ADD COLUMNS are visible in older read view created before INSTANT DDL)
# to MyRocks.
# Changes from the original:
#   - ENGINE=ROCKSDB instead of InnoDB; one row format instead of three
#   - ALGORITHM=INSTANT goes through include/innodb_port_instant_alter.inc. MyRocks
#     adds the column instantly (rocksdb_enable_instant_ddl_for_append_column=ON)
#     but rejects INSTANT DROP COLUMN, which then runs with the default algorithm
#     (COPY)
#
# A transaction whose snapshot is older than the ALTER must get
# ER_TABLE_DEF_CHANGED when it reads the altered table, as in InnoDB, instead of
# reading it with the new definition.
#
# Disabled until fixed (port-findings.md #42): with the COPY ALTERs MyRocks
# returns an empty table instead of the error until PS-11627 is merged, and
# after an INSTANT ADD COLUMN it reads the old rows with the new column even
# with the PS-11627 fix.
#
--source include/have_rocksdb.inc

SET @saved_append_column = @@global.rocksdb_enable_instant_ddl_for_append_column;
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;

--connect(con2,localhost,root,,)
--connect(con3,localhost,root,,)

--let $drop=0

while ($drop <= 1) {

  --let $use_instant=0
  while ($use_instant <= 1) {

    connection con2;
    CREATE TABLE t2 (c1 char(10), c2 char(10)) ENGINE=ROCKSDB;
    INSERT INTO t2 VALUES ("r1c1", "r1c2");
    SELECT * FROM t2;

    CREATE TABLE t1 (c1 char(10), c2 char(10)) ENGINE=ROCKSDB;
    INSERT INTO t1 VALUES ("r1c1", "r1c2");
    SELECT * FROM t1;

    BEGIN;
    SELECT * FROM t2;

    connection con3;
    if ($use_instant == 0) {
      if ($drop == 0) {
        ALTER TABLE t1 ADD COLUMN c3 char(10) DEFAULT "c3_def",
        ALGORITHM=COPY;
      }
      if ($drop == 1) {
        ALTER TABLE t1 DROP COLUMN c2,
        ALGORITHM=COPY;
      }
    }

    if ($use_instant == 1) {
      if ($drop == 0) {
        --let $alter = ALTER TABLE t1 ADD COLUMN c3 char(10) DEFAULT "c3_def"
        --source suite/rocksdb/include/innodb_port_instant_alter.inc
      }
      if ($drop == 1) {
        --let $alter = ALTER TABLE t1 DROP COLUMN c2
        --source suite/rocksdb/include/innodb_port_instant_alter.inc
      }
    }

    UPDATE t1 SET c1 = "r1c11";
    SELECT * FROM t1;

    connection con2;
    --error ER_TABLE_DEF_CHANGED
    SELECT * FROM t1;

    ROLLBACK;
    DROP TABLE t1;
    DROP TABLE t2;

    --inc $use_instant
  }
  --inc $drop
}

connection default;

disconnect con2;
disconnect con3;

SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = @saved_append_column;
