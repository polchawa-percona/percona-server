#
# Port of innodb.ddl_kill (mysql-test/suite/innodb/t/ddl_kill.test) to MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - InnoDB's ddl_merge_sort_interrupt and ddl_btree_build_interrupt points are
#     replaced by the MyRocks INPLACE index build points:
#       rocksdb.inplace_populate_sk_scan_row (in the primary key scan, after the
#         first row), rocksdb.inplace_populate_sk_before_merge (scan finished,
#         merge sort not started) and rocksdb.bulk_load_before_ingest (SST files
#         written, not yet ingested).
#   - ADD PRIMARY KEY is a COPY ALTER on MyRocks, so every case is an INPLACE
#     ADD INDEX; the table has a primary key.
#   - Not a big test: 1000 rows are inserted with one statement.
#   - After each killed ALTER the test checks that the index does not exist and
#     can be created afterwards.
#   - MyRocks checks for KILL only while it scans the primary key. Killed at
#     rocksdb.inplace_populate_sk_before_merge or rocksdb.bulk_load_before_ingest,
#     the ALTER completes and the index exists. KILL QUERY is honoured only where
#     a statement checks for it, so this is recorded as the expected result.
#   - Each case uses a new connection, because a killed index build leaves state
#     behind in its connection (port-findings.md #41).
#
# The ALTER killed in the scan must fail with ER_QUERY_INTERRUPTED, as on InnoDB. MyRocks reports ER_SK_POPULATE_DURING_ALTER
# instead (port-findings.md #30), so this test is disabled until that is fixed.
#
--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

CREATE TABLE t (pk INT PRIMARY KEY, c INT) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 2000;
INSERT INTO t WITH RECURSIVE v AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM v WHERE n < 1000) SELECT n, n FROM v;

call mtr.add_suppression("Error retrieving index entry from primary key");

--let $i= 1
while ($i <= 3)
{
  if ($i == 1)
  {
    --let $point= rocksdb.inplace_populate_sk_scan_row
  }
  if ($i == 2)
  {
    --let $point= rocksdb.inplace_populate_sk_before_merge
  }
  if ($i == 3)
  {
    --let $point= rocksdb.bulk_load_before_ingest
  }

  # A new connection for every case: a killed index build leaves state behind
  # in its connection (port-findings.md #41).
  connect (con1,localhost,root,,);
  --echo # con1: Start the DDL, paused at $point
  let $ID= `SELECT @id := CONNECTION_ID()`;
  eval SET DEBUG_SYNC='$point SIGNAL ready WAIT_FOR interrupt';
  --send ALTER TABLE t ADD INDEX i(c), ALGORITHM=INPLACE

  connection default;
  --echo # default: Kill the DDL
  let $ignore= `SELECT @id := $ID`;
  SET DEBUG_SYNC='now WAIT_FOR ready';
  KILL QUERY @id;
  SET DEBUG_SYNC='now SIGNAL interrupt';

  connection con1;
  --echo # con1: reap
  if ($i == 1)
  {
    --error ER_QUERY_INTERRUPTED
    --reap
  }
  if ($i > 1)
  {
    --reap
  }
  SET DEBUG_SYNC='RESET';

  connection default;
  SELECT COUNT(*) FROM information_schema.statistics
    WHERE table_schema = 'test' AND table_name = 't' AND index_name = 'i';
  CHECK TABLE t;
  if ($i == 1)
  {
    ALTER TABLE t ADD INDEX i(c), ALGORITHM=INPLACE;
  }
  SELECT COUNT(*), SUM(c) FROM t FORCE INDEX (i);
  ALTER TABLE t DROP INDEX i;
  disconnect con1;
  --inc $i
}

connection default;
--echo # Cleanup
SET DEBUG_SYNC="RESET";
DROP TABLE t;
--source include/wait_until_count_sessions.inc
