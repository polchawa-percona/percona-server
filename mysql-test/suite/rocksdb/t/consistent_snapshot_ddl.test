#
# A transaction whose snapshot predates a DDL statement that rewrote a table's
# data must get ER_TABLE_DEF_CHANGED when it reads that table, as with InnoDB.
# Before the fix MyRocks returned the rebuilt table as empty.
#
# The COUNT(*) cases follow innodb.select_count_perf, which checks the same
# error on the COUNT(*) fast path after a rebuild.
#
--source include/have_rocksdb.inc

CREATE TABLE t_base (id INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t_base VALUES (1);

--let $i = 1
while ($i <= 5)
{
  eval CREATE TABLE t$i (id INT PRIMARY KEY, v INT, KEY kv (v)) ENGINE=ROCKSDB;
  eval INSERT INTO t$i VALUES (1,10),(2,20),(3,30);
  --inc $i
}

connect (reader,localhost,root,,);
connect (ddl,localhost,root,,);

--echo #
--echo # 1. START TRANSACTION WITH CONSISTENT SNAPSHOT, then COPY ALTER.
--echo #
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE t1 ADD COLUMN name VARCHAR(10) FIRST, ALGORITHM=COPY;
connection reader;
--error ER_TABLE_DEF_CHANGED
SELECT COUNT(*) FROM t1;
--error ER_TABLE_DEF_CHANGED
SELECT SUM(v) FROM t1;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t1 FORCE INDEX (kv) WHERE v = 20;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t1 WHERE id = 2;
COMMIT;
SELECT COUNT(*), SUM(v) FROM t1;

--echo #
--echo # 2. Plain BEGIN with a first read before the COPY ALTER.
--echo #
connection reader;
BEGIN;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE t2 FORCE, ALGORITHM=COPY;
connection reader;
--error ER_TABLE_DEF_CHANGED
SELECT COUNT(*) FROM t2;
ROLLBACK;
SELECT COUNT(*) FROM t2;

--echo #
--echo # 3. TRUNCATE creates new indexes as well.
--echo #
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
TRUNCATE TABLE t3;
INSERT INTO t3 VALUES (4,40);
connection reader;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t3;
COMMIT;
SELECT * FROM t3;

--echo #
--echo # 4. INPLACE ADD INDEX: the primary key stays readable, only the new
--echo #    index is too new for the transaction.
--echo #
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE t4 ADD INDEX kv2 (v, id), ALGORITHM=INPLACE;
INSERT INTO t4 VALUES (4,40);
connection reader;
SELECT * FROM t4 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT * FROM t4 FORCE INDEX (kv) ORDER BY v;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t4 FORCE INDEX (kv2) ORDER BY v;
COMMIT;
SELECT * FROM t4 FORCE INDEX (kv2) ORDER BY v;

--echo #
--echo # 5. A plain RENAME keeps the indexes and their data, so the
--echo #    transaction can still read the table through its snapshot.
--echo #    (INSTANT ADD COLUMN is PS-11657 and tested separately.)
--echo #
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
RENAME TABLE t5 TO t5_renamed;
connection reader;
SELECT * FROM t5_renamed ORDER BY id;
COMMIT;

--echo #
--echo # 6. A table created after the snapshot is too new as well.
--echo #
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
CREATE TABLE t_new (id INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t_new VALUES (1),(2);
connection reader;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t_new;
COMMIT;
SELECT * FROM t_new ORDER BY id;

--echo #
--echo # 7. READ COMMITTED takes a new snapshot per statement and sees the
--echo #    rebuilt table.
--echo #
connection reader;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE t1 DROP COLUMN name, ALGORITHM=COPY;
connection reader;
SELECT COUNT(*), SUM(v) FROM t1;
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

--echo #
--echo # 8. Plain reads of a table without a primary key (hidden primary key)
--echo #    and of a table renamed by its COPY ALTER. Locking reads and DML on
--echo #    the rebuilt table report the same error (before the fix they failed
--echo #    with a snapshot conflict reported as a deadlock).
--echo #
CREATE TABLE t_hpk (v INT) ENGINE=ROCKSDB;
INSERT INTO t_hpk VALUES (1),(2),(3);
CREATE TABLE t_dml (id INT PRIMARY KEY, v INT, KEY kv (v)) ENGINE=ROCKSDB;
INSERT INTO t_dml VALUES (1,10),(2,20),(3,30);
CREATE TABLE t_ren (id INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t_ren VALUES (1),(2);
connection reader;
# MyRocks refuses writes after START TRANSACTION WITH CONSISTENT SNAPSHOT,
# so take the snapshot with a first read instead.
BEGIN;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE t_hpk FORCE, ALGORITHM=COPY;
ALTER TABLE t_dml FORCE, ALGORITHM=COPY;
ALTER TABLE t_ren RENAME TO t_ren2, ADD COLUMN c INT, ALGORITHM=COPY;
connection reader;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t_hpk;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t_ren2;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t_dml WHERE id = 2 FOR UPDATE;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM t_dml WHERE v = 20 LOCK IN SHARE MODE;
# DML uses full primary key equality: other forms are refused earlier with
# the gap lock error at REPEATABLE READ.
--error ER_TABLE_DEF_CHANGED
UPDATE t_dml SET v = v + 1 WHERE id = 2;
--error ER_TABLE_DEF_CHANGED
DELETE FROM t_dml WHERE id = 3;
ROLLBACK;
SELECT * FROM t_dml ORDER BY id;
SELECT * FROM t_hpk ORDER BY v;
SELECT * FROM t_ren2 ORDER BY id;
DROP TABLE t_hpk, t_dml, t_ren2;

--echo #
--echo # 9. Partitioned table: the new index of an INPLACE ADD INDEX is marked
--echo #    in every partition, and TRUNCATE PARTITION marks the truncated one.
--echo #
CREATE TABLE tp (id INT PRIMARY KEY, v INT, KEY kv (v)) ENGINE=ROCKSDB
  PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (10),
                           PARTITION p1 VALUES LESS THAN (20),
                           PARTITION p2 VALUES LESS THAN (30));
INSERT INTO tp VALUES (1,1),(11,11),(21,21);
connection reader;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE tp ADD INDEX kv2 (v, id), ALGORITHM=INPLACE;
connection reader;
SELECT * FROM tp FORCE INDEX (kv) ORDER BY v;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM tp PARTITION (p0) FORCE INDEX (kv2) ORDER BY v;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM tp PARTITION (p1) FORCE INDEX (kv2) ORDER BY v;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM tp PARTITION (p2) FORCE INDEX (kv2) ORDER BY v;
COMMIT;

START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM t_base;
connection ddl;
ALTER TABLE tp TRUNCATE PARTITION p2;
connection reader;
SELECT * FROM tp PARTITION (p0, p1) FORCE INDEX (kv2) ORDER BY v;
--error ER_TABLE_DEF_CHANGED
SELECT * FROM tp PARTITION (p2);
--error ER_TABLE_DEF_CHANGED
SELECT COUNT(*) FROM tp;
COMMIT;
SELECT * FROM tp FORCE INDEX (kv2) ORDER BY v;
DROP TABLE tp;

connection default;
disconnect reader;
disconnect ddl;
DROP TABLE t_base, t1, t2, t3, t4, t5_renamed, t_new;
