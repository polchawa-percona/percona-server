--rocksdb_max_subcompactions=1
--rocksdb_default_cf_options=write_buffer_size=64m;target_file_size_base=32k;target_file_size_multiplier=1;max_bytes_for_level_base=64k;max_bytes_for_level_multiplier=10;level0_file_num_compaction_trigger=1000;block_based_table_factory={filter_policy=bloomfilter:10:false;whole_key_filtering=0;}
--rocksdb_override_cf_options=rev:cf_x4g5={prefix_extractor=capped:8};cf_x4g5f={prefix_extractor=capped:8}
