--source include/have_rocksdb.inc

#
# PS-11743: a COPY ALTER run by a session with rocksdb_write_disable_wal=ON
# writes the copied rows without the WAL, while the dictionary change that
# switches the table to the new indexes is committed durably. After a crash
# before the next memtable flush the table is empty: rows committed before
# the ALTER are lost.
#
# The test asserts the correct behaviour (all rows survive the crash) and is
# disabled until the bug is fixed. INPLACE ADD INDEX and TRUNCATE are shown
# for comparison; they are not affected.
#

--let $save_fltc = `SELECT @@global.rocksdb_flush_log_at_trx_commit`
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;

CREATE TABLE t_copy (id INT PRIMARY KEY, k INT, v VARCHAR(100), KEY sk (k)) ENGINE=ROCKSDB;
CREATE TABLE t_inplace (id INT PRIMARY KEY, k INT, v VARCHAR(100), KEY sk (k)) ENGINE=ROCKSDB;

--disable_query_log
let $i = 0;
while ($i < 30)
{
  eval INSERT INTO t_copy VALUES ($i, $i, 'a'), ($i + 1000, $i, 'b');
  eval INSERT INTO t_inplace VALUES ($i, $i, 'a');
  inc $i;
}
--enable_query_log

# The rows are durable before the ALTER.
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

SET SESSION rocksdb_write_disable_wal = ON;
ALTER TABLE t_copy ADD COLUMN c INT, ALGORITHM=COPY;
ALTER TABLE t_inplace ADD INDEX k2 (v), ALGORITHM=INPLACE;
SET SESSION rocksdb_write_disable_wal = OFF;

SELECT COUNT(*) FROM t_copy;

--let $restart_parameters = restart: --rocksdb_flush_log_at_trx_commit=2
--source include/kill_and_restart_mysqld.inc

--echo # All rows committed before the ALTER must survive.
SELECT COUNT(*) FROM t_copy FORCE INDEX (PRIMARY);
SELECT COUNT(*) FROM t_copy FORCE INDEX (sk);
SELECT COUNT(*) FROM t_inplace FORCE INDEX (PRIMARY);
SELECT COUNT(*) FROM t_inplace FORCE INDEX (k2);
CHECK TABLE t_copy, t_inplace;

DROP TABLE t_copy, t_inplace;
--eval SET GLOBAL rocksdb_flush_log_at_trx_commit = $save_fltc
