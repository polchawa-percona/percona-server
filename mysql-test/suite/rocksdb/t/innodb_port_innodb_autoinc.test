INSERT IGNORE INTO t1 VALUES (-1, 'innodb');
INSERT IGNORE INTO t1 VALUES (-127, 'innodb');
INSERT INTO t1 VALUES (NULL, NULL);
SHOW CREATE TABLE t1;
SELECT * FROM t1;
DROP TABLE t1;
