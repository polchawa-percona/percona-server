--source include/have_rocksdb.inc
--source include/have_asan.inc

#
# PS-12169: a row this transaction wrote is read back from its write batch
# without a copy, so the BLOB/TEXT field points into the batch buffer. When a
# write of the same statement grows the batch, the buffer is reallocated and
# the field points into freed memory. The secondary key of the copied row and
# its binary log row event are then built from freed memory
# (ASAN: heap-use-after-free in Rdb_key_def::pack_record()).
#

CREATE TABLE t1 (id INT PRIMARY KEY, c TEXT) ENGINE=ROCKSDB;
CREATE TABLE t2 (id INT PRIMARY KEY, c TEXT, KEY k (c(20))) ENGINE=ROCKSDB;

# READ COMMITTED: INSERT ... SELECT needs no gap lock.
SET SESSION transaction_isolation = 'READ-COMMITTED';

--echo # Rows the transaction wrote, copied by the same transaction
BEGIN;
INSERT INTO t1
  WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 40)
  SELECT n, REPEAT(CHAR(97 + n % 26), 3000) FROM seq;
INSERT INTO t2 SELECT id, c FROM t1;
COMMIT;

--echo # The copies, read through the primary key and the secondary key
SELECT COUNT(*), SUM(CRC32(c)) FROM t1;
SELECT COUNT(*), SUM(CRC32(c)) FROM t2 FORCE INDEX (PRIMARY);
SELECT GROUP_CONCAT(id ORDER BY id) FROM t2 FORCE INDEX (k)
  WHERE c = REPEAT('b', 3000);
CHECK TABLE t2;

DROP TABLE t1, t2;
