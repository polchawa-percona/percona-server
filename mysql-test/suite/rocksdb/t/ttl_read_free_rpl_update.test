# PS-11903: with read-free replication the replica does not read the old
# row before it applies an UPDATE. For a table with an implicit TTL (no
# ttl_col) the UPDATE copies the old row's TTL timestamp from a handler
# buffer that only a row read or an INSERT fills, so the replica writes
# uninitialized bytes (fresh handler) or the timestamp of the row this
# handler last read or inserted (reused handler). The updated row then
# expires on the replica at the wrong time, and its secondary key entry,
# when no key column changes, keeps the old TTL, so the replica's indexes
# disagree.
#
# The test uses the reused-handler case only: the stale timestamp is known
# (that of the row inserted just before), so the failure is deterministic.
# The fresh-handler case writes uninitialized bytes, whose value is not
# predictable, so it is not part of the test.
#
# A fixed server keeps the row's own TTL on the replica.
#
# rocksdb_debug_ttl_read_filter_ts = F hides a row when
# ts + ttl_duration + F <= now, so F = -2500 reads as if 2500 seconds had
# passed.

--source include/have_debug.inc
--source include/have_rocksdb.inc
--source include/have_binlog_format_row.inc
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
SELECT @@global.rocksdb_read_free_rpl, @@global.replica_parallel_workers;
SET @saved_rec_ts = @@global.rocksdb_debug_ttl_rec_ts;
SET @saved_filter_ts = @@global.rocksdb_debug_ttl_read_filter_ts;
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = 0;

--echo #
--echo # Reused handler: the updated row keeps its own TTL
--echo #
--source include/rpl/connection_source.inc
CREATE TABLE t2 (a INT PRIMARY KEY, b INT, c INT, KEY(b)) ENGINE=ROCKSDB
  COMMENT 'ttl_duration=3600;';
--source include/rpl/sync_to_replica.inc
--source include/rpl/connection_replica.inc
--echo # Rows 1 and 3 are written on the replica 2000 seconds in the past,
--echo # so they expire 1600 seconds from now; row 3 is not updated.
SET GLOBAL rocksdb_debug_ttl_rec_ts = -2000;
--source include/rpl/connection_source.inc
INSERT INTO t2 VALUES (1, 1, 1), (3, 3, 3);
--source include/rpl/sync_to_replica.inc
--source include/rpl/connection_replica.inc
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
--echo # One transaction on one replica worker, which reuses the table's
--echo # handler: the INSERT of row 2 (written now) comes first.
--source include/rpl/connection_source.inc
BEGIN;
INSERT INTO t2 VALUES (2, 2, 2);
UPDATE t2 SET c = 10 WHERE a = 1;
COMMIT;
--source include/rpl/sync_to_replica.inc
--source include/rpl/connection_replica.inc
SELECT * FROM t2 FORCE INDEX(PRIMARY) ORDER BY a;
--echo # 2500 seconds later rows 1 and 3 have expired, row 2 has not
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = -2500;
SELECT * FROM t2 FORCE INDEX(PRIMARY) ORDER BY a;
SELECT a, b FROM t2 FORCE INDEX(b) ORDER BY a;
SET GLOBAL rocksdb_debug_ttl_read_filter_ts = @saved_filter_ts;

SET GLOBAL rocksdb_debug_ttl_rec_ts = @saved_rec_ts;

--source include/rpl/connection_source.inc
DROP TABLE t2;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
