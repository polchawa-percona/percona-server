# PS-12224: at REPEATABLE READ, a locking read with SKIP LOCKED that scans a
# secondary key ends at the first row another transaction holds locked: the
# unlocked rows after it in index order are missing from the result.
#
# get_row_by_rowid() reports the skipped locked row to secondary_index_read()
# as HA_ERR_KEY_NOT_FOUND with skip_row set. In
# ha_rocksdb::index_next_with_direction_intern() the secondary-key branch
# continues only on (!rc && skip_row), which never holds for a skipped row;
# should_skip_invalidated_record() rescues it only at READ COMMITTED, so at
# REPEATABLE READ the loop ends and HA_ERR_KEY_NOT_FOUND becomes end of file.
# The primary-key branch continues on (rc && skip_row) and is not affected.
#
# Expected result: SKIP LOCKED leaves out only the locked row, at both
# isolation levels and for both key kinds, as InnoDB does with the same
# statements. The READ COMMITTED and PRIMARY key statements are controls.

--source include/have_rocksdb.inc

--let $i = 0
while ($i < 2)
{
  if ($i == 0)
  {
    --echo # Table with an explicit primary key
    CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka (a)) ENGINE=ROCKSDB;
  }
  if ($i == 1)
  {
    --echo # Table without a primary key (hidden primary key)
    CREATE TABLE t1 (id INT, a INT, b INT, KEY ka (a)) ENGINE=ROCKSDB;
  }
  INSERT INTO t1 VALUES (1, 1, 1), (2, 2, 2), (3, 3, 3), (4, 4, 4), (5, 5, 5);

  --connect (con1, localhost, root,,)
  SET SESSION transaction_isolation = 'READ-COMMITTED';
  BEGIN;
  --echo # con1 locks the row with a = 2
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a = 2 FOR UPDATE;

  --connection default
  SET SESSION transaction_isolation = 'REPEATABLE-READ';
  --echo # REPEATABLE READ, secondary key: rows 1, 3, 4, 5 expected
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a BETWEEN 1 AND 5 FOR UPDATE SKIP LOCKED;
  --echo # REPEATABLE READ, secondary key, descending: rows 5, 4, 3, 1 expected
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a >= 1 ORDER BY a DESC FOR UPDATE SKIP LOCKED;
  --echo # REPEATABLE READ, secondary key, first row locked: rows 3, 4, 5 expected
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a BETWEEN 2 AND 5 FOR UPDATE SKIP LOCKED;
  if ($i == 0)
  {
    --echo # Control: REPEATABLE READ, primary key
    SELECT * FROM t1 FORCE INDEX (PRIMARY) WHERE id BETWEEN 1 AND 5 FOR UPDATE SKIP LOCKED;
  }

  SET SESSION transaction_isolation = 'READ-COMMITTED';
  --echo # Control: READ COMMITTED, secondary key
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a BETWEEN 1 AND 5 FOR UPDATE SKIP LOCKED;
  SELECT * FROM t1 FORCE INDEX (ka) WHERE a BETWEEN 2 AND 5 FOR UPDATE SKIP LOCKED;
  SET SESSION transaction_isolation = DEFAULT;

  --connection con1
  ROLLBACK;
  --disconnect con1
  --connection default
  DROP TABLE t1;
  --inc $i
}
