#
# A MyRocks checkpoint (rocksdb_create_checkpoint) taken while a DDL statement
# is in progress must restore to a usable table.
#
# Each case pauses an ALTER TABLE at a debug sync point, creates a checkpoint,
# kills the server and restarts it on the checkpoint, as a restore of a backup
# taken at that moment would. The server data dictionary is recovered to its
# state before the DDL committed, so the restored table must have its original
# definition and all rows, and MyRocks must not keep any index or #sql table
# from the interrupted DDL.
#
--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/not_valgrind.inc

--let $rocksdb_dir = `SELECT CONCAT(@@datadir, '.rocksdb')`
--let $checkpoint_dir = $MYSQL_TMP_DIR/checkpoint_during_ddl

call mtr.add_suppression("Plugin rocksdb reported");
call mtr.add_suppression("\\[Warning\\] .* #sql");

--echo #
--echo # Checkpoint taken after the DDL completed (baseline).
--echo #
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
ALTER TABLE t1 ADD COLUMN c INT DEFAULT 5, ALGORITHM=COPY;
ALTER TABLE t1 ADD INDEX kc (c), ALGORITHM=INPLACE;
--replace_result $checkpoint_dir CHECKPOINT
eval SET GLOBAL rocksdb_create_checkpoint = '$checkpoint_dir';
--source include/shutdown_mysqld.inc
--force-rmdir $rocksdb_dir
--move_file $checkpoint_dir $rocksdb_dir
--source include/start_mysqld.inc
SHOW CREATE TABLE t1;
SELECT * FROM t1 FORCE INDEX (kc) ORDER BY a;
CHECK TABLE t1;
DROP TABLE t1;

--echo #
--echo # COPY ALTER
--echo #
let $ddl = ALTER TABLE t1 ADD COLUMN d INT DEFAULT 7, ALGORITHM=COPY;

let $case_name = COPY ALTER, temporary table created, no rows copied;
let $sync_point = copy_data_between_tables_before;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

let $case_name = COPY ALTER, rows copied;
let $sync_point = alter_after_copy_table;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

let $case_name = COPY ALTER, before the renames;
let $sync_point = alter_table_before_rename_result_table;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

--echo #
--echo # INPLACE ADD INDEX
--echo #
let $ddl = ALTER TABLE t1 ADD INDEX kc (c), ALGORITHM=INPLACE;

let $case_name = INPLACE ADD INDEX, before the index build;
let $sync_point = alter_table_inplace_after_lock_downgrade;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

let $case_name = INPLACE ADD INDEX, index built, not committed;
let $sync_point = alter_table_inplace_before_commit;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

let $case_name = INPLACE ADD INDEX, before the MyRocks commit;
let $sync_point = rocksdb.commit_in_place_alter_table;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc

--echo #
--echo # INPLACE DROP INDEX
--echo #
let $ddl = ALTER TABLE t1 DROP INDEX kb, ALGORITHM=INPLACE;

let $case_name = INPLACE DROP INDEX, before the MyRocks commit;
let $sync_point = rocksdb.commit_in_place_alter_table;
--source suite/rocksdb/include/checkpoint_during_ddl_case.inc
