#
# Port of innodb.blob-crash (mysql-test/suite/innodb/t/blob-crash.test) to MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - InnoDB page-size checks, ROW_FORMAT=COMPRESSED and innodb_compression_level removed:
#     MyRocks has no off-page BLOB storage or page compression; the compressed-table
#     rounds run on a plain MyRocks table with the same columns and indexes
#   - the ib_blob_update_rollback crash point (crash during rollback) is replaced by a
#     server kill while the large UPDATE is still uncommitted
#   - the innodb_log_checkpoint_now / innodb-force-recovery-crash round is replaced by a
#     kill after a large committed UPDATE, followed by a restart; the check is that the
#     committed value survives
#   - runs at READ COMMITTED because MyRocks rejects gap locks at REPEATABLE READ
#   - no debug features are used, so the test also runs on release builds
#
--source include/have_rocksdb.inc
--source include/not_valgrind.inc
--source include/not_crashrep.inc

--echo #
--echo # Bug #16963396 INNODB: USE OF LARGE EXTERNALLY-STORED FIELDS MAKES
--echo # CRASH RECOVERY LOSE DATA
--echo #

connection default;

--echo #
--echo # Insert Operation - Crash Test
--echo # Fresh insert with blobs
--echo #

CREATE TABLE t1 (a BIGINT PRIMARY KEY, b LONGBLOB) ENGINE=ROCKSDB;

# Insert a few rows. These transactions are committed once they are acked,
# so they should not be lost.
INSERT INTO t1 (a, b) VALUES (1, repeat('^', 40000));
INSERT INTO t1 (a, b) VALUES (2, '2');
INSERT INTO t1 (a, b) VALUES (3, '3');
INSERT INTO t1 (a, b) VALUES (4, '4');
INSERT INTO t1 (a, b) VALUES (5, '5');

# The uncommitted BLOB insert should disappear. No committed data may be lost.
begin;
INSERT INTO t1 (a, b) VALUES (6, REPEAT('a', 4*1024*1024));

--source include/kill_and_restart_mysqld.inc

SELECT a, right(b, 50) FROM t1;

--echo #
--echo # UPDATE Operation - Crash Test
--echo # Update of a small value to a large blob.
--echo #

begin;
UPDATE t1 set b = REPEAT('a', 4*1024*1024) where a = 5 ;

--source include/kill_and_restart_mysqld.inc

SELECT a, right(b, 50) FROM t1;

--echo #
--echo # UPDATE Operation - Crash Test
--echo # Update of blob column to blob.
--echo #

begin;
UPDATE t1 set b = REPEAT('$', 50000) where a = 1 ;

--source include/kill_and_restart_mysqld.inc

SELECT a, right(b, 50) FROM t1;
CHECK TABLE t1;

DROP TABLE t1;

--echo #
--echo # Kill during an uncommitted multi-statement UPDATE that shrinks large
--echo # values; the rollback on recovery must restore the old values.
--echo #

create table t2 (f1 bigint primary key, f2 longblob, f3 longblob,
  index(f2(10), f3(10))) engine=rocksdb;

insert into t2 values (10, repeat('.', 40000), repeat('?', 40000));

start transaction;
update t2 set f2 = '=';
select f1, right(f2, 20), right(f3, 20) from t2;
update t2 set f3 = '&';
select f1, right(f2, 20), right(f3, 20) from t2;

--source include/kill_and_restart_mysqld.inc

select f1, right(f2, 20), right(f3, 20) from t2;
select f1, right(f2, 20), right(f3, 20) from t2 force index (f2);
check table t2;

--echo #
--echo # Committed large UPDATE followed by a kill: the new value must survive
--echo #

insert into t2 values (20, repeat('.', 40000), repeat('?', 40000));

select f1, right(f2, 20), right(f3, 20) from t2;

start transaction;
update t2 set f2 = repeat('$', 60000) where f1 = 20;
select f1, right(f2, 20), right(f3, 20) from t2;
commit;

--source include/kill_and_restart_mysqld.inc

select f1, right(f2, 20), right(f3, 20) from t2;
select f1, right(f2, 20), right(f3, 20) from t2 force index (f2);
check table t2;
drop table t2;

--echo #
--echo # Insert Operation - Crash Test (former compressed-table round)
--echo # fresh insert with BLOBs
--echo #

create table t3 (f1 bigint primary key, f2 longblob, f3 longblob,
  index(f2(10), f3(10))) engine=rocksdb;

# The uncommitted BLOB insert should disappear.
--disable_query_log
begin;
INSERT INTO t3 (f1, f2, f3) VALUES (6, repeat('/', 40000), repeat('<', 40000));
--enable_query_log

--source include/kill_and_restart_mysqld.inc

select f1, length(f2), length(f3) from t3;
select f1, right(f2, 30), right(f3, 20) from t3;
check table t3;

--echo #
--echo # Update Operation - Crash Test
--echo # update of a non-BLOB-sized value so that it becomes large
--echo #

insert into t3 values (2, repeat('!', 30), repeat('+', 30));

begin;
UPDATE t3 set f2 = repeat('>', 40000) where f1 = 2;

--source include/kill_and_restart_mysqld.inc

select f1, length(f2), length(f3) from t3;
select f1, right(f2, 30), right(f3, 20) from t3;
select f1, length(f2), length(f3) from t3 force index (f2);
check table t3;

--echo #
--echo # Update Operation - Crash Test
--echo # update blob to blob
--echo #

insert into t3 values (3, repeat('%', 40000), repeat('~', 40000));

begin;
UPDATE t3 set f2 = concat(f2, repeat(',', 10)) where f1 = 3;

--source include/kill_and_restart_mysqld.inc

select f1, length(f2), length(f3) from t3;
select f1, right(f2, 30), right(f3, 20) from t3;
select f1, length(f2), length(f3) from t3 force index (f2);
check table t3;

DROP TABLE t3;
