[default]

[unsorted_sk_unique]
rocksdb-bulk-load-allow-unsorted=ON
rocksdb-bulk-load-allow-sk=ON
rocksdb-bulk-load-enable-unique-key-check=ON
rocksdb-bulk-load-compression-parallel-threads=4

[small_batches]
rocksdb-bulk-load-size=50
rocksdb-merge-buf-size=4096
rocksdb-merge-combine-read-size=65536
rocksdb-merge-tmp-file-removal-delay-ms=1
rocksdb-commit-in-the-middle=ON
rocksdb-tmpdir=$MYSQLTEST_VARDIR/tmp

[partial_off_large]
rocksdb-bulk-load-partial-index=OFF
rocksdb-bulk-load-size=100000
rocksdb-bulk-load-allow-sk=ON
