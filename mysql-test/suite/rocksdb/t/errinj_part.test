#
# Systematic error injection into the RocksDB calls of DML and partition
# DDL on partitioned tables (RANGE with a column family per partition, HASH),
# with a secondary key (see suite/rocksdb/include/errinj_loop.inc): point
# reads, SST writes, ingests and compactions. After every injected failure
# each partition is checked through each index.
#
--source include/have_rocksdb.inc
--source include/have_debug.inc

call mtr.add_suppression("Got error [0-9]+ when reading table");
call mtr.add_suppression("aborting on");
call mtr.add_suppression("failed to write to WAL");
call mtr.add_suppression("failed on I/O");
call mtr.add_suppression("Failed to read/write in RocksDB");
call mtr.add_suppression("Status error, code: [0-9]+");
call mtr.add_suppression("Attempting backtrace");
call mtr.add_suppression("following information to find out");
call mtr.add_suppression("Rocksdb: ");
call mtr.add_suppression("Failed to bulk load");
call mtr.add_suppression("bulk load error");
call mtr.add_suppression("Error [0-9]+ finalizing last SST file");
call mtr.add_suppression("Error finishing bulk load");
call mtr.add_suppression("Found [0-9]+ prepared XA transactions");

--let $errinj_part_sk = 1
--source suite/rocksdb/include/errinj_part_setup.inc
--let $errinj_class = READ
--let $errinj_status = BUSY
--source suite/rocksdb/include/errinj_part_workloads.inc
--let $errinj_part_ddl = 1
--source suite/rocksdb/include/errinj_part_workloads.inc
--let $errinj_class = SST
--let $errinj_status = ABORTED
--source suite/rocksdb/include/errinj_part_workloads.inc
--let $errinj_class = INGEST
--source suite/rocksdb/include/errinj_part_workloads.inc
--let $errinj_class = COMPACT
--source suite/rocksdb/include/errinj_part_workloads.inc

--let $errinj_part_ddl =
--let $errinj_state_proc =
DROP TABLE IF EXISTS tp, th;
DROP TABLE t_outp;
DROP PROCEDURE errinj_part_reset;
DROP PROCEDURE errinj_tables_state;
