#
# PS-11669 (finding 49 in port-findings.md): a crash inside INPLACE ADD INDEX
# after the MyRocks dictionary commit and before the server's data dictionary
# commit left MyRocks with one more index than the server. With the default
# rocksdb_validate_tables=1 the table opened, but the first INSERT crashed the
# server (SIGSEGV in Rdb_field_packing::get_field_in_table). Only
# rocksdb_validate_tables=2 repaired the table, matching keys by position and
# leaving the data of the added index behind. The same happened for a crash
# between the MyRocks commit and the end of the "create index ongoing" marker
# (rocksdb_crash_before_finish_create_index).
#
# Expected: with default options the table matches the server's data
# dictionary and is usable through every index: before its data dictionary
# commit the ALTER TABLE is rolled back and the data of the added index is
# reclaimed; after it the new index is kept. Covers an added UNIQUE index (it
# sorts before the existing secondary key), a partitioned table and
# rocksdb_enable_delete_range_for_drop_index=ON.
#
--source include/have_rocksdb.inc
--source include/have_debug.inc
--source include/not_valgrind.inc

--disable_query_log
CALL mtr.add_suppression("ALTER TABLE was interrupted before the data dictionary commit");
--enable_query_log

CREATE TABLE orphan_probe (a INT PRIMARY KEY) ENGINE=ROCKSDB;
--let $orphan_base = `SELECT INDEX_NUMBER - 1 FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'orphan_probe'`
DROP TABLE orphan_probe;

--let $i = 0
while ($i < 6)
{
  --let $partitioned =
  --let $crash_point = crash_commit_after_prepare
  --let $crash_stmt = ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE
  if ($i == 1)
  {
    --let $crash_point = rocksdb_crash_before_finish_create_index
  }
  if ($i == 2)
  {
    --let $crash_stmt = ALTER TABLE t1 ADD UNIQUE INDEX kb(b), ALGORITHM=INPLACE
  }
  if ($i == 3)
  {
    --let $partitioned = PARTITION BY HASH(id) PARTITIONS 2
  }
  if ($i == 4)
  {
    --let $crash_point = crash_after_index_create
    --let $crash_stmt = ALTER TABLE t1 ADD UNIQUE INDEX kb(b), ALGORITHM=INPLACE
  }
  if ($i == 5)
  {
    --let $restart_parameters = restart: --rocksdb_enable_delete_range_for_drop_index=ON
  }
  --eval CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB $partitioned
  INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
  --source suite/rocksdb/include/ddl_crash.inc
  SHOW CREATE TABLE t1;
  SELECT INDEX_NAME FROM information_schema.ROCKSDB_DDL
    WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
    ORDER BY PARTITION_NAME, INDEX_NAME;
  INSERT INTO t1 VALUES (4,40,40);
  UPDATE t1 SET b = b + 100 WHERE id = 1;
  SELECT * FROM t1 ORDER BY id;
  SELECT id, a FROM t1 FORCE INDEX(ka) WHERE a > 0 ORDER BY a;
  CHECK TABLE t1;
  --error 0,ER_DUP_KEYNAME
  ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE;
  SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
  CHECK TABLE t1;
  --echo # The data of the indexes that the table no longer uses is reclaimed
  --source suite/rocksdb/include/ddl_crash_no_orphan_index.inc
  DROP TABLE t1;
  --inc $i
}

--echo # The data of the rolled back indexes is reclaimed
--source suite/rocksdb/include/ddl_crash_no_orphan_index.inc

--echo # INFORMATION_SCHEMA.TABLES statistics read the MyRocks definition
--echo # without opening the table. With an interrupted ALTER TABLE, the first
--echo # open may replace that definition: a statistics query that reads it
--echo # (debug sync point) makes the first open wait, before or after the data
--echo # dictionary commit.
--let $j = 0
while ($j < 2)
{
  CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
  INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
  --let $crash_point = crash_commit_after_prepare
  if ($j == 1)
  {
    --let $crash_point = crash_after_index_create
  }
  --let $crash_stmt = ALTER TABLE t1 ADD UNIQUE INDEX kb(b), ALGORITHM=INPLACE
  --source suite/rocksdb/include/ddl_crash.inc
  SELECT COUNT(*) AS rocksdb_indexes_before_open FROM information_schema.ROCKSDB_DDL
    WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
  --connect (con_stats,localhost,root,,test)
  SET DEBUG_SYNC = 'rocksdb_table_statistics_pending_alter SIGNAL in_stats WAIT_FOR stats_done';
  --send SELECT TABLE_ROWS IS NOT NULL, DATA_LENGTH IS NOT NULL FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
  --connection default
  SET DEBUG_SYNC = 'now WAIT_FOR in_stats';
  --connect (con_open,localhost,root,,test)
  # Reached only if the dictionary lock is held when the open resolves the
  # record. Without the lock in the statistics query the open does not
  # signal, and the wait below times out.
  SET DEBUG_SYNC = 'rocksdb_resolve_pending_alter_lock_busy SIGNAL open_waits';
  --send SHOW CREATE TABLE t1
  --connection default
  --echo # The first open waits for the statistics query
  SET DEBUG_SYNC = 'now WAIT_FOR open_waits TIMEOUT 60';
  SELECT COUNT(*) AS open_waits FROM performance_schema.processlist
    WHERE INFO = 'SHOW CREATE TABLE t1';
  SET DEBUG_SYNC = 'now SIGNAL stats_done';
  --connection con_stats
  --reap
  --disconnect con_stats
  --connection con_open
  --reap
  --disconnect con_open
  --connection default
  SET DEBUG_SYNC = 'RESET';
  SELECT COUNT(*) AS rocksdb_indexes FROM information_schema.ROCKSDB_DDL
    WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
  SELECT * FROM t1 ORDER BY id;
  CHECK TABLE t1;
  DROP TABLE t1;
  --inc $j
}

--echo # The cleanup after a committed ALTER TABLE fails (debug point): the
--echo # table stays usable with the new index list, and the next ALTER TABLE
--echo # first finishes the cleanup, or fails without changing anything.
--disable_query_log
CALL mtr.add_suppression("failed to finish an interrupted ALTER TABLE");
--enable_query_log
--let $save_append = `SELECT @@global.rocksdb_enable_instant_ddl_for_append_column`
SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = ON;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET SESSION debug = "+d,rocksdb_fail_pending_alter_cleanup";
ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE;
SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
--error ER_INTERNAL_ERROR
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=INSTANT;
SET SESSION debug = "-d,rocksdb_fail_pending_alter_cleanup";
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=INSTANT;
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES (4,40,40,4);
SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
CHECK TABLE t1;
--source include/restart_mysqld.inc
SELECT * FROM t1 ORDER BY id;
SELECT id, b FROM t1 FORCE INDEX(kb) WHERE b > 0 ORDER BY b;
CHECK TABLE t1;
--source suite/rocksdb/include/ddl_crash_no_orphan_index.inc
DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL rocksdb_enable_instant_ddl_for_append_column = $save_append
--enable_query_log

--echo # A server version without pending ALTER TABLE records left the index
--echo # list of MyRocks ahead of the data dictionary: the table cannot be
--echo # opened (instead of crashing the server) until the server is started
--echo # with rocksdb_validate_tables=2, which rebuilds the index list.
--disable_query_log
CALL mtr.add_suppression("Table '.*' definition differs between MyRocks");
CALL mtr.add_suppression("Start the server with \"rocksdb_validate_tables=2\"");
CALL mtr.add_suppression("Failed to rebuild table definition for table");
--enable_query_log
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,10,30),(2,20,20),(3,30,10);
--let $crash_point = rocksdb_skip_pending_alter,crash_commit_after_prepare
--let $crash_stmt = ALTER TABLE t1 ADD INDEX kb(b), ALGORITHM=INPLACE
--source suite/rocksdb/include/ddl_crash.inc
SET SESSION rocksdb_perf_context_level = 2;
--error ER_INTERNAL_ERROR
SELECT * FROM t1;
--echo # The failed open released the table handler (expect 0)
SELECT COUNT(*) AS open_handlers FROM information_schema.ROCKSDB_PERF_CONTEXT
  WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
--let $restart_parameters = restart: --rocksdb_validate_tables=2
--source include/restart_mysqld.inc
--echo # The rebuild fails (debug point): the open fails and releases the
--echo # table handler (expect 0)
SET SESSION rocksdb_perf_context_level = 2;
SET SESSION debug = "+d,rocksdb_open_fail_rebuild";
--error ER_KEY_CREATE_DURING_ALTER
SELECT * FROM t1;
SET SESSION debug = "-d,rocksdb_open_fail_rebuild";
SELECT COUNT(*) AS open_handlers FROM information_schema.ROCKSDB_PERF_CONTEXT
  WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
SELECT * FROM t1 ORDER BY id;
INSERT INTO t1 VALUES (4,40,40);
CHECK TABLE t1;
DROP TABLE t1;
--let $restart_parameters =
--source include/restart_mysqld.inc
