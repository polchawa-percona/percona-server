[default]

[delete_range_table_scan]
rocksdb_enable_delete_range_for_drop_index=ON
rocksdb_table_stats_use_table_scan=ON
rocksdb_max_manual_compactions=1
rocksdb_manual_compaction_threads=4
rocksdb_compaction_sequential_deletes=1000
rocksdb_compaction_sequential_deletes_window=2000

[write_unprepared]
rocksdb_write_policy=write_unprepared
rocksdb_write_batch_flush_threshold=1

[compaction_settings]
rocksdb_manual_compaction_bottommost_level=kIfHaveCompactionFilter
rocksdb_compaction_sequential_deletes=50
rocksdb_compaction_sequential_deletes_window=100
