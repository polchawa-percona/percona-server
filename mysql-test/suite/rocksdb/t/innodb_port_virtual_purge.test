#
# Port of innodb.virtual_purge (mysql-test/suite/innodb/t/virtual_purge.test) to MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - MyRocks adds and drops virtual columns only with ALGORITHM=COPY, so
#     ALGORITHM=INPLACE is removed from those ALTERs (one is pinned as
#     unsupported). Adding or dropping only an index stays INPLACE.
#   - InnoDB purge has no MyRocks equivalent. The "disable purge" transaction
#     becomes a consistent snapshot, which keeps old RocksDB versions alive, and
#     wait_innodb_all_purged.inc becomes a memtable flush plus a manual
#     compaction after the snapshot is released, so the old versions are really
#     dropped before the checks.
#   - Extra checks: every secondary index on a virtual column is compared with a
#     scan without that index, and the values are compared with the base columns.
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc

--echo #
--echo # Bug#21869656 UNDO LOG DOES NOT CONTAIN ENOUGH INFORMATION
--echo # ON INDEXED VIRTUAL COLUMNS
--echo #

CREATE TABLE t1 (a INT, b INT,
 a1 INT GENERATED ALWAYS AS (a) VIRTUAL, INDEX(a1)
) ENGINE=ROCKSDB;

INSERT INTO t1 (a,b) VALUES(1,1);

connect (con1,localhost,root,,);
# hold old row versions
CREATE TABLE t0 (a INT) ENGINE=ROCKSDB;
START TRANSACTION WITH CONSISTENT SNAPSHOT; SELECT * FROM t0;

connection default;
UPDATE t1 SET a=0;

--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t1 DROP COLUMN a1, ALGORITHM=INPLACE;
ALTER TABLE t1 DROP COLUMN a1;
ALTER TABLE t1 ADD COLUMN b1 INT GENERATED ALWAYS AS (b) VIRTUAL, ADD
INDEX(b1);

connection con1;
# release old row versions
COMMIT;
UPDATE t1 SET a=1;

connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';

CHECK TABLE t1;
SELECT b1 FROM t1;
--let $pk_check_table= t1
--let $pk_check_index= b1
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc


# Create multi-virtual column, more ADD/DROP to test it
ALTER TABLE t1
ADD COLUMN a1 INT GENERATED ALWAYS AS (a) VIRTUAL,
ADD COLUMN a2 INT GENERATED ALWAYS AS (a + b) VIRTUAL,
ADD COLUMN a3 INT GENERATED ALWAYS AS (a - b) VIRTUAL,
ADD COLUMN a4 INT GENERATED ALWAYS AS (a - b) VIRTUAL,
ADD INDEX(a1), ADD INDEX(a2), ADD INDEX(a3);

CREATE TABLE t2 (
  a BLOB,
  b BLOB,
  c BLOB GENERATED ALWAYS AS (CONCAT(a,b)) VIRTUAL,
  h VARCHAR(10) DEFAULT NULL
) ENGINE=ROCKSDB;

INSERT INTO t2 VALUES (REPEAT('g', 16000), REPEAT('x', 16000), DEFAULT, 'kk');

INSERT INTO t2 VALUES (REPEAT('a', 16000), REPEAT('b', 16000), DEFAULT, 'mm');

CREATE INDEX idx ON t2(c(100));
--let $pk_check_table= t2
--let $pk_check_index= idx
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc

INSERT INTO t1 (a, b) VALUES(1,1);

connection con1;
# hold old row versions
START TRANSACTION WITH CONSISTENT SNAPSHOT; SELECT * FROM t0;

connection default;
--enable_info

UPDATE t1 SET a=0;
UPDATE t1 SET b=0;

ALTER TABLE t1 DROP COLUMN a3;

UPDATE t1 SET a=2;
ALTER TABLE t1 DROP COLUMN a2;
UPDATE t1 SET b=3;

ALTER TABLE t1 ADD COLUMN b2 INT GENERATED ALWAYS AS (b) VIRTUAL,
ADD INDEX(b2);
UPDATE t1 SET b=9;

ALTER TABLE t1 ADD COLUMN b3 INT GENERATED ALWAYS AS (a) VIRTUAL,
ADD INDEX(b3);

UPDATE t1 SET b=10;

ALTER TABLE t2 DROP COLUMN c;

UPDATE t2 SET a = REPEAT('s', 6000) WHERE a like 'aaa%';

ALTER TABLE t2 ADD COLUMN x1 BLOB GENERATED ALWAYS AS (CONCAT(a,b)) VIRTUAL,
ADD COLUMN x2 BLOB GENERATED ALWAYS AS (CONCAT(a,b)) VIRTUAL,
ADD INDEX(x1(100), x2(120)), ADD INDEX (x1(20));

UPDATE t1 SET a=5;

UPDATE t2 SET a = REPEAT('m', 16000) WHERE a like 'sss%';

ALTER TABLE t1 DROP COLUMN b2;

UPDATE t1 SET a=6;

ALTER TABLE t2 DROP COLUMN x1, DROP COLUMN x2;

UPDATE t2 SET a = REPEAT('x', 1000) WHERE a like 'mmm%';

ALTER TABLE t1 DROP INDEX b3, ALGORITHM=INPLACE;
UPDATE t1 SET a=100;
--disable_info

connection con1;
# release old row versions
COMMIT;
disconnect con1;

connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_compact_cf = 'default';

CHECK TABLE t1;
SELECT b1 FROM t1;

SELECT * FROM t1;
SELECT COUNT(*) FROM t1 WHERE a1 <> a OR b1 <> b OR a4 <> a - b OR b3 <> a;
--let $pk_check_index= b1
--let $pk_check_table= t1
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
--let $pk_check_index= a1
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
CHECK TABLE t2;
SELECT LEFT(a, 3), LENGTH(a), LEFT(b, 3), LENGTH(b), h FROM t2 ORDER BY h;
DROP TABLE t2, t1, t0;

CREATE TABLE t1 (a VARCHAR(30), b INT, a2 VARCHAR(30) GENERATED ALWAYS AS (a) VIRTUAL) ENGINE=ROCKSDB;

--error ER_DUP_FIELDNAME
CREATE INDEX idx ON t1(a2(10), b, a2(20));

DROP TABLE t1;

--source include/wait_until_count_sessions.inc
