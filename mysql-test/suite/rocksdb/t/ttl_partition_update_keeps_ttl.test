# PS-12182: an UPDATE that moves a row of a partitioned table with an implicit
# TTL (ttl_duration without ttl_col) to another partition gives the row a new
# TTL timestamp, so it expires ttl_duration after the UPDATE instead of after
# its INSERT. Every other UPDATE keeps the row's original timestamp (see
# ttl_primary.inc, "TTL retains original timestamp during update").
# Expected: the moved row keeps its timestamp (expired rows stay expired).
--source include/have_rocksdb.inc

# With $TTL_NO_PART set the table is not partitioned, so the same UPDATE is a
# plain PK change that keeps the timestamp (control run, same result).
--let $part= PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (100), PARTITION p1 VALUES LESS THAN MAXVALUE)
if ($TTL_NO_PART)
{
  --let $part=
}
--disable_query_log
eval CREATE TABLE t1 (id INT NOT NULL, k INT, PRIMARY KEY (id), KEY kk (k))
  ENGINE=ROCKSDB COMMENT='ttl_duration=2;' $part;
--enable_query_log

--source include/count_sessions.inc
# A READ COMMITTED transaction keeps the TTL read filter time of its first
# snapshot. con_upd takes it before the rows exist, so it can still update them
# after they expired for everyone else; con_r takes it after they expired.
--connect (con_upd,localhost,root,,)
SET SESSION transaction_isolation = 'READ-COMMITTED';
BEGIN;
SELECT COUNT(*) FROM t1;

--connection default
INSERT INTO t1 VALUES (1, 1), (3, 3);
--echo # Wait until rows 1 and 3 are expired for new transactions
--let $wait_timeout= 60
--let $wait_condition= SELECT COUNT(*) = 0 FROM t1
--source include/wait_condition.inc

--connect (con_r,localhost,root,,)
SET SESSION transaction_isolation = 'READ-COMMITTED';
BEGIN;
SELECT COUNT(*) FROM t1;

--connection con_upd
--echo # Row 1 stays in its partition, row 3 moves to p1
UPDATE t1 SET id = 51 WHERE id = 1;
SELECT ROW_COUNT();
UPDATE t1 SET id = 103 WHERE id = 3;
SELECT ROW_COUNT();
COMMIT;
--disconnect con_upd

--connection con_r
--echo # The updated rows keep their expired TTL: none is visible
SELECT id FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 FORCE INDEX (kk) ORDER BY id;
COMMIT;
--disconnect con_r

--connection default
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
