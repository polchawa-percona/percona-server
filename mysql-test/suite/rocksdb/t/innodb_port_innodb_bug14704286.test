#
# Port of innodb.innodb_bug14704286
# (mysql-test/suite/innodb/t/innodb_bug14704286.test) to MyRocks.
#
# A consistent snapshot is held while another transaction updates the
# secondary key of one row 28000 times; the old snapshot then reads that row
# through the secondary key. In InnoDB the read walks a long undo chain and is
# killed. In MyRocks every update leaves a deleted secondary-key entry and a
# new one behind the snapshot; the snapshot must still return exactly the
# row it saw, also after the memtable is flushed and compacted while the
# snapshot pins the old versions.
#
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB.
#   - The KILL QUERY of the slow read is in a separate, debug-only test
#     (innodb_port_innodb_bug14704286_kill), which parks the read at a
#     MyRocks sync point instead of waiting for it to be slow: MyRocks skips
#     the 28000 newer versions quickly, so the original timing-based KILL
#     would not be deterministic.
#   - Added: the snapshot reads the row through the secondary key, the
#     primary key and a full scan, before and after a memtable flush and a
#     manual compaction of the column family, and the new values are visible
#     to a new transaction afterwards.
#   - Runs at REPEATABLE READ (START TRANSACTION WITH CONSISTENT SNAPSHOT),
#     as the original.
#
--source include/have_rocksdb.inc
--source include/big_test.inc
--source include/count_sessions.inc

create table t1 (id int primary key, value int, value2 int,
value3 int, index(value,value2)) ENGINE=ROCKSDB;

insert into t1 values
(10,10,10,10),(11,11,11,11),(12,12,12,12),(13,13,13,13),(14,14,14,14),
(15,15,15,15),(16,16,16,16),(17,17,17,17),(18,18,18,18),(19,19,19,19),
(20,20,20,20);

connect (conn1, localhost, root,,);
connect (conn2, localhost, root,,);

connection conn1;
start transaction with consistent snapshot;

connection conn2;
delimiter |;
CREATE PROCEDURE update_t1()
BEGIN
	DECLARE i INT DEFAULT 1;
	while (i <= 28000) DO
		update test.t1 set value2=value2+1, value3=value3+1 where id=12;
		SET i = i + 1;
	END WHILE;
END|
delimiter ;|
set autocommit=0;
CALL update_t1();
select * from t1 where id = 12;
set autocommit=1;
select * from t1 where id = 12;

connection conn1;
--echo # The old snapshot still sees the original row.
select * from t1 force index(value) where value=12;
select * from t1 force index(primary) where id=12;
select count(*), sum(value2), sum(value3) from t1;

connection default;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'default';

connection conn1;
--echo # After flush and compaction the snapshot still sees the original row.
select * from t1 force index(value) where value=12;
select * from t1 force index(value) where value=12 and value2 = 12;
select * from t1 force index(value) where value=12 and value2 = 28012;
select * from t1 force index(primary) where id=12;
select count(*), sum(value2), sum(value3) from t1;
commit;

--echo # A new transaction sees the updated row.
select * from t1 force index(value) where value=12;
select * from t1 force index(value) where value=12 and value2 = 12;
select * from t1 force index(primary) where id=12;

connection default;
disconnect conn1;
disconnect conn2;
drop procedure update_t1;
drop table t1;
--source include/wait_until_count_sessions.inc
