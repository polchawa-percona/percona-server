[drop_index_thread]
loose-rocksdb_enable_delete_range_for_drop_index=OFF

[delete_range]
loose-rocksdb_enable_delete_range_for_drop_index=ON

[table_scan_stats]
loose-rocksdb_enable_delete_range_for_drop_index=OFF
loose-rocksdb_table_stats_use_table_scan=ON
loose-rocksdb_stats_recalc_rate=10

[stats_settings]
loose-rocksdb_enable_delete_range_for_drop_index=OFF
loose-rocksdb_table_stats_use_table_scan=ON
loose-rocksdb_table_stats_recalc_threshold_count=0
loose-rocksdb_table_stats_sampling_pct=100
loose-rocksdb_stats_recalc_rate=100
loose-rocksdb_seconds_between_stat_computes=0
loose-rocksdb_table_stats_skip_system_cf=ON
loose-rocksdb_force_compute_memtable_stats=OFF
