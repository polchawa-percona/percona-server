--source include/have_debug.inc
--source include/have_rocksdb.inc

--echo #
--echo # Adding, changing and removing TTL on populated MyRocks tables with
--echo # ALTER TABLE. Rows expire in compaction; read filtering is off so that
--echo # COUNT(*) shows what compaction kept. rocksdb.alter_table_comment_inplace
--echo # covers changing ttl_duration in place; this test covers the changes that
--echo # need a COPY rebuild, and what the rebuild does to row timestamps.
--echo #

let $compact = SET GLOBAL rocksdb_force_flush_memtable_now = 1;
let $compact2 = SET GLOBAL rocksdb_compact_cf = 'default';
let $counts = SELECT (SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY)) AS n_pk, (SELECT COUNT(*) FROM t1 FORCE INDEX (kb)) AS n_kb;
let $ddl = SELECT INDEX_NAME, TTL_DURATION, INDEX_FLAGS FROM INFORMATION_SCHEMA.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY INDEX_NAME;

--echo #
--echo # 1. Explicit TTL column added to a populated table. Half the rows have an
--echo #    old timestamp; they expire at the next compaction after the ALTER.
--echo #
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, ts BIGINT UNSIGNED NOT NULL, KEY kb (b)) ENGINE=ROCKSDB;
--disable_query_log
let $i = 1;
while ($i <= 100) {
  if ($i <= 50) {
    eval INSERT INTO t1 VALUES ($i, $i, UNIX_TIMESTAMP() - 1000);
  }
  if ($i > 50) {
    eval INSERT INTO t1 VALUES ($i, $i, UNIX_TIMESTAMP() + 100000);
  }
  inc $i;
}
--enable_query_log
eval $compact; eval $compact2;
eval $counts;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t1 COMMENT = 'ttl_duration=100;ttl_col=ts;', ALGORITHM=INPLACE;
ALTER TABLE t1 COMMENT = 'ttl_duration=100;ttl_col=ts;', ALGORITHM=COPY;
eval $ddl;
eval $counts;
eval $compact; eval $compact2;
eval $counts;
SELECT MIN(a), MAX(a) FROM t1;

--echo # Changing ttl_duration to a longer value keeps rows that would have
--echo # expired with the shorter one.
INSERT INTO t1 VALUES (1, 1, UNIX_TIMESTAMP() - 1000);
ALTER TABLE t1 COMMENT = 'ttl_duration=100000;ttl_col=ts;';
eval $compact; eval $compact2;
eval $counts;

--echo # The TTL column cannot be dropped or made nullable while it is the TTL
--echo # column; its type cannot change to a non-timestamp type.
--error ER_RDB_TTL_COL_FORMAT
ALTER TABLE t1 DROP COLUMN ts;
--error ER_RDB_TTL_COL_FORMAT
ALTER TABLE t1 MODIFY ts BIGINT UNSIGNED NULL;
--error ER_RDB_TTL_COL_FORMAT
ALTER TABLE t1 MODIFY ts VARCHAR(20) NOT NULL;
eval $counts;

--echo # Switching the TTL column to another column re-evaluates expiry by the
--echo # new column.
ALTER TABLE t1 ADD COLUMN ts2 BIGINT UNSIGNED NOT NULL DEFAULT 0;
UPDATE t1 SET ts2 = IF(a % 2 = 0, UNIX_TIMESTAMP() - 1000000, UNIX_TIMESTAMP() + 100000);
ALTER TABLE t1 COMMENT = 'ttl_duration=100;ttl_col=ts2;', ALGORITHM=COPY;
eval $ddl;
eval $compact; eval $compact2;
eval $counts;
SELECT COUNT(*) FROM t1 WHERE a % 2 = 0;

--echo #
--echo # 2. Removing TTL keeps every row, also expired-looking ones.
--echo #
INSERT INTO t1 (a, b, ts, ts2) VALUES (1000, 1000, 0, 0);
ALTER TABLE t1 COMMENT = '', ALGORITHM=COPY;
eval $ddl;
eval $compact; eval $compact2;
SELECT COUNT(*) FROM t1 WHERE a = 1000;
eval $counts;
DROP TABLE t1;

--echo #
--echo # 3. Implicit TTL (no ttl_col) added to a populated table. A COPY rebuild
--echo #    writes new row timestamps, so rows are aged from the ALTER, not from
--echo #    their original insert time.
--echo #
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB;
SET GLOBAL rocksdb_debug_ttl_rec_ts = -1000;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
ALTER TABLE t1 COMMENT = 'ttl_duration=100;', ALGORITHM=COPY;
eval $ddl;
eval $compact; eval $compact2;
eval $counts;
--echo # Time travel past the duration: now they expire, primary and secondary.
SET GLOBAL rocksdb_debug_ttl_snapshot_ts = 1000;
eval $compact; eval $compact2;
SET GLOBAL rocksdb_debug_ttl_snapshot_ts = 0;
eval $counts;

--echo # Rows written while TTL is on, then TTL removed by COPY: the rebuilt rows
--echo # carry no TTL, so time travel no longer expires them.
SET GLOBAL rocksdb_debug_ttl_rec_ts = -1000;
INSERT INTO t1 VALUES (4, 4), (5, 5);
SET GLOBAL rocksdb_debug_ttl_rec_ts = 0;
ALTER TABLE t1 COMMENT = '', ALGORITHM=COPY;
SET GLOBAL rocksdb_debug_ttl_snapshot_ts = 3600;
eval $compact; eval $compact2;
SET GLOBAL rocksdb_debug_ttl_snapshot_ts = 0;
eval $counts;
--echo # Removing implicit TTL in place is not supported.
ALTER TABLE t1 COMMENT = 'ttl_duration=100;', ALGORITHM=COPY;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t1 COMMENT = '', ALGORITHM=INPLACE;

--echo # Restart: the TTL definition survives.
--source include/restart_mysqld.inc
SELECT COUNT(*) FROM t1;
eval $ddl;
SHOW CREATE TABLE t1;
DROP TABLE t1;
