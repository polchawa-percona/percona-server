#
# Systematic error injection into the RocksDB point reads made by DML
# statements and transactions (see suite/rocksdb/include/errinj_loop.inc).
# Every Get/GetForUpdate of each workload fails in turn; the statement must
# then fail and leave the table unchanged, or succeed with the same result as
# without the failure.
#
# Writes and iterator steps are covered by errinj_dml_write and
# errinj_dml_iterator, I/O errors (which abort the server) by errinj_crash.
#
--source include/have_rocksdb.inc
--source include/have_debug.inc

call mtr.add_suppression("Got error [0-9]+ when reading table");

--source suite/rocksdb/include/errinj_dml_setup.inc

--let $errinj_class = READ
--let $errinj_status = BUSY
--source suite/rocksdb/include/errinj_dml_workloads.inc
--let $errinj_status = TIMEDOUT
--source suite/rocksdb/include/errinj_dml_workloads.inc
--let $errinj_status = TRYAGAIN
--source suite/rocksdb/include/errinj_dml_workloads.inc
--let $errinj_status = INCOMPLETE
--source suite/rocksdb/include/errinj_dml_workloads.inc

DROP PROCEDURE errinj_reset;
DROP PROCEDURE errinj_tx_rr;
DROP PROCEDURE errinj_tx_rc;
DROP TABLE t1, t_out;
