#
# Port of innodb.xa_another (mysql-test/suite/innodb/t/xa_another.test) to
# MyRocks.
# Changes from the original:
#   - ENGINE=ROCKSDB on the table
#   - the wait for the disconnected client's transaction uses
#     INFORMATION_SCHEMA.ROCKSDB_TRX (THREAD_ID) instead of
#     INFORMATION_SCHEMA.INNODB_TRX (TRX_MYSQL_THREAD_ID)
#   - a final SELECT checks that the row of the XA transaction committed from
#     the other connection is really there
#
# The expected result is InnoDB's: with xa_detach_on_prepare=OFF, a prepared
# XA transaction survives its client's disconnect and can then be committed
# from another connection.
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc
--echo # The specific purpose of this test is to test the 
--echo # detach at disconnect behavior
SET @saved_xa_detach_on_prepare = @@GLOBAL.xa_detach_on_prepare;
SET GLOBAL xa_detach_on_prepare = OFF;
CREATE TABLE t (id INT PRIMARY KEY) ENGINE=ROCKSDB;

--connect (con1, localhost, root,,)
	XA START "xa1";
	INSERT INTO t VALUES (1);
	XA END "xa1";
	XA PREPARE "xa1";

--connect (con2, localhost, root,,)
	# Trying to commit by XID from another connection, should fail
	# if there is still a client connected to it
	--error ER_XAER_NOTA
	XA COMMIT "xa1";
	# same for rollback
	--error ER_XAER_NOTA
	XA ROLLBACK "xa1";
	# Yet the transaction's XID should appear in the XA RECOVER output
	XA RECOVER;

# We disconnect a client from "xa1", so that it becomes available for con2
--connection con1
--disconnect con1
--source include/wait_until_disconnected.inc

--connection default
# MyRocks: wait until no transaction is still attached to a client thread.
let $wait_condition=
	SELECT COUNT(1)=0
	FROM information_schema.rocksdb_trx
	WHERE thread_id>0 AND thread_id <> CONNECTION_ID();
--source include/wait_condition.inc

--connection con2
	# Check that the XID is still visible
	XA RECOVER;
	# Trying to commit an abandoned XID should now succeed
	XA COMMIT "xa1";
	# And it should no longer appear in the list of available XIDs
	XA RECOVER;
	# Trying to commit it again, should fail
	--error ER_XAER_NOTA
	XA COMMIT "xa1";

--connection default

--disconnect con2

# Added for MyRocks: the committed XA transaction's row must be there.
SELECT * FROM t;
DROP TABLE t;

SET GLOBAL xa_detach_on_prepare = @saved_xa_detach_on_prepare;
--source include/wait_until_count_sessions.inc
