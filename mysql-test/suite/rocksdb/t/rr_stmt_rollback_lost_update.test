--source include/have_rocksdb.inc

--echo #
--echo # A statement rollback must not drop the transaction snapshot. If it
--echo # does, a later write is validated against a newer snapshot and
--echo # silently overwrites a change committed by another session after the
--echo # transaction snapshot (lost update).
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);

--connect (con1,localhost,root,,)

--let $i = 0
while ($i < 2)
{
  --connection default
  SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
  if ($i == 0)
  {
    --echo # Case $i: no failing statement (reference)
  }
  if ($i == 1)
  {
    --echo # Case $i: first write statement fails and is rolled back
  }
  BEGIN;
  SELECT * FROM t1 ORDER BY a;

  --connection con1
  UPDATE t1 SET b = b + 100 WHERE a = 3;

  --connection default
  if ($i == 1)
  {
    --error ER_DUP_ENTRY
    INSERT INTO t1 VALUES (5, 5), (1, 1);
  }
  --echo # Must fail: row a=3 changed after the transaction snapshot.
  --error ER_LOCK_DEADLOCK
  UPDATE t1 SET b = 4 WHERE a = 3;
  ROLLBACK;

  --connection con1
  SELECT * FROM t1 ORDER BY a;
  UPDATE t1 SET b = 3 WHERE a = 3;
  --inc $i
}

--connection default
--disconnect con1
DROP TABLE t1;
