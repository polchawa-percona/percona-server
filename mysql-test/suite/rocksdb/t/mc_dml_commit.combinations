[write_committed]
rocksdb-write-policy=write_committed

[write_prepared]
rocksdb-write-policy=write_prepared

[write_unprepared]
rocksdb-write-policy=write_unprepared
rocksdb-write-batch-flush-threshold=1
rocksdb-manual-compaction-bottommost-level=kSkip

[subcompactions_force]
rocksdb-manual-compaction-threads=4
rocksdb-manual-compaction-bottommost-level=kForce

[filter_bottommost]
rocksdb-write-policy=write_prepared
rocksdb-manual-compaction-bottommost-level=kIfHaveCompactionFilter
