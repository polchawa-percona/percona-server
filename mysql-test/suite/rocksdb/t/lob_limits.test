#
# Very large rows on MyRocks near the server and engine limits:
# max_allowed_packet, rocksdb_write_batch_max_bytes and rocksdb_max_row_locks.
# After each error the data must be unchanged and the transaction usable.
#
# Not a port: the InnoDB row-size tests (innodb.lob_big_rollback,
# innodb.ddl_large_record, innodb.bug120323_row_size_insert_boundary) test
# InnoDB page-format limits that MyRocks does not have, so this test covers the
# limits MyRocks does have instead. Written during the InnoDB LOB port work.
# Runs at READ COMMITTED (-master.opt) because MyRocks rejects gap locks at
# REPEATABLE READ.
#

--source include/have_rocksdb.inc
SET @old_max_allowed_packet = @@GLOBAL.max_allowed_packet;

CREATE TABLE t1 (id INT PRIMARY KEY, b LONGBLOB, t LONGTEXT) ENGINE=ROCKSDB;

--echo #
--echo # 1. max_allowed_packet: a value just below the limit is stored intact,
--echo #    a value above it is rejected without a partial row
--echo #
SET GLOBAL max_allowed_packet = 16 * 1024 * 1024;
connect (con1, localhost, root,,);
INSERT INTO t1 VALUES (1, REPEAT('a', 16 * 1024 * 1024 - 1024), NULL);
SELECT id, LENGTH(b), RIGHT(b, 3) FROM t1;
--error ER_WARN_ALLOWED_PACKET_OVERFLOWED
INSERT INTO t1 VALUES (2, REPEAT('b', 16 * 1024 * 1024 + 1), NULL);
--error ER_WARN_ALLOWED_PACKET_OVERFLOWED
UPDATE t1 SET b = CONCAT(b, REPEAT('c', 2048)) WHERE id = 1;
SELECT id, LENGTH(b), RIGHT(b, 3) FROM t1;
# Two large columns in one row: each below the limit, together above it.
UPDATE t1 SET t = REPEAT('t', 15 * 1024 * 1024) WHERE id = 1;
SELECT id, LENGTH(b), LENGTH(t) FROM t1;
disconnect con1;
connection default;
SET GLOBAL max_allowed_packet = @old_max_allowed_packet;
SELECT id, LENGTH(b), LENGTH(t), CRC32(t) = CRC32(REPEAT('t', 15 * 1024 * 1024)) AS t_ok FROM t1;
DELETE FROM t1;

--echo #
--echo # 2. rocksdb_write_batch_max_bytes: the statement that exceeds the batch
--echo #    limit fails and is rolled back; earlier statements in the same
--echo #    transaction survive and can be committed
--echo #
INSERT INTO t1 VALUES (1, REPEAT('a', 1000), NULL);
SET SESSION rocksdb_write_batch_max_bytes = 100000;
--error ER_GET_ERRMSG
INSERT INTO t1 VALUES (2, REPEAT('b', 200000), NULL);
BEGIN;
INSERT INTO t1 VALUES (5, REPEAT('e', 60000), NULL);
--error ER_GET_ERRMSG
INSERT INTO t1 VALUES (6, REPEAT('f', 60000), NULL);
SELECT id, LENGTH(b) FROM t1 ORDER BY id;
INSERT INTO t1 VALUES (7, 'small', NULL);
COMMIT;
SELECT id, LENGTH(b), LEFT(b, 1) FROM t1 ORDER BY id;
--echo # A LOB update over the limit leaves the old value
--error ER_GET_ERRMSG
UPDATE t1 SET b = REPEAT('z', 300000) WHERE id = 1;
SELECT id, LENGTH(b), LEFT(b, 1) FROM t1 WHERE id = 1;
SET SESSION rocksdb_write_batch_max_bytes = DEFAULT;
UPDATE t1 SET b = REPEAT('z', 300000) WHERE id = 1;
SELECT id, LENGTH(b), LEFT(b, 1) FROM t1 WHERE id = 1;
DELETE FROM t1;

--echo #
--echo # 3. rocksdb_max_row_locks: a LOB update touching more rows than allowed
--echo #    fails as a whole; earlier work in the transaction is kept
--echo #
INSERT INTO t1 (id, b)
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 20)
  SELECT n, REPEAT(CHAR(64 + n), 10000) FROM s;
SET SESSION rocksdb_max_row_locks = 10;
BEGIN;
UPDATE t1 SET b = REPEAT('z', 20000) WHERE id <= 5;
--error ER_GET_ERRMSG
UPDATE t1 SET b = REPEAT('y', 20000);
SELECT COUNT(*), SUM(LENGTH(b)), SUM(LEFT(b, 1) = 'z') AS z_rows, SUM(LEFT(b, 1) = 'y') AS y_rows FROM t1;
COMMIT;
SELECT COUNT(*), SUM(LENGTH(b)), SUM(LEFT(b, 1) = 'z') AS z_rows, SUM(LEFT(b, 1) = 'y') AS y_rows FROM t1;
SET SESSION rocksdb_max_row_locks = DEFAULT;

--echo #
--echo # 4. A large multi-row LOB transaction commits and reads back intact
--echo #    (about 60 MB in one write batch)
--echo #
BEGIN;
UPDATE t1 SET b = REPEAT(CHAR(96 + id), 3 * 1024 * 1024);
COMMIT;
SELECT COUNT(*), SUM(LENGTH(b)), SUM(CRC32(b) = CRC32(REPEAT(CHAR(96 + id), 3 * 1024 * 1024))) AS ok_rows FROM t1;

DROP TABLE t1;
