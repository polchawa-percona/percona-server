#
# Port of innodb.lob_purge (mysql-test/suite/innodb/t/lob_purge.test) to MyRocks.
# Changes from the original:
#   - ENGINE=ROCKSDB written explicitly
#   - part 1: the ALTER is paused at the server sync point alter_opened_table instead
#     of innodb_inplace_alter_table_enter. MyRocks blocks concurrent writes once its
#     ALTER copies or rebuilds the table; at alter_opened_table the ALTER holds only an
#     upgradable metadata lock, so the concurrent transaction can still update the row
#     and roll back, as in the original
#   - part 1 runs at READ COMMITTED because MyRocks rejects gap locks at REPEATABLE READ
#     (the table has no primary key, so the UPDATE scans the hidden key)
#   - part 2 (Bug #28510599) is disabled upstream for InnoDB (BUG#29702764) but is
#     enabled here: InnoDB purge is replaced by a memtable flush and a manual compaction
#     after each batch, and the .ibd file size by the size of the live SST files of the
#     default column family (INFORMATION_SCHEMA.ROCKSDB_LIVE_FILES_METADATA)
#
--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

CREATE TABLE t(j1 JSON) ENGINE=ROCKSDB;

--disable_query_log
INSERT INTO t VALUES
('["Sven", ""]');
--enable_query_log

connect (con1,localhost,root,,);
connection con1;

SET DEBUG_SYNC = 'alter_opened_table SIGNAL start_dml WAIT_FOR alter_continue';
--send ALTER TABLE t row_format = compact;

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR start_dml';

start transaction;
--echo # Sven
select json_extract(j1, '$[0]') from t;

UPDATE t SET j1 = JSON_SET(j1, '$[0]', 'Knut');

--echo # Knut
select json_extract(j1, '$[0]') from t;

UPDATE t SET j1 = JSON_SET(j1, '$[0]', 'Anna');

--echo # Anna
select json_extract(j1, '$[0]') from t;

rollback;

SET DEBUG_SYNC = 'now SIGNAL alter_continue';

connection con1;
--reap

connection default;
disconnect con1;

--echo # Sven
select json_extract(j1, '$[0]') from t;
select length(j1) from t;
check table t;

--source include/wait_until_count_sessions.inc

drop table t;

SET DEBUG_SYNC = reset;

--echo #
--echo # Bug #28510599 THE MYSQL.IBD FILE SIZE IS CONSTANTLY GROWING.
--echo #

let $sst_size = SELECT COALESCE(SUM(SIZE), 0) FROM INFORMATION_SCHEMA.ROCKSDB_LIVE_FILES_METADATA WHERE CF_NAME = 'default';

CREATE TABLE t1 (f1 INT AUTO_INCREMENT PRIMARY KEY, f2 LONGBLOB)
ENGINE=ROCKSDB;
let $i=10;
#Set the SST size limit to 5 MB, which is used to compare
#the SST size after multiple insert-delete operations
SET @fs_limit = 5 * 1024 * 1024;
--echo # Execute multiple insert-delete operations.
--disable_query_log
--let insert_count = 0
while ($i)
{
  let $j=10;
  while ($j)
  {
    INSERT INTO t1 (f2) VALUES (repeat('x', 65764));
    DELETE FROM t1;
    dec $j;
    inc $insert_count;
  }
  dec $i;
  # Clean up after every 10 records
  SET GLOBAL rocksdb_force_flush_memtable_now = 1;
  SET GLOBAL rocksdb_compact_cf = 'default';
}
--enable_query_log
--echo Insert/Delete count = $insert_count
--let $fs = `$sst_size`
if ($fs > 5242880)
{
   --echo Error: The SST size is growing.
   --echo $fs
}
if ($fs <= 5242880)
{
   --echo The SST size is not growing.
}
SELECT COUNT(*) FROM t1;
DROP TABLE t1;

CREATE TABLE t1 (f1 INT AUTO_INCREMENT PRIMARY KEY, f2 LONGBLOB)
ENGINE=ROCKSDB;
INSERT INTO t1 (f2) VALUES (repeat('x', 65764));
let $i=20;
#Set the SST size limit to 10 MB, which is used to compare
#the SST size after multiple update operations
--echo # Execute multiple update operations.
--disable_query_log
--let update_count = 0
while ($i)
{
  let $j=5;
  while ($j)
  {
    UPDATE t1 set f2 = repeat('y', 66764) where f1=1;
    UPDATE t1 set f2 = repeat('x', 65764) where f1=1;
    dec $j;
    inc $update_count;
  }
  dec $i;
  # Clean up after every 5 records
  SET GLOBAL rocksdb_force_flush_memtable_now = 1;
  SET GLOBAL rocksdb_compact_cf = 'default';
}
--enable_query_log
--echo Update count = $update_count
--let $fs = `$sst_size`
if ($fs > 10485760)
{
   --echo Error: The SST size is growing.
   --echo $fs
}
if ($fs <= 10485760)
{
   --echo The SST size is not growing.
}
SELECT f1, LENGTH(f2), LEFT(f2, 3) FROM t1;
DROP TABLE t1;
