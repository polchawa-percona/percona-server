# PS-12263: MyRocks server start or the next DDL statement hangs forever when
# a background flush updates index statistics while the DDL manager is being
# initialized.
#
# Rdb_ddl_manager::init() calls mysql_rwlock_init() on m_rwlock after the
# TransactionDB has been opened. Background flushes can already run then; their
# completion listener (Rdb_event_listener::OnFlushCompleted) calls
# Rdb_ddl_manager::adjust_stats(), which write-locks m_rwlock. A lock
# re-initialized while held is later unlocked by adjust_stats(), its state is
# corrupted, and later users of the lock (the rest of the startup, CREATE
# TABLE, the next adjust_stats()) block forever.
#
# Scenario: kill the server with an open write_unprepared transaction, so that
# its rollback during the restart fills small memtables and starts flushes.
# The debug keyword rocksdb_ddl_manager_init_during_adjust_stats only orders
# the events: the first background adjust_stats() of the startup waits until
# the init has started, then holds the lock until the init has passed the lock
# initialization; the init waits for that holder. max_write_buffer_number=32
# keeps the rollback writes from stalling while that flush thread waits.
#
# Expected: the server starts and a CREATE TABLE + DROP TABLE of a MyRocks
# table completes. Debug only (the ordering hook is debug only).
# The reach asserts assume that background listeners can still take the lock
# while the init runs; a fix that makes them skip adjust_stats() until the init
# is done must adapt the hook and those asserts.

--source include/have_rocksdb.inc
--source include/have_debug.inc
--source include/not_valgrind.inc

# Left behind by the hung CREATE TABLE when the server is killed (unfixed only)
call mtr.add_suppression("Removing table test.t2: CREATE TABLE was interrupted");

CREATE TABLE t1 (pk INT PRIMARY KEY, a INT, b VARCHAR(64), KEY ka (a))
  ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 100)
  SELECT n, n, REPEAT('a', 50) FROM s;

--connect (con1,localhost,root,,test)
SET SESSION cte_max_recursion_depth = 10000;
BEGIN;
# An open write_unprepared transaction: its batches reach the WAL before the
# commit and are rolled back while the restarted server opens the database.
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 6000)
  SELECT n + 1000, n, REPEAT('b', 50) FROM s;

--connection default
--source include/kill_mysqld.inc
--disconnect con1

--let $ddl_check_rc_file= $MYSQLTEST_VARDIR/tmp/ddl_manager_init_stats_hang.inc
--let $ddl_check_script= $MYSQLTEST_VARDIR/tmp/ddl_manager_init_stats_hang.sh
--let $ddl_check_expect= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--write_file $ddl_check_script
#!/bin/bash
# $1 = result file, $2 = expect file of the server, $3 = vardir.
# Waits at most 60 s for the server to accept connections and for a
# CREATE TABLE + DROP TABLE of a MyRocks table, then kills the server
# (a thread blocked on the corrupted lock cannot be stopped otherwise).
timeout 60 bash -c 'until $MYSQL -e "SELECT 1" > /dev/null 2>&1; do sleep 0.2; done;
  $MYSQL test -e "CREATE TABLE t2 (pk INT PRIMARY KEY) ENGINE=ROCKSDB; DROP TABLE t2"' > /dev/null 2>&1
echo "--let \$ddl_check_rc= $?" > "$1"
echo "wait" > "$2"
pkill -9 -f -- "^[^ ]*/mysqld(-debug)? --defaults-group-suffix=\.1 --defaults-file=$3/my\.cnf"
exit 0
EOF

--echo # Restart with the ordering hook; the start and a DDL statement must complete
--exec echo "restart: --debug=d,rocksdb_ddl_manager_init_during_adjust_stats" > $ddl_check_expect
--exec bash $ddl_check_script $ddl_check_rc_file $ddl_check_expect $MYSQLTEST_VARDIR
--source $ddl_check_rc_file
--let $ddl_check_ok= 0
if ($ddl_check_rc == 0)
{
  --let $ddl_check_ok= 1
}
--echo # Server start + CREATE TABLE + DROP TABLE completed within 60 s: $ddl_check_ok

--let $restart_parameters= restart
--source include/start_mysqld.inc

--echo # Reach: the init ran while a background adjust_stats held the lock
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after= CURRENT_TEST: rocksdb.ddl_manager_init_stats_hang
--let $assert_select= MyRocks: test: DDL manager init runs while adjust_stats holds the lock
--let $assert_count= 1
--let $assert_text= DDL manager init ran while a background adjust_stats held the lock
--source include/assert_grep.inc
--let $assert_select= MyRocks: test: background adjust_stats holds the DDL manager lock
--let $assert_text= a background adjust_stats held the DDL manager lock
--source include/assert_grep.inc

SELECT COUNT(*) FROM t1;
CHECK TABLE t1;
DROP TABLE t1;
--remove_file $ddl_check_rc_file
--remove_file $ddl_check_script
