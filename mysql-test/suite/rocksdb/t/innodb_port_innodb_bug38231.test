#
# Port of innodb.innodb_bug38231 (mysql-test/suite/innodb/t/innodb_bug38231.test)
# to MyRocks.
# Changes from the original:
#   - ENGINE=ROCKSDB instead of the InnoDB default engine
#   - the waiting LOCK TABLE and TRUNCATE statements are reaped in order, and
#     the table is checked afterwards (the original only checks for a crash
#     and leaves the waiters running)
#   - rows are inserted so that TRUNCATE has data to remove
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc

CREATE TABLE bug38231_1 (a INT) ENGINE=ROCKSDB;
INSERT INTO bug38231_1 VALUES (1), (2), (3);

--connect (lock_gain,localhost,root,,)
--connect (lock_wait1,localhost,root,,)
--connect (lock_wait2,localhost,root,,)
--connect (truncate_wait,localhost,root,,)

--connection lock_gain
SET autocommit=0;
LOCK TABLE bug38231_1 WRITE;

--connection lock_wait1
SET autocommit=0;
--send LOCK TABLE bug38231_1 WRITE

--connection default
let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.processlist
  WHERE state = 'Waiting for table metadata lock' AND info LIKE 'LOCK TABLE%';
--source include/wait_condition.inc

--connection lock_wait2
SET autocommit=0;
--send LOCK TABLE bug38231_1 WRITE

--connection default
let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.processlist
  WHERE state = 'Waiting for table metadata lock' AND info LIKE 'LOCK TABLE%';
--source include/wait_condition.inc

--connection truncate_wait
--send TRUNCATE TABLE bug38231_1

--connection default
let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.processlist
  WHERE state = 'Waiting for table metadata lock' AND info LIKE 'TRUNCATE%';
--source include/wait_condition.inc

--connection lock_gain
# The original crashed InnoDB here (Bug#38231).
UNLOCK TABLES;

# The waiters get the lock one after another; each releases it right away.
--connection lock_wait1
--reap
UNLOCK TABLES;
--connection lock_wait2
--reap
UNLOCK TABLES;
--connection truncate_wait
--reap

--connection default
SELECT COUNT(*) FROM bug38231_1;
INSERT INTO bug38231_1 VALUES (4);
SELECT * FROM bug38231_1;
CHECK TABLE bug38231_1;

--disconnect lock_gain
--disconnect lock_wait1
--disconnect lock_wait2
--disconnect truncate_wait

DROP TABLE bug38231_1;
--source include/wait_until_count_sessions.inc
