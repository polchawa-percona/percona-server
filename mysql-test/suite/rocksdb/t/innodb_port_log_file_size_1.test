#
# Port of innodb.log_file_size_1 (mysql-test/suite/innodb/t/log_file_size_1.test) to
# MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - MyRocks rejects ROLLBACK TO SAVEPOINT after rows were modified
#     (ER_ROLLBACK_TO_SAVEPOINT, a documented limitation) and the transaction can then
#     only be rolled back. This is recorded; the committed state of the original
#     (rows 11..13 committed, rows 21..23 rolled back) is then built with a committed
#     transaction and a rolled-back one
#   - innodb_checkpoint_disabled + innodb_fast_shutdown=2 (shutdown that needs crash
#     recovery) are replaced by killing the server, so the committed rows are recovered
#     from the RocksDB WAL
#   - --innodb-redo-log-capacity is replaced by --rocksdb_max_total_wal_size (20M,
#     then 8M); the search for the crash-recovery message is dropped
#   - no debug features are used, so the test also runs on release builds
#
--echo # Test changing the RocksDB WAL size limit across crash recovery.

--source include/have_rocksdb.inc
--source include/not_crashrep.inc

CREATE TABLE t1(id INT PRIMARY KEY,bfield BLOB) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1,repeat('a',2000)),(2,repeat('b',2000)),
(3,repeat('c',2000));

--echo # ROLLBACK TO SAVEPOINT after modifications is not supported by MyRocks
START TRANSACTION;
INSERT INTO t1 VALUES (11,repeat('a',2000)),(12,repeat('b',2000)),
(13,repeat('c',2000));
SAVEPOINT A;
INSERT INTO t1 VALUES (21,repeat('a',2000)),(22,repeat('b',2000)),
(23,repeat('c',2000));
SAVEPOINT B;
SELECT id,LEFT(bfield,20) FROM t1;
--error ER_ROLLBACK_TO_SAVEPOINT
ROLLBACK TO A;
--error ER_ROLLBACK_ONLY
COMMIT;
ROLLBACK;
SELECT id,LEFT(bfield,20) FROM t1;

--echo # The same final state without ROLLBACK TO SAVEPOINT
START TRANSACTION;
INSERT INTO t1 VALUES (11,repeat('a',2000)),(12,repeat('b',2000)),
(13,repeat('c',2000));
COMMIT;
START TRANSACTION;
INSERT INTO t1 VALUES (21,repeat('a',2000)),(22,repeat('b',2000)),
(23,repeat('c',2000));
ROLLBACK;
SELECT id,LEFT(bfield,20) FROM t1;

--echo
--echo # Kill and restart with a different WAL size limit (20M)
--let $restart_parameters = restart: --rocksdb_max_total_wal_size=20971520
--source include/kill_and_restart_mysqld.inc

SELECT @@rocksdb_max_total_wal_size;
SELECT id,LEFT(bfield,20) FROM t1;

--ERROR ER_DUP_ENTRY
INSERT INTO t1 VALUES (1,repeat('a',2000)),(2,repeat('b',2000)),
(3,repeat('c',2000));
INSERT INTO t1 VALUES (21,repeat('a',2000)),(22,repeat('b',2000)),
(23,repeat('c',2000));
SELECT id,LEFT(bfield,20) FROM t1;

--echo
--echo # Kill and restart with a different WAL size limit (8M)
--let $restart_parameters = restart: --rocksdb_max_total_wal_size=8388608
--source include/kill_and_restart_mysqld.inc

SELECT @@rocksdb_max_total_wal_size;
--ERROR ER_DUP_ENTRY
INSERT INTO t1 VALUES (21,repeat('a',2000));
INSERT INTO t1 VALUES (24,repeat('a',2000)),(25,repeat('b',2000));
SELECT id,LEFT(bfield,20) FROM t1;

--echo
--echo # Kill and restart with default parameters
--let $restart_parameters = restart
--source include/kill_and_restart_mysqld.inc

SELECT id,LEFT(bfield,20) FROM t1;
CHECK TABLE t1;

--echo
--echo # Cleanup
DROP TABLE t1;
