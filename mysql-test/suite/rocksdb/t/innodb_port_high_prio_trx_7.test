#
# Port of innodb.high_prio_trx_7 (mysql-test/suite/innodb/t/high_prio_trx_7.test) to MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - MyRocks has no high-priority transactions: start_transaction_high_prio.inc and the
#     dbug_set_high_prio_trx debug keyword are replaced by plain START TRANSACTION, and the
#     scenarios check the ordinary MyRocks outcome of the same lock-ordering sequences:
#     row locks vs LOCK TABLES (scenarios 1, 2, 4), shared locks in READ ONLY transactions
#     (scenario 3), a chain of waiters on one row (scenario 5, serialized: see there) and
#     the read of Bug#21075892, where InnoDB's semi-consistent read does not wait but
#     MyRocks, which has no semi-consistent read, waits for the row lock
#   - scenarios 6 and 7 (XA transactions marked high priority) are not ported: they need XA
#     with MyRocks, which is covered by the XA test work
#   - runs at READ COMMITTED (-master.opt): at REPEATABLE READ, waiters in scenario 5 fail
#     with ER_LOCK_DEADLOCK (snapshot conflict) once the row they wait for is committed, and
#     the unrestricted UPDATE in scenario 4 is rejected by the gap-lock rule; scenario 4
#     checks that rule explicitly at REPEATABLE READ
#   - waits are detected with INFORMATION_SCHEMA.ROCKSDB_TRX (row locks) or the processlist
#     (table locks) instead of fixed sleeps, so the test needs no debug build
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc
SET @saved_lock_wait_timeout = @@global.rocksdb_lock_wait_timeout;
SET GLOBAL rocksdb_lock_wait_timeout = 30;
SET SESSION rocksdb_lock_wait_timeout = 30;

--echo # Scenario:1
--echo #  T1= ({W(B)})
--echo #  T2= ( Try to take table level lock )
--echo # Outcome: T2 waits for T1 to commit before it gets the table lock

CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);

--connect(con1,localhost,root,,test)
--connect(con2,localhost,root,,test)

--connection con1
START TRANSACTION;
UPDATE t1 SET c1=1 WHERE c1=0;

--connection con2
--let $con2_id= `SELECT CONNECTION_ID()`
--send LOCK TABLE t1 WRITE/* From connection 2 */

--connection con1
--let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.processlist WHERE id = $con2_id AND INFO = 'LOCK TABLE t1 WRITE/* From connection 2 */' AND STATE = 'Waiting for table metadata lock'
--source include/wait_condition.inc
COMMIT;

--connection con2
--reap
SELECT * FROM t1;
UNLOCK TABLES;

--connection default
--let $assert_text= 'There is a 1 in t1'
--let $assert_cond= [SELECT COUNT(*) AS count FROM t1 WHERE t1.c1 = 1, count, 1] = 1
--source include/assert.inc

DROP TABLE t1;
--disconnect con1
--disconnect con2

--echo # Scenario:2
--echo #  T1= (LOCK TABLE)
--echo #  T2= ({ W(B)})
--echo # Outcome : T2 waits for T1.

CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);

--connect(con1,localhost,root,,test)
--connect(con2,localhost,root,,test)

--connection con2
LOCK TABLE t1 WRITE/* From connection 2 */;
UPDATE t1 SET c1=2 WHERE c1=0;

--connection con1
--let $con1_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
--send UPDATE t1 SET c1=1 WHERE c1=0

--connection con2
--let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.processlist WHERE id = $con1_id AND INFO = 'UPDATE t1 SET c1=1 WHERE c1=0' AND STATE = 'Waiting for table metadata lock'
--source include/wait_condition.inc
COMMIT;
UNLOCK TABLES;

--connection con1
--reap
SELECT ROW_COUNT() AS con1_updated;
COMMIT;

--connection default
SELECT * FROM t1;
DROP TABLE t1;
--disconnect con1
--disconnect con2

--echo # Scenario:3
--echo #  T1= ({R(B)}, READ ONLY)
--echo #  T2= ({ R(B)}, READ ONLY)
--echo # Outcome: Both T1 and T2 continue as they only take shared locks; a writer waits.

CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);

--connect(con1,localhost,root,,test)
--connect(con2,localhost,root,,test)
--connect(con3,localhost,root,,test)

--connection con1
START TRANSACTION READ ONLY;
SELECT c1 FROM t1 WHERE c1=0 LOCK IN SHARE MODE;

--connection con2
START TRANSACTION READ ONLY;
SELECT c1 FROM t1 WHERE c1=0 LOCK IN SHARE MODE;

--connection con3
SET SESSION rocksdb_lock_wait_timeout = 1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t1 SET c1=1 WHERE c1=0;

--connection con1
COMMIT;

--connection con2
COMMIT;

--connection con3
UPDATE t1 SET c1=1 WHERE c1=0;

--connection default
SELECT * FROM t1;
DROP TABLE t1;
--disconnect con1
--disconnect con2
--disconnect con3

--echo # Scenario:4
--echo # Start of transaction causes table locks acquired with LOCK TABLES to be released
--echo # LOCK TABLES Implicitly commit any active transaction

CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t2 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);
INSERT INTO t2 VALUES (0);

--connect(con1,localhost,root,,test)

--connection con1
LOCK TABLE t2 WRITE;
--echo # In_use is 1
SHOW OPEN TABLES LIKE 't2';
START TRANSACTION;
--echo # In_use is 0 , its released due to start transaction statement
SHOW OPEN TABLES LIKE 't2';
UPDATE t1 SET c1=1;
ROLLBACK;
--echo # At REPEATABLE READ the same multi-statement update hits the gap-lock rule
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--replace_regex /Query: .*/Query: <query>/
--error ER_UNKNOWN_ERROR
UPDATE t1 SET c1=1;
UPDATE t1 SET c1=1 WHERE c1=0;
--echo # Implicitly commits active transaction
LOCK TABLE t1 READ;
UNLOCK TABLES;

--connection default
--let $assert_text= 'There is a 1 in t1'
--let $assert_cond= [SELECT COUNT(*) AS count FROM t1 WHERE t1.c1 = 1, count, 1] = 1
--source include/assert.inc

DROP TABLES t1,t2;
--disconnect con1

--echo # Scenario:5
--echo # Concurrent transactions waiting on the same row, one after another.
--echo # Outcome : each waiter is granted when the previous holder commits

# The InnoDB original queues three waiters on the row at once and relies on InnoDB granting
# them in FIFO order. The RocksDB point lock manager wakes every waiter of a lock stripe
# (NotifyAll) and the first one to retry wins, so the grant order of several simultaneous
# waiters is not deterministic. Here every waiter queues behind the previous one, which
# keeps the same statements, the same holders and the same final result.

CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (0);

--connect(con1,localhost,root,,test)
--connect(con2,localhost,root,,test)
--connect(con3,localhost,root,,test)
--connect(con4,localhost,root,,test)
--connect(con5,localhost,root,,test)

--connection con1
START TRANSACTION;
--echo # connection 1:
# a statement rollback keeps the transaction and its locks
--error ER_DUP_ENTRY
INSERT INTO t1 VALUES (0);
UPDATE t1 SET c1=1 WHERE c1=0;

--connection con2
--let $con2_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
--echo # connection 2: wait - update
--send UPDATE t1 SET c1=2 WHERE c1=1 /* From connection 2 */

--connection con5
--let $wait_conn_id= $con2_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc
START TRANSACTION;
--echo # connection 5: Insert goes but as it new row
INSERT INTO t1 VALUES (50);

--connection con1
--echo # connection 1:
COMMIT;

--connection con2
--echo # connection 2: Reap UPDATE t1 SET c1=2 WHERE c1=1
--reap
SELECT ROW_COUNT() AS con2_updated;

--connection con3
--let $con3_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
--echo # connection 3: wait - delete
--send DELETE FROM t1 WHERE c1=1 /* From connection 3 */

--connection con2
--let $wait_conn_id= $con3_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc
COMMIT;

--connection con3
--echo # connection 3: Reap DELETE FROM t1 WHERE c1=1
--reap
SELECT ROW_COUNT() AS con3_deleted;

--connection con4
--let $con4_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
--echo # connection 4: wait - insert
--send INSERT INTO t1 VALUES (1) /* From connection 4 */

--connection con3
--let $wait_conn_id= $con4_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc
COMMIT;

--connection con4
--echo # connection 4: Reap INSERT INTO t1 VALUES (1)
--reap
COMMIT;

--connection con1
INSERT INTO t1 VALUES (3);
UPDATE t1 SET c1=4 WHERE c1=2;
--let $con1_id= `SELECT CONNECTION_ID()`
# con1 is in autocommit mode now; the insert waits for con5, which holds the new key 50.
--send INSERT INTO t1 VALUES (50)

--connection con5
--let $wait_conn_id= $con1_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc
COMMIT;

--connection con1
--error ER_DUP_ENTRY
--reap

--connection default
--let $assert_text= 'There is a 3 in t1'
--let $assert_cond= [SELECT COUNT(*) AS count FROM t1 WHERE t1.c1 = 3, count, 1] = 1
--source include/assert.inc
--echo # Expected values : 1,3,4,50
SELECT * FROM t1 order by c1;

DROP TABLES t1;

--disconnect con1
--disconnect con2
--disconnect con3
--disconnect con4
--disconnect con5

--echo #
--echo # Bug#21075892 SHUTDOWN HANG, WAITING FOR ASYNC ROLLBACK TO FINISH
--echo #

--connect(con1,localhost,root,,test)
CREATE TABLE t1(col1 INT PRIMARY KEY, col2 INT) ENGINE=ROCKSDB;
INSERT INTO t1 values(10, 10), (20, 20), (30, 30);

--echo #connection 0
--connection default
START TRANSACTION;
--echo #Lock record (col1 = 20)
UPDATE t1 set col2 = 25 where col1 = 20;

--echo #connection 1
--connection con1
--let $con1_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
# InnoDB does a semi-consistent read here: the last committed version of the locked row
# does not match col2 = 30, so the UPDATE skips it without waiting. MyRocks has no
# semi-consistent read: the UPDATE waits for the row lock even though the row cannot match.
--echo #MyRocks waits for the row locked by connection 0
--send UPDATE t1 SET col2 = 20 where col1 > 10 and col1 <30 and col2 = 30

--echo #connection 0
--connection default
--let $wait_conn_id= $con1_id
--source suite/rocksdb/include/innodb_port_wait_for_lock.inc
ROLLBACK WORK;

--echo #connection 1
--connection con1
--reap
SELECT ROW_COUNT() AS con1_updated;
COMMIT WORK;

--connection default
SELECT * FROM t1 ORDER BY col1;
DROP TABLE t1;
--disconnect con1

SET GLOBAL rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
SET SESSION rocksdb_lock_wait_timeout = @saved_lock_wait_timeout;
--source include/wait_until_count_sessions.inc
