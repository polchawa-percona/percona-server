--let $errinj_class = DICT_READ
--let $errinj_status = IOERROR
# Other dictionary reads of the statement may abort the server by design.
--let $errinj_crash = 1

--let $s_list = pk,reverse_cf,ttl
while ($s_list) {
  --let $shape = `SELECT SUBSTRING_INDEX('$s_list', ',', 1)`
  --let $s_list = `SELECT IF(LOCATE(',', '$s_list') > 0, SUBSTRING('$s_list', LOCATE(',', '$s_list') + 1), '')`
  --let $errinj_reset = CALL fr1_reset('$shape')
  --let $errinj_label = $shape DICT_READ/IOERROR COPY ALTER
  --source suite/rocksdb/include/errinj_loop.inc
}

# COPY ALTER TABLE works afterwards.
CALL fr1_reset('reverse_cf');
ALTER TABLE t ADD COLUMN z INT NOT NULL DEFAULT 5, ALGORITHM=COPY;
ALTER TABLE t DROP COLUMN z, ALGORITHM=COPY;
SELECT COUNT(*), SUM(a) FROM t;
CHECK TABLE t;

DROP TABLE t;
DROP PROCEDURE fr1_reset;
DROP PROCEDURE fr1_state;
DROP PROCEDURE errinj_tables_state;
