[defaults]

[instant_off]
rocksdb_enable_instant_ddl=OFF
rocksdb_alter_column_default_inplace=OFF

[instant_all]
rocksdb_enable_instant_ddl_for_append_column=ON
rocksdb_enable_instant_ddl_for_column_default_changes=ON
rocksdb_enable_instant_ddl_for_table_comment_changes=ON
rocksdb_enable_instant_ddl_for_drop_index_changes=ON

[inplace_switches]
rocksdb_alter_column_default_inplace=ON
rocksdb_alter_table_comment_inplace=ON
rocksdb_allow_unsafe_alter=ON

[master_off_subs_on]
rocksdb_enable_instant_ddl=OFF
rocksdb_enable_instant_ddl_for_append_column=ON
rocksdb_enable_instant_ddl_for_column_default_changes=ON
rocksdb_enable_instant_ddl_for_table_comment_changes=ON
rocksdb_enable_instant_ddl_for_drop_index_changes=ON
rocksdb_alter_table_comment_inplace=ON
