--source include/have_rocksdb.inc
# Hunt tests, part 4: composite-key depth on a 3-part tinyint/bigint key:
# bounds on the (b, c) prefix vs bloom on the full (b, c, d) prefix,
# three-interval bounds->bloom->bounds alternation in one statement, and
# a two-interval bloom->bloom control with the same first two parts.
# Differential vs an identical InnoDB table.
# (Fix under test: aae69cc8f6b; per-test opt file:
# prefix_extractor=capped:12, bloom eligible iff eq_cond_len >= 12.)
#
# Packed key arithmetic (packed key = 4-byte index id + parts; a
# nullable tinyint is 2B and a nullable bigint is 9B, i.e. value bytes
# plus a 1-byte NULL flag), index idx_bcd(b, c, d):
#   b only        -> eq_cond 4+2     =  6 -> iterator bounds
#   (b, c)        -> eq_cond 4+2+2   =  8 -> iterator bounds
#   (b, c, d)     -> eq_cond 4+2+2+9 = 17 -> prefix bloom
#
# The range optimizer scans OR-intervals in KEY order; the comments below
# state the key order.
#
# Bloom-delta evidence: with session rocksdb_perf_context_level=2, the sum
# of BLOOM_{SST,MEMTABLE}_{HIT,MISS}_COUNT in
# INFORMATION_SCHEMA.ROCKSDB_PERF_CONTEXT_GLOBAL grows by exactly one per
# range interval that takes the prefix bloom path, and by zero per bounds
# interval; a full-scan plan would read 0, so the exact expected values
# double as a guard against silent plan changes.
# Result sets are asserted identical to the InnoDB twin via
# count+CRC32 fingerprint.

create table t_d(
  a int,
  b tinyint,
  c tinyint,
  d bigint,
  primary key(a), key idx_bcd(b, c, d)
) engine=rocksdb;
create table t_di(
  a int,
  b tinyint,
  c tinyint,
  d bigint,
  primary key(a), key idx_bcd(b, c, d)
) engine=innodb;
insert into t_d values(1,2,1,1),(2,1,3,3),(3,1,3,4),(4,2,1,5),(5,2,2,6);
insert into t_di values(1,2,1,1),(2,1,3,3),(3,1,3,4),(4,2,1,5),(5,2,2,6);
--disable_query_log
BEGIN;
let $i = 100;
while ($i < 400)
{
  eval insert into t_d values($i, 10, 10, $i);
  eval insert into t_di values($i, 10, 10, $i);
  inc $i;
}
COMMIT;
--enable_query_log
set global rocksdb_force_flush_memtable_now = 1;
analyze table t_d;
analyze table t_di;
set session rocksdb_perf_context_level = 2;

# --- Q16 (key order: bounds -> bloom -> bounds): (b=1,c=2) bounds
#     (eq_cond 8, holds no row), then (b=1,c=3,d=3) bloom (eq_cond 17),
#     then b=2 bounds (eq_cond 6); expected delta 1 ---
--replace_column 10 # 11 #
explain select a from t_d force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2 order by a;
--let $bl0 = `SELECT IFNULL(SUM(VALUE),0) FROM INFORMATION_SCHEMA.ROCKSDB_PERF_CONTEXT_GLOBAL WHERE STAT_TYPE IN ('BLOOM_SST_HIT_COUNT','BLOOM_MEMTABLE_HIT_COUNT','BLOOM_SST_MISS_COUNT','BLOOM_MEMTABLE_MISS_COUNT')`
select a from t_d force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2 order by a;
--let $bl1 = `SELECT IFNULL(SUM(VALUE),0) FROM INFORMATION_SCHEMA.ROCKSDB_PERF_CONTEXT_GLOBAL WHERE STAT_TYPE IN ('BLOOM_SST_HIT_COUNT','BLOOM_MEMTABLE_HIT_COUNT','BLOOM_SST_MISS_COUNT','BLOOM_MEMTABLE_MISS_COUNT')`
--let $delta = `SELECT $bl1 - $bl0`
--echo bloom_intervals $delta
--let $assert_text = Q16 bloom delta is 1
--let $assert_cond = ($bl1 - $bl0) = 1
--source include/assert.inc
select a from t_di force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2 order by a;
--let $f_r = `select concat(count(*),':',ifnull(sum(crc32(concat(a,0x1f,b,0x1f,c,0x1f,d))),0)) from t_d force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2`
--let $f_i = `select concat(count(*),':',ifnull(sum(crc32(concat(a,0x1f,b,0x1f,c,0x1f,d))),0)) from t_di force index(idx_bcd) where (b = 1 and c = 2) or (b = 1 and c = 3 and d = 3) or b = 2`
--let $assert_text = Q16 rocksdb == innodb
--let $assert_cond = "$f_r" = "$f_i"
--source include/assert.inc

# --- Q17 (two bloom intervals, key order d=3 -> d=4): same (b,c) prefix
#     paired with different third-part values, both eq_cond 17;
#     expected delta 2 ---
--let $bl0 = `SELECT IFNULL(SUM(VALUE),0) FROM INFORMATION_SCHEMA.ROCKSDB_PERF_CONTEXT_GLOBAL WHERE STAT_TYPE IN ('BLOOM_SST_HIT_COUNT','BLOOM_MEMTABLE_HIT_COUNT','BLOOM_SST_MISS_COUNT','BLOOM_MEMTABLE_MISS_COUNT')`
select a from t_d force index(idx_bcd) where (b = 1 and c = 3 and d = 3) or (b = 1 and c = 3 and d = 4) order by a;
--let $bl1 = `SELECT IFNULL(SUM(VALUE),0) FROM INFORMATION_SCHEMA.ROCKSDB_PERF_CONTEXT_GLOBAL WHERE STAT_TYPE IN ('BLOOM_SST_HIT_COUNT','BLOOM_MEMTABLE_HIT_COUNT','BLOOM_SST_MISS_COUNT','BLOOM_MEMTABLE_MISS_COUNT')`
--let $delta = `SELECT $bl1 - $bl0`
--echo bloom_intervals $delta
--let $assert_text = Q17 bloom delta is 2
--let $assert_cond = ($bl1 - $bl0) = 2
--source include/assert.inc
select a from t_di force index(idx_bcd) where (b = 1 and c = 3 and d = 3) or (b = 1 and c = 3 and d = 4) order by a;
--let $f_r = `select concat(count(*),':',ifnull(sum(crc32(concat(a,0x1f,b,0x1f,c,0x1f,d))),0)) from t_d force index(idx_bcd) where (b = 1 and c = 3 and d = 3) or (b = 1 and c = 3 and d = 4)`
--let $f_i = `select concat(count(*),':',ifnull(sum(crc32(concat(a,0x1f,b,0x1f,c,0x1f,d))),0)) from t_di force index(idx_bcd) where (b = 1 and c = 3 and d = 3) or (b = 1 and c = 3 and d = 4)`
--let $assert_text = Q17 rocksdb == innodb
--let $assert_cond = "$f_r" = "$f_i"
--source include/assert.inc

drop table t_d;
drop table t_di;
