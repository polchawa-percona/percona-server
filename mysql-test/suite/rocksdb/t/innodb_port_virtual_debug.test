--echo #
--echo # BUG#28448853 - ASSERTION FAILURE: ROW0LOG.CC:2153 ROW_LOG_TABLE_APPLY (THR=0X7F7C7C050030
--echo #

CREATE TABLE t1(a INT NOT NULL, d INT NOT NULL, b VARCHAR(198) NOT NULL, c CHAR(84), vbcol CHAR(2) AS (substr(b, 2, 2)) VIRTUAL) ENGINE=ROCKSDB;

INSERT INTO t1(a, d, b, c) VALUES(200, 300, '1.3.1415926535', 'hello world');

SELECT * FROM t1;

connection default;

SET DEBUG_SYNC = 'alter_table_copy_after_lock_upgrade SIGNAL altered WAIT_FOR dmls_done';

--send ALTER TABLE t1 ROW_FORMAT = COMPRESSED;

connection conn1;

SET DEBUG_SYNC = 'now WAIT_FOR altered';

SELECT * FROM t1;

SET DEBUG_SYNC = 'now SIGNAL dmls_done';

disconnect conn1;
disconnect conn2;

connection default;

reap;

START TRANSACTION;
UPDATE t1 SET b = '6.1516179' WHERE a = 200;
ROLLBACK;

SET DEBUG_SYNC = 'reset';

CHECK TABLE t1;

SHOW CREATE TABLE t1;

SELECT * FROM t1;

DROP TABLE t1;



--echo #
--echo # Bug#28825718 - ASSERTION FAILURE: TRX0REC.CC:NNN:N_IDX > 0 WHILE DOING REPLACE/INSERT
--echo #

CREATE TABLE t1(a INT PRIMARY KEY, b INT, c INT GENERATED ALWAYS AS(b+1) VIRTUAL) ENGINE=ROCKSDB;

INSERT INTO t1(a, b) VALUES(1, 1);

BEGIN;
INSERT INTO t1(a, b) VALUES(2, 2);

connect (con1,localhost,root,,);
connection con1;
SET lock_wait_timeout = 1;
--echo /* con1 */ ALTER TABLE t1 ADD UNIQUE INDEX(c, b);
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE t1 ADD UNIQUE INDEX(c, b);

disconnect con1;

connection default;
COMMIT;

ALTER TABLE t1 ADD KEY(b);

INSERT INTO t1(a, b) VALUES(3, 3);

SELECT * FROM t1;

CHECK TABLE t1;
SHOW CREATE TABLE t1;

DROP TABLE t1;

--echo #
--echo # Bug#28834208 ROW_LOG_TABLE_APPLY_UPDATE*INPLACE_ALTER_TABLE
--echo #

CREATE TABLE t1 (
   pkey INT(11) PRIMARY KEY,
   a VARCHAR(100),
   v VARCHAR(100) GENERATED ALWAYS AS (SUBSTRING(a,2,2)) VIRTUAL,
   c varchar(100),
  UNIQUE KEY k (v)
) ENGINE=ROCKSDB;
INSERT INTO t1 ( pkey,a,c) VALUES (149,'bata','test');
SELECT pkey,a,v FROM t1;
SET DEBUG_SYNC = 'after_admin_flush SIGNAL index_built WAIT_FOR S2';
--send OPTIMIZE TABLE t1
connect (con1,localhost,root,,);
connect (con2,localhost,root,,);
--echo # Connect to con1
--connection con1
SET DEBUG_SYNC = 'now WAIT_FOR index_built';
--connection con2
--send UPDATE t1 SET a='tata' WHERE pkey=149
--connection con1
--source include/wait_condition.inc
SET DEBUG_SYNC ='now signal S2';
--connection con2
reap;
SELECT pkey,a,v FROM t1;
--connection default
--echo # Connect to Default
reap;
SELECT * FROM t1;
--let $pk_check_table= t1
--let $pk_check_index= k
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t1;

CREATE TABLE t1 (
   pkey INT(11) PRIMARY KEY,
   a VARCHAR(100),
   v VARCHAR(100) GENERATED ALWAYS AS (SUBSTRING(a,2,2)) VIRTUAL,
   c varchar(100),
   v1 VARCHAR(100) GENERATED ALWAYS AS (SUBSTRING(c,2,2)) VIRTUAL,
   KEY k (v),
   KEY v (v1)
) ENGINE=ROCKSDB;
INSERT INTO t1 (pkey, a, c) VALUES (149, 'bata', 'test');
INSERT INTO t1 (pkey, a, c) VALUES (150, 'bata', 'test');
INSERT INTO t1 (pkey, a, c) VALUES (160, 'bata', 'test');
SELECT pkey, a, v, c, v1 FROM t1;
SET DEBUG_SYNC = 'after_admin_flush SIGNAL index_built WAIT_FOR S2';
--send OPTIMIZE TABLE t1
--connection con1
SET DEBUG_SYNC = 'now WAIT_FOR index_built';
--connection con2
--send UPDATE t1 SET c = 'best' WHERE pkey = 149
--connection con1
--source include/wait_condition.inc
SET DEBUG_SYNC ='now signal S2';
--connection con2
reap;
UPDATE t1 SET a = 'tata' WHERE pkey = 150;
UPDATE t1 SET a = 'tata', c = 'best' WHERE pkey = 160;
SELECT pkey, a, v, c, v1 FROM t1;
--connection default
--echo # Connect to Default
reap;
SELECT * FROM t1;
--let $pk_check_table= t1
--let $pk_check_index= k
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
--let $pk_check_index= v
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t1;

CREATE TABLE t1(
   j SERIAL PRIMARY KEY,
   a VARCHAR(36),
   isa BOOLEAN,
   ab VARCHAR(36) AS (IF(`isa`,`a`,NULL )),
   KEY k(ab)
) ENGINE=ROCKSDB;
INSERT INTO t1 (a, isa) VALUES ('test', 1);
SET DEBUG_SYNC = 'after_admin_flush SIGNAL index_built WAIT_FOR S2';
--send OPTIMIZE TABLE t1
--connection con1
SET DEBUG_SYNC = 'now WAIT_FOR index_built';
--connection con2
--send UPDATE t1 SET isa=0
--connection con1
--source include/wait_condition.inc
SET DEBUG_SYNC ='now signal S2';
--connection con2
reap;
SELECT j,a,isa,ab FROM t1;
disconnect con1;
disconnect con2;
--echo # Connect to Default
--connection default
reap;
SELECT j,a,isa,ab FROM t1;
UPDATE t1 SET isa = 1 WHERE a = 'test' AND isa = 0;
SELECT j,a,isa,ab FROM t1;
--let $pk_check_table= t1
--let $pk_check_index= k
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t1;



# Test for the rollback scenario when both a virtual column and a virtual
# Index are added. MyRocks adds the virtual column with COPY, and the index
# build on it fails.

CREATE TABLE t1(a INT) ENGINE=ROCKSDB;

INSERT INTO t1 VALUES(1), (1);

ALTER TABLE t1 ADD COLUMN (h INT GENERATED ALWAYS AS(a+1) VIRTUAL);

set session debug = '+d,myrocks_simulate_index_create_rollback';

connect (conn1,localhost,root,,);

connection default;

SET DEBUG_SYNC='alter_table_inplace_after_lock_downgrade SIGNAL rolling_back WAIT_FOR drop_created';
--send ALTER TABLE t1 ADD INDEX idx(h), ALGORITHM=INPLACE;

connection conn1;
SET DEBUG_SYNC='now WAIT_FOR rolling_back';
SELECT * FROM t1;
SET DEBUG_SYNC='now SIGNAL drop_created';

connection default;
--error ER_UNKNOWN_ERROR
--reap

connection conn1;
SELECT * FROM t1;

disconnect conn1;

connection default;

set session debug = '-d,myrocks_simulate_index_create_rollback';

INSERT INTO t1(a) VALUES(1);

CHECK TABLE t1;
SHOW CREATE TABLE t1;

DROP TABLE t1;

--echo #
--echo # Bug 31279528 - CRASH IN MYSQL SERVER, ASSERTION FAILURE: DICT0DICT.CC
--echo #
CREATE TABLE t1 (c1 INT) ENGINE=ROCKSDB;

# Create a secondary index which will cause virtual columns to be added into table
CREATE INDEX idx ON t1 ( ( c1 = 127 ) , ( c1 + c1 ) , c1 , ( c1 + - -1 ) , (c1 > 26 ) ) ;

SHOW WARNINGS;

SHOW CREATE TABLE t1;

SET SESSION debug= '+d,skip_dd_table_access_check';
SELECT ID INTO @tid FROM mysql.tables WHERE NAME='t1';
SELECT NAME, ORDINAL_POSITION, TYPE, HIDDEN, GENERATION_EXPRESSION_UTF8 FROM mysql.columns WHERE TABLE_ID=@tid ORDER BY ORDINAL_POSITION;
SET SESSION debug= '-d,skip_dd_table_access_check';

INSERT INTO t1 VALUES (1), (127), (200);
SELECT * FROM t1 FORCE INDEX (idx) WHERE c1 = 127 AND c1 + c1 = 254;

DROP TABLE t1;


--echo #
--echo # Bug #30556595  FAILING ASSERTION: !CURSOR->INDEX->IS_COMMITTED()
--echo # ON TABLE WITH GCOLS
--echo #

--echo # Set binlog_row_image = MINIMAL.
SET @old_binlog_row_image = @@binlog_row_image;
SET @@session.binlog_row_image = 'MINIMAL';

--echo # Testcase-1
CREATE TABLE t (pid int PRIMARY KEY,
                uid int,
                vid int AS (uid) VIRTUAL) ENGINE=ROCKSDB;
connect(con1,localhost,root,,);
connect(con2,localhost,root,,);
connection con1;
--echo # Create index on virtual column and pause it.
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL start_dml WAIT_FOR resume_ddl';
--send ALTER TABLE t ADD INDEX idx_vid(vid), algorithm=inplace
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR start_dml';
connection con2;
--echo # Insert a record queued behind the ALTER.
--send INSERT INTO t(pid, uid) VALUES (1,10)
connection default;
--source include/wait_condition.inc
SET DEBUG_SYNC= 'now SIGNAL resume_ddl';
connection con1;
--reap
connection con2;
--reap
connection default;
--echo # Update the record changing PK.
UPDATE t SET pid = 2 WHERE pid = 1;
SELECT * FROM t;
--echo # Insert a record that re-uses the old index key [10, 1]
INSERT INTO t(pid, uid) VALUES (1,10);
SELECT * FROM t;
--let $pk_check_table= t
--let $pk_check_index= idx_vid
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t;

--echo # Testcase-2
CREATE TABLE t (pid int PRIMARY KEY,
                uid int,
                vid int AS (uid) VIRTUAL) ENGINE=ROCKSDB;
--echo # Create index on virtual column and pause it.
connection con1;
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL start_dml WAIT_FOR resume_ddl';
--send ALTER TABLE t ADD INDEX idx_vid(vid), algorithm=inplace
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR start_dml';
SELECT * FROM t;
SET DEBUG_SYNC= 'now SIGNAL resume_ddl';
connection con1;
--reap
connection default;
--echo # Start transaction
BEGIN;
INSERT INTO t(pid, uid) VALUES (1,10);
--echo # Update the record changing PK.
UPDATE t SET pid = 2 WHERE pid = 1;
SELECT * FROM t;
--echo # Rollback transaction
ROLLBACK;
--echo # Insert a record to check valid entry in idx_vid [NULL, 1]
INSERT INTO t(pid) VALUES (1);
SELECT * FROM t;
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t;

--echo # Testcase-3
CREATE TABLE t (pid int PRIMARY KEY,
                uid int,
                vid int AS (uid) VIRTUAL) ENGINE=ROCKSDB;
INSERT INTO t(pid, uid) VALUES (1,10);
--echo # Create index on virtual column and pause it.
connection con1;
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL start_dml WAIT_FOR resume_ddl';
--send ALTER TABLE t ADD INDEX idx_vid(vid), algorithm=inplace
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR start_dml';
connection con2;
--echo # Update the record changing PK, queued behind the ALTER.
--send UPDATE t SET pid = 2 WHERE pid = 1
connection default;
--source include/wait_condition.inc
SET DEBUG_SYNC= 'now SIGNAL resume_ddl';
connection con1;
--reap
connection con2;
--reap
connection default;
--echo # Read [2, 10, 10] row using idx_vid index key.
select * from t where VID=10;
--source suite/rocksdb/include/innodb_port_check_sk_vs_pk.inc
DROP TABLE t;

--echo # Testcase-4
CREATE TABLE t (pid int PRIMARY KEY,
                uid int,
                vid int AS (uid) VIRTUAL) ENGINE=ROCKSDB;
INSERT INTO t(pid, uid) VALUES (1,10);
--echo # Create index on virtual column and pause it.
connection con1;
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL start_dml WAIT_FOR resume_ddl';
--send ALTER TABLE t ADD INDEX idx_vid(vid), algorithm=inplace
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR start_dml';
connection con2;
--echo # Update the record changing PK, queued behind the ALTER.
--send UPDATE t SET pid = 2 WHERE pid = 1
connection default;
--source include/wait_condition.inc
SET DEBUG_SYNC= 'now SIGNAL resume_ddl';
connection con1;
--reap
connection con2;
--reap
connection default;
--echo # Delete a record.
delete from t limit 1;
SELECT COUNT(*) FROM t FORCE INDEX (idx_vid);
disconnect con1;
disconnect con2;
DROP TABLE t;
SET @@session.binlog_row_image = @old_binlog_row_image;
SET DEBUG_SYNC = 'RESET';

--source include/wait_until_count_sessions.inc
