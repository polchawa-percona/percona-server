#
# Port of innodb.innodb_bug26818787 (mysql-test/suite/innodb/t/innodb_bug26818787.test)
# to MyRocks.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - InnoDB purge control (innodb_purge_stop_now / innodb_purge_run_now,
#     wait_innodb_all_purged.inc) is replaced by the MyRocks equivalent of cleaning up
#     deleted rows: a memtable flush and a manual compaction, run while the
#     re-insert is paused
#   - the InnoDB sync point before_row_ins_upd_pessimistic is replaced by the MyRocks
#     sync point rocksdb.update_write_row_after_unique_check, which pauses the
#     re-insert after its unique checks and before it writes the row
#   - checks added at the end: the re-inserted row is read back through the primary
#     key and the prefix index, and CHECK TABLE verifies the indexes
#
--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

SET DEBUG_SYNC='reset';

connect (con1,localhost,root,,);

let $round = 2;
while ($round)
{
  connection default;
  if ($round == 2)
  {
    --echo #
    --echo # Index without virtual columns
    --echo #
    CREATE TABLE t1 (
      id INT UNIQUE NOT NULL,
      a INT,
      b BLOB,
      ag INT GENERATED ALWAYS AS (a) VIRTUAL,
      PRIMARY KEY(id),
      INDEX bugidx (b(100),a)
    ) ENGINE=ROCKSDB;
  }
  if ($round == 1)
  {
    --echo #
    --echo # Index with a virtual column
    --echo #
    CREATE TABLE t1 (
      id INT UNIQUE NOT NULL,
      a INT,
      b BLOB,
      ag INT GENERATED ALWAYS AS (a) VIRTUAL,
      PRIMARY KEY(id),
      INDEX bugidx (b(100),ag)
    ) ENGINE=ROCKSDB;
  }

  INSERT INTO t1 (id, a, b) VALUES (1001, 1, REPEAT('a', 50001));
  INSERT INTO t1 (id, a, b) VALUES (1002, 2, REPEAT('b', 50002));

  DELETE FROM t1 WHERE id = 1001;

  connection con1;
  SET DEBUG_SYNC='rocksdb.update_write_row_after_unique_check SIGNAL s1 WAIT_FOR s2 TIMEOUT 10';
  send INSERT INTO t1 (id, a, b) VALUES (1001, 1, REPEAT('z', 60001));

  connection default;
  SET DEBUG_SYNC='now WAIT_FOR s1';
  # Clean up the deleted row's versions while the re-insert is paused.
  SET GLOBAL rocksdb_force_flush_memtable_now = 1;
  SET GLOBAL rocksdb_compact_cf = 'default';
  SET DEBUG_SYNC='now SIGNAL s2';

  connection con1;
  reap;
  SET DEBUG_SYNC='reset';

  connection default;
  SET DEBUG_SYNC='reset';
  SELECT id, a, ag, LEFT(b, 3), LENGTH(b) FROM t1 ORDER BY id;
  SELECT id, a, ag, LEFT(b, 3), LENGTH(b) FROM t1 FORCE INDEX (bugidx) ORDER BY id;
  SELECT id FROM t1 FORCE INDEX (id) ORDER BY id;
  SELECT id, LENGTH(b) FROM t1 FORCE INDEX (bugidx) WHERE b LIKE 'z%';
  SET GLOBAL rocksdb_force_flush_memtable_now = 1;
  SET GLOBAL rocksdb_compact_cf = 'default';
  SELECT id, a, ag, LEFT(b, 3), LENGTH(b) FROM t1 FORCE INDEX (bugidx) ORDER BY id;
  CHECK TABLE t1;
  DROP TABLE t1;
  dec $round;
}

connection con1;
disconnect con1;

connection default;
--source include/wait_until_count_sessions.inc
