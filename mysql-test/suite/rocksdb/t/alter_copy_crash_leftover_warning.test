# A crash during ALTER TABLE ... ALGORITHM=COPY can leave the ALTER's
# intermediate "#sql-..." table in the MyRocks dictionary while the data
# dictionary has rolled back to the old table. MyRocks has no atomic DDL, so
# the leftover is not removed automatically, but it must be reported at
# startup: it is invisible to SHOW TABLES and can hold a full copy of the
# table. The leftover must stay droppable with DROP TABLE `db`.`#sql-...`.
#
# Window B: the copy transaction has committed (the intermediate table holds
# all rows) and the server dies before the tables are renamed.
# Window A: the server dies during the row copy; the intermediate table is
# registered but holds no rows.
# Window B is also run with each rocksdb_validate_tables value (the leftover
# is reported in every mode and is never a validation mismatch) and on a
# partitioned table.
# Window C1: the original table has been renamed to "#sql2-..." in MyRocks.
# Window C2: the intermediate table has also been renamed to the original name.
# The recovery of t1 after C1 and C2 is checked by alter_copy_crash_rename.test.

--source include/have_rocksdb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_valgrind.inc

call mtr.add_suppression("is a leftover of an interrupted ALTER TABLE");
call mtr.add_suppression("Schema mismatch - A DD table exists for table test.t1");
call mtr.add_suppression("Attempt to open a table that is not present in RocksDB-SE");
call mtr.add_suppression("Schema mismatch - Table test.t1 is registered in RocksDB but does not have a corresponding DD table");

--let $error_log= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $leftover_q= SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%'

CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
  ENGINE=ROCKSDB;
--disable_query_log
let $i= 1;
while ($i <= 1000) {
  eval INSERT INTO t1 VALUES ($i, $i MOD 10, REPEAT('x', 80));
  inc $i;
}
--enable_query_log
--let $checksum_before= `CHECKSUM TABLE t1`

--echo #
--echo # Window B: crash after the copy commits, before the renames.
--echo #
connect (con1,localhost,root,,test);
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
--send ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY
connection default;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
--source include/kill_mysqld.inc
disconnect con1;
--source include/start_mysqld.inc

--echo # The table is the old version, data unchanged.
SHOW CREATE TABLE t1;
--let $checksum_after= `CHECKSUM TABLE t1`
--let $assert_text= Table data is unchanged after the interrupted ALTER
--let $assert_cond= "$checksum_before" = "$checksum_after"
--source include/assert.inc

--echo # The intermediate table is left in the MyRocks dictionary only.
--eval $leftover_q
--let $leftover= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%' LIMIT 1`

--echo # It is reported at startup, with the statement that drops it.
--let $assert_file= $error_log
--let $assert_select= Table test\.$leftover is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is not used\. Drop it with: DROP TABLE `test`\.`$leftover`
--let $assert_count= 1
--let $assert_text= The leftover of window B is reported once at startup
--source include/assert_grep.inc

--echo # It can be dropped, and is no longer reported after a restart.
--replace_result $leftover #sql-LEFTOVER
--eval DROP TABLE `test`.`$leftover`
--eval $leftover_q
--source include/restart_mysqld.inc
--let $assert_count= 1
--let $assert_text= The dropped leftover is not reported again
--source include/assert_grep.inc

--echo # The ALTER can be retried.
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
SELECT COUNT(*), SUM(id), COUNT(c) FROM t1;
ALTER TABLE t1 DROP COLUMN c, ALGORITHM=COPY;

--echo #
--echo # Window A: crash during the row copy. The intermediate table is empty.
--echo #
SET SESSION debug='+d,crash_copy_before_commit';
--source include/expect_crash.inc
--error CR_SERVER_LOST
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
--source include/start_mysqld.inc

--let $checksum_after= `CHECKSUM TABLE t1`
--let $assert_text= Table data is unchanged after the interrupted ALTER
--let $assert_cond= "$checksum_before" = "$checksum_after"
--source include/assert.inc
--eval $leftover_q
--let $leftover= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%' LIMIT 1`
--let $assert_select= Table test\.$leftover is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is not used\. Drop it with: DROP TABLE `test`\.`$leftover`
--let $assert_count= 1
--let $assert_text= The leftover of window A is reported once at startup
--source include/assert_grep.inc
--replace_result $leftover #sql-LEFTOVER
--eval DROP TABLE `test`.`$leftover`
--eval $leftover_q

--echo #
--echo # Window B with each rocksdb_validate_tables value: the leftover is
--echo # reported in every mode, never as a validation mismatch, and the
--echo # server starts.
--echo #
--let $v= 0
while ($v <= 2) {
  --echo # rocksdb_validate_tables=$v
  connect (con1,localhost,root,,test);
  SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
  --send ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY
  connection default;
  SET DEBUG_SYNC='now WAIT_FOR at_rename';
  --source include/kill_mysqld.inc
  disconnect con1;
  --let $restart_parameters= restart: --rocksdb_validate_tables=$v
  --source include/start_mysqld.inc
  SELECT @@global.rocksdb_validate_tables;
  --let $checksum_after= `CHECKSUM TABLE t1`
  --let $assert_text= Table data is unchanged after the interrupted ALTER
  --let $assert_cond= "$checksum_before" = "$checksum_after"
  --source include/assert.inc
  --eval $leftover_q
  --let $leftover= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%' LIMIT 1`
  --let $assert_select= Table test\.$leftover is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is not used\. Drop it with: DROP TABLE `test`\.`$leftover`
  --let $assert_count= 1
  --let $assert_text= The leftover is reported once at startup
  --source include/assert_grep.inc
  --let $assert_select= Schema mismatch.*$leftover
  --let $assert_count= 0
  --let $assert_text= The leftover is not a validation mismatch
  --source include/assert_grep.inc
  --let $assert_select= Problems validating
  --let $assert_text= Validation reports no problem
  --source include/assert_grep.inc
  --replace_result $leftover #sql-LEFTOVER
  --eval DROP TABLE `test`.`$leftover`
  --eval $leftover_q
  --inc $v
}
--let $restart_parameters=
--source include/restart_mysqld.inc

--echo #
--echo # Window B with a partitioned table: one warning for the whole table.
--echo #
ALTER TABLE t1 PARTITION BY HASH(id) PARTITIONS 3;
--let $checksum_before= `CHECKSUM TABLE t1`
connect (con1,localhost,root,,test);
SET DEBUG_SYNC='alter_table_before_rename_result_table SIGNAL at_rename WAIT_FOR never';
--send ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY
connection default;
SET DEBUG_SYNC='now WAIT_FOR at_rename';
--source include/kill_mysqld.inc
disconnect con1;
--source include/start_mysqld.inc

--let $checksum_after= `CHECKSUM TABLE t1`
--let $assert_text= Table data is unchanged after the interrupted ALTER
--let $assert_cond= "$checksum_before" = "$checksum_after"
--source include/assert.inc
--eval $leftover_q
--let $leftover= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql%' LIMIT 1`
--let $assert_select= Table test\.$leftover is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE \(6 indexes,.*It is not used\. Drop it with: DROP TABLE `test`\.`$leftover`
--let $assert_count= 1
--let $assert_text= The partitioned leftover is reported once, with all its indexes
--source include/assert_grep.inc
--replace_result $leftover #sql-LEFTOVER
--eval DROP TABLE `test`.`$leftover`
--eval $leftover_q
DROP TABLE t1;

--echo #
--echo # Window C1: crash after the original is renamed to "#sql2-...". MyRocks
--echo # does not start with the default rocksdb_validate_tables=1 (finding 37,
--echo # see alter_copy_crash_rename.test), so restart with =2 to see the
--echo # warnings. "#sql2-..." has no DD table and holds the table before the
--echo # ALTER. SQL cannot repair this state, so the data directory is restored
--echo # from a copy afterwards.
--echo #
--let $MYSQLD_DATADIR= `SELECT @@datadir`
--let $BACKUP_DATADIR= $MYSQL_TMP_DIR/alter_copy_crash_datadir
--source include/shutdown_mysqld.inc
--force-cpdir $MYSQLD_DATADIR $BACKUP_DATADIR
--source include/start_mysqld.inc

CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
  ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b');
SET SESSION debug='+d,rocksdb_crash_after_rename';
--source include/expect_crash.inc
--error CR_SERVER_LOST
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
--let $restart_parameters= restart: --rocksdb_validate_tables=2
--source include/start_mysqld.inc

--eval $leftover_q
--let $leftover= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql-%' LIMIT 1`
--let $backup= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql2-%' LIMIT 1`
--let $assert_select= Table test\.$leftover is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is not used\. Drop it with: DROP TABLE `test`\.`$leftover`
--let $assert_count= 1
--let $assert_text= The intermediate table of window C1 is reported as droppable
--source include/assert_grep.inc
--let $assert_select= Table test\.$backup is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is the table before the ALTER and can hold the only copy of its data\. It has no DD table, so DROP TABLE cannot remove it
--let $assert_text= The original table of window C1 is reported as possibly the only copy
--source include/assert_grep.inc

--echo # The intermediate table can be dropped, "#sql2-..." cannot.
--replace_result $leftover #sql-LEFTOVER
--eval DROP TABLE `test`.`$leftover`
--replace_result $backup #sql2-LEFTOVER
--error ER_BAD_TABLE_ERROR
--eval DROP TABLE `test`.`$backup`
--eval $leftover_q

--source include/shutdown_mysqld.inc
--force-rmdir $MYSQLD_DATADIR
--force-cpdir $BACKUP_DATADIR $MYSQLD_DATADIR
--let $restart_parameters=
--source include/start_mysqld.inc

--echo #
--echo # Window C2: crash after the intermediate table gets the original name.
--echo # Here "#sql2-..." has a hidden DD table, so the hint has the DROP
--echo # statement, with a caution.
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(100), KEY ka(a))
  ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b');
SET SESSION debug='+d,rocksdb_crash_after_rename_from_tmp';
--source include/expect_crash.inc
--error CR_SERVER_LOST
ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY;
--let $restart_parameters= restart: --rocksdb_validate_tables=2
--source include/start_mysqld.inc

--eval $leftover_q
--let $backup= `SELECT TABLE_NAME FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE '#sql2-%' LIMIT 1`
--let $assert_select= Table test\.$backup is registered in RocksDB but is not a visible table\. It is a leftover of an interrupted ALTER TABLE.*It is the table before the ALTER and can hold the only copy of its data\. Check the altered table before dropping it with: DROP TABLE `test`\.`$backup`
--let $assert_count= 1
--let $assert_text= The original table of window C2 is reported with a cautious DROP hint
--source include/assert_grep.inc
--replace_result $backup #sql2-LEFTOVER
--eval DROP TABLE `test`.`$backup`
--eval $leftover_q

--source include/shutdown_mysqld.inc
--force-rmdir $MYSQLD_DATADIR
--force-cpdir $BACKUP_DATADIR $MYSQLD_DATADIR
--force-rmdir $BACKUP_DATADIR
--let $restart_parameters=
--source include/start_mysqld.inc
SELECT COUNT(*) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test';
