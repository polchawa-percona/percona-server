#
# Systematic error injection into the RocksDB writes made by DDL statements
# and bulk load (see suite/rocksdb/include/errinj_loop.inc).
#
# PS-11744 and PS-11745: COPY ALTER and bulk load write the rows through
# update_write_pk()/update_write_sk(), which ignore the status of the write
# batch Put, so a failed write is lost and the statement succeeds.
#
--source include/have_rocksdb.inc
--source include/have_debug.inc

call mtr.add_suppression("Got error [0-9]+ when reading table");
call mtr.add_suppression("Failed to bulk load");
call mtr.add_suppression("bulk load error");
call mtr.add_suppression("Error [0-9]+ finalizing last SST file");
call mtr.add_suppression("Error finishing bulk load");

--source suite/rocksdb/include/errinj_ddl_setup.inc

--let $errinj_bulk_load = 2
--let $errinj_class = WRITE
--let $errinj_status = BUSY
--source suite/rocksdb/include/errinj_ddl_workloads.inc
--let $errinj_status = MEMORYLIMIT
--source suite/rocksdb/include/errinj_ddl_workloads.inc

--let $errinj_state_proc =
--let $errinj_bulk_load =
DROP TABLE IF EXISTS t2;
DROP PROCEDURE errinj_ddl_reset;
DROP PROCEDURE errinj_ddl_state;
DROP PROCEDURE errinj_bulk_load;
