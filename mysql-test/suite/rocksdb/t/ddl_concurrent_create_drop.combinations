[drop_thread]
rocksdb_enable_delete_range_for_drop_index=OFF

[delete_range]
rocksdb_enable_delete_range_for_drop_index=ON

[small_sst]
rocksdb_enable_delete_range_for_drop_index=OFF
rocksdb_default_cf_options=write_buffer_size=64k;target_file_size_base=64k;level0_file_num_compaction_trigger=2;max_bytes_for_level_base=256k

[compaction_settings]
rocksdb_enable_delete_range_for_drop_index=OFF
rocksdb_manual_compaction_bottommost_level=kSkip
rocksdb_compaction_sequential_deletes=50
rocksdb_compaction_sequential_deletes_window=100
rocksdb_compaction_sequential_deletes_count_sd=OFF
