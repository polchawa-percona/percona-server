#
# DDL must survive a power cut. After the crash and recovery (with
# rocksdb_validate_tables=1, so a mismatch between the data dictionary and
# MyRocks stops the server) each table must have either its old or its new
# definition, all its rows, and consistent indexes.
#
# The combinations run every scenario with a simulated power cut under
# rocksdb_flush_log_at_trx_commit=1 and 2 (with the background WAL sync held
# back), and with a plain kill. All three must give the same result: a
# difference means the DDL relies on writes that are not synced.
#
--source include/have_rocksdb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # DDL that completed before the crash
--echo #
--let $pl_ddl = ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 DROP INDEX ka, ALGORITHM=INPLACE
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 FORCE, ALGORITHM=COPY
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 ADD COLUMN c INT DEFAULT 7, ALGORITHM=COPY
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 ADD COLUMN c INT DEFAULT 7
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 MODIFY b VARCHAR(64), ADD INDEX kab (a, b)
--source ../include/power_loss_ddl.inc
--let $pl_ddl = TRUNCATE TABLE t1
--source ../include/power_loss_ddl.inc
--let $pl_ddl = RENAME TABLE t1 TO t2
--source ../include/power_loss_ddl.inc
--let $pl_ddl = DROP TABLE t1
--source ../include/power_loss_ddl.inc
# CREATE TABLE ... SELECT is in power_loss_ctas_flush_log_lazy.test: with
# rocksdb_flush_log_at_trx_commit=2 it is not atomic across a power cut.
--let $pl_ddl = CREATE TABLE t2 ENGINE=ROCKSDB SELECT * FROM t1
--let $pl_mode_override = 1
--source ../include/power_loss_ddl.inc
--let $pl_create = CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(32), KEY ka (a)) ENGINE=ROCKSDB PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (250), PARTITION p1 VALUES LESS THAN (1000))
--let $pl_ddl = ALTER TABLE t1 REORGANIZE PARTITION p1 INTO (PARTITION p1 VALUES LESS THAN (400), PARTITION p2 VALUES LESS THAN (1000))
--source ../include/power_loss_ddl.inc
--let $pl_create = CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b VARCHAR(32), KEY ka (a)) ENGINE=ROCKSDB PARTITION BY HASH (id) PARTITIONS 4
--let $pl_ddl = ALTER TABLE t1 TRUNCATE PARTITION p1
--source ../include/power_loss_ddl.inc

--echo #
--echo # Crash while the DDL is running
--echo #
--let $pl_ddl = ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE
--let $pl_sync = alter_table_inplace_after_lock_downgrade
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE
--let $pl_sync = alter_table_inplace_before_commit
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 ADD INDEX kb (b), ALGORITHM=INPLACE
--let $pl_sync = alter_table_before_main_binlog
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 FORCE, ALGORITHM=COPY
--let $pl_sync = alter_after_copy_table
--source ../include/power_loss_ddl.inc
--let $pl_ddl = ALTER TABLE t1 FORCE, ALGORITHM=COPY
--let $pl_sync = alter_table_before_main_binlog
--source ../include/power_loss_ddl.inc

DROP TABLE IF EXISTS t1, t2;
