#
# PS-11631: XA transactions in a session with rocksdb_master_skip_tx_api=ON.
#
# A write batch (skip tx API) cannot be prepared, so its XA PREPARE used to
# succeed without persisting anything: detaching the prepared transaction
# (xa_detach_on_prepare=ON, or a disconnect) dropped the writes, and the
# later XA COMMIT reported success without them.
#
# Expected: a session that starts its MyRocks transaction inside an XA
# transaction uses a real RocksDB transaction, so XA works. A session that
# already owns a write batch gets an error at XA PREPARE and the transaction
# is rolled back; nothing is silently lost.
#
--source include/have_rocksdb.inc
--source include/count_sessions.inc

--let $saved_global_detach = `SELECT @@GLOBAL.xa_detach_on_prepare`

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;

--let $detach = 1
while ($detach >= 0)
{
  --echo
  --echo ### xa_detach_on_prepare = $detach
  --eval SET GLOBAL xa_detach_on_prepare = $detach

  --echo # The first MyRocks statement of the session is inside XA:
  --echo # XA COMMIT in the same session keeps the rows.
  --connect (con1,localhost,root,,test)
  SET SESSION rocksdb_master_skip_tx_api = ON;
  XA START 'xs1';
  INSERT INTO t1 VALUES (1, 1);
  XA END 'xs1';
  XA PREPARE 'xs1';
  XA COMMIT 'xs1';
  SELECT * FROM t1 ORDER BY a;
  --echo # The session keeps working after the XA transaction.
  INSERT INTO t1 VALUES (2, 2);
  SELECT * FROM t1 ORDER BY a;
  --disconnect con1
  --connection default

  --echo # ... and the prepared rows survive a disconnect and are committed
  --echo # from another session.
  --connect (con1,localhost,root,,test)
  SET SESSION rocksdb_master_skip_tx_api = ON;
  XA START 'xs2';
  INSERT INTO t1 VALUES (3, 3);
  XA END 'xs2';
  XA PREPARE 'xs2';
  --disconnect con1
  --connection default
  --source include/wait_until_count_sessions.inc
  XA RECOVER;
  XA COMMIT 'xs2';
  SELECT * FROM t1 ORDER BY a;

  --echo # A session that already owns a write batch cannot prepare an XA
  --echo # transaction that modified MyRocks tables.
  --connect (con1,localhost,root,,test)
  SET SESSION rocksdb_master_skip_tx_api = ON;
  INSERT INTO t1 VALUES (4, 4);
  XA START 'xs3';
  INSERT INTO t1 VALUES (5, 5);
  XA END 'xs3';
  --error ER_NOT_SUPPORTED_YET
  XA PREPARE 'xs3';
  XA RECOVER;
  --error ER_XAER_NOTA
  XA COMMIT 'xs3';
  SELECT * FROM t1 ORDER BY a;
  --echo # A read-only XA transaction still works.
  XA START 'xs4';
  SELECT * FROM t1 WHERE a = 1;
  XA END 'xs4';
  XA PREPARE 'xs4';
  XA COMMIT 'xs4';
  --disconnect con1
  --connection default
  --source include/wait_until_count_sessions.inc

  DELETE FROM t1;
  --dec $detach
}

--replace_result $saved_global_detach SAVED
--eval SET GLOBAL xa_detach_on_prepare = $saved_global_detach
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
