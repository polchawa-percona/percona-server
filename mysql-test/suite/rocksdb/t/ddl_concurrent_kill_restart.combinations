[fltc1_binlog]
rocksdb_flush_log_at_trx_commit=1

[fltc2_nobinlog]
rocksdb_flush_log_at_trx_commit=2
skip-log-bin

[fltc0_nobinlog]
rocksdb_flush_log_at_trx_commit=0
skip-log-bin

[fltc2_binlog_nosync]
rocksdb_flush_log_at_trx_commit=2
sync_binlog=0

[manual_wal_flush_off]
rocksdb_flush_log_at_trx_commit=2
rocksdb_manual_wal_flush=OFF

[wal_recovery_0]
rocksdb_wal_recovery_mode=0

[wal_recovery_1]
rocksdb_wal_recovery_mode=1

[wal_recovery_3]
rocksdb_wal_recovery_mode=3
