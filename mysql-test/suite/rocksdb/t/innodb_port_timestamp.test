#
# Port of innodb.timestamp (mysql-test/suite/innodb/t/timestamp.test) to MyRocks.
# Bug #47453: TIMESTAMP ... ON UPDATE CURRENT_TIMESTAMP columns must change only
# when a multi-table UPDATE really changes the row.
# Changes from the original:
#   - ENGINE=InnoDB replaced by ENGINE=ROCKSDB
#   - Runs at READ COMMITTED (-master.opt): at REPEATABLE READ MyRocks rejects
#     the multi-table UPDATE with the gap-lock error, because it reads
#     the joined table without a full unique key
#   - Added: a table with a primary key and a secondary index on the TIMESTAMP
#     column, checked through both indexes, because MyRocks writes the secondary
#     key of the TIMESTAMP column only when the row changes
#
--source include/have_rocksdb.inc

--echo #
--echo # Bug #47453: InnoDB incorrectly changes TIMESTAMP columns when
--echo #  JOINed during an UPDATE
--echo #

CREATE TABLE t1 (d INT) ENGINE=ROCKSDB;
CREATE TABLE t2 (a INT, b INT,
  c TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)
  ON UPDATE CURRENT_TIMESTAMP(6)) ENGINE=ROCKSDB;

--echo # set up our data elements
INSERT INTO t1 (d) VALUES (1);
INSERT INTO t2 (a,b) VALUES (1,1);
SELECT c INTO @bug47453 FROM t2;

SELECT c!=@bug47453 FROM t1 JOIN t2 ON d=a;
UPDATE t1 JOIN t2 ON d=a SET b=1 WHERE a=1;
SELECT c!=@bug47453 FROM t1 JOIN t2 ON d=a;
UPDATE t1 JOIN t2 ON d=a SET b=1;
--echo # should be 0
SELECT c!=@bug47453 FROM t1 JOIN t2 ON d=a;
UPDATE t1 JOIN t2 ON d=a SET b=2;
--echo # should not be 0
SELECT c!=@bug47453 FROM t1 JOIN t2 ON d=a;

DROP TABLE t1, t2;

--echo #
--echo # MyRocks: the same with a primary key and an index on the TIMESTAMP column
--echo #
CREATE TABLE t1 (d INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t2 (a INT PRIMARY KEY, b INT,
  c TIMESTAMP(6) NOT NULL DEFAULT '2000-01-01 00:00:00'
  ON UPDATE CURRENT_TIMESTAMP(6), KEY kc (c)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1), (2);
INSERT INTO t2 (a, b) VALUES (1, 1), (2, 2), (3, 3);
UPDATE t1 JOIN t2 ON d=a SET b=b;
--echo # no row changed: every TIMESTAMP is still the default
SELECT a, c = '2000-01-01 00:00:00' AS unchanged FROM t2 ORDER BY a;
SELECT COUNT(*) FROM t2 FORCE INDEX (kc) WHERE c = '2000-01-01 00:00:00';
UPDATE t1 JOIN t2 ON d=a SET b=b+10;
--echo # rows 1 and 2 changed, row 3 not
SELECT a, b, c = '2000-01-01 00:00:00' AS unchanged FROM t2 ORDER BY a;
SELECT a FROM t2 FORCE INDEX (kc) WHERE c = '2000-01-01 00:00:00';
SELECT COUNT(*) FROM t2 FORCE INDEX (kc) WHERE c > '2000-01-01 00:00:00';
CHECK TABLE t2;
DROP TABLE t1, t2;
