#
# A clean shutdown must complete when background work is paused
# (rocksdb_pause_background_work=ON) and the memtable holds data.
#
# rocksdb_shutdown() flushes all memtables and waits for the flushes, but a
# paused database runs no flush, so the server waited forever and had to be
# killed. The shutdown must resume background work first (or not wait), and
# the committed rows must be there after the restart.
#
--source include/have_rocksdb.inc

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
SET GLOBAL rocksdb_pause_background_work = ON;
INSERT INTO t1 VALUES (4, 4);

--echo # Clean shutdown and restart with background work paused.
--let $shutdown_server_timeout = 60
--source include/restart_mysqld.inc

SELECT @@global.rocksdb_pause_background_work;
SELECT * FROM t1 ORDER BY a;
DROP TABLE t1;
