# Scratch: power loss after the first dict commit of a COPY ALTER.
--source include/have_rocksdb.inc
--source include/have_debug.inc
--let $zz_ref = 1
call mtr.add_suppression(".*");
if (!$zz_n) {
  --let $zz_n = 1
}
if (!$zz_status) {
  --let $zz_status = POWER_LOSS_AFTER
}
if ($zz_ref) {
  CREATE TABLE t2 (pk INT PRIMARY KEY, a INT NOT NULL, b VARCHAR(32) NOT NULL,
    d INT NOT NULL, KEY kb (b)) ENGINE=ROCKSDB;
  INSERT INTO t2 VALUES (1,1,'b1',299),(2,2,'b2',298),(3,3,'b3',297);
  ALTER TABLE t2 ADD COLUMN e INT NOT NULL DEFAULT 5, ADD INDEX ke (e), ALGORITHM=COPY;
  SET GLOBAL rocksdb_flush_log_at_trx_commit = 1;
  DROP TABLE t2;
}
SET GLOBAL rocksdb_flush_log_at_trx_commit = 1;
CREATE TABLE t2 (pk INT PRIMARY KEY, a INT NOT NULL, b VARCHAR(32) NOT NULL,
  d INT NOT NULL, KEY kb (b)) ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (1,1,'b1',299),(2,2,'b2',298),(3,3,'b3',297);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;
SELECT table_name, index_name, index_number FROM information_schema.rocksdb_ddl ORDER BY 1, 2;
SET SESSION rocksdb_debug_inject_trace = ON;
eval SET SESSION rocksdb_debug_inject_error_class = 'DICT';
eval SET SESSION rocksdb_debug_inject_error_status = '$zz_status';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
eval SET SESSION rocksdb_debug_inject_error_nth = $zz_n;
--error 2013
ALTER TABLE t2 ADD COLUMN e INT NOT NULL DEFAULT 5, ADD INDEX ke (e), ALGORITHM=COPY;
--source include/wait_until_disconnected.inc
--exec echo "restart: --rocksdb_validate_tables=2" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/wait_until_connected_again.inc
SELECT table_name, index_name, index_number FROM information_schema.rocksdb_ddl ORDER BY 1, 2;
SELECT name FROM information_schema.innodb_tables WHERE name LIKE 'test/%';
SELECT table_name FROM information_schema.tables WHERE table_schema = 'test';
--error 0,1146,1412
SELECT * FROM t2;
--let $restart_parameters =
--source include/restart_mysqld.inc
--error 0,1146
DROP TABLE IF EXISTS t2;
