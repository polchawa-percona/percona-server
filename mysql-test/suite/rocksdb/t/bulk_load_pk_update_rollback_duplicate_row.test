--source include/have_rocksdb.inc

# PS-12233: an UPDATE that changes the primary key value, run while
# rocksdb_bulk_load=1 is in effect, writes the new primary key record to the
# bulk load's SST file (ha_rocksdb::update_write_pk()), while the delete of the
# old record and the secondary index changes go to the transaction's write
# batch. When the UPDATE is rolled back (ROLLBACK, or the statement fails on a
# later row), the write batch is discarded but the SST file is still ingested
# when the load ends: the old row is back and a second copy of it exists under
# the new key, in the primary key only.
# Related: PS-12227 (same code path, PK-keeping UPDATE loses its change),
# PS-12229 (same code path, failed ingest deletes the row), PS-11899
# (rollback in a bulk load keeps the rows of rolled-back INSERTs), PS-12232
# (keys handed to a bulk load are not undone when a statement fails).
#
# Expected: an UPDATE either takes effect completely or not at all, and every
# index holds the same rows; it never adds a row. The test does not print
# whether an UPDATE succeeded, failed or was undone, only whether the table
# agrees with one of the two allowed outcomes.

--let $case = 1
while ($case <= 4)
{
  --let $has_sk = 1
  if ($case == 1)
  {
    --echo # Case 1: UPDATE of the primary key, then ROLLBACK
  }
  if ($case == 2)
  {
    --echo # Case 2: as case 1, on a table without secondary index
    --let $has_sk = 0
  }
  if ($case == 3)
  {
    --echo # Case 3: as case 1, rocksdb_bulk_load_allow_sk = 1, rows in an SST file
  }
  if ($case == 4)
  {
    --echo # Case 4: autocommit UPDATE of the primary key whose new keys are not in order
  }
  if ($has_sk)
  {
    CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=ROCKSDB;
  }
  if (!$has_sk)
  {
    CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
  }
  if ($case != 4)
  {
    INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
  }
  if ($case == 4)
  {
    INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 40), (4, 30);
  }
  if ($case == 3)
  {
    SET GLOBAL rocksdb_force_flush_memtable_now = 1;
    SET SESSION rocksdb_bulk_load_allow_sk = 1;
  }

  SET SESSION rocksdb_bulk_load = 1;
  --disable_query_log
  --disable_result_log
  --disable_abort_on_error
  if ($case != 4)
  {
    BEGIN;
    UPDATE t1 SET a = 102 WHERE a = 2;
    ROLLBACK;
  }
  if ($case == 4)
  {
    # the new keys are 120, 140, 130: no duplicate, but not in ascending order
    UPDATE t1 SET a = b + 100 WHERE a >= 2;
  }
  SET SESSION rocksdb_bulk_load = 0;
  --enable_abort_on_error
  --enable_result_log
  --enable_query_log
  SET SESSION rocksdb_bulk_load_allow_sk = DEFAULT;

  # Allowed outcomes: the original rows, or the rows after the UPDATE took
  # full effect (after a ROLLBACK the second one is what PS-11899 accepts for
  # rolled-back rows of a bulk load); never a mix, and the same rows through
  # the primary key and the secondary index.
  if ($case != 4)
  {
    --let $orig = 1:10,2:20,3:30
    --let $upd = 1:10,3:30,102:20
  }
  if ($case == 4)
  {
    --let $orig = 1:10,2:20,3:40,4:30
    --let $upd = 1:10,120:20,130:30,140:40
  }
  --let $pk_rows = `SELECT GROUP_CONCAT(a, ':', b ORDER BY a) FROM t1 USE INDEX ()`
  --let $sk_rows = $pk_rows
  if ($has_sk)
  {
    --let $sk_rows = `SELECT GROUP_CONCAT(a, ':', b ORDER BY a) FROM t1 FORCE INDEX (kb)`
  }
  --let $ok = 0
  if ($pk_rows == $orig)
  {
    if ($sk_rows == $orig)
    {
      --let $ok = 1
    }
  }
  if ($pk_rows == $upd)
  {
    if ($sk_rows == $upd)
    {
      --let $ok = 1
    }
  }
  --echo ok: $ok
  if (!$ok)
  {
    --echo primary key: $pk_rows
    if ($has_sk)
    {
      --echo secondary key: $sk_rows
    }
  }
  SELECT COUNT(*) FROM t1 USE INDEX ();
  CHECK TABLE t1;
  DROP TABLE t1;
  --inc $case
}
