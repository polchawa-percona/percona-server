# RocksDB 9.3.1 -> 9.7.4 (PS-9766, PR 6263): checkpoint creation path changed
# together with HISTORY H51 (9.4.0, checkpoint WAL hard link fix).
# CheckpointImpl::CleanStagingDirectory() now returns a Status and
# CreateCheckpoint() returns Aborted when the stale "<dir>.tmp" staging
# directory cannot be removed (rocksdb/utilities/checkpoint/checkpoint_impl.cc
# :49-84 and :130-135); 9.3.1 ignored the cleanup result and failed later in
# CreateDir().
#
# MyRocks path: SET GLOBAL rocksdb_create_checkpoint and SET SESSION
# rocksdb_create_temporary_checkpoint -> rocksdb_create_checkpoint()
# (ha_rocksdb.cc:323), which maps any non-OK Status to ER_GET_ERRMSG
# (ha_rocksdb.cc:341-346).
#
# Correct behaviour:
#  1. A stale staging directory that only holds files (left behind by an
#     interrupted checkpoint) is cleaned and the checkpoint succeeds.
#  2. A staging directory that cannot be cleaned makes the statement fail with
#     ER_GET_ERRMSG, no checkpoint directory is created, and the server keeps
#     working. The error text differs between versions and is not checked.

--source include/have_rocksdb.inc

CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);

--let $checkpoint = $MYSQL_TMP_DIR/rdb974_x3g5_stage

--echo # 1. Stale staging directory with files only
--mkdir $checkpoint.tmp
--write_file $checkpoint.tmp/000099.sst
garbage
EOF
--write_file $checkpoint.tmp/CURRENT
MANIFEST-000099
EOF
--replace_result $checkpoint [CHECKPOINT]
--eval SET GLOBAL rocksdb_create_checkpoint = '$checkpoint'
--file_exists $checkpoint/CURRENT
--error 1
--file_exists $checkpoint.tmp
--error 1
--file_exists $checkpoint/000099.sst
--force-rmdir $checkpoint

--echo # Same with a temporary checkpoint
--mkdir $checkpoint.tmp
--write_file $checkpoint.tmp/000099.sst
garbage
EOF
--replace_result $checkpoint [CHECKPOINT]
--eval SET SESSION rocksdb_create_temporary_checkpoint = '$checkpoint'
--file_exists $checkpoint/CURRENT
SET SESSION rocksdb_create_temporary_checkpoint = NULL;
--error 1
--file_exists $checkpoint/CURRENT

--echo # 2. Staging directory that cannot be cleaned
--mkdir $checkpoint.tmp
--mkdir $checkpoint.tmp/subdir
--write_file $checkpoint.tmp/subdir/keep
keep
EOF
--replace_result $checkpoint [CHECKPOINT]
--replace_regex /Got error [0-9]+ '.*' from/Got error <ERR> from/
--error ER_GET_ERRMSG
--eval SET GLOBAL rocksdb_create_checkpoint = '$checkpoint'
--error 1
--file_exists $checkpoint
--file_exists $checkpoint.tmp/subdir/keep
--replace_result $checkpoint [CHECKPOINT]
--replace_regex /Got error [0-9]+ '.*' from/Got error <ERR> from/
--error ER_GET_ERRMSG
--eval SET SESSION rocksdb_create_temporary_checkpoint = '$checkpoint'
--error 1
--file_exists $checkpoint
SELECT @@SESSION.rocksdb_create_temporary_checkpoint IS NULL AS no_tmp_checkpoint;

--echo # The server still works and a later checkpoint succeeds
--force-rmdir $checkpoint.tmp
INSERT INTO t1 VALUES (4, 40);
--replace_result $checkpoint [CHECKPOINT]
--eval SET GLOBAL rocksdb_create_checkpoint = '$checkpoint'
--file_exists $checkpoint/CURRENT
--force-rmdir $checkpoint
SELECT * FROM t1 ORDER BY id;
DROP TABLE t1;
