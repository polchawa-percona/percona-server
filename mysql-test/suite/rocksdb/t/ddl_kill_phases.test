--source include/have_rocksdb.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

#
# KILL QUERY delivered while an ALTER TABLE waits at each server-side DDL
# phase, for COPY ALTER (ADD COLUMN) and INPLACE ADD INDEX, on InnoDB and on
# MyRocks. For each phase the test records whether the ALTER was interrupted
# or completed, and checks that the table is consistent either way: the
# change is applied completely or not at all, all rows are readable through
# the primary key and the secondary index, and MyRocks has no leftover
# temporary table or index in its dictionary.
#
# Known differences (documented, not bugs): MyRocks does not check for KILL
# between the end of an INPLACE index build and its commit, so an INPLACE ADD
# INDEX killed at alter_table_inplace_before_commit completes on MyRocks and
# is rolled back on InnoDB. KILL inside the MyRocks index-build scan is
# covered by innodb_port_ddl_kill (PS-11635).
#

connect (ddl, localhost, root,,);
--let $ddl_id = `SELECT CONNECTION_ID()`
connect (killer, localhost, root,,);

--let $e = 0
while ($e < 2)
{
  if ($e == 0)
  {
    --let $engine = InnoDB
  }
  if ($e == 1)
  {
    --let $engine = ROCKSDB
  }
  --echo
  --echo ######## $engine
  connection default;
  eval CREATE TABLE t (a INT PRIMARY KEY, b INT, KEY kb (b)) ENGINE=$engine;
  --disable_query_log
  let $i = 0;
  while ($i < 200) {
    eval INSERT INTO t VALUES ($i, $i % 50);
    inc $i;
  }
  --enable_query_log

  --let $k = 0
  while ($k < 9)
  {
    if ($k == 0)
    {
      --let $point = alter_opened_table
      --let $alter = ADD COLUMN d INT, ALGORITHM=COPY
    }
    if ($k == 1)
    {
      --let $point = copy_data_between_tables_before
      --let $alter = ADD COLUMN d INT, ALGORITHM=COPY
    }
    if ($k == 2)
    {
      --let $point = after_copy_data_between_tables
      --let $alter = ADD COLUMN d INT, ALGORITHM=COPY
    }
    if ($k == 3)
    {
      --let $point = alter_table_copy_after_lock_upgrade
      --let $alter = ADD COLUMN d INT, ALGORITHM=COPY
    }
    if ($k == 4)
    {
      --let $point = alter_table_before_rename_result_table
      --let $alter = ADD COLUMN d INT, ALGORITHM=COPY
    }
    if ($k == 5)
    {
      --let $point = alter_opened_table
      --let $alter = ADD INDEX kab (a, b), ALGORITHM=INPLACE
    }
    if ($k == 6)
    {
      --let $point = alter_table_inplace_after_lock_upgrade
      --let $alter = ADD INDEX kab (a, b), ALGORITHM=INPLACE
    }
    if ($k == 7)
    {
      --let $point = alter_table_inplace_after_lock_downgrade
      --let $alter = ADD INDEX kab (a, b), ALGORITHM=INPLACE
    }
    if ($k == 8)
    {
      --let $point = alter_table_inplace_before_commit
      --let $alter = ADD INDEX kab (a, b), ALGORITHM=INPLACE
    }

    --echo # KILL QUERY at $point: ALTER TABLE t $alter
    connection ddl;
    eval SET DEBUG_SYNC = '$point SIGNAL reached WAIT_FOR go';
    --send_eval ALTER TABLE t $alter
    connection killer;
    SET DEBUG_SYNC = 'now WAIT_FOR reached';
    --disable_query_log
    eval KILL QUERY $ddl_id;
    --enable_query_log
    SET DEBUG_SYNC = 'now SIGNAL go';
    connection ddl;
    # MyRocks reports a kill noticed by its index-build scan as
    # ER_SK_POPULATE_DURING_ALTER (PS-11635); both count as interrupted.
    --error 0, ER_QUERY_INTERRUPTED, ER_SK_POPULATE_DURING_ALTER
    --reap
    if ($mysql_errno)
    {
      --echo # result: interrupted
    }
    if (!$mysql_errno)
    {
      --echo # result: completed
    }
    SET DEBUG_SYNC = 'RESET';
    connection default;
    SELECT COUNT(*) AS new_column FROM information_schema.COLUMNS
      WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't' AND COLUMN_NAME = 'd';
    SELECT COUNT(*) AS new_index FROM information_schema.STATISTICS
      WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't' AND INDEX_NAME = 'kab';
    SELECT COUNT(*), SUM(a), SUM(b) FROM t;
    SELECT COUNT(*), SUM(b) FROM t FORCE INDEX (kb) WHERE b >= 0;
    if ($e == 1)
    {
      SELECT INDEX_NAME FROM information_schema.rocksdb_ddl
        WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't' ORDER BY INDEX_NAME;
      SELECT COUNT(*) AS sql_leftovers FROM information_schema.rocksdb_ddl
        WHERE TABLE_NAME LIKE '#sql%';
    }
    CHECK TABLE t;
    # Undo a completed ALTER so that every phase starts from the same table.
    --disable_query_log
    if (`SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't' AND COLUMN_NAME = 'd'`)
    {
      ALTER TABLE t DROP COLUMN d;
    }
    if (`SELECT COUNT(*) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't' AND INDEX_NAME = 'kab'`)
    {
      ALTER TABLE t DROP INDEX kab;
    }
    --enable_query_log
    inc $k;
  }
  DROP TABLE t;
  inc $e;
}

connection default;
disconnect ddl;
disconnect killer;
--source include/wait_until_count_sessions.inc
