#
# In-place upgrade of a Percona Server 8.0 datadir with MyRocks tables after
# the 8.0 server was killed with SIGKILL (std_data/data80_rocks_upgrade_crash.zip,
# generated by std_data/upgrade80_rocksdb/gen_upgrade_datadirs.sh with
# 8.0.46-37). 8.4 recovers the 8.0 WAL and upgrades the data dictionary in
# the same startup. At the time of the kill:
#   - t_wal and t_wal_part had committed rows that were only in the WAL;
#   - a session was bulk loading 500 rows into t_bulk (never finished);
#   - t_drop had just been dropped, sharing a column family with t_drop_keep;
#   - a COPY ALTER of t_alter was filling its #sql table.
#
--source include/have_rocksdb.inc
--source include/have_util_unzip.inc
--source include/not_windows.inc

--source include/upgrade_from_prev_ver_suppressions.inc

--let $ADDITIONAL_OPTS = --log-bin=binlog
--let $ARCH_DATA = data80_rocks_upgrade_crash
--source include/begin_upgrade_from_prev_ver_mysql_upgrade.inc

SET SESSION transaction_isolation = 'READ-COMMITTED';

--echo # Committed rows, including the ones that were only in the WAL.
SELECT COUNT(*) AS expected_entries FROM upgcheck.expected WHERE db = 'upgc';
CALL upgcheck.collect('upgc', 'actual', 't_bulk,t_alter,t_drop');
--let $compare_db = upgc
--source suite/rocksdb/include/upgrade_from_80_compare.inc
SELECT COUNT(*), SUM(a), MAX(id) FROM upgc.t_wal;
SELECT COUNT(*) FROM upgc.t_wal FORCE INDEX (kb) WHERE b LIKE 'wal 5 u%';

--echo # The unfinished bulk load left nothing behind.
SELECT COUNT(*), MAX(id) FROM upgc.t_bulk;
--let $datadir = `SELECT @@datadir`
--list_files $datadir/.rocksdb *.bulk_load.tmp.sst
SET SESSION rocksdb_bulk_load = 1;
INSERT INTO upgc.t_bulk SELECT seq + 100, seq FROM upgc.seq1000 WHERE seq < 500;
SET SESSION rocksdb_bulk_load = 0;
SELECT COUNT(*), MAX(id) FROM upgc.t_bulk;

--echo # The dropped table is gone; the table sharing its column family is intact.
SELECT COUNT(*) FROM information_schema.tables
 WHERE table_schema = 'upgc' AND table_name = 't_drop';
SELECT COUNT(*) FROM information_schema.rocksdb_ddl
 WHERE table_schema = 'upgc' AND table_name = 't_drop';
SELECT COUNT(*), SUM(a) FROM upgc.t_drop_keep FORCE INDEX (ka);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 'upgc_drop_cf';
SELECT COUNT(*), SUM(a) FROM upgc.t_drop_keep FORCE INDEX (ka);

--echo # The interrupted COPY ALTER left t_alter unchanged.
SHOW CREATE TABLE upgc.t_alter;
SELECT COUNT(*), SUM(a) FROM upgc.t_alter;
SELECT COUNT(*), SUM(a) FROM upgc.t_alter FORCE INDEX (ka);
--echo # The #sql table of the interrupted COPY ALTER is not visible as a table.
SELECT COUNT(*) FROM information_schema.tables
 WHERE table_schema = 'upgc' AND table_name LIKE '#sql%';
--echo # Its MyRocks dictionary entries (if any) belong to a #sql name only.
SELECT COUNT(*) FROM information_schema.rocksdb_ddl
 WHERE table_schema = 'upgc' AND table_name NOT LIKE '#sql%'
   AND table_name NOT IN ('t_wal', 't_wal_part', 't_bulk', 't_drop_keep',
                          't_alter');
ALTER TABLE upgc.t_alter ADD COLUMN h CHAR(64) AS (SHA2(id, 256)) STORED,
  ALGORITHM=COPY;
SELECT COUNT(*), COUNT(DISTINCT h) FROM upgc.t_alter;

CHECK TABLE upgc.t_wal, upgc.t_wal_part, upgc.t_bulk, upgc.t_drop_keep,
            upgc.t_alter;

--echo # Restart once more with rocksdb_validate_tables=1.
--let $restart_parameters = "restart: --loose-skip-log-bin --skip-log-slave-updates --datadir=$MYSQLD_DATADIR1 --log-bin=binlog --rocksdb_validate_tables=1"
--let $do_not_echo_parameters = 1
--source include/restart_mysqld.inc
SELECT COUNT(*) FROM upgc.t_wal;
SELECT COUNT(*) FROM upgc.t_bulk;
SELECT COUNT(*) FROM upgc.t_alter;

--source include/end_upgrade_from_prev_ver_mysql_upgrade.inc
