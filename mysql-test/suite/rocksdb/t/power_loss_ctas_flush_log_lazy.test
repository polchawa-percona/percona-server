#
# CREATE TABLE ... SELECT must be atomic across a power cut also with
# rocksdb_flush_log_at_trx_commit=2: after recovery the new table either
# does not exist or holds all the selected rows, as with InnoDB.
#
# MyRocks commits the table definition durably (data dictionary and the
# MyRocks dictionary are synced) but the copied rows go through the WAL
# with the lazy setting, so a power cut right after the statement leaves the
# new table empty. The background WAL sync is held back to make the window
# deterministic. See power_loss_commit.test for the power cut simulation.
#
# Disabled until PS-11763 is fixed (mysql-test/collections/disabled.def).
#
--source include/have_rocksdb.inc
--source include/have_debug.inc

SET SESSION cte_max_recursion_depth = 10000;
SET GLOBAL rocksdb_flush_log_at_trx_commit = 1;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT) ENGINE=ROCKSDB;
INSERT INTO t1 SELECT seq, seq % 50 FROM (WITH RECURSIVE s(seq) AS (SELECT 1 UNION ALL SELECT seq + 1 FROM s WHERE seq < 500) SELECT seq FROM s) AS x;
SET GLOBAL rocksdb_flush_log_at_trx_commit = 2;

# At REPEATABLE READ MyRocks refuses CREATE TABLE ... SELECT (gap lock).
SET SESSION transaction_isolation = 'READ-COMMITTED';
CREATE TABLE t2 ENGINE=ROCKSDB SELECT * FROM t1;
SELECT COUNT(*) FROM t2;

--source ../include/simulate_power_loss.inc

SELECT COUNT(*) FROM t1;
--echo # t2 must either be gone or hold all 500 rows.
SELECT COUNT(*) = 0 OR (SELECT COUNT(*) FROM t2) = 500 AS ctas_atomic
  FROM information_schema.tables
  WHERE table_schema = 'test' AND table_name = 't2';

DROP TABLE IF EXISTS t2;
DROP TABLE t1;
