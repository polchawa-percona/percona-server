#
# Port of innodb.lob_double_purge (mysql-test/suite/innodb/t/lob_double_purge.test) to MyRocks.
# Changes from the original:
#   - ENGINE=ROCKSDB instead of ENGINE=InnoDB
#   - include/have_debug.inc removed: the test uses no debug feature
#   - runs at READ COMMITTED (-master.opt): at REPEATABLE READ MyRocks rejects
#     the UPDATE without a unique key inside a multi-statement transaction
#     (gap-lock rule)
#
--source include/have_rocksdb.inc


CREATE TABLE t(f1 int primary key, j1 JSON) ENGINE=ROCKSDB;

start transaction;
--disable_query_log
INSERT INTO t VALUES
(1, '["Sven", ""]');
--enable_query_log

UPDATE t SET j1 = JSON_SET(j1, '$[0]', 'Knut');
delete from t;
commit;

drop table t;

