#
# PS-11300 (PR #6145 review): UPDATE that changes the PRIMARY KEY of
# a vector-indexed row.
#
# A PK-only UPDATE does not touch the graph -- the vector has not
# moved -- so it mints no label and adds no node (design: "UPDATE").
# It re-points the row's CURRENT node at the new key: one write to
# the aux table's base_pk column, addressed by the row's (unchanged)
# percona_vec_aux_id, found by a plain lookup under the row's new
# key once the UPDATE has run.
#
# That write reaches only the aux table, not the in-memory graph. A
# session whose graph for this index is already loaded (every
# session's is, from the first INSERT: vec_add_node lazy-loads it)
# keeps its resident node's OLD base_pk until the graph is next
# (re)loaded. That is deliberate, not a bug: nothing an old
# snapshot reads depends on this write (see the isolation check
# below), and a session that queries the index again after a
# reload sees the correction. The window in between is demonstrated
# below as a KNOWN result, the way vector_update.test documents its
# own known gaps.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
k INT,
v VECTOR(4) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (7, 100, STRING_TO_VECTOR('[1,0,0,0]'));
INSERT INTO t1 VALUES (8, 200, STRING_TO_VECTOR('[0,1,0,0]'));
INSERT INTO t1 VALUES (9, 300, STRING_TO_VECTOR('[0,0,1,0]'));
# Baseline: node 1 carries base_pk=7, and the kNN query for row 7's
# own vector finds it -- both via the index and via the exact
# (IGNORE INDEX) path. This also warms the graph into memory
# (FORCE INDEX forces the load), which is what makes the KNOWN
# result below happen.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=3
id=0 level=# base_pk=# nb=#
id=1 level=# base_pk=7 nb=#
id=2 level=# base_pk=8 nb=#
id=3 level=# base_pk=9 nb=#

SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
7
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
7
#
# Change ONLY the primary key of row 7: 7 -> 70. The vector is
# untouched.
#
UPDATE t1 SET id = 70 WHERE id = 7;
# No new node, no new label: node count is unchanged (still 4, id
# 0..3) and node 1 -- the SAME node -- now carries base_pk=70.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=3
id=0 level=# base_pk=# nb=#
id=1 level=# base_pk=70 nb=#
id=2 level=# base_pk=8 nb=#
id=3 level=# base_pk=9 nb=#

SELECT id, k, VECTOR_TO_STRING(v) FROM t1 FORCE INDEX (PRIMARY) WHERE id = 70;
id	k	VECTOR_TO_STRING(v)
70	100	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
# The exact path is unaffected by the graph's memory state: it
# reads the base table directly and finds row 70.
SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
70
#
# KNOWN result, and why it is not a failing testcase here.
#
# This session's graph for t1 was warmed by the baseline queries
# above, so node 1's IN-MEMORY base_pk is still 7 -- the aux
# table's copy was corrected, but nothing re-reads it into an
# already-loaded graph. The index path below therefore still
# resolves node 1 to base_pk=7, which no longer exists, skips it,
# and returns the next-nearest row instead of 70. This is the
# accepted cost of an aux-only write (see the header comment); the
# section after the restart below shows the aux write is in fact
# correct once something re-reads it.
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
9
#
# Force a graph reload the way vector_stale_node.test does, by
# restarting the server. The graph rebuilds from the aux table,
# which is where the fix actually lives.
#
# restart
# Now the index path agrees with the exact path: row 70 is found,
# via its re-pointed node.
SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
70
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
70
# Same agreement with a wider LIMIT.
SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
70
8
9
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
70
9
8
#
# A combined UPDATE (PK AND vector change together) is the OTHER
# case: the vector DID move, so this mints a fresh label and node
# exactly as a vector-only UPDATE does, and that new node must
# carry the NEW key, not the pre-update one vec_upd_row_pk() (the
# PK-unchanged path) would report.
#
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=3
id=0 level=# base_pk=# nb=#
id=1 level=# base_pk=70 nb=#
id=2 level=# base_pk=8 nb=#
id=3 level=# base_pk=9 nb=#

UPDATE t1 SET id = 80, v = STRING_TO_VECTOR('[0,0,0,1]') WHERE id = 8;
# A new node (id=4) appears, carrying base_pk=80.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 max_id=4
id=0 level=# base_pk=# nb=#
id=1 level=# base_pk=70 nb=#
id=2 level=# base_pk=8 nb=#
id=3 level=# base_pk=9 nb=#
id=4 level=# base_pk=80 nb=#

# A newly inserted node is written into the live graph directly
# (unlike a base_pk repoint), so no restart is needed here: both
# paths already agree.
SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;
id
80
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;
id
80
#
# Isolation: what a reader whose snapshot predates a PK-changing
# UPDATE sees. It must still find the row at its OLD key, and must
# NOT see it at the new one.
#
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t2 VALUES (1, STRING_TO_VECTOR('[0,0]')),
(2, STRING_TO_VECTOR('[10,0]')),
(3, STRING_TO_VECTOR('[50,0]'));
START TRANSACTION WITH CONSISTENT SNAPSHOT;
UPDATE t2 SET id = 101 WHERE id = 1;
# The snapshot reader still finds row 1 under its OLD key...
SELECT id, VECTOR_TO_STRING(v) FROM t2
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
id	VECTOR_TO_STRING(v)
1	[0.00000e+00,0.00000e+00]
COMMIT;
# After the snapshot ends, the new key is what a fresh read sees
# (this session's t2 graph was warmed by the INSERTs above, same
# as t1's, so this also exercises the corrected aux row via a
# reader whose snapshot postdates the UPDATE -- it is not itself
# relying on the in-memory node, which is why it sees the change
# without a restart: check (2) resolves it via the base table).
SELECT id, VECTOR_TO_STRING(v) FROM t2
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
id	VECTOR_TO_STRING(v)
2	[1.00000e+01,0.00000e+00]
DROP TABLE t1, t2;
