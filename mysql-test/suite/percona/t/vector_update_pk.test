--source include/have_debug.inc

--echo #
--echo # PS-11300 (PR #6145 review): UPDATE that changes the PRIMARY KEY of
--echo # a vector-indexed row.
--echo #
--echo # A PK-only UPDATE does not touch the graph -- the vector has not
--echo # moved -- so it mints no label and adds no node (design: "UPDATE").
--echo # It re-points the row's CURRENT node at the new key: one write to
--echo # the aux table's base_pk column, addressed by the row's (unchanged)
--echo # percona_vec_aux_id, found by a plain lookup under the row's new
--echo # key once the UPDATE has run.
--echo #
--echo # That write reaches only the aux table, not the in-memory graph. A
--echo # session whose graph for this index is already loaded (every
--echo # session's is, from the first INSERT: vec_add_node lazy-loads it)
--echo # keeps its resident node's OLD base_pk until the graph is next
--echo # (re)loaded. That is deliberate, not a bug: nothing an old
--echo # snapshot reads depends on this write (see the isolation check
--echo # below), and a session that queries the index again after a
--echo # reload sees the correction. The window in between is demonstrated
--echo # below as a KNOWN result, the way vector_update.test documents its
--echo # own known gaps.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 k INT,
                 v VECTOR(4) NOT NULL,
                 KEY vk (v) TYPE hnsw WITH (M = 4));

INSERT INTO t1 VALUES (7, 100, STRING_TO_VECTOR('[1,0,0,0]'));
INSERT INTO t1 VALUES (8, 200, STRING_TO_VECTOR('[0,1,0,0]'));
INSERT INTO t1 VALUES (9, 300, STRING_TO_VECTOR('[0,0,1,0]'));

--echo # Baseline: node 1 carries base_pk=7, and the kNN query for row 7's
--echo # own vector finds it -- both via the index and via the exact
--echo # (IGNORE INDEX) path. This also warms the graph into memory
--echo # (FORCE INDEX forces the load), which is what makes the KNOWN
--echo # result below happen.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t1 FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo #
--echo # Change ONLY the primary key of row 7: 7 -> 70. The vector is
--echo # untouched.
--echo #
UPDATE t1 SET id = 70 WHERE id = 7;

--echo # No new node, no new label: node count is unchanged (still 4, id
--echo # 0..3) and node 1 -- the SAME node -- now carries base_pk=70.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

SELECT id, k, VECTOR_TO_STRING(v) FROM t1 FORCE INDEX (PRIMARY) WHERE id = 70;

--echo # The exact path is unaffected by the graph's memory state: it
--echo # reads the base table directly and finds row 70.
SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo #
--echo # KNOWN result, and why it is not a failing testcase here.
--echo #
--echo # This session's graph for t1 was warmed by the baseline queries
--echo # above, so node 1's IN-MEMORY base_pk is still 7 -- the aux
--echo # table's copy was corrected, but nothing re-reads it into an
--echo # already-loaded graph. The index path below therefore still
--echo # resolves node 1 to base_pk=7, which no longer exists, skips it,
--echo # and returns the next-nearest row instead of 70. This is the
--echo # accepted cost of an aux-only write (see the header comment); the
--echo # section after the restart below shows the aux write is in fact
--echo # correct once something re-reads it.
SELECT id FROM t1 FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo #
--echo # Force a graph reload the way vector_stale_node.test does, by
--echo # restarting the server. The graph rebuilds from the aux table,
--echo # which is where the fix actually lives.
--echo #
--source include/restart_mysqld.inc

--echo # Now the index path agrees with the exact path: row 70 is found,
--echo # via its re-pointed node.
SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t1 FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo # Same agreement with a wider LIMIT.
SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id FROM t1 FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

--echo #
--echo # A combined UPDATE (PK AND vector change together) is the OTHER
--echo # case: the vector DID move, so this mints a fresh label and node
--echo # exactly as a vector-only UPDATE does, and that new node must
--echo # carry the NEW key, not the pre-update one vec_upd_row_pk() (the
--echo # PK-unchanged path) would report.
--echo #
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

UPDATE t1 SET id = 80, v = STRING_TO_VECTOR('[0,0,0,1]') WHERE id = 8;

--echo # A new node (id=4) appears, carrying base_pk=80.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

--echo # A newly inserted node is written into the live graph directly
--echo # (unlike a base_pk repoint), so no restart is needed here: both
--echo # paths already agree.
SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t1 FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;

--echo #
--echo # Isolation: what a reader whose snapshot predates a PK-changing
--echo # UPDATE sees. It must still find the row at its OLD key, and must
--echo # NOT see it at the new one.
--echo #
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t2 VALUES (1, STRING_TO_VECTOR('[0,0]')),
                      (2, STRING_TO_VECTOR('[10,0]')),
                      (3, STRING_TO_VECTOR('[50,0]'));

START TRANSACTION WITH CONSISTENT SNAPSHOT;

connect (con2, localhost, root,,);
UPDATE t2 SET id = 101 WHERE id = 1;
disconnect con2;
--source include/wait_until_disconnected.inc
connection default;

--echo # The snapshot reader still finds row 1 under its OLD key...
SELECT id, VECTOR_TO_STRING(v) FROM t2
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;

COMMIT;

--echo # KNOWN result, same warm-graph window as above: this session's t2
--echo # graph was warmed by the INSERTs, so its resident node still
--echo # names base_pk=1, which no longer exists -- the index path skips
--echo # it and falls through to the next-nearest row, NOT row 101.
SELECT id, VECTOR_TO_STRING(v) FROM t2
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo # A fresh graph resolves it: after a reload, row 101 -- the SAME
--echo # node, re-pointed -- is what the index path returns too.
--source include/restart_mysqld.inc

SELECT id, VECTOR_TO_STRING(v) FROM t2
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;

DROP TABLE t1, t2;
