UPDATE performance_schema.setup_consumers SET ENABLED = 'NO'
  WHERE NAME = 'latch_source_summary';
SET GLOBAL performance_schema_latch_source_granularity = SOURCE;
CALL sys.ps_setup_reset_to_default(FALSE);
SELECT * FROM performance_schema.setup_consumers
WHERE NAME = 'latch_source_summary';
NAME	ENABLED
latch_source_summary	YES
SHOW GLOBAL VARIABLES LIKE 'performance_schema_latch_source_granularity';
Variable_name	Value
performance_schema_latch_source_granularity	SOURCE
SET GLOBAL performance_schema_latch_source_granularity = NONE;
UPDATE performance_schema.setup_instruments SET enabled = 'YES', timed = 'YES';
TRUNCATE TABLE performance_schema.setup_actors;
INSERT INTO performance_schema.setup_actors VALUES ('%', '%', '%', 'YES', 'YES');
UPDATE performance_schema.setup_consumers SET enabled = 'YES';
UPDATE performance_schema.threads SET instrumented = 'YES';
