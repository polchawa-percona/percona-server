#
# PS-11508: rows that do not fit in events_waits_summary_by_source are counted
# in Performance_schema_latch_source_summaries_lost.
#

SHOW GLOBAL VARIABLES LIKE 'performance_schema_max_latch_source_summaries';

UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME LIKE 'wait/synch/mutex/sql/%';
UPDATE performance_schema.setup_consumers SET ENABLED = 'YES'
  WHERE NAME = 'latch_source_summary';

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1), (2);
SELECT COUNT(*) FROM t1;
SHOW STATUS LIKE 'Threads_connected';
DROP TABLE t1;

SELECT COUNT(*) <= 2 AS FITS
  FROM performance_schema.events_waits_summary_by_source;
SELECT VARIABLE_VALUE > 0 AS LOST
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Performance_schema_latch_source_summaries_lost';

UPDATE performance_schema.setup_consumers SET ENABLED = 'NO'
  WHERE NAME = 'latch_source_summary';
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SHOW GLOBAL STATUS LIKE 'Performance_schema_latch_source_summaries_lost';

UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME LIKE 'wait/synch/mutex/sql/%';
