FROM performance_schema.events_waits_summary_by_source;
FITS
1
SELECT VARIABLE_VALUE > 0 AS LOST
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Performance_schema_latch_source_summaries_lost';
LOST
1
