SELECT * FROM performance_schema.setup_consumers
WHERE NAME IN ('latch_source_summary', 'thread_instrumentation');
NAME	ENABLED
latch_source_summary	YES
thread_instrumentation	NO
SELECT * FROM performance_schema.setup_consumer_options;
CONSUMER	NAME	VALUE
latch_source_summary	granularity	SOURCE
UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME = 'wait/synch/mutex/sql/LOCK_status';
FLUSH STATUS;
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	1
SELECT COUNT(*) > 0 AS HAS_ROWS, SUM(COUNT_STAR) > 0 AS COUNTED
FROM performance_schema.events_waits_summary_by_source
WHERE EVENT_NAME = 'wait/synch/mutex/sql/LOCK_status';
HAS_ROWS	COUNTED
1	1
# Restart: threads that end during startup and shutdown are fine.
# restart
SELECT * FROM performance_schema.setup_consumer_options;
CONSUMER	NAME	VALUE
latch_source_summary	granularity	SOURCE
