[connection master]
[connection slave]
call mtr.add_suppression("Recovery from source pos .* and file .*");
call mtr.add_suppression("Relay log recovery on channel with GTID_ONLY=1");
call mtr.add_suppression("Replica SQL for channel '': .* Error_code");
call mtr.add_suppression("Replica I/O for channel '': .* Error_code");
call mtr.add_suppression("Error reading relay log event for channel");
call mtr.add_suppression("Error looking for file after");
SELECT @@global.rocksdb_flush_log_at_trx_commit, @@global.sync_binlog,
@@global.relay_log_recovery, @@global.replica_preserve_commit_order;
@@global.rocksdb_flush_log_at_trx_commit	@@global.sync_binlog	@@global.relay_log_recovery	@@global.replica_preserve_commit_order
1	1	1	1
include/rpl/start_replica.inc
[connection master]
call mtr.add_suppression("Timeout waiting for reply of binlog");
CREATE TABLE r_acc (id INT PRIMARY KEY, bal INT NOT NULL, moves INT NOT NULL,
KEY kbal (bal)) ENGINE=ROCKSDB;
CREATE TABLE r_log (id INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE r_ev (id INT PRIMARY KEY, k INT NOT NULL, pad VARCHAR(64) NOT NULL,
KEY kk (k)) ENGINE=ROCKSDB;
CREATE TABLE i_acc (id INT PRIMARY KEY, bal INT NOT NULL, moves INT NOT NULL)
ENGINE=InnoDB;
CREATE TABLE i_log (id INT PRIMARY KEY) ENGINE=InnoDB;
include/rpl/sync_to_replica.inc
[connection master]
# Round 1: kill a replica with 4 workers
[connection slave]
include/assert.inc [replica runs with the expected number of workers]
include/rpl/stop_applier.inc
[connection master]
[connection slave]
include/rpl/start_applier.inc
include/assert.inc [performance_schema lists one row per worker]
# Kill the server
include/rpl/start_server.inc [server_number=2]
[connection slave]
include/rpl/start_replica.inc
[connection master]
include/assert.inc [the round's load committed transactions on the source]
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:r_acc, slave:r_acc]
include/diff_tables.inc [master:r_log, slave:r_log]
include/diff_tables.inc [master:r_ev, slave:r_ev]
include/diff_tables.inc [master:i_acc, slave:i_acc]
include/diff_tables.inc [master:i_log, slave:i_log]
[connection master]
[connection slave]
include/assert.inc [the replica executed exactly the source's GTIDs]
SELECT SUM(bal) = 0 AS rocksdb_zero_sum,
SUM(moves) = 2 * (SELECT COUNT(*) FROM r_log) AS rocksdb_moves_match_log
FROM r_acc;
rocksdb_zero_sum	rocksdb_moves_match_log
1	1
SELECT SUM(bal) = 0 AS innodb_zero_sum,
SUM(moves) = 2 * (SELECT COUNT(*) FROM i_log) AS innodb_moves_match_log
FROM i_acc;
innodb_zero_sum	innodb_moves_match_log
1	1
SELECT COUNT(*) AS mixed_only_in_rocksdb FROM r_log
WHERE id % 2 = 0 AND id NOT IN (SELECT id FROM i_log);
mixed_only_in_rocksdb
0
SELECT COUNT(*) AS mixed_only_in_innodb FROM i_log
WHERE id NOT IN (SELECT id FROM r_log);
mixed_only_in_innodb
0
SELECT (SELECT GROUP_CONCAT(id, ':', bal ORDER BY id) FROM r_acc FORCE INDEX (kbal)
WHERE bal > -1000000) =
(SELECT GROUP_CONCAT(id, ':', bal ORDER BY id) FROM r_acc FORCE INDEX (PRIMARY))
AS acc_sk_matches_pk;
acc_sk_matches_pk
1
SELECT (SELECT COUNT(*) FROM r_ev FORCE INDEX (kk) WHERE k >= 0) =
(SELECT COUNT(*) FROM r_ev FORCE INDEX (PRIMARY)) AS ev_sk_count_matches_pk,
(SELECT SUM(k) FROM r_ev FORCE INDEX (kk) WHERE k >= 0) =
(SELECT SUM(k) FROM r_ev FORCE INDEX (PRIMARY)) AS ev_sk_sum_matches_pk;
ev_sk_count_matches_pk	ev_sk_sum_matches_pk
1	1
CHECK TABLE r_acc, r_log, r_ev;
Table	Op	Msg_type	Msg_text
test.r_acc	check	status	OK
test.r_log	check	status	OK
test.r_ev	check	status	OK
include/assert.inc [the applier reports no error]
