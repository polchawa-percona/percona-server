include/rpl/reconnect.inc
[connection master]
SELECT COUNT(*) AS rocksdb_available FROM information_schema.ENGINES
WHERE ENGINE = 'ROCKSDB' AND SUPPORT IN ('YES', 'DEFAULT');
rocksdb_available
1
SELECT (SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1')) = (SELECT COUNT(DISTINCT TABLE_NAME) FROM information_schema.ROCKSDB_DDL WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1')) AS dictionaries_agree;
dictionaries_agree
1
# Startup finished the DROP on the source.
SELECT COUNT(*) AS t1_on_source FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
t1_on_source
0
include/rpl/sync_to_replica.inc
# The replica must not keep the table.
SELECT COUNT(*) AS t1_on_replica FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
t1_on_replica
0
