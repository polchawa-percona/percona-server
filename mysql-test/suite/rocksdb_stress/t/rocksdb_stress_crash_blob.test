# Port of innodb_stress.innodb_bigstress_crash_blob_nocompress for MyRocks.
# Stress test with BLOBs up to 24 KB: crash=yes, source and replica killed.

--source include/have_rocksdb.inc
# Don't test this under valgrind, memory leaks will occur
--source include/not_valgrind.inc
--source include/big_test.inc
--source include/rpl/init_source_replica.inc

--disable_query_log
call mtr.add_suppression("Got error 522 when reading table");
--connection slave
SET SESSION sql_log_bin = 0;
call mtr.add_suppression("Got error 522 when reading table");
# The killed replica recovers its relay log position (relay-log-recovery).
call mtr.add_suppression("Recovery from source pos .* for channel ''");
SET SESSION sql_log_bin = 1;
--connection master
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

# create the actual table
CREATE TABLE t1(id INT AUTO_INCREMENT PRIMARY KEY,
                msg_prefix VARCHAR(255),
                msg longtext,
                msg_length int,
                msg_checksum varchar(128),
                KEY msg_i(msg_prefix))
ENGINE=ROCKSDB;

let $use_blob=1;
let $do_crash=1;
let $kill_replica=1;

--let $num_crashes = 2
--let $num_workers = 20
--let $num_transactions = 0
--let $kill_db_after = 90
--let $num_records = 1000
--let $max_rows = 4096

--source suite/rocksdb_stress/include/rocksdb_stress_blob.inc
