--source include/have_rocksdb.inc

# The values include reserved words (WRITE, READ), so they are set quoted
# here instead of through rocksdb_sys_var.inc.

SET @start_global_value = @@global.rocksdb_debug_inject_error_status;
SELECT @start_global_value;
SET @start_session_value = @@session.rocksdb_debug_inject_error_status;
SELECT @start_session_value;

SET @@global.rocksdb_debug_inject_error_status = 'IOERROR';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'IOERROR';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'NOSPACE';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'NOSPACE';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'CORRUPTION';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'CORRUPTION';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'BUSY';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'BUSY';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'TIMEDOUT';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'TIMEDOUT';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'TRYAGAIN';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'TRYAGAIN';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'INCOMPLETE';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'INCOMPLETE';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'ABORTED';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'ABORTED';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'MEMORYLIMIT';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'MEMORYLIMIT';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'EXPIRED';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'EXPIRED';
SELECT @@session.rocksdb_debug_inject_error_status;
SET @@global.rocksdb_debug_inject_error_status = 'INVALIDARGUMENT';
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = 'INVALIDARGUMENT';
SELECT @@session.rocksdb_debug_inject_error_status;

SET @@global.rocksdb_debug_inject_error_status = 1;
SELECT @@global.rocksdb_debug_inject_error_status;

--error ER_WRONG_VALUE_FOR_VAR
SET @@global.rocksdb_debug_inject_error_status = 'aaa';
--error ER_WRONG_VALUE_FOR_VAR
SET @@session.rocksdb_debug_inject_error_status = 100;

SET @@global.rocksdb_debug_inject_error_status = DEFAULT;
SELECT @@global.rocksdb_debug_inject_error_status;
SET @@session.rocksdb_debug_inject_error_status = DEFAULT;
SELECT @@session.rocksdb_debug_inject_error_status;
