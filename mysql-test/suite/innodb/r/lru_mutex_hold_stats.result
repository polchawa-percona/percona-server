# Expect a row with the wait fields:
Pattern "LRU_list_mutex_hold\[[a-zA-Z0-9_.]+\.cc:[0-9]+\].*count=[1-9].*wait_total_ns=[0-9]+,wait_max_ns=[0-9]+" found
# Expect the CSV header:
Pattern "ts_us,site,count,total_wait_ns,max_wait_ns,total_held_ns,max_held_ns" found
# Expect a CSV data row:
Pattern "[0-9]+,[^,]+\.cc:[0-9]+,[1-9][0-9]*,[0-9]+,[0-9]+,[0-9]+,[0-9]+" found
