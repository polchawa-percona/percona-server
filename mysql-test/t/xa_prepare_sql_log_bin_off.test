#
# An XA transaction prepared with the binary log enabled but with
# sql_log_bin = 0 for the session must stay prepared across a server
# restart, like any other prepared XA transaction, until XA COMMIT or
# XA ROLLBACK.
#
# MYSQL_BIN_LOG::commit() runs for XA PREPARE too. When nothing is written
# to the binary log (no binlog cache manager yet, or empty caches because of
# sql_log_bin = 0), it must still mark the transaction as prepared in the
# transaction coordinator (set_prepared_in_tc); otherwise recovery sees a
# transaction that is prepared only in the storage engine and rolls it back.
#
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

CALL mtr.add_suppression("Found [0-9]+ prepared XA transactions");

CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;

--echo # 1. sql_log_bin = 0 in a session that never wrote to the binary log
--echo #    (the session has no binlog cache manager).
--connect (con1,localhost,root,,)
SET SESSION sql_log_bin = 0;
XA START 'xa_nolog';
INSERT INTO t1 VALUES (1);
XA END 'xa_nolog';
XA PREPARE 'xa_nolog';
--disconnect con1

--echo # 2. sql_log_bin = 0 in a session that already wrote to the binary log
--echo #    (the binlog cache manager exists, its caches are empty).
--connect (con2,localhost,root,,)
INSERT INTO t1 VALUES (10);
SET SESSION sql_log_bin = 0;
XA START 'xa_nolog_cached';
INSERT INTO t1 VALUES (3);
XA END 'xa_nolog_cached';
XA PREPARE 'xa_nolog_cached';
--disconnect con2

--echo # 3. sql_log_bin = 0, resolved with XA ROLLBACK after the restarts.
--connect (con3,localhost,root,,)
SET SESSION sql_log_bin = 0;
XA START 'xa_nolog_rb';
INSERT INTO t1 VALUES (4);
XA END 'xa_nolog_rb';
XA PREPARE 'xa_nolog_rb';
--disconnect con3

--echo # 4. Control: sql_log_bin = 1.
--connect (con4,localhost,root,,)
XA START 'xa_log';
INSERT INTO t1 VALUES (2);
XA END 'xa_log';
XA PREPARE 'xa_log';
--disconnect con4

--connection default
--sorted_result
XA RECOVER;

--echo # All must still be prepared after a clean restart.
--source include/restart_mysqld.inc
--sorted_result
XA RECOVER;

--echo # 5. sql_log_bin = 0, prepared after the clean restart and followed by
--echo #    a kill only (no clean shutdown in between).
--connect (con5,localhost,root,,)
SET SESSION sql_log_bin = 0;
XA START 'xa_nolog_kill';
INSERT INTO t1 VALUES (5);
XA END 'xa_nolog_kill';
XA PREPARE 'xa_nolog_kill';
--disconnect con5
--connection default

--echo # All must still be prepared after a kill.
--source include/kill_and_restart_mysqld.inc
--sorted_result
XA RECOVER;

SET SESSION sql_log_bin = 0;
XA COMMIT 'xa_nolog';
XA COMMIT 'xa_nolog_cached';
XA COMMIT 'xa_nolog_kill';
XA ROLLBACK 'xa_nolog_rb';
SET SESSION sql_log_bin = 1;
XA COMMIT 'xa_log';
--sorted_result
XA RECOVER;
SELECT * FROM t1 ORDER BY a;

DROP TABLE t1;
